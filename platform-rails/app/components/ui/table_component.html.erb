<table class="w-full text-sm <%= @css_class %>">
  <thead>
    <tr class="border-b border-gray-800 text-left">
      <% @headers.each do |h| %>
        <th class="<%= header_class(h) %>"><%= header_label(h) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-800/60">
    <%= content %>
  </tbody>
</table>
