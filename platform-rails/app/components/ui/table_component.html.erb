<table class="w-full text-sm <%= @css_class %>">
  <thead>
    <tr class="border-b border-border text-left bg-white/[0.02]">
      <% @headers.each do |h| %>
        <th class="<%= header_class(h) %>"><%= header_label(h) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody class="divide-y divide-border/60">
    <%= content %>
  </tbody>
</table>
