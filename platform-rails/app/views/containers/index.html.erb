<% page_title "Containers" %>
<% page_subtitle "Gerencie containers em execução e parados no ambiente Docker" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 256 256" class="w-7 h-7">
    <path d="M0 0h256v256H0z" fill="none" />
    <path fill="currentColor" d="M236.4 70.65L130.2 40.31a8 8 0 0 0-3.33-.23L21.74 55.1A16.08 16.08 0 0 0 8 70.94v114.12a16.08 16.08 0 0 0 13.74 15.84l105.13 15a8.5 8.5 0 0 0 1.13.1a8 8 0 0 0 2.2-.31l106.2-30.34A16.07 16.07 0 0 0 248 170V86a16.07 16.07 0 0 0-11.6-15.35M96 120H80V62.94l40-5.72v141.56l-40-5.72V136h16a8 8 0 0 0 0-16M24 70.94l40-5.72V120H48a8 8 0 0 0 0 16h16v54.78l-40-5.72Zm112 126.45V58.61L232 86v84Z" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%
    status_colors = {
      "running"    => "bg-green-500",
      "exited"     => "bg-red-500",
      "paused"     => "bg-blue-400",
      "restarting" => "bg-yellow-400",
      "created"    => "bg-gray-400",
      "dead"       => "bg-red-900"
    }
  %>
  <%= form_with url: containers_path, method: :get, data: { turbo: false }, class: "flex items-center gap-1.5" do |f| %>
    <% status_colors.each do |status, dot_color| %>
      <label class="relative cursor-pointer">
        <%= check_box_tag "statuses[]", status,
              Array(params[:statuses]).include?(status),
              id: "status_#{status}",
              class: "peer sr-only",
              onchange: "this.form.submit()" %>
        <span class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium border transition-all select-none
                     peer-checked:bg-gray-700 peer-checked:text-white peer-checked:border-gray-500
                     bg-gray-900 text-gray-500 border-gray-700 hover:border-gray-600 hover:text-gray-300">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= dot_color %>"></span>
          <%= status.capitalize %>
        </span>
      </label>
    <% end %>
    <%= hidden_field_tag "per_page", params[:per_page] if params[:per_page].present? %>
    <%= hidden_field_tag "infra", params[:infra] if params[:infra].present? %>
  <% end %>
<% end %>

<turbo-frame id="containers-content" src="<%= rows_containers_path(statuses: params[:statuses], per_page: params[:per_page], infra: params[:infra], page: params[:page]) %>">
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden animate-pulse">
    <div class="px-4 pt-3 pb-2 border-b border-gray-800 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <div class="h-8 w-52 bg-gray-800 rounded-lg"></div>
        <div class="h-8 w-40 bg-gray-800 rounded-lg"></div>
      </div>
      <div class="h-8 w-32 bg-gray-800 rounded-lg"></div>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800">
          <th class="px-4 py-3 w-8"><div class="w-3.5 h-3.5 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-28 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-14 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-14 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-10 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-12 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-10 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-12 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-16 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% 10.times do %>
          <tr>
            <td class="px-4 py-3"><div class="w-3.5 h-3.5 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3">
              <div class="flex items-start gap-2">
                <div class="w-10 h-10 bg-gray-800 rounded flex-shrink-0"></div>
                <div class="flex flex-col gap-1.5 mt-0.5">
                  <div class="h-3.5 w-36 bg-gray-800 rounded"></div>
                  <div class="h-2.5 w-24 bg-gray-800 rounded"></div>
                  <div class="h-2.5 w-48 bg-gray-800 rounded"></div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-5 w-16 bg-gray-800 rounded-full"></div></td>
            <td class="px-4 py-3"><div class="h-5 w-16 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3 text-center"><div class="h-4 w-4 bg-gray-800 rounded inline-block"></div></td>
            <td class="px-4 py-3">
              <div class="flex flex-col gap-2">
                <div class="h-4 w-32 bg-gray-800 rounded"></div>
                <div class="h-4 w-32 bg-gray-800 rounded"></div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-3 w-24 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-20 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-16 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <div class="h-7 w-7 bg-gray-800 rounded"></div>
                <div class="h-7 w-7 bg-gray-800 rounded"></div>
                <div class="h-7 w-7 bg-gray-800 rounded"></div>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
