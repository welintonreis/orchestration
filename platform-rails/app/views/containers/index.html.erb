<% page_title "Containers" %>

<% content_for :actions do %>
  <div class="flex items-center gap-1 bg-gray-800 rounded-lg p-1">
    <%= link_to "All",
          containers_path,
          class: "px-3 py-1.5 rounded-md text-sm font-medium transition-colors #{params[:filter] != 'running' ? 'bg-gray-700 text-white' : 'text-gray-400 hover:text-white'}" %>
    <%= link_to "Running",
          containers_path(filter: "running"),
          class: "px-3 py-1.5 rounded-md text-sm font-medium transition-colors #{params[:filter] == 'running' ? 'bg-gray-700 text-white' : 'text-gray-400 hover:text-white'}" %>
  </div>
<% end %>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
  <% if @containers.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
      <p class="text-gray-400 font-medium">No containers found</p>
      <p class="text-sm text-gray-600 mt-1">
        <% if params[:filter] == "running" %>
          No running containers. <br>
          <%= link_to "Show all containers", containers_path, class: "text-cyan-400 hover:text-cyan-300" %>
        <% else %>
          No containers exist on this Docker host.
        <% end %>
      </p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-left">
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Image</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Ports</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% @containers.each do |c| %>
          <% container_name = c["Names"]&.first&.sub(/^\//, "") || c["Id"][0..11] %>
          <% state = c["State"].to_s.downcase %>
          <tr class="hover:bg-gray-800/40 transition-colors group">
            <td class="px-4 py-3">
              <%= link_to container_path(c["Id"]), class: "font-mono text-gray-200 hover:text-cyan-400 transition-colors" do %>
                <%= container_name %>
              <% end %>
              <div class="text-xs text-gray-600 font-mono mt-0.5"><%= c["Id"][0..11] %></div>
            </td>
            <td class="px-4 py-3">
              <span class="text-gray-300 font-mono text-xs break-all"><%= c["Image"] %></span>
            </td>
            <td class="px-4 py-3">
              <span class="<%= status_badge(c["State"]) %>"><%= c["Status"] %></span>
            </td>
            <td class="px-4 py-3">
              <% ports = c["Ports"]&.select { |p| p["PublicPort"] }&.map { |p| "#{p["PublicPort"]}:#{p["PrivatePort"]}" } || [] %>
              <% if ports.any? %>
                <div class="flex flex-col gap-0.5">
                  <% ports.first(3).each do |port| %>
                    <span class="text-xs font-mono text-gray-400"><%= port %></span>
                  <% end %>
                  <% if ports.size > 3 %>
                    <span class="text-xs text-gray-600">+<%= ports.size - 3 %> more</span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-gray-700">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">
              <%= human_age(Time.at(c["Created"].to_i)) %>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-1 flex-wrap">
                <% if state == "running" %>
                  <%= button_to "Stop", stop_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-yellow-900/40 text-gray-300 hover:text-yellow-300 border border-gray-700 hover:border-yellow-800 transition-colors",
                        data: { turbo_confirm: "Stop container #{container_name}?" } %>
                  <%= button_to "Restart", restart_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-cyan-900/40 text-gray-300 hover:text-cyan-300 border border-gray-700 hover:border-cyan-800 transition-colors",
                        data: { turbo_confirm: "Restart container #{container_name}?" } %>
                  <%= button_to "Kill", kill_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-red-900/40 text-gray-300 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                        data: { turbo_confirm: "Force kill container #{container_name}? This is immediate and ungraceful." } %>
                  <%= button_to "Pause", pause_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-blue-900/40 text-gray-300 hover:text-blue-300 border border-gray-700 hover:border-blue-800 transition-colors" %>
                <% elsif state == "paused" %>
                  <%= button_to "Unpause", unpause_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-green-900/40 text-gray-300 hover:text-green-300 border border-gray-700 hover:border-green-800 transition-colors" %>
                <% else %>
                  <%= button_to "Start", start_container_path(c["Id"]), method: :post,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-green-900/40 text-gray-300 hover:text-green-300 border border-gray-700 hover:border-green-800 transition-colors" %>
                  <%= button_to "Remove", remove_container_path(c["Id"]), method: :delete,
                        class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-red-900/40 text-gray-300 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                        data: { turbo_confirm: "Remove container #{container_name}? This cannot be undone." } %>
                <% end %>
                <%= link_to "Logs", container_logs_path(c["Id"]),
                      class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-gray-200 border border-gray-700 transition-colors" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-4 py-2 border-t border-gray-800 text-xs text-gray-600">
      <%= @containers.size %> container<%= @containers.size == 1 ? "" : "s" %>
      <% if params[:filter] == "running" %>
        running
      <% else %>
        total
      <% end %>
    </div>
  <% end %>
</div>
