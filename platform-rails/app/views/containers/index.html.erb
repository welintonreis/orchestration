<% page_title "Containers" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 256 256" class="w-7 h-7">
    <path d="M0 0h256v256H0z" fill="none" />
    <path fill="currentColor" d="M236.4 70.65L130.2 40.31a8 8 0 0 0-3.33-.23L21.74 55.1A16.08 16.08 0 0 0 8 70.94v114.12a16.08 16.08 0 0 0 13.74 15.84l105.13 15a8.5 8.5 0 0 0 1.13.1a8 8 0 0 0 2.2-.31l106.2-30.34A16.07 16.07 0 0 0 248 170V86a16.07 16.07 0 0 0-11.6-15.35M96 120H80V62.94l40-5.72v141.56l-40-5.72V136h16a8 8 0 0 0 0-16M24 70.94l40-5.72V120H48a8 8 0 0 0 0 16h16v54.78l-40-5.72Zm112 126.45V58.61L232 86v84Z" />
  </svg>
<% end %>

<% content_for :actions do %>
  <%
    status_colors = {
      "running"    => "bg-green-500",
      "exited"     => "bg-red-500",
      "paused"     => "bg-blue-400",
      "restarting" => "bg-yellow-400",
      "created"    => "bg-gray-400",
      "dead"       => "bg-red-900"
    }
  %>
  <%= form_with url: containers_path, method: :get, data: { turbo: false }, class: "flex items-center gap-1.5" do |f| %>
    <% status_colors.each do |status, dot_color| %>
      <label class="relative cursor-pointer">
        <%= check_box_tag "statuses[]", status,
              @selected_statuses.include?(status),
              id: "status_#{status}",
              class: "peer sr-only",
              onchange: "this.form.submit()" %>
        <span class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium border transition-all select-none
                     peer-checked:bg-gray-700 peer-checked:text-white peer-checked:border-gray-500
                     bg-gray-900 text-gray-500 border-gray-700 hover:border-gray-600 hover:text-gray-300">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= dot_color %>"></span>
          <%= status.capitalize %>
        </span>
      </label>
    <% end %>
    <%= hidden_field_tag "per_page", params[:per_page] if params[:per_page].present? %>
  <% end %>
<% end %>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden"
     data-controller="filter bulk-select"
     data-bulk-select-url-value="<%= bulk_action_containers_path %>">
  <% if @containers.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
      <p class="text-gray-400 font-medium">No containers found</p>
      <p class="text-sm text-gray-600 mt-1">
        <% if @selected_statuses.any? %>
          No containers match selected filters.<br>
          <%= link_to "Show all containers", containers_path, class: "text-cyan-400 hover:text-cyan-300" %>
        <% else %>
          No containers exist on this Docker host.
        <% end %>
      </p>
    </div>
  <% else %>
    <div class="px-4 pt-3 pb-2 border-b border-gray-800 flex items-center justify-between gap-3">
      <input
        type="text"
        placeholder="Filter by name…"
        data-filter-target="input"
        data-action="input->filter#filter"
        class="w-64 px-3 py-1.5 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600"
      >
      <div class="flex items-center gap-2">
        <span data-bulk-select-target="count" class="hidden text-xs text-gray-400 whitespace-nowrap"></span>
        <% if Current.user&.admin? || Current.user&.operator? %>
          <div class="flex items-center">
            <%
              bulk_btns = [
                { action: "start",   label: "Start",   cls: "bg-green-600  hover:bg-green-500  rounded-l-lg" },
                { action: "pause",   label: "Pause",   cls: "bg-yellow-500 hover:bg-yellow-400 border-l border-black/20" },
                { action: "unpause", label: "Resume",  cls: "bg-green-600  hover:bg-green-500  border-l border-black/20" },
                { action: "stop",    label: "Stop",    cls: "bg-orange-500 hover:bg-orange-400 border-l border-black/20" },
                { action: "restart", label: "Restart", cls: "bg-green-600  hover:bg-green-500  border-l border-black/20" },
                { action: "kill",    label: "Kill",    cls: "bg-orange-500 hover:bg-orange-400 border-l border-black/20" },
                { action: "remove",  label: "Remove",  cls: "bg-red-600    hover:bg-red-500    border-l border-black/20 rounded-r-lg" },
              ]
            %>
            <% bulk_btns.each do |b| %>
              <button
                type="button"
                disabled
                data-bulk-select-target="btn"
                data-bulk-action="<%= b[:action] %>"
                data-action="click->bulk-select#perform"
                class="px-2.5 py-1.5 text-xs font-medium text-white transition-all
                       disabled:opacity-30 disabled:cursor-not-allowed
                       <%= b[:cls] %>"
              ><%= b[:label] %></button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-left">
          <th class="px-4 py-3 w-8">
            <input type="checkbox"
                   data-bulk-select-target="selectAll"
                   data-action="change->bulk-select#toggleAll"
                   class="w-3.5 h-3.5 rounded border-gray-600 bg-gray-800 text-cyan-500 cursor-pointer accent-cyan-500">
          </th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Name / ID / Image</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Stats</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Ports</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% @containers.each do |c| %>
          <% container_name = c["Names"]&.first&.sub(/^\//, "") || c["Id"][0..11] %>
          <% state = c["State"].to_s.downcase %>
          <% raw_image = c["Image"] || "" %>
          <% image_short = raw_image.split("@").first %>
          <tr class="hover:bg-gray-800/40 transition-colors group"
              data-filter-target="row"
              data-name="<%= container_name %>">
            <td class="px-4 py-3 w-8">
              <input type="checkbox"
                     value="<%= c["Id"] %>"
                     data-bulk-select-target="checkbox"
                     data-action="change->bulk-select#toggle"
                     class="w-3.5 h-3.5 rounded border-gray-600 bg-gray-800 text-cyan-500 cursor-pointer accent-cyan-500">
            </td>
            <td class="px-4 py-3">
              <%= link_to container_path(c["Id"]), class: "font-mono text-gray-200 hover:text-cyan-400 transition-colors font-medium" do %>
                <%= container_name %>
              <% end %>
              <div class="text-xs text-gray-600 font-mono mt-0.5"><%= c["Id"][0..11] %></div>
              <div class="text-xs text-gray-500 font-mono mt-0.5 truncate max-w-[260px]" title="<%= image_short %>"><%= image_short %></div>
            </td>
            <td class="px-4 py-3">
              <span class="<%= status_badge(c["State"]) %>"><%= c["Status"] %></span>
            </td>
            <td class="px-4 py-3">
              <% if state == "running" %>
                <div
                  data-controller="stats"
                  data-stats-container-id-value="<%= c["Id"] %>"
                  data-stats-endpoint-value="<%= active_environment&.endpoint || 'unix:///var/run/docker.sock' %>"
                  class="flex flex-col gap-1 min-w-[90px]"
                >
                  <div class="flex items-center gap-1">
                    <span class="text-[10px] text-gray-600 w-7">CPU</span>
                    <div class="flex-1 bg-gray-800 rounded-full h-1.5">
                      <div data-stats-target="cpuBar" class="h-1.5 rounded-full bg-green-400 transition-all duration-500" style="width:0%"></div>
                    </div>
                    <span data-stats-target="cpuText" class="text-[10px] font-mono text-gray-600 w-9 text-right">—</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <span class="text-[10px] text-gray-600 w-7">MEM</span>
                    <div class="flex-1 bg-gray-800 rounded-full h-1.5">
                      <div data-stats-target="memBar" class="h-1.5 rounded-full bg-blue-400 transition-all duration-500" style="width:0%"></div>
                    </div>
                    <span data-stats-target="memText" class="text-[10px] font-mono text-gray-600 w-9 text-right">—</span>
                  </div>
                </div>
              <% else %>
                <span class="text-gray-700 text-xs">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% ports = c["Ports"]&.select { |p| p["PublicPort"] }&.map { |p| "#{p["PublicPort"]}:#{p["PrivatePort"]}" } || [] %>
              <% if ports.any? %>
                <div class="flex flex-col gap-0.5">
                  <% ports.first(3).each do |port| %>
                    <span class="text-xs font-mono text-gray-400"><%= port %></span>
                  <% end %>
                  <% if ports.size > 3 %>
                    <span class="text-xs text-gray-600">+<%= ports.size - 3 %> more</span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-gray-700">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">
              <%= human_age(Time.at(c["Created"].to_i)) %>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-1" data-controller="loading">
                <% if Current.user&.admin? || Current.user&.operator? %>
                  <% if state == "running" %>
                    <%= button_to stop_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-yellow-900/40 text-gray-400 hover:text-yellow-300 border border-gray-700 hover:border-yellow-800 transition-colors",
                          title: "Stop", data: { turbo_confirm: "Stop container #{container_name}?", action: "click->loading#start" } do %>
                      <%= action_icon(:stop) %>
                    <% end %>
                    <%= button_to restart_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-cyan-900/40 text-gray-400 hover:text-cyan-300 border border-gray-700 hover:border-cyan-800 transition-colors",
                          title: "Restart", data: { turbo_confirm: "Restart container #{container_name}?", action: "click->loading#start" } do %>
                      <%= action_icon(:restart) %>
                    <% end %>
                    <%= button_to kill_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-red-900/40 text-gray-400 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                          title: "Kill", form: { class: "inline-flex" },
                          data: { turbo_confirm: "Force kill #{container_name}? Immediate and ungraceful.", action: "click->loading#start" } do %>
                      <%= action_icon(:kill) %>
                    <% end %>
                    <%= button_to pause_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-blue-900/40 text-gray-400 hover:text-blue-300 border border-gray-700 hover:border-blue-800 transition-colors",
                          title: "Pause", data: { action: "click->loading#start" } do %>
                      <%= action_icon(:pause) %>
                    <% end %>
                  <% elsif state == "paused" %>
                    <%= button_to unpause_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-green-900/40 text-gray-400 hover:text-green-300 border border-gray-700 hover:border-green-800 transition-colors",
                          title: "Unpause", data: { action: "click->loading#start" } do %>
                      <%= action_icon(:unpause) %>
                    <% end %>
                  <% else %>
                    <%= button_to start_container_path(c["Id"]), method: :post,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-green-900/40 text-gray-400 hover:text-green-300 border border-gray-700 hover:border-green-800 transition-colors",
                          title: "Start", data: { action: "click->loading#start" } do %>
                      <%= action_icon(:play) %>
                    <% end %>
                    <%= button_to remove_container_path(c["Id"]), method: :delete,
                          class: "p-1.5 rounded bg-gray-800 hover:bg-red-900/40 text-gray-400 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                          title: "Remove", data: { turbo_confirm: "Remove container #{container_name}? Cannot be undone.", action: "click->loading#start" } do %>
                      <%= action_icon(:remove) %>
                    <% end %>
                  <% end %>
                <% end %>
                <%= link_to container_logs_path(c["Id"]),
                      class: "p-1.5 rounded bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-gray-200 border border-gray-700 transition-colors",
                      title: "Logs" do %>
                  <%= action_icon(:logs) %>
                <% end %>
                <% if state == "running" %>
                  <%= link_to container_terminal_path(c["Id"]),
                        class: "p-1.5 rounded bg-gray-800 hover:bg-green-900/40 text-gray-400 hover:text-green-300 border border-gray-700 hover:border-green-800 transition-colors",
                        title: "Terminal" do %>
                    <%= action_icon(:terminal) %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%# Pagination bar %>
    <div class="px-4 py-3 border-t border-gray-800 flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-500">Por página:</span>
        <% [10, 20, 30, 50, 100].each do |n| %>
          <%= link_to n, containers_path(statuses: @selected_statuses, per_page: n, page: 1),
                class: "px-2 py-0.5 text-xs rounded transition-colors #{(@per_page || 10) == n ? 'bg-gray-700 text-white' : 'text-gray-500 hover:text-gray-300 hover:bg-gray-800'}" %>
        <% end %>
        <%= link_to "Todos", containers_path(statuses: @selected_statuses, per_page: 0, page: 1),
              class: "px-2 py-0.5 text-xs rounded transition-colors #{@per_page.nil? ? 'bg-gray-700 text-white' : 'text-gray-500 hover:text-gray-300 hover:bg-gray-800'}" %>
      </div>
      <div class="flex items-center gap-1 text-xs text-gray-500">
        <span><%= @total %> container<%= @total == 1 ? "" : "s" %><%= @selected_statuses.any? ? " (#{@selected_statuses.join(", ")})" : " total" %></span>
        <% if @per_page && @total_pages > 1 %>
          <span class="mx-1 text-gray-700">·</span>
          <%= link_to "‹", containers_path(statuses: @selected_statuses, per_page: params[:per_page], page: @page - 1),
                class: "px-2 py-0.5 rounded #{@page <= 1 ? 'text-gray-700 cursor-not-allowed pointer-events-none' : 'text-gray-400 hover:text-white hover:bg-gray-800'}" %>
          <span class="text-gray-400"><%= @page %> / <%= @total_pages %></span>
          <%= link_to "›", containers_path(statuses: @selected_statuses, per_page: params[:per_page], page: @page + 1),
                class: "px-2 py-0.5 rounded #{@page >= @total_pages ? 'text-gray-700 cursor-not-allowed pointer-events-none' : 'text-gray-400 hover:text-white hover:bg-gray-800'}" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
