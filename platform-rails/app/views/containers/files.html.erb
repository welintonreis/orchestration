<% page_title "Arquivos: #{@container_name}" %>
<% page_subtitle "Container: #{@container_id.first(12)} · #{@path}" %>

<% can_write = Current.user&.admin? || Current.user&.operator? %>

<div x-data="{ renameModal: false, renamePath: '', renameCurrent: '', mkdirModal: false }"
     @keydown.escape.window="renameModal = false; mkdirModal = false">

<div class="mb-4 flex items-center justify-between flex-wrap gap-3">
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <%= link_to containers_path, class: "flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary flex-shrink-0" do %>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Containers
    <% end %>
    <span class="text-text-muted flex-shrink-0">/</span>
    <nav class="flex items-center gap-1 text-xs overflow-x-auto min-w-0">
      <%= link_to @container_name, container_files_path(@container_id, path: "/"),
            class: "font-mono text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-medium whitespace-nowrap flex-shrink-0" %>
      <% segments = @path.split("/").reject(&:blank?) %>
      <% segments.each_with_index do |seg, i| %>
        <span class="text-text-muted flex-shrink-0">/</span>
        <% partial = "/" + segments[0..i].join("/") %>
        <% if i == segments.size - 1 %>
          <span class="font-mono text-orange-700 dark:text-orange-300 font-medium whitespace-nowrap flex-shrink-0"><%= seg %></span>
        <% else %>
          <%= link_to seg, container_files_path(@container_id, path: partial),
                class: "font-mono text-text-secondary hover:text-orange-600 dark:hover:text-orange-400 whitespace-nowrap flex-shrink-0" %>
        <% end %>
      <% end %>
    </nav>
  </div>

  <% if can_write %>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= form_with url: container_files_upload_path(@container_id), method: :post, multipart: true, data: { turbo: false }, class: "inline-flex" do |f| %>
        <%= f.hidden_field :path, value: @path %>
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-surface-active hover:bg-surface-active-hover text-text-primary rounded-lg border border-border-subtle transition-colors cursor-pointer" title="Upload arquivo">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Upload
          <%= f.file_field :file, class: "hidden", onchange: "this.form.submit()" %>
        </label>
      <% end %>
      <button @click="mkdirModal = true"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-surface-active hover:bg-surface-active-hover text-text-primary rounded-lg border border-border-subtle transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Novo dir
      </button>
    </div>
  <% end %>
</div>

<div class="mb-4 flex items-center gap-2 px-4 py-2.5 bg-yellow-100 dark:bg-yellow-900/20 border border-yellow-300 dark:border-yellow-800/40 rounded-xl text-xs text-yellow-600 dark:text-yellow-400">
  <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  Mudanças aqui morrem com o container — pra persistência de verdade, use um volume ou rebuilde a imagem.
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @path != "/" %>
    <div class="px-4 py-2 border-b border-border/50">
      <%= link_to container_files_path(@container_id, path: File.dirname(@path)),
            class: "flex items-center gap-2 text-sm text-text-muted hover:text-text-secondary" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        <span class="font-mono">..</span>
        <span class="text-xs text-text-muted">diretório pai</span>
      <% end %>
    </div>
  <% end %>

  <% if @entries.empty? %>
    <div class="text-center py-16 text-text-muted"><p class="text-sm">Diretório vazio ou inacessível.</p></div>
  <% else %>
    <table class="w-full text-sm">
      <thead class="bg-surface-inset/40">
        <tr>
          <th class="px-4 py-2.5 w-8"></th>
          <th class="px-4 py-2.5 text-left text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-4 py-2.5 text-left text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider w-24">Tamanho</th>
          <th class="px-4 py-2.5 text-left text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider w-40">Modificado</th>
          <th class="px-4 py-2.5 text-left text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider w-28">Permissões</th>
          <th class="px-4 py-2.5 text-right text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider w-36">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @entries.each do |entry| %>
          <% entry_path = [@path.chomp("/"), entry[:name]].join("/") %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-4 py-2.5">
              <% if entry[:type] == :directory %>
                <svg class="w-4 h-4 text-yellow-500/80" fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              <% elsif entry[:type] == :symlink %>
                <svg class="w-4 h-4 text-cyan-500/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              <% else %>
                <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <% end %>
            </td>
            <td class="px-4 py-2.5">
              <% if entry[:type] == :directory %>
                <%= link_to entry[:name], container_files_path(@container_id, path: entry_path),
                      class: "font-mono text-text-primary hover:text-orange-500 font-medium" %>
              <% else %>
                <span class="text-text-secondary font-mono text-xs"><%= entry[:name] %></span>
              <% end %>
            </td>
            <td class="px-4 py-2.5 text-text-muted text-xs font-mono">
              <%= entry[:type] == :directory ? "—" : human_bytes(entry[:size]) %>
            </td>
            <td class="px-4 py-2.5 text-text-muted text-xs font-mono"><%= entry[:modified] %></td>
            <td class="px-4 py-2.5 text-text-muted text-xs font-mono"><%= entry[:permissions] %></td>
            <td class="px-4 py-2.5 text-right">
              <div class="flex items-center justify-end gap-1">
                <%= render Ui::ButtonComponent.new(url: container_files_download_path(@container_id, path: entry_path),
                      variant: :cyan, title: entry[:type] == :directory ? "Baixar como .tar" : "Baixar") do %>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <% end %>

                <% if can_write %>
                  <% if entry[:type] == :directory %>
                    <%= form_with url: container_files_upload_path(@container_id), method: :post, multipart: true, data: { turbo: false }, class: "inline-flex" do |f| %>
                      <%= f.hidden_field :path, value: entry_path %>
                      <label class="p-1.5 rounded hover:bg-surface-active text-text-muted hover:text-green-600 dark:hover:text-green-400 transition-colors cursor-pointer" title="Upload para este diretório">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        <%= f.file_field :file, class: "hidden", onchange: "this.form.submit()" %>
                      </label>
                    <% end %>
                  <% end %>

                  <button
                    @click="renameModal = true; renamePath = '<%= j(entry_path) %>'; renameCurrent = '<%= j(entry[:name]) %>'"
                    class="p-1.5 rounded hover:bg-surface-active text-text-muted hover:text-yellow-600 dark:hover:text-yellow-400 transition-colors"
                    title="Renomear">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </button>

                  <%= render Ui::ButtonComponent.new(url: container_files_delete_path(@container_id, path: entry_path), method: :delete,
                        variant: :red, size: "p-1.5 rounded", icon: :remove, icon_css_class: "w-3.5 h-3.5", title: "Remover",
                        confirm: "Remover \"#{entry[:name]}\"? Não pode ser desfeito.") %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<% if can_write %>
<div x-show="renameModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60" @click="renameModal = false"></div>
  <div class="relative bg-surface-raised border border-border-subtle rounded-xl shadow-2xl w-80">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <h3 class="text-sm font-semibold text-text-primary">Renomear</h3>
      <button @click="renameModal = false" class="text-text-muted hover:text-text-secondary">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: container_files_rename_path(@container_id), method: :patch, data: { turbo: false }, class: "px-5 py-4 space-y-3" do |f| %>
      <input type="hidden" name="path" :value="renamePath">
      <div>
        <label class="block text-xs font-medium text-text-secondary mb-1">Novo nome</label>
        <input type="text" name="new_name" :value="renameCurrent" autofocus required
               class="w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-sm text-text-primary focus:outline-none focus:border-cyan-600"
               @focus="$el.select()">
      </div>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" @click="renameModal = false" class="px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary">Cancelar</button>
        <%= f.submit "Renomear", class: "px-4 py-1.5 text-sm font-medium bg-yellow-600 hover:bg-yellow-500 text-text-primary rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<div x-show="mkdirModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60" @click="mkdirModal = false"></div>
  <div class="relative bg-surface-raised border border-border-subtle rounded-xl shadow-2xl w-80">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <h3 class="text-sm font-semibold text-text-primary">Criar Diretório</h3>
      <button @click="mkdirModal = false" class="text-text-muted hover:text-text-secondary">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: container_files_mkdir_path(@container_id), method: :post, data: { turbo: false }, class: "px-5 py-4 space-y-3" do |f| %>
      <%= f.hidden_field :path, value: @path %>
      <div>
        <label class="block text-xs font-medium text-text-secondary mb-1">Nome do diretório</label>
        <%= f.text_field :dir_name, placeholder: "nova-pasta", autofocus: true, required: true,
              class: "w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-sm text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-600" %>
      </div>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" @click="mkdirModal = false" class="px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary">Cancelar</button>
        <%= f.submit "Criar", class: "px-4 py-1.5 text-sm font-medium bg-red-600 hover:bg-red-500 text-text-primary rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
<% end %>

</div>
