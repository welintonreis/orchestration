<% page_title "Arquivos: #{@container_name}" %>
<% page_subtitle "Container: #{@container_id.first(12)} · #{@path}" %>

<div class="mb-4 flex items-center gap-2 min-w-0">
  <%= link_to containers_path, class: "flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary flex-shrink-0" do %>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Containers
  <% end %>
  <span class="text-text-muted flex-shrink-0">/</span>
  <nav class="flex items-center gap-1 text-xs overflow-x-auto min-w-0">
    <%= link_to @container_name, container_files_path(@container_id, path: "/"),
          class: "text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-medium whitespace-nowrap flex-shrink-0" %>
    <% segments = @path.split("/").reject(&:blank?) %>
    <% segments.each_with_index do |seg, i| %>
      <span class="text-text-muted flex-shrink-0">/</span>
      <% partial = "/" + segments[0..i].join("/") %>
      <% if i == segments.size - 1 %>
        <span class="text-orange-700 dark:text-orange-300 font-medium whitespace-nowrap flex-shrink-0"><%= seg %></span>
      <% else %>
        <%= link_to seg, container_files_path(@container_id, path: partial),
              class: "text-text-secondary hover:text-orange-600 dark:hover:text-orange-400 whitespace-nowrap flex-shrink-0" %>
      <% end %>
    <% end %>
  </nav>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @path != "/" %>
    <div class="px-4 py-2 border-b border-border/50">
      <%= link_to container_files_path(@container_id, path: File.dirname(@path)),
            class: "flex items-center gap-2 text-sm text-text-muted hover:text-text-secondary" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        <span class="font-mono">..</span>
        <span class="text-xs text-text-muted">diretório pai</span>
      <% end %>
    </div>
  <% end %>

  <% if @entries.empty? %>
    <div class="text-center py-16 text-text-muted"><p class="text-sm">Diretório vazio ou inacessível.</p></div>
  <% else %>
    <table class="w-full text-sm">
      <thead class="bg-surface-inset/40">
        <tr>
          <th class="px-4 py-2.5 w-8"></th>
          <th class="px-4 py-2.5 text-left text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-4 py-2.5 text-left text-xs font-semibold text-text-muted uppercase tracking-wider w-24">Tamanho</th>
          <th class="px-4 py-2.5 text-left text-xs font-semibold text-text-muted uppercase tracking-wider w-40">Modificado</th>
          <th class="px-4 py-2.5 text-left text-xs font-semibold text-text-muted uppercase tracking-wider w-28">Permissões</th>
          <th class="px-4 py-2.5 text-right text-xs font-semibold text-text-muted uppercase tracking-wider w-20">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @entries.each do |entry| %>
          <% entry_path = [@path.chomp("/"), entry[:name]].join("/") %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-4 py-2.5">
              <% if entry[:type] == :directory %>
                <svg class="w-4 h-4 text-yellow-500/80" fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              <% elsif entry[:type] == :symlink %>
                <svg class="w-4 h-4 text-cyan-500/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              <% else %>
                <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <% end %>
            </td>
            <td class="px-4 py-2.5">
              <% if entry[:type] == :directory %>
                <%= link_to entry[:name], container_files_path(@container_id, path: entry_path),
                      class: "text-text-primary hover:text-orange-500 font-medium" %>
              <% else %>
                <span class="text-text-secondary font-mono text-xs"><%= entry[:name] %></span>
              <% end %>
            </td>
            <td class="px-4 py-2.5 text-text-muted text-xs">
              <%= entry[:type] == :directory ? "—" : human_bytes(entry[:size]) %>
            </td>
            <td class="px-4 py-2.5 text-text-muted text-xs font-mono"><%= entry[:modified] %></td>
            <td class="px-4 py-2.5 text-text-muted text-xs font-mono"><%= entry[:permissions] %></td>
            <td class="px-4 py-2.5 text-right">
              <%= link_to container_files_download_path(@container_id, path: entry_path),
                    class: "p-1.5 rounded hover:bg-surface-active text-text-muted hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors inline-flex",
                    title: entry[:type] == :directory ? "Baixar como .tar" : "Baixar" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
