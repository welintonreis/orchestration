<% page_title "Terminal — #{@container_name}" %>

<%
  current_user_param = params[:user].presence
  is_root = current_user_param == "root" || params[:root] == "1"
  exec_user = is_root ? "root" : current_user_param
%>

<div class="flex flex-col rounded-xl overflow-hidden border border-border bg-[#0d1117]"
     style="height: calc(100vh - 128px)">

  <%# Header bar %>
  <div class="flex items-center gap-3 px-3 py-2 bg-surface-raised/90 border-b border-border flex-shrink-0 flex-wrap gap-y-2">

    <%# Back button %>
    <%= link_to containers_path,
          class: "inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors flex-shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7-7 7 7 7"/>
      </svg>
      Voltar
    <% end %>

    <%# Divider %>
    <span class="w-px h-4 bg-surface-active flex-shrink-0"></span>

    <%# Container identity %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600 dark:text-green-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 6-6-6-6m8 14h8"/>
    </svg>
    <span class="text-xs font-mono text-text-secondary flex-shrink-0"><%= @container_name %></span>
    <span class="text-xs text-text-muted font-mono flex-shrink-0 hidden sm:inline"><%= @container_id[0..11] %></span>

    <%# Spacer %>
    <span class="flex-1"></span>

    <%# User config form %>
    <%= form_with url: container_terminal_path(@container_id), method: :get,
          data: { turbo: false },
          class: "flex items-center gap-2" do |f| %>

      <%# Root toggle %>
      <label class="relative cursor-pointer flex-shrink-0" title="Conectar como root">
        <%= check_box_tag "root", "1", is_root,
              id: "root_toggle",
              class: "peer sr-only",
              onchange: "this.form.submit()" %>
        <span class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium border transition-all select-none
                     peer-checked:bg-red-100 dark:bg-red-950/60 peer-checked:text-red-600 dark:text-red-400 peer-checked:border-red-300 dark:border-red-800/60
                     bg-surface-raised text-text-muted border-border-subtle hover:text-text-secondary hover:border-border-subtle">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.302 21.615c.221.129.332.194.488.227.122.026.298.026.42 0 .156-.034.267-.098.488-.227C14.646 20.478 20 16.908 20 12V7.217c0-.799 0-1.199-.13-1.542a2 2 0 0 0-.548-.79c-.275-.243-.65-.383-1.398-.664l-5.362-2.01c-.208-.078-.312-.117-.419-.133a1 1 0 0 0-.286 0c-.107.016-.21.055-.419.133L6.076 4.22c-.748.28-1.122.421-1.398.664a2 2 0 0 0-.547.79C4 6.018 4 6.418 4 7.217V12c0 4.908 5.354 8.478 7.302 9.615Z"/>
          </svg>
          root
        </span>
      </label>

      <%# Custom user input %>
      <% unless is_root %>
        <input type="text"
               name="user"
               value="<%= current_user_param %>"
               placeholder="usuário…"
               class="w-28 px-2.5 py-1.5 bg-surface-inset border border-border-subtle rounded-lg text-xs font-mono text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-700">
        <button type="submit"
                class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors whitespace-nowrap">
          Reconectar
        </button>
      <% end %>
    <% end %>

    <% if exec_user.present? %>
      <span class="text-[10px] text-text-muted uppercase tracking-widest flex-shrink-0">TTY · <%= exec_user %></span>
    <% else %>
      <span class="text-[10px] text-text-muted uppercase tracking-widest flex-shrink-0">TTY · /bin/sh</span>
    <% end %>
  </div>

  <%# xterm container %>
  <div data-controller="terminal"
       data-terminal-container-id-value="<%= @container_id %>"
       data-terminal-user-value="<%= exec_user %>"
       data-terminal-root-value="<%= is_root %>"
       class="flex-1 min-h-0">
    <div data-terminal-target="container" class="w-full h-full p-1"></div>
  </div>
</div>
