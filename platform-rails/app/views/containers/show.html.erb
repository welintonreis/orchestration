<% page_title "Container" %>

<% content_for :title_actions do %>
  <%= link_to "← Containers", containers_path,
        class: "px-3 py-1.5 text-sm text-gray-400 hover:text-white bg-gray-800 hover:bg-gray-700 border border-gray-700 rounded-lg transition-colors" %>
  <%= link_to "Logs", container_logs_path(@container["Id"]),
        class: "px-3 py-1.5 text-sm text-gray-300 hover:text-white bg-gray-800 hover:bg-gray-700 border border-gray-700 rounded-lg transition-colors" %>
<% end %>

<div class="space-y-4">

  <%# Identity card %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-lg font-semibold text-white font-mono">
          <%= @container["Name"]&.sub(/^\//, "") %>
        </h2>
        <div class="text-xs text-gray-500 font-mono mt-0.5"><%= @container["Id"] %></div>
      </div>
      <span class="<%= status_badge(@container["State"]["Status"]) %> flex-shrink-0">
        <%= @container["State"]["Status"] %>
      </span>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Image</dt>
        <dd class="text-sm font-mono text-gray-200 text-right ml-4 break-all"><%= @container["Config"]["Image"] %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Platform</dt>
        <dd class="text-sm font-mono text-gray-200"><%= @container["Platform"] || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Restart Policy</dt>
        <dd class="text-sm text-gray-200"><%= @container.dig("HostConfig", "RestartPolicy", "Name") || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">PID</dt>
        <dd class="text-sm font-mono text-gray-200"><%= @container.dig("State", "Pid") || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Created</dt>
        <dd class="text-sm text-gray-200">
          <% created = @container["Created"] %>
          <%= created.present? ? human_age(Time.parse(created)) : "—" %>
        </dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Started</dt>
        <dd class="text-sm text-gray-200">
          <% started = @container.dig("State", "StartedAt") %>
          <%= started.present? && started != "0001-01-01T00:00:00Z" ? human_age(Time.parse(started)) : "—" %>
        </dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-gray-800/60 pb-2">
        <dt class="text-sm text-gray-500">Finished</dt>
        <dd class="text-sm text-gray-200">
          <% finished = @container.dig("State", "FinishedAt") %>
          <%= finished.present? && finished != "0001-01-01T00:00:00Z" ? human_age(Time.parse(finished)) : "—" %>
        </dd>
      </div>
    </dl>
  </div>

  <%# Environment variables %>
  <% env_vars = @container.dig("Config", "Env") || [] %>
  <% if env_vars.any? %>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
      <h3 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Environment Variables</h3>
      <div class="space-y-1">
        <% env_vars.each do |env| %>
          <div class="font-mono text-xs text-gray-400 bg-gray-950 rounded px-3 py-1.5 break-all"><%= env %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Mounts %>
  <% mounts = @container["Mounts"] || [] %>
  <% if mounts.any? %>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
      <h3 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Mounts</h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left">
            <th class="pb-2 text-xs text-gray-500 uppercase tracking-wider font-semibold pr-4">Type</th>
            <th class="pb-2 text-xs text-gray-500 uppercase tracking-wider font-semibold pr-4">Source</th>
            <th class="pb-2 text-xs text-gray-500 uppercase tracking-wider font-semibold pr-4">Destination</th>
            <th class="pb-2 text-xs text-gray-500 uppercase tracking-wider font-semibold">Mode</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/60">
          <% mounts.each do |m| %>
            <tr>
              <td class="py-2 pr-4 text-xs text-gray-400 font-mono"><%= m["Type"] %></td>
              <td class="py-2 pr-4 text-xs text-gray-300 font-mono break-all"><%= m["Source"] %></td>
              <td class="py-2 pr-4 text-xs text-gray-300 font-mono break-all"><%= m["Destination"] %></td>
              <td class="py-2 text-xs text-gray-500"><%= m["Mode"].presence || "rw" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# Actions %>
  <% state = @container.dig("State", "Status").to_s.downcase %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <h3 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Actions</h3>
    <div class="flex flex-wrap gap-2">
      <% if state == "running" %>
        <%= render Ui::ButtonComponent.new(url: stop_container_path(@container["Id"]), method: :post,
              variant: :yellow, size: :md, label: "Stop", confirm: "Stop this container?") %>
        <%= render Ui::ButtonComponent.new(url: restart_container_path(@container["Id"]), method: :post,
              variant: :cyan, size: :md, label: "Restart", confirm: "Restart this container?") %>
        <%= render Ui::ButtonComponent.new(url: kill_container_path(@container["Id"]), method: :post,
              variant: :red, size: :md, label: "Kill", confirm: "Force kill this container? This is immediate and ungraceful.") %>
        <%= render Ui::ButtonComponent.new(url: pause_container_path(@container["Id"]), method: :post,
              variant: :blue, size: :md, label: "Pause") %>
      <% elsif state == "paused" %>
        <%= render Ui::ButtonComponent.new(url: unpause_container_path(@container["Id"]), method: :post,
              variant: :green, size: :md, label: "Unpause") %>
      <% else %>
        <%= render Ui::ButtonComponent.new(url: start_container_path(@container["Id"]), method: :post,
              variant: :green, size: :md, label: "Start") %>
        <%= render Ui::ButtonComponent.new(url: remove_container_path(@container["Id"]), method: :delete,
              variant: :red, size: :md, label: "Remove", confirm: "Remove this container? This cannot be undone.") %>
      <% end %>
      <%= render Ui::ButtonComponent.new(url: container_logs_path(@container["Id"]),
            variant: :gray, size: :md, label: "View Logs") %>
    </div>
  </div>

</div>
