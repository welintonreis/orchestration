<% page_title "Container" %>

<% content_for :title_actions do %>
  <%= render Ui::ButtonComponent.new(url: containers_path, variant: :gray, size: :md, label: "← Containers") %>
  <%= render Ui::ButtonComponent.new(url: container_logs_path(@container["Id"]), variant: :gray, size: :md, label: "Logs") %>
  <%= render Ui::ButtonComponent.new(url: container_files_path(@container["Id"]), variant: :gray, size: :md, label: "Files") %>
<% end %>

<div class="space-y-4">

  <%# Identity card %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-lg font-semibold text-text-primary font-mono">
          <%= @container["Name"]&.sub(/^\//, "") %>
        </h2>
        <div class="text-xs text-text-muted font-mono mt-0.5"><%= @container["Id"] %></div>
      </div>
      <%
        # ponytail: same state->color mapping as rows.html.erb (running=green,
        # restarting=brand, paused=amber, exited=red, created=cyan, dead=gray).
        show_badge_color = {
          "running" => :green, "restarting" => :orange, "paused" => :yellow,
          "exited" => :red, "created" => :cyan, "dead" => :gray
        }.fetch(@container["State"]["Status"].to_s.downcase, :gray)
      %>
      <%= render(Ui::BadgeComponent.new(color: show_badge_color, size: :md, dot: true, css_class: "flex-shrink-0")) { @container["State"]["Status"] } %>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Image</dt>
        <dd class="text-sm font-mono text-text-primary text-right ml-4 break-all"><%= @container["Config"]["Image"] %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Platform</dt>
        <dd class="text-sm font-mono text-text-primary"><%= @container["Platform"] || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Restart Policy</dt>
        <dd class="text-sm font-mono text-text-primary"><%= @container.dig("HostConfig", "RestartPolicy", "Name") || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">PID</dt>
        <dd class="text-sm font-mono text-text-primary"><%= @container.dig("State", "Pid") || "—" %></dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Created</dt>
        <dd class="text-sm font-mono text-text-primary">
          <% created = @container["Created"] %>
          <%= created.present? ? human_age(Time.parse(created)) : "—" %>
        </dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Started</dt>
        <dd class="text-sm font-mono text-text-primary">
          <% started = @container.dig("State", "StartedAt") %>
          <%= started.present? && started != "0001-01-01T00:00:00Z" ? human_age(Time.parse(started)) : "—" %>
        </dd>
      </div>

      <div class="flex items-baseline justify-between border-b border-border/60 pb-2">
        <dt class="text-sm text-text-muted">Finished</dt>
        <dd class="text-sm font-mono text-text-primary">
          <% finished = @container.dig("State", "FinishedAt") %>
          <%= finished.present? && finished != "0001-01-01T00:00:00Z" ? human_age(Time.parse(finished)) : "—" %>
        </dd>
      </div>
    </dl>
  </div>

  <%# Environment variables %>
  <% env_vars = @container.dig("Config", "Env") || [] %>
  <% if env_vars.any? %>
    <div class="bg-surface-raised border border-border rounded-xl p-5">
      <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3">Environment Variables</h3>
      <div class="space-y-1">
        <% env_vars.each do |env| %>
          <div class="font-mono text-xs text-text-secondary bg-surface-sunken rounded px-3 py-1.5 break-all"><%= env %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Mounts %>
  <% mounts = @container["Mounts"] || [] %>
  <% if mounts.any? %>
    <div class="bg-surface-raised border border-border rounded-xl p-5">
      <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3">Mounts</h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left">
            <th class="pb-2 text-xs text-text-muted uppercase tracking-wider font-semibold pr-4">Type</th>
            <th class="pb-2 text-xs text-text-muted uppercase tracking-wider font-semibold pr-4">Source</th>
            <th class="pb-2 text-xs text-text-muted uppercase tracking-wider font-semibold pr-4">Destination</th>
            <th class="pb-2 text-xs text-text-muted uppercase tracking-wider font-semibold">Mode</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          <% mounts.each do |m| %>
            <tr>
              <td class="py-2 pr-4 text-xs text-text-secondary font-mono"><%= m["Type"] %></td>
              <td class="py-2 pr-4 text-xs text-text-secondary font-mono break-all"><%= m["Source"] %></td>
              <td class="py-2 pr-4 text-xs text-text-secondary font-mono break-all"><%= m["Destination"] %></td>
              <td class="py-2 text-xs text-text-muted"><%= m["Mode"].presence || "rw" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# Actions %>
  <% state = @container.dig("State", "Status").to_s.downcase %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3">Actions</h3>
    <div class="flex flex-wrap gap-2">
      <% if state == "running" %>
        <%= render Ui::ButtonComponent.new(url: stop_container_path(@container["Id"]), method: :post,
              variant: :yellow, size: :md, label: "Stop", confirm: "Stop this container?") %>
        <%= render Ui::ButtonComponent.new(url: restart_container_path(@container["Id"]), method: :post,
              variant: :cyan, size: :md, label: "Restart", confirm: "Restart this container?") %>
        <%= render Ui::ButtonComponent.new(url: kill_container_path(@container["Id"]), method: :post,
              variant: :red, size: :md, label: "Kill", confirm: "Force kill this container? This is immediate and ungraceful.") %>
        <%= render Ui::ButtonComponent.new(url: pause_container_path(@container["Id"]), method: :post,
              variant: :blue, size: :md, label: "Pause") %>
      <% elsif state == "paused" %>
        <%= render Ui::ButtonComponent.new(url: unpause_container_path(@container["Id"]), method: :post,
              variant: :green, size: :md, label: "Unpause") %>
      <% else %>
        <%= render Ui::ButtonComponent.new(url: start_container_path(@container["Id"]), method: :post,
              variant: :green, size: :md, label: "Start") %>
        <%= render Ui::ButtonComponent.new(url: remove_container_path(@container["Id"]), method: :delete,
              variant: :red, size: :md, label: "Remove", confirm: "Remove this container? This cannot be undone.") %>
      <% end %>
      <%= render Ui::ButtonComponent.new(url: container_logs_path(@container["Id"]),
            variant: :gray, size: :md, label: "View Logs") %>
    </div>
  </div>

</div>
