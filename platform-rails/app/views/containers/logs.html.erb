<% page_title "Logs — #{@container_id[0..11]}" %>

<% content_for :title_actions do %>
  <div class="flex items-center gap-2 flex-wrap">
    <%# Tail selector %>
    <div class="flex items-center gap-1 bg-surface-inset rounded-lg p-1">
      <% [100, 200, 500, 1000].each do |n| %>
        <%= link_to n, container_logs_path(@container_id, tail: n, timestamps: params[:timestamps]),
              class: "px-2.5 py-1 rounded text-xs font-medium transition-colors #{@tail == n ? 'bg-surface-active text-text-primary' : 'text-text-secondary hover:text-text-primary'}" %>
      <% end %>
    </div>

    <%# Timestamp toggle %>
    <%= link_to container_logs_path(@container_id, tail: @tail, timestamps: params[:timestamps] == "1" ? nil : "1"),
          class: "inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium border transition-colors #{params[:timestamps] == '1' ? 'bg-surface-active text-text-primary border-border-subtle' : 'text-text-secondary border-border-subtle hover:text-text-primary hover:border-border-subtle'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"/>
      </svg>
      Timestamp
    <% end %>

    <%= link_to containers_path,
          class: "px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle rounded-lg transition-colors" do %>
      ← Containers
    <% end %>
  </div>
<% end %>

<div class="space-y-3"
     data-controller="log-stream"
     data-log-stream-container-id-value="<%= @container_id %>"
     data-log-stream-endpoint-value="<%= active_environment&.endpoint || 'unix:///var/run/docker.sock' %>"
     data-log-stream-tail-value="<%= @tail %>"
     data-log-stream-timestamps-value="<%= params[:timestamps] == '1' %>">

  <%# Toolbar %>
  <div class="flex items-center gap-3 px-4 py-2.5 bg-surface-raised border border-border rounded-xl">
    <%# Back %>
    <%= link_to containers_path,
          class: "inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors flex-shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7-7 7 7 7"/>
      </svg>
      Voltar
    <% end %>

    <%# Search %>
    <div class="flex-1 relative">
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0Z"/>
      </svg>
      <input type="text"
             placeholder="Filtrar logs…"
             data-log-stream-target="search"
             data-action="input->log-stream#filter"
             class="w-full pl-8 pr-3 py-1.5 bg-surface-inset border border-border-subtle rounded-lg text-xs font-mono text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-700">
    </div>

    <%# Line count %>
    <span class="text-xs text-text-muted font-mono whitespace-nowrap">
      <span data-log-stream-target="count">0</span> linhas
    </span>

    <%# Auto-scroll toggle %>
    <button data-action="click->log-stream#toggleScroll"
            data-log-stream-target="scrollBtn"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-800/50 hover:bg-cyan-100 dark:bg-cyan-900/50 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 13l-7 7-7-7m14-8l-7 7-7-7"/>
      </svg>
      Auto-scroll
    </button>

    <%# Clear %>
    <button data-action="click->log-stream#clear"
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-muted hover:text-text-secondary border border-border hover:border-border-subtle transition-colors">
      Limpar
    </button>
  </div>

  <%# Log viewer %>
  <div class="bg-surface-sunken border border-border rounded-xl overflow-hidden">
    <pre data-log-stream-target="output"
         class="log-viewer overflow-auto p-4 text-xs font-mono leading-5 min-h-[200px] max-h-[calc(100vh-260px)]"></pre>
  </div>
</div>
