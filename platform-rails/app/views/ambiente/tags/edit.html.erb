<% content_for :title, "Editar Tag" %>
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-2 text-sm text-text-muted mb-4">
    <%= link_to "Tags", ambiente_tags_path, class: "hover:text-text-secondary" %> <span>/</span> <span class="text-text-secondary">Editar</span>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <h2 class="text-lg font-semibold text-text-primary mb-5">Editar Tag: <%= @tag.name %></h2>
    <%# Model is EnvironmentTag but route is ambiente_tags — same mismatch
        as ambiente/registries, explicit url: needed. %>
    <%= form_with model: @tag, url: ambiente_tag_path(@tag), local: true do |f| %>
      <div class="mb-4">
        <%= f.label :name, "Nome", class: "block text-xs font-medium text-text-secondary mb-1" %>
        <%= f.text_field :name, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
      </div>
      <div class="mb-5">
        <%= f.label :color, "Cor", class: "block text-xs font-medium text-text-secondary mb-1" %>
        <div class="flex items-center gap-3">
          <%= f.color_field :color, class: "w-12 h-10 rounded-lg bg-surface-inset border border-border-subtle cursor-pointer p-0.5" %>
          <%= f.text_field :color, id: "tag_color_hex", class: "flex-1 bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm font-mono text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
        </div>
      </div>
      <div class="flex gap-3">
        <%= f.submit "Salvar", class: "btn-primary" %>
        <%= link_to "Cancelar", ambiente_tags_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
