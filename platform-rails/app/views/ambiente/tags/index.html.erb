<% content_for :title, "Tags de Ambiente" %>
<% page_subtitle "Labels coloridas para categorizar e organizar ambientes" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none"/>
    <path fill="currentColor" d="m21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9A2 2 0 0 0 13 22a2 2 0 0 0 1.41-.59l7-7A2 2 0 0 0 22 13a2 2 0 0 0-.59-1.42M13 20l-9-9V4h7l9 9M6.5 5A1.5 1.5 0 1 1 5 6.5A1.5 1.5 0 0 1 6.5 5"/>
  </svg>
<% end %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Tags</h2>
    <p class="text-sm text-text-secondary mt-0.5">Labels coloridas para categorizar ambientes</p>
  </div>
  <%= link_to new_ambiente_tag_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nova Tag
  <% end %>
</div>

<% if @tags.empty? %>
  <div class="text-center py-16 text-text-muted">
    <p>Nenhuma tag criada</p>
    <%= link_to "Criar primeira tag", new_ambiente_tag_path, class: "text-cyan-400 hover:text-cyan-300 text-sm mt-1 inline-block" %>
  </div>
<% else %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-xs text-text-muted uppercase border-b border-border">
          <th class="px-4 py-3 text-left">Tag</th>
          <th class="px-4 py-3 text-left">Cor</th>
          <th class="px-4 py-3 text-left">Ambientes</th>
          <th class="px-4 py-3 text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr class="border-b border-border/50 hover:bg-surface-inset/20">
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold text-text-primary" style="background-color: <%= tag.color %>">
                <%= tag.name %>
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded border border-border-subtle" style="background-color: <%= tag.color %>"></span>
                <span class="font-mono text-xs text-text-secondary"><%= tag.color %></span>
              </div>
            </td>
            <td class="px-4 py-3 text-text-secondary"><%= tag.environments.count %></td>
            <td class="px-4 py-3 text-right flex items-center gap-2 justify-end">
              <%= link_to edit_ambiente_tag_path(tag), class: "p-1.5 rounded hover:bg-surface-inset text-text-secondary hover:text-text-primary", title: "Editar" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to ambiente_tag_path(tag), method: :delete, data: { turbo_confirm: "Remover tag #{tag.name}?" }, class: "p-1.5 rounded hover:bg-red-950 text-text-secondary hover:text-red-400", title: "Remover" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
