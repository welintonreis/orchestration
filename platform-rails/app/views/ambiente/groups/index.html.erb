<% content_for :title, "Grupos de Ambientes" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Grupos de Ambientes</h2>
    <p class="text-sm text-gray-400 mt-0.5">Organize ambientes em grupos lógicos</p>
  </div>
  <%= link_to new_ambiente_group_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Novo Grupo
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @groups.each do |group| %>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-700 transition-colors">
      <div class="flex items-start justify-between mb-3">
        <div>
          <h3 class="font-semibold text-white"><%= group.name %></h3>
          <p class="text-xs text-gray-500"><%= group.environments.count %> ambiente(s)</p>
        </div>
        <div class="flex items-center gap-1">
          <%= link_to edit_ambiente_group_path(group), class: "p-1.5 rounded hover:bg-gray-800 text-gray-400 hover:text-white", title: "Editar" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          <% end %>
          <%= button_to ambiente_group_path(group), method: :delete, data: { turbo_confirm: "Remover grupo?" }, class: "p-1.5 rounded hover:bg-red-950 text-gray-400 hover:text-red-400", title: "Remover" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <% end %>
        </div>
      </div>
      <% if group.description.present? %>
        <p class="text-xs text-gray-400 mb-3"><%= group.description %></p>
      <% end %>
      <div class="flex flex-wrap gap-1.5">
        <% group.environments.each do |env| %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-gray-800 text-gray-300 border border-gray-700">
            <span class="w-1.5 h-1.5 rounded-full <%= env.active? ? 'bg-green-400' : 'bg-gray-600' %>"></span>
            <%= env.name %>
            <%= button_to remove_environment_ambiente_group_path(group, environment_id: env.id), method: :delete, class: "ml-0.5 text-gray-500 hover:text-red-400", title: "Remover do grupo" do %>×<% end %>
          </span>
        <% end %>
      </div>
      <% other_envs = @environments.reject { |e| group.environment_ids.include?(e.id) } %>
      <% if other_envs.any? %>
        <%= form_with url: add_environment_ambiente_group_path(group), method: :post, local: true, class: "mt-3 flex gap-2" do |f| %>
          <%= f.select :environment_id, options_for_select(other_envs.map { |e| [e.name, e.id] }), {}, class: "flex-1 bg-gray-800 border border-gray-700 rounded px-2 py-1 text-xs text-gray-200" %>
          <%= f.submit "+", class: "px-2 py-1 bg-gray-700 hover:bg-gray-600 rounded text-xs text-gray-200 cursor-pointer" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @groups.empty? %>
    <div class="col-span-3 text-center py-16 text-gray-500">
      <p>Nenhum grupo criado</p>
      <%= link_to "Criar primeiro grupo", new_ambiente_group_path, class: "text-cyan-400 hover:text-cyan-300 text-sm mt-1 inline-block" %>
    </div>
  <% end %>
</div>
