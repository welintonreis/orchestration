<% content_for :title, "Grupos de Ambientes" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Grupos de Ambientes</h2>
    <p class="text-sm text-text-secondary mt-0.5">Organize ambientes em grupos lógicos</p>
  </div>
  <%= link_to new_ambiente_group_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Novo Grupo
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @groups.each do |group| %>
    <div class="bg-surface-raised border border-border rounded-xl p-5 hover:border-border-subtle transition-colors">
      <div class="flex items-start justify-between mb-3">
        <div>
          <h3 class="font-semibold text-text-primary"><%= group.name %></h3>
          <p class="text-xs text-text-muted"><%= group.environments.count %> ambiente(s)</p>
        </div>
        <div class="flex items-center gap-1">
          <%= render Ui::ButtonComponent.new(url: edit_ambiente_group_path(group), variant: :gray, icon: :edit, title: "Editar") %>
          <%= render Ui::ButtonComponent.new(url: ambiente_group_path(group), method: :delete, variant: :red, icon: :remove, title: "Remover",
                confirm: "Remover grupo?") %>
        </div>
      </div>
      <% if group.description.present? %>
        <p class="text-xs text-text-secondary mb-3"><%= group.description %></p>
      <% end %>
      <div class="flex flex-wrap gap-1.5">
        <% group.environments.each do |env| %>
          <%= render(Ui::BadgeComponent.new(color: env.active? ? :green : :gray, dot: true)) do %>
            <%= env.name %>
            <%= button_to remove_environment_ambiente_group_path(group, environment_id: env.id), method: :delete, class: "ml-0.5 text-text-muted hover:text-red-600 dark:hover:text-red-400", title: "Remover do grupo" do %>×<% end %>
          <% end %>
        <% end %>
      </div>
      <% other_envs = @environments.reject { |e| group.environment_ids.include?(e.id) } %>
      <% if other_envs.any? %>
        <%= form_with url: add_environment_ambiente_group_path(group), method: :post, local: true, class: "mt-3 flex gap-2" do |f| %>
          <%= f.select :environment_id, options_for_select(other_envs.map { |e| [e.name, e.id] }), {}, class: "flex-1 bg-surface-inset border border-border-subtle rounded px-2 py-1 text-xs text-text-primary" %>
          <%= f.submit "+", class: "px-2 py-1 bg-surface-active hover:bg-surface-active-hover rounded text-xs text-text-primary cursor-pointer" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @groups.empty? %>
    <div class="col-span-3 text-center py-16 text-text-muted">
      <p>Nenhum grupo criado</p>
      <%= link_to "Criar primeiro grupo", new_ambiente_group_path, class: "text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 text-sm mt-1 inline-block" %>
    </div>
  <% end %>
</div>
