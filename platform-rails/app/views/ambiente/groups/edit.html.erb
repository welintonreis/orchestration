<% content_for :title, "Editar Grupo" %>
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <%= link_to "Grupos", ambiente_groups_path, class: "hover:text-gray-300" %> <span>/</span> <span class="text-gray-300">Editar</span>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h2 class="text-lg font-semibold text-white mb-5">Editar: <%= @group.name %></h2>
    <%= form_with model: [:ambiente, @group], local: true do |f| %>
      <div class="mb-4">
        <%= f.label :name, "Nome", class: "block text-xs font-medium text-gray-400 mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100 focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
      </div>
      <div class="mb-5">
        <%= f.label :description, "Descrição", class: "block text-xs font-medium text-gray-400 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100 focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
      </div>
      <div class="flex gap-3">
        <%= f.submit "Salvar", class: "btn-primary" %>
        <%= link_to "Cancelar", ambiente_groups_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
