<% content_for :title, "Políticas de Ambiente" %>
<% page_subtitle "Regras de acesso, cotas e restrições por ambiente" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 48 48">
    <path d="M0 0h48v48H0z" fill="none" />
    <g fill="currentColor">
      <path d="M18 11a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H19a1 1 0 0 1-1-1m-3 5a1 1 0 1 0 0 2h18a1 1 0 1 0 0-2zm-1 5a1 1 0 0 1 1-1h18a1 1 0 1 1 0 2H15a1 1 0 0 1-1-1m1 3a1 1 0 1 0 0 2h18a1 1 0 1 0 0-2z" />
      <path fill-rule="evenodd" d="M38 36a4 4 0 0 1-4 4h-3v4l-3-1.5l-3 1.5v-4H14a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4h20a4 4 0 0 1 4 4zM14 6a2 2 0 0 0-2 2v28a2 2 0 0 0 2 2h11v-2.354a4 4 0 1 1 6 0V38h3a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zm15 30.874a4 4 0 0 1-2 0v3.89l1-.5l1 .5zM28 35a2 2 0 1 0 0-4a2 2 0 0 0 0 4" clip-rule="evenodd" />
    </g>
  </svg>
<% end %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-text-primary">Políticas de Ambiente</h2>
  <p class="text-sm text-text-secondary mt-0.5">Controle o que é permitido em cada ambiente</p>
</div>

<% policy_keys = %w[allow_bind_mounts allow_privileged allow_host_networking allow_container_capabilities] %>
<% policy_labels = { "allow_bind_mounts" => "Bind Mounts", "allow_privileged" => "Containers Privilegiados", "allow_host_networking" => "Host Networking", "allow_container_capabilities" => "Capabilities do Container" } %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-text-muted uppercase border-b border-border">
        <th class="px-4 py-3 text-left">Ambiente</th>
        <% policy_labels.values.each do |label| %>
          <th class="px-4 py-3 text-center text-xs"><%= label %></th>
        <% end %>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @environments.each do |env| %>
        <tr class="border-b border-border/50 hover:bg-surface-inset/20">
          <td class="px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full <%= env.active? ? 'bg-green-400' : 'bg-gray-600' %>"></span>
              <span class="font-medium text-text-primary"><%= env.name %></span>
            </div>
          </td>
          <% policy_keys.each do |key| %>
            <% allowed = AppSetting.get("env_policy_#{env.id}_#{key}", default: "true") == "true" %>
            <td class="px-4 py-3 text-center">
              <% if allowed %>
                <svg class="w-4 h-4 text-green-600 dark:text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <% else %>
                <svg class="w-4 h-4 text-red-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              <% end %>
            </td>
          <% end %>
          <td class="px-4 py-3 text-right">
            <%= render Ui::ButtonComponent.new(url: edit_ambiente_policy_path(env), variant: :gray, icon: :edit, title: "Editar") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
