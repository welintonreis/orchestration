<% content_for :title, "Licenças" %>
<% page_subtitle "Informações de licença, plano e uso da plataforma" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 36 36">
    <path d="M0 0h36v36H0z" fill="none"/>
    <path fill="currentColor" d="M27.46 17.23a6.36 6.36 0 0 0-4.4 11l-1.94 2.37l.9 3.61l3.66-4.46a6.26 6.26 0 0 0 3.55 0l3.66 4.46l.9-3.61l-1.94-2.37a6.36 6.36 0 0 0-4.4-11Zm0 10.68a4.31 4.31 0 1 1 4.37-4.31a4.35 4.35 0 0 1-4.37 4.31"/>
    <path fill="currentColor" d="M30 13.5A7.5 7.5 0 0 1 22.5 6H4a2 2 0 0 0-2 2v20a2 2 0 0 0 2 2h15l.57-.7l.93-1.14A8.34 8.34 0 0 1 34 18.37v-6a7.46 7.46 0 0 1-4 1.13M17 24.6H7V23h10Zm1-7H7V16h11Zm6-4H7V12h17Z"/>
    <circle cx="30" cy="6" r="5" fill="currentColor"/>
  </svg>
<% end %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-text-primary">Licenças</h2>
  <p class="text-sm text-text-secondary mt-0.5">Informações de licença e uso da plataforma</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center">
        <svg class="w-6 h-6 text-text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-text-primary"><%= @license[:product] %></h3>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800/50">
          <%= @license[:plan] %>
        </span>
      </div>
    </div>

    <div class="space-y-3">
      <% [
        ["Emitida para", @license[:issued_to]],
        ["Plano", @license[:plan]],
        ["Expiração", @license[:expires]],
        ["Licenças", @license[:seats]],
      ].each do |label, value| %>
        <div class="flex items-center justify-between py-2 border-b border-border">
          <span class="text-sm text-text-secondary"><%= label %></span>
          <span class="text-sm font-medium text-text-primary"><%= value %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <h3 class="text-sm font-semibold text-text-primary mb-4">Uso da Infraestrutura</h3>
    <div class="space-y-3">
      <% [
        ["Versão Docker", @license[:docker_version]],
        ["Nós em uso", "#{@license[:nodes_used]}"],
        ["Limite de Nós", @license[:nodes_max]],
      ].each do |label, value| %>
        <div class="flex items-center justify-between py-2 border-b border-border">
          <span class="text-sm text-text-secondary"><%= label %></span>
          <span class="text-sm font-medium text-text-primary"><%= value %></span>
        </div>
      <% end %>
    </div>

    <div class="mt-5 p-3 bg-cyan-100 dark:bg-cyan-950/30 border border-cyan-300 dark:border-cyan-800/30 rounded-lg">
      <p class="text-xs text-cyan-600 dark:text-cyan-400 font-medium">Community Edition</p>
      <p class="text-xs text-text-secondary mt-1">RedHusky Community Edition é gratuito e open source. Para suporte empresarial, SLAs e funcionalidades avançadas, entre em contato.</p>
    </div>
  </div>
</div>
