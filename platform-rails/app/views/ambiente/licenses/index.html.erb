<% content_for :title, "Licenças" %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-white">Licenças</h2>
  <p class="text-sm text-gray-400 mt-0.5">Informações de licença e uso da plataforma</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white"><%= @license[:product] %></h3>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-900/40 text-cyan-300 border border-cyan-800/50">
          <%= @license[:plan] %>
        </span>
      </div>
    </div>

    <div class="space-y-3">
      <% [
        ["Emitida para", @license[:issued_to]],
        ["Plano", @license[:plan]],
        ["Expiração", @license[:expires]],
        ["Licenças", @license[:seats]],
      ].each do |label, value| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-800">
          <span class="text-sm text-gray-400"><%= label %></span>
          <span class="text-sm font-medium text-gray-200"><%= value %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h3 class="text-sm font-semibold text-gray-200 mb-4">Uso da Infraestrutura</h3>
    <div class="space-y-3">
      <% [
        ["Versão Docker", @license[:docker_version]],
        ["Nós em uso", "#{@license[:nodes_used]}"],
        ["Limite de Nós", @license[:nodes_max]],
      ].each do |label, value| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-800">
          <span class="text-sm text-gray-400"><%= label %></span>
          <span class="text-sm font-medium text-gray-200"><%= value %></span>
        </div>
      <% end %>
    </div>

    <div class="mt-5 p-3 bg-cyan-950/30 border border-cyan-800/30 rounded-lg">
      <p class="text-xs text-cyan-400 font-medium">Community Edition</p>
      <p class="text-xs text-gray-400 mt-1">RedHusky Community Edition é gratuito e open source. Para suporte empresarial, SLAs e funcionalidades avançadas, entre em contato.</p>
    </div>
  </div>
</div>
