<% content_for :title, "Registries por Ambiente" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Registries</h2>
    <p class="text-sm text-text-secondary mt-0.5">Registries de imagens associados a cada ambiente</p>
  </div>
  <%= link_to new_ambiente_registry_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Adicionar
  <% end %>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-text-muted uppercase border-b border-border">
        <th class="px-4 py-3 text-left">Ambiente</th>
        <th class="px-4 py-3 text-left">URL</th>
        <th class="px-4 py-3 text-left">Usuário</th>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @registries.empty? %>
        <tr><td colspan="4" class="px-4 py-12 text-center text-text-muted">Nenhum registry configurado</td></tr>
      <% else %>
        <% @registries.each do |reg| %>
          <tr class="border-b border-border/50 hover:bg-surface-inset/20">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-green-400"></span>
                <span class="text-text-primary"><%= reg.environment.name %></span>
              </div>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-text-secondary"><%= reg.url %></td>
            <td class="px-4 py-3 text-text-secondary"><%= reg.username %></td>
            <td class="px-4 py-3 text-right flex items-center gap-2 justify-end">
              <%= render Ui::ButtonComponent.new(url: edit_ambiente_registry_path(reg), variant: :gray, icon: :edit, title: "Editar") %>
              <%= render Ui::ButtonComponent.new(url: ambiente_registry_path(reg), method: :delete, variant: :red, icon: :remove, title: "Remover",
                    confirm: "Remover?") %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
