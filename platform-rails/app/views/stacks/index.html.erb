<% page_title "Stacks" %>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider">Stacks</h2>
    <span class="text-xs text-gray-500"><%= @stacks.size %> stack<%= @stacks.size == 1 ? "" : "s" %></span>
  </div>

  <% if @stacks.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-700 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      <p class="text-sm text-gray-500">Nenhuma stack ativa</p>
      <p class="text-xs text-gray-600 mt-1">Stacks aparecem quando Swarm está ativo com serviços implantados</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-left">
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider w-6"></th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Serviços</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Orquestrador</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Criado em</th>
        </tr>
      </thead>

      <% @stacks.each do |stack| %>
        <tbody x-data="{ open: false }" class="divide-y divide-gray-800/60">
          <%# Stack row %>
          <tr @click="open = !open"
              class="hover:bg-gray-800/30 transition-colors cursor-pointer select-none">
            <td class="pl-4 py-3 w-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-500 transition-transform duration-150" :class="open ? 'rotate-90' : ''" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-gray-800 border border-gray-700 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
                <span class="font-mono text-sm text-gray-200"><%= stack["Name"] %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-900/40 text-cyan-300 border border-cyan-800/40">
                <%= stack["Services"] %> serviço<%= stack["Services"] == 1 ? "" : "s" %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-400"><%= stack["Orchestrator"] %></td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <% created = stack["CreatedAt"] %>
              <%= created ? Time.parse(created).strftime("%Y-%m-%d %H:%M") : "—" rescue "—" %>
            </td>
          </tr>

          <%# Expanded services row %>
          <tr x-show="open"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              style="display: none;">
            <td colspan="5" class="bg-gray-950/60 border-t border-gray-800/60 px-0 py-0">
              <div class="mx-4 my-3 rounded-lg border border-gray-800 overflow-hidden">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="bg-gray-800/60 text-left border-b border-gray-800">
                      <th class="px-4 py-2 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Serviço</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Imagem</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Modo / Réplicas</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Atualizado</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Ações</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-800/50">
                    <% stack["ServiceList"].each do |svc| %>
                      <%
                        svc_name     = svc.dig("Spec", "Name") || svc["ID"]
                        raw_image    = svc.dig("Spec", "TaskTemplate", "ContainerSpec", "Image") || "—"
                        image        = raw_image.split("@").first
                        replicated   = svc.dig("Spec", "Mode", "Replicated")
                        global_mode  = svc.dig("Spec", "Mode", "Global")
                        replicas     = replicated ? replicated["Replicas"].to_i : nil
                        mode_label   = global_mode ? "global" : "replicated"
                        updated_at   = svc["UpdatedAt"]
                      %>
                      <tr class="hover:bg-gray-800/20 transition-colors" x-data="{ scaleInput: <%= replicas || 1 %> }">
                        <td class="px-4 py-2.5">
                          <span class="font-mono text-gray-300"><%= svc_name %></span>
                        </td>
                        <td class="px-4 py-2.5 max-w-[220px]">
                          <span class="text-gray-400 truncate block" title="<%= image %>"><%= image %></span>
                        </td>
                        <td class="px-4 py-2.5">
                          <% if global_mode %>
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-purple-900/40 text-purple-300 border border-purple-800/40">global</span>
                          <% elsif replicated %>
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-800 text-gray-300 border border-gray-700">
                              <span class="text-gray-500">replicated</span>
                              <span class="text-cyan-400 font-semibold"><%= replicas %></span>
                            </span>
                          <% else %>
                            <span class="text-gray-600">—</span>
                          <% end %>
                        </td>
                        <td class="px-4 py-2.5 text-gray-500">
                          <%= updated_at ? Time.parse(updated_at).strftime("%Y-%m-%d %H:%M") : "—" rescue "—" %>
                        </td>
                        <td class="px-4 py-2.5">
                          <div class="flex items-center gap-2" @click.stop>
                            <% unless global_mode %>
                              <%# Scale form %>
                              <%= form_with url: scale_stack_service_stacks_path(service_id: svc["ID"]), method: :post,
                                            class: "flex items-center gap-1" do |f| %>
                                <input type="number" name="replicas"
                                       x-model="scaleInput"
                                       min="0" max="99"
                                       class="w-14 px-1.5 py-1 text-xs bg-gray-800 border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-cyan-600 text-center">
                                <button type="submit"
                                        class="px-2 py-1 text-[10px] font-medium bg-cyan-800/40 hover:bg-cyan-700/50 text-cyan-300 border border-cyan-700/50 rounded transition-colors whitespace-nowrap">
                                  Escalar
                                </button>
                              <% end %>
                            <% end %>

                            <%# Drain button %>
                            <%= button_to drain_stack_service_stacks_path(service_id: svc["ID"]),
                                          method: :post,
                                          class: "px-2 py-1 text-[10px] font-medium bg-orange-900/30 hover:bg-orange-800/40 text-orange-400 border border-orange-800/40 rounded transition-colors whitespace-nowrap",
                                          form: { data: { turbo_confirm: "Desidratar #{svc_name}? Isso vai zerar as réplicas." } } do %>
                              Desidratar
                            <% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </td>
          </tr>
        </tbody>
      <% end %>
    </table>
  <% end %>
</div>
