<% page_title "Stacks" %>
<% page_subtitle "Stacks Docker Compose em execução no ambiente ativo" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none"/>
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
      <path d="m20.27 7.796l-3.61 1.876l-4.392 2.236a.55.55 0 0 1-.536 0L7.341 9.672L3.73 7.796a.594.594 0 0 1 0-1.06l8.014-3.925a.57.57 0 0 1 .512 0l8.014 3.925a.594.594 0 0 1 0 1.06"/>
      <path d="m7.34 9.672l-3.61 1.723a.594.594 0 0 0 0 1.06l3.61 1.876l4.392 2.236a.55.55 0 0 0 .536 0l4.391-2.236l3.611-1.875a.594.594 0 0 0 0-1.014l-3.61-1.77"/>
      <path d="m7.34 14.33l-3.61 1.725a.594.594 0 0 0 0 1.06l8.002 4.065a.55.55 0 0 0 .536 0l8.002-4.065a.594.594 0 0 0 0-1.014l-3.61-1.77"/>
    </g>
  </svg>
<% end %>

<turbo-frame id="stacks-content" src="<%= rows_stacks_path %>">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6 animate-pulse">
    <% 5.times do %>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <div class="h-8 w-10 bg-gray-800 rounded mb-2"></div>
        <div class="h-3 w-16 bg-gray-800 rounded"></div>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden animate-pulse">
    <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between">
      <div class="h-3 w-16 bg-gray-800 rounded"></div>
      <div class="h-3 w-16 bg-gray-800 rounded"></div>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800">
          <th class="px-5 py-3 w-6"></th>
          <th class="px-5 py-3"><div class="h-3 w-12 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-16 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-20 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-16 bg-gray-700 rounded"></div></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% 6.times do %>
          <tr>
            <td class="pl-4 py-3 w-6"></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 bg-gray-800 rounded-lg"></div>
                <div class="h-3.5 w-32 bg-gray-800 rounded"></div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-5 w-20 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-14 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-28 bg-gray-800 rounded"></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
