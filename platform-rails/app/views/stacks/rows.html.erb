<turbo-frame id="stacks-content">
<%# rows is rendered with layout: false (both for the lazy frame's initial
    load and for scale_service/drain_stack_service redirecting back here
    from inside the frame), so shared/_flash from the full layout never
    renders — render it here too so flash.now set by those actions
    actually shows up. %>
<%= render "shared/flash" %>
<% managers_count = (@nodes || []).count { |n| n.dig("Spec", "Role") == "manager" } %>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="text-3xl font-bold text-text-primary"><%= @total %></div>
    <div class="text-sm text-text-secondary mt-1">Stacks</div>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="text-3xl font-bold text-green-600 dark:text-green-400"><%= @active_total %></div>
    <div class="text-sm text-text-secondary mt-1">Ativas</div>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="text-3xl font-bold text-red-600 dark:text-red-400"><%= @total - @active_total %></div>
    <div class="text-sm text-text-secondary mt-1">Inativas</div>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="text-3xl font-bold text-text-primary"><%= (@nodes || []).size %></div>
    <div class="text-sm text-text-secondary mt-1">Nodes</div>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="text-3xl font-bold text-text-primary"><%= managers_count %></div>
    <div class="text-sm text-text-secondary mt-1">Managers</div>
  </div>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden"
     data-controller="filter"
     data-filter-url-value="<%= stacks_path(per_page: params[:per_page]) %>"
     data-filter-frame-value="stacks-content">
  <div class="px-5 py-4 border-b border-border flex items-center justify-between gap-3 flex-wrap">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Stacks</h2>
    <div class="flex items-center gap-3">
      <%= render Ui::InputComponent.new(name: "filter_query", value: @query, placeholder: "Buscar stack ou serviço…",
            css_class: "w-64 px-3 py-1.5 rounded-lg placeholder-text-muted",
            data: { filter_target: "input", action: "input->filter#search" }) %>
      <span class="text-xs text-text-muted"><%= @total %> stack<%= @total == 1 ? "" : "s" %></span>
    </div>
  </div>

  <% if @stacks.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-text-muted mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      <p class="text-sm text-text-muted">
        <% if @query.present? %>
          Nenhuma stack encontrada para "<%= @query %>".
        <% else %>
          Nenhuma stack ativa
        <% end %>
      </p>
      <p class="text-xs text-text-muted mt-1">
        <% if @query.present? %>
          <%= link_to "Limpar busca", stacks_path, class: "text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300" %>
        <% else %>
          Stacks aparecem quando Swarm está ativo com serviços implantados
        <% end %>
      </p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider w-6"></th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Serviços</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Orquestrador</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Criado em</th>
        </tr>
      </thead>

      <% @stacks.each do |stack| %>
        <tbody x-data="{ open: false }" class="divide-y divide-border/60">
          <tr @click="open = !open"
              class="hover:bg-surface-inset/30 transition-colors cursor-pointer select-none">
            <td class="pl-4 py-3 w-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-text-muted transition-transform duration-150" :class="open ? 'rotate-90' : ''" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-surface-inset border border-border-subtle flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24">
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                      <path d="m20.27 7.796l-3.61 1.876l-4.392 2.236a.55.55 0 0 1-.536 0L7.341 9.672L3.73 7.796a.594.594 0 0 1 0-1.06l8.014-3.925a.57.57 0 0 1 .512 0l8.014 3.925a.594.594 0 0 1 0 1.06"/>
                      <path d="m7.34 9.672l-3.61 1.723a.594.594 0 0 0 0 1.06l3.61 1.876l4.392 2.236a.55.55 0 0 0 .536 0l4.391-2.236l3.611-1.875a.594.594 0 0 0 0-1.014l-3.61-1.77"/>
                      <path d="m7.34 14.33l-3.61 1.725a.594.594 0 0 0 0 1.06l8.002 4.065a.55.55 0 0 0 .536 0l8.002-4.065a.594.594 0 0 0 0-1.014l-3.61-1.77"/>
                    </g>
                  </svg>
                </div>
                <span class="font-mono text-sm text-text-primary"><%= stack["Name"] %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <%= render(Ui::BadgeComponent.new(color: "bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 border-cyan-300 dark:border-cyan-800/40")) do %>
                <%= stack["Services"] %> serviço<%= stack["Services"] == 1 ? "" : "s" %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-text-secondary"><%= stack["Orchestrator"] %></td>
            <td class="px-4 py-3 text-xs text-text-muted">
              <% created = stack["CreatedAt"] %>
              <%= created ? Time.parse(created).strftime("%Y-%m-%d %H:%M") : "—" rescue "—" %>
            </td>
          </tr>

          <tr x-show="open"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              style="display: none;">
            <td colspan="5" class="bg-surface-sunken/60 border-t border-border/60 px-0 py-0">
              <div class="mx-4 my-3 rounded-lg border border-border overflow-hidden">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="bg-surface-inset/60 text-left border-b border-border">
                      <th class="px-4 py-2 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Serviço</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Imagem</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Modo / Réplicas</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Atualizado</th>
                      <th class="px-4 py-2 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Ações</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border/50">
                    <% stack["ServiceList"].each do |svc| %>
                      <%
                        svc_name     = svc.dig("Spec", "Name") || svc["ID"]
                        raw_image    = svc.dig("Spec", "TaskTemplate", "ContainerSpec", "Image") || "—"
                        image        = raw_image.split("@").first
                        replicated   = svc.dig("Spec", "Mode", "Replicated")
                        global_mode  = svc.dig("Spec", "Mode", "Global")
                        replicas     = replicated ? replicated["Replicas"].to_i : nil
                        mode_label   = global_mode ? "global" : "replicated"
                        updated_at   = svc["UpdatedAt"]
                      %>
                      <tr class="hover:bg-surface-inset/20 transition-colors">
                        <td class="px-4 py-2.5">
                          <span class="font-mono text-text-secondary"><%= svc_name %></span>
                        </td>
                        <td class="px-4 py-2.5 max-w-[220px]">
                          <span class="text-text-secondary truncate block" title="<%= image %>"><%= image %></span>
                        </td>
                        <td class="px-4 py-2.5">
                          <% if global_mode %>
                            <%= render(Ui::BadgeComponent.new(color: "bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 border-purple-300 dark:border-purple-800/40", size: :xs)) { "global" } %>
                          <% elsif replicated %>
                            <%= render(Ui::BadgeComponent.new(color: "bg-surface-inset text-text-secondary border-border-subtle", size: :xs)) do %>
                              <span class="text-text-muted">replicated</span>
                              <span class="text-cyan-600 dark:text-cyan-400 font-semibold"><%= replicas %></span>
                            <% end %>
                          <% else %>
                            <span class="text-text-muted">—</span>
                          <% end %>
                        </td>
                        <td class="px-4 py-2.5 text-text-muted">
                          <%= updated_at ? Time.parse(updated_at).strftime("%Y-%m-%d %H:%M") : "—" rescue "—" %>
                        </td>
                        <td class="px-4 py-2.5" x-data="{ scaleInput: <%= replicas || 1 %> }">
                          <div class="flex items-center gap-2" @click.stop>
                            <% unless global_mode %>
                              <%= form_with url: scale_stack_service_stacks_path(service_id: svc["ID"]), method: :post,
                                            class: "flex items-center gap-1" do |f| %>
                                <%= render Ui::InputComponent.new(name: "replicas", type: :number, min: 0, max: 99,
                                      css_class: "w-14 px-1.5 py-1 rounded text-center", html_attrs: { "x-model" => "scaleInput" }) %>
                                <button type="submit"
                                        class="px-2 py-1 text-[10px] font-medium bg-cyan-800/40 hover:bg-cyan-700/50 text-cyan-700 dark:text-cyan-300 border border-cyan-700/50 rounded transition-colors whitespace-nowrap">
                                  Escalar
                                </button>
                              <% end %>
                            <% end %>

                            <%= render Ui::ButtonComponent.new(url: drain_stack_service_stacks_path(service_id: svc["ID"]),
                                  method: :post,
                                  variant: "bg-orange-100 dark:bg-orange-900/30 hover:bg-orange-800/40 text-orange-600 dark:text-orange-400 border-orange-300 dark:border-orange-800/40",
                                  size: "px-2 py-1 text-[10px] font-medium rounded", label: "Desidratar",
                                  css_class: "whitespace-nowrap",
                                  confirm: "Desidratar #{svc_name}? Isso vai zerar as réplicas.") %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </td>
          </tr>
        </tbody>
      <% end %>
    </table>
    <div class="px-4 py-3 border-t border-border flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xs text-text-muted">Por página:</span>
        <% [10, 20, 30, 50, 100].each do |n| %>
          <%= link_to n, stacks_path(q: @query, per_page: n, page: 1),
                class: "px-2 py-0.5 text-xs rounded transition-colors #{(@per_page || 10) == n ? 'bg-surface-active text-text-primary' : 'text-text-muted hover:text-text-secondary hover:bg-surface-inset'}" %>
        <% end %>
        <%= link_to "Todos", stacks_path(q: @query, per_page: 0, page: 1),
              class: "px-2 py-0.5 text-xs rounded transition-colors #{@per_page.nil? ? 'bg-surface-active text-text-primary' : 'text-text-muted hover:text-text-secondary hover:bg-surface-inset'}" %>
      </div>
      <div class="flex items-center gap-1 text-xs text-text-muted">
        <span><%= @total %> stack<%= @total == 1 ? "" : "s" %> total</span>
        <% if @per_page && @total_pages > 1 %>
          <span class="mx-1 text-text-muted">·</span>
          <%= link_to "‹", stacks_path(q: @query, per_page: params[:per_page], page: @page - 1),
                class: "px-2 py-0.5 rounded #{@page <= 1 ? 'text-text-muted cursor-not-allowed pointer-events-none' : 'text-text-secondary hover:text-text-primary hover:bg-surface-inset'}" %>
          <span class="text-text-secondary"><%= @page %> / <%= @total_pages %></span>
          <%= link_to "›", stacks_path(q: @query, per_page: params[:per_page], page: @page + 1),
                class: "px-2 py-0.5 rounded #{@page >= @total_pages ? 'text-text-muted cursor-not-allowed pointer-events-none' : 'text-text-secondary hover:text-text-primary hover:bg-surface-inset'}" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
</turbo-frame>
