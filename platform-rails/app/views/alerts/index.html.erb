<% page_title "Alerts" %>

<% content_for :title_actions do %>
  <div class="flex items-center gap-3">
    <span class="text-sm text-text-muted">
      <%= @unread_count > 0 ? "#{@unread_count} unread alert#{"s" if @unread_count != 1}" : "No unread alerts" %>
    </span>
    <% if @unread_count > 0 %>
      <%= button_to "Mark all read", mark_all_read_alerts_path, method: :post,
            class: "px-3 py-1.5 text-sm rounded-lg bg-red-900/40 hover:bg-red-900/60 text-red-700 dark:text-red-300 border border-red-800/60 hover:border-red-700 transition-colors font-medium" %>
    <% end %>
  </div>
<% end %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @alerts.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-text-secondary font-medium">No alerts</p>
      <p class="text-sm text-text-muted mt-1">System is running normally.</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Level</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Resource</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Message</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Time</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @alerts.each do |alert| %>
          <tr class="<%= alert.read? ? 'bg-surface-sunken opacity-70' : 'bg-surface-raised' %> hover:bg-surface-inset/40 transition-colors">
            <td class="px-4 py-3">
              <% level_class = case alert.level
                               when "critical" then "bg-red-900/60 text-red-700 dark:text-red-300 border border-red-800/60"
                               when "warning"  then "bg-yellow-900/60 text-yellow-700 dark:text-yellow-300 border border-yellow-800/60"
                               else                 "bg-blue-900/60 text-blue-700 dark:text-blue-300 border border-blue-800/60"
                               end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold <%= level_class %>">
                <%= alert.level.capitalize %>
              </span>
            </td>
            <td class="px-4 py-3">
              <span class="font-mono text-text-secondary text-xs uppercase tracking-wider"><%= alert.resource %></span>
            </td>
            <td class="px-4 py-3 text-text-secondary">
              <%= alert.message %>
            </td>
            <td class="px-4 py-3 text-text-muted text-xs whitespace-nowrap">
              <%= human_age(alert.created_at) %>
            </td>
            <td class="px-4 py-3">
              <% if alert.read? %>
                <span class="inline-flex items-center gap-1.5 text-xs text-green-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
                  Read
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 text-xs text-text-secondary">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-500 flex-shrink-0"></span>
                  Unread
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-4 py-2 border-t border-border text-xs text-text-muted">
      <%= @alerts.size %> alert<%= @alerts.size == 1 ? "" : "s" %> total
    </div>
  <% end %>
</div>
