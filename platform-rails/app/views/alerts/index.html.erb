<% page_title "Alerts" %>

<% content_for :title_actions do %>
  <div class="flex items-center gap-3">
    <span class="text-sm text-text-muted">
      <%= @unread_count > 0 ? "#{@unread_count} unread alert#{"s" if @unread_count != 1}" : "No unread alerts" %>
    </span>
    <% if @unread_count > 0 %>
      <%= render Ui::ButtonComponent.new(url: mark_all_read_alerts_path, method: :post,
            variant: :solid_orange, size: :sm, label: "Mark all read") %>
    <% end %>
  </div>
<% end %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @alerts.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-text-secondary font-medium">No alerts</p>
      <p class="text-sm text-text-muted mt-1">System is running normally.</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left bg-white/[0.02]">
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Level</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Resource</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Message</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Time</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @alerts.each do |alert| %>
          <tr class="<%= alert.read? ? 'bg-surface-sunken opacity-70' : 'bg-surface-raised' %> hover:bg-surface-inset/40 transition-colors">
            <td class="px-4 py-3">
              <% level_color = case alert.level
                               when "critical" then :red
                               when "warning"  then :yellow
                               else                  :blue
                               end %>
              <%= render Ui::BadgeComponent.new(color: level_color, dot: true) { alert.level.capitalize } %>
            </td>
            <td class="px-4 py-3">
              <span class="font-mono text-text-secondary text-xs uppercase tracking-wider"><%= alert.resource %></span>
            </td>
            <td class="px-4 py-3 text-text-secondary">
              <%= alert.message %>
            </td>
            <td class="px-4 py-3 text-text-muted text-xs whitespace-nowrap">
              <%= human_age(alert.created_at) %>
            </td>
            <td class="px-4 py-3">
              <% if alert.read? %>
                <%= render Ui::BadgeComponent.new(color: :green, dot: true) { "Read" } %>
              <% else %>
                <%= render Ui::BadgeComponent.new(color: :gray, dot: true) { "Unread" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-4 py-2 border-t border-border text-xs text-text-muted">
      <%= @alerts.size %> alert<%= @alerts.size == 1 ? "" : "s" %> total
    </div>
  <% end %>
</div>
