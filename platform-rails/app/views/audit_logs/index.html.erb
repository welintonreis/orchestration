<% page_title "Audit Log" %>

<% content_for :title_actions do %>
  <form class="flex items-center gap-2" method="get">
    <select name="user_id" class="px-2 py-1.5 bg-surface-inset border border-border-subtle rounded-lg text-sm text-text-primary focus:outline-none focus:border-cyan-600">
      <option value="">All users</option>
      <% @users.each do |u| %>
        <option value="<%= u.id %>" <%= "selected" if params[:user_id] == u.id.to_s %>><%= u.email_address %></option>
      <% end %>
    </select>
    <input type="text" name="action_filter" value="<%= params[:action_filter] %>"
           placeholder="Filter action…"
           class="w-40 px-3 py-1.5 bg-surface-inset border border-border-subtle rounded-lg text-sm text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-600">
    <button type="submit" class="px-3 py-1.5 text-sm bg-surface-active hover:bg-surface-active-hover text-text-primary rounded-lg transition-colors">Filter</button>
    <%= link_to "Clear", audit_logs_path, class: "text-sm text-text-muted hover:text-text-secondary transition-colors" if params[:user_id].present? || params[:action_filter].present? %>
  </form>
<% end %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @audit_logs.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <p class="text-text-secondary">No audit log entries found.</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Time</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">User</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Action</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Target</th>
          <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">IP</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @audit_logs.each do |log| %>
          <tr class="hover:bg-surface-inset/40 transition-colors">
            <td class="px-4 py-3 text-xs text-text-muted whitespace-nowrap">
              <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
            </td>
            <td class="px-4 py-3 text-sm text-text-secondary">
              <%= log.user&.email_address || "—" %>
            </td>
            <td class="px-4 py-3">
              <span class="font-mono text-xs text-cyan-400"><%= log.action %></span>
            </td>
            <td class="px-4 py-3 text-xs text-text-secondary">
              <% if log.target_type.present? %>
                <span class="text-text-muted"><%= log.target_type %></span>
                <span class="font-mono text-text-secondary ml-1"><%= log.target_id&.first(12) %></span>
              <% end %>
              <% if log.metadata.present? && log.metadata != {} %>
                <div class="text-text-muted mt-0.5">
                  <% log.metadata.each do |k, v| %>
                    <span class="mr-2"><%= k %>: <%= v %></span>
                  <% end %>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs font-mono text-text-muted">
              <%= log.ip_address || "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="px-4 py-3 border-t border-border flex items-center justify-between">
      <span class="text-xs text-text-muted">
        Showing <%= (@page - 1) * 50 + 1 %>–<%= [(@page * 50), @total].min %> of <%= @total %>
      </span>
      <div class="flex items-center gap-2">
        <% if @page > 1 %>
          <%= link_to "← Prev", audit_logs_path(page: @page - 1, user_id: params[:user_id], action_filter: params[:action_filter]),
                class: "px-3 py-1 text-xs bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary rounded border border-border-subtle transition-colors" %>
        <% end %>
        <% if @page * 50 < @total %>
          <%= link_to "Next →", audit_logs_path(page: @page + 1, user_id: params[:user_id], action_filter: params[:action_filter]),
                class: "px-3 py-1 text-xs bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary rounded border border-border-subtle transition-colors" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
