<turbo-frame id="volumes-content">
<% all_names = @volumes.map { |v| v["Name"] }
   all_names_js = "[#{all_names.map { |n| "'#{n}'" }.join(',')}]" %>

<% if @volumes.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
    </svg>
    <p class="text-text-secondary text-sm">No volumes found.</p>
    <p class="text-text-muted text-xs mt-1">Create a volume with <span class="font-mono text-text-muted">docker volume create &lt;name&gt;</span></p>
  </div>
<% else %>
  <div x-data="{
    perPage: 10, page: 1, total: <%= @volumes.size %>,
    selected: [],
    toggle(name) {
      if (this.selected.includes(name)) {
        this.selected = this.selected.filter(s => s !== name);
      } else {
        this.selected.push(name);
      }
    },
    toggleAll(names) {
      const allSel = names.every(n => this.selected.includes(n));
      this.selected = allSel ? [] : [...names];
    }
  }">
    <div x-show="selected.length > 0"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 -translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         class="mb-4 flex items-center justify-between bg-red-100 dark:bg-red-950/40 border border-red-300 dark:border-red-800/50 rounded-xl px-4 py-3">
      <span class="text-sm text-red-700 dark:text-red-300">
        <span x-text="selected.length"></span> volume(s) selecionado(s)
      </span>
      <form method="post" action="<%= batch_remove_volumes_path %>"
            data-turbo-confirm="Remover os volumes selecionados? Esta ação não pode ser desfeita.">
        <input type="hidden" name="_method" value="delete">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <template x-for="name in selected" :key="name">
          <input type="hidden" name="names[]" :value="name">
        </template>
        <button type="submit"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-red-700/50 hover:bg-red-600/60 text-red-200 border border-red-600/60 rounded-lg transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Remover selecionados
        </button>
      </form>
    </div>

    <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-surface-inset/50">
          <tr>
            <th class="px-4 py-3 w-10">
              <%= render Ui::CheckboxComponent.new(size: "w-4 h-4", html_attrs: {
                    ":checked" => "#{all_names_js}.every(n => selected.includes(n))",
                    ":indeterminate" => "selected.length > 0 && !#{all_names_js}.every(n => selected.includes(n))",
                    "@change" => "toggleAll(#{all_names_js})",
                  }) %>
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Driver</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Tamanho</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Mountpoint</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Created</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @volumes.each_with_index do |v, idx| %>
            <%
              created_at = begin
                v["CreatedAt"].present? ? Time.parse(v["CreatedAt"]) : nil
              rescue
                nil
              end
              vol_size = v["_size"].to_i
            %>
            <tr class="hover:bg-surface-inset/30 transition-colors"
              x-show="perPage === 0 || ((<%= idx %>) >= (page - 1) * perPage && (<%= idx %>) < page * perPage)">
              <td class="px-4 py-3">
                <%
                  vol_name_js = v["Name"].gsub("'", "\\\\'")
                %>
                <%= render Ui::CheckboxComponent.new(size: "w-4 h-4", html_attrs: {
                      ":checked" => "selected.includes('#{vol_name_js}')",
                      "@change" => "toggle('#{vol_name_js}')",
                    }) %>
              </td>
              <td class="px-4 py-3 font-mono text-text-primary max-w-[240px]">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="truncate" title="<%= v["Name"] %>"><%= v["Name"] %></span>
                  <% if v["_refs"] == 0 %>
                    <%= render(Ui::BadgeComponent.new(color: "bg-yellow-100 dark:bg-yellow-900/40 text-yellow-600 dark:text-yellow-400 border-yellow-700/50", size: :xs, css_class: "flex-shrink-0 whitespace-nowrap")) { "Não utilizado" } %>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3 text-text-secondary"><%= v["Driver"] %></td>
              <td class="px-4 py-3 text-text-secondary text-xs">
                <% if vol_size > 0 %>
                  <%= human_bytes(vol_size) %>
                <% else %>
                  <span class="text-text-muted">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 font-mono text-text-muted text-xs max-w-[180px]">
                <span class="truncate block" title="<%= v["Mountpoint"] %>"><%= v["Mountpoint"] %></span>
              </td>
              <td class="px-4 py-3 text-text-secondary text-xs"><%= human_age(created_at) %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                  <%= render Ui::ButtonComponent.new(url: browse_volume_path(v["Name"]),
                        variant: :cyan, size: "p-1.5 rounded", title: "Explorar arquivos", frame: "_top") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                    </svg>
                  <% end %>
                  <%= render Ui::ButtonComponent.new(url: remove_volume_path(v["Name"]), method: :delete,
                        variant: :red, size: "p-1.5 rounded", icon: :remove, title: "Remover",
                        confirm: "Remover volume \"#{v["Name"]}\"? Não pode ser desfeito.") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/table_pagination" %>
    </div>
  </div>
<% end %>
</turbo-frame>
