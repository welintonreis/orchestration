<% page_title "Explorar: #{@volume_name}" %>
<% page_subtitle @container_id ? "Container: #{@container_id.first(12)} · #{@mountpoint}" : "Container temporário (volume órfão)" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
  </svg>
<% end %>

<div x-data="{ renameModal: false, renamePath: '', renameCurrent: '', mkdirModal: false }"
     @keydown.escape.window="renameModal = false; mkdirModal = false">

<%# ── Toolbar ── %>
<div class="mb-4 flex items-center justify-between flex-wrap gap-3">
  <%# Path breadcrumb %>
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <%= link_to volumes_path, class: "flex items-center gap-1 text-xs text-gray-500 hover:text-gray-300 flex-shrink-0" do %>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Volumes
    <% end %>
    <span class="text-gray-700 flex-shrink-0">/</span>
    <nav class="flex items-center gap-1 text-xs overflow-x-auto min-w-0">
      <%= link_to @volume_name, browse_volume_path(@volume_name, path: "/"),
            class: "text-orange-400 hover:text-orange-300 font-medium whitespace-nowrap flex-shrink-0" %>
      <% segments = @path.split("/").reject(&:blank?) %>
      <% segments.each_with_index do |seg, i| %>
        <span class="text-gray-700 flex-shrink-0">/</span>
        <% partial = "/" + segments[0..i].join("/") %>
        <% if i == segments.size - 1 %>
          <span class="text-orange-300 font-medium whitespace-nowrap flex-shrink-0"><%= seg %></span>
        <% else %>
          <%= link_to seg, browse_volume_path(@volume_name, path: partial),
                class: "text-gray-400 hover:text-orange-400 whitespace-nowrap flex-shrink-0" %>
        <% end %>
      <% end %>
    </nav>
  </div>

  <%# Action buttons %>
  <% if Current.user&.admin? || Current.user&.operator? %>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%# Upload %>
      <%= form_with url: upload_volume_path(@volume_name), method: :post, multipart: true, data: { turbo: false }, class: "inline-flex" do |f| %>
        <%= f.hidden_field :path, value: @path %>
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-gray-700 hover:bg-gray-600 text-gray-200 rounded-lg border border-gray-600 transition-colors cursor-pointer" title="Upload arquivo">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Upload
          <%= f.file_field :file, class: "hidden", onchange: "this.form.submit()" %>
        </label>
      <% end %>
      <%# Mkdir %>
      <button @click="mkdirModal = true"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-gray-700 hover:bg-gray-600 text-gray-200 rounded-lg border border-gray-600 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Novo dir
      </button>
    </div>
  <% end %>
</div>

<%# Orphan notice %>
<% vol_obj = current_docker_client.volumes["Volumes"]&.find { |v| v["Name"] == @volume_name } rescue nil %>
<% if flash[:alert].blank? %>
  <div class="mb-4 flex items-center gap-2 px-4 py-2.5 bg-yellow-900/20 border border-yellow-800/40 rounded-xl text-xs text-yellow-400">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    Volume órfão — usando container busybox temporário para acesso aos arquivos. Operações podem ser ligeiramente mais lentas.
  </div>
<% end %> <%# always show for orphan — controller sets @container_id only when running container found %>

<% if @entries.empty? && @path == "/" && flash[:alert].present? %>
  <div class="flex flex-col items-center justify-center py-24 text-center bg-gray-900 border border-gray-800 rounded-xl">
    <svg class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
    </svg>
    <p class="text-gray-400 font-medium mb-1">Não foi possível acessar o volume</p>
    <p class="text-sm text-gray-600 mt-1"><%= flash[:alert] %></p>
    <%= link_to "← Voltar para Volumes", volumes_path, class: "mt-4 text-sm text-cyan-400 hover:text-cyan-300" %>
  </div>
<% else %>

  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <%# Parent dir link %>
    <% if @path != "/" %>
      <div class="px-4 py-2 border-b border-gray-800/50">
        <%= link_to browse_volume_path(@volume_name, path: File.dirname(@path)),
              class: "flex items-center gap-2 text-sm text-gray-500 hover:text-gray-300" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          <span class="font-mono">..</span>
          <span class="text-xs text-gray-600">diretório pai</span>
        <% end %>
      </div>
    <% end %>

    <% if @entries.empty? %>
      <div class="text-center py-16 text-gray-600"><p class="text-sm">Diretório vazio.</p></div>
    <% else %>
      <table class="w-full text-sm">
        <thead class="bg-gray-800/40">
          <tr>
            <th class="px-4 py-2.5 w-8"></th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nome</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-24">Tamanho</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-40">Modificado</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-28">Permissões</th>
            <th class="px-4 py-2.5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider w-36">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/60">
          <% @entries.each do |entry| %>
            <% entry_path = [@path.chomp("/"), entry[:name]].join("/") %>
            <tr class="hover:bg-gray-800/30 transition-colors group">
              <%# Type icon %>
              <td class="px-4 py-2.5">
                <% if entry[:type] == :directory %>
                  <svg class="w-4 h-4 text-yellow-500/80" fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                <% elsif entry[:type] == :symlink %>
                  <svg class="w-4 h-4 text-cyan-500/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                <% else %>
                  <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <% end %>
              </td>
              <%# Name %>
              <td class="px-4 py-2.5">
                <% if entry[:type] == :directory %>
                  <%= link_to entry[:name], browse_volume_path(@volume_name, path: entry_path),
                        class: "text-gray-200 hover:text-white font-medium" %>
                <% else %>
                  <span class="text-gray-300 font-mono text-xs"><%= entry[:name] %></span>
                <% end %>
              </td>
              <%# Size %>
              <td class="px-4 py-2.5 text-gray-500 text-xs">
                <%= entry[:type] == :directory ? "—" : human_bytes(entry[:size]) %>
              </td>
              <%# Modified %>
              <td class="px-4 py-2.5 text-gray-500 text-xs font-mono"><%= entry[:modified] %></td>
              <%# Permissions %>
              <td class="px-4 py-2.5 text-gray-600 text-xs font-mono"><%= entry[:permissions] %></td>
              <%# Actions — always visible, not just on hover %>
              <td class="px-4 py-2.5 text-right">
                <div class="flex items-center justify-end gap-1">
                  <%# Download (file → direct, dir → tar archive) %>
                  <%= link_to download_volume_path(@volume_name, path: entry_path),
                        class: "p-1.5 rounded hover:bg-gray-700 text-gray-500 hover:text-cyan-400 transition-colors",
                        title: entry[:type] == :directory ? "Baixar como .tar" : "Baixar" do %>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                  <% end %>

                  <%# Upload into dir %>
                  <% if entry[:type] == :directory && (Current.user&.admin? || Current.user&.operator?) %>
                    <%= form_with url: upload_volume_path(@volume_name), method: :post, multipart: true, data: { turbo: false }, class: "inline-flex" do |f| %>
                      <%= f.hidden_field :path, value: entry_path %>
                      <label class="p-1.5 rounded hover:bg-gray-700 text-gray-500 hover:text-green-400 transition-colors cursor-pointer" title="Upload para este diretório">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        <%= f.file_field :file, class: "hidden", onchange: "this.form.submit()" %>
                      </label>
                    <% end %>
                  <% end %>

                  <%# Rename %>
                  <% if Current.user&.admin? || Current.user&.operator? %>
                    <button
                      @click="renameModal = true; renamePath = '<%= j(entry_path) %>'; renameCurrent = '<%= j(entry[:name]) %>'"
                      class="p-1.5 rounded hover:bg-gray-700 text-gray-500 hover:text-yellow-400 transition-colors"
                      title="Renomear">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                  <% end %>

                  <%# Delete %>
                  <% if Current.user&.admin? || Current.user&.operator? %>
                    <%= button_to file_delete_volume_path(@volume_name, path: entry_path),
                          method: :delete,
                          data: { turbo_confirm: "Remover \"#{entry[:name]}\"? Não pode ser desfeito." },
                          class: "p-1.5 rounded hover:bg-red-900/40 text-gray-500 hover:text-red-400 transition-colors",
                          title: "Remover" do %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

<% end %>

<%# ── Rename modal ── %>
<div x-show="renameModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60" @click="renameModal = false"></div>
  <div class="relative bg-gray-900 border border-gray-700 rounded-xl shadow-2xl w-80">
    <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between">
      <h3 class="text-sm font-semibold text-white">Renomear</h3>
      <button @click="renameModal = false" class="text-gray-500 hover:text-gray-300">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="post" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="_method" value="post">
      <input type="hidden" name="path" :value="renamePath">
      <div class="px-5 py-4 space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Novo nome</label>
          <input type="text" name="new_name" :value="renameCurrent" autofocus required
                 class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 focus:outline-none focus:border-cyan-600"
                 @focus="$el.select()">
        </div>
        <div class="flex items-center justify-end gap-2 pt-1">
          <button type="button" @click="renameModal = false" class="px-3 py-1.5 text-sm text-gray-400 hover:text-gray-200">Cancelar</button>
          <button type="submit"
                  :formaction="'<%= file_rename_volume_path(@volume_name) %>'"
                  class="px-4 py-1.5 text-sm font-medium bg-yellow-600 hover:bg-yellow-500 text-white rounded-lg transition-colors">Renomear</button>
        </div>
      </div>
    </form>
  </div>
</div>

<%# ── Mkdir modal ── %>
<div x-show="mkdirModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60" @click="mkdirModal = false"></div>
  <div class="relative bg-gray-900 border border-gray-700 rounded-xl shadow-2xl w-80">
    <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between">
      <h3 class="text-sm font-semibold text-white">Criar Diretório</h3>
      <button @click="mkdirModal = false" class="text-gray-500 hover:text-gray-300">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <%= form_with url: file_mkdir_volume_path(@volume_name), method: :post, data: { turbo: false }, class: "px-5 py-4 space-y-3" do |f| %>
      <%= f.hidden_field :path, value: @path %>
      <div>
        <label class="block text-xs font-medium text-gray-400 mb-1">Nome do diretório</label>
        <%= f.text_field :dir_name, placeholder: "nova-pasta", autofocus: true, required: true,
              class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600" %>
      </div>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" @click="mkdirModal = false" class="px-3 py-1.5 text-sm text-gray-400 hover:text-gray-200">Cancelar</button>
        <%= f.submit "Criar", class: "px-4 py-1.5 text-sm font-medium bg-red-600 hover:bg-red-500 text-white rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

</div><%# end x-data %>
