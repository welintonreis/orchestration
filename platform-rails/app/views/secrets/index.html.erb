<% page_title "Secrets" %>
<% page_subtitle "Segredos criptografados do Swarm — senhas, tokens e certificados" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none" />
    <path fill="currentColor" d="M8 21c2.76 0 5-2.24 5-5c0-1.02-.31-1.96-.83-2.75l3.33-3.33l1.79 1.79l1.41-1.41l-1.79-1.79L18 7.42l2.29 2.29L21.7 8.3l-2.29-2.29l1.29-1.29l-1.41-1.41l-8.54 8.54c-.79-.52-1.74-.83-2.75-.83c-2.76 0-5 2.24-5 5s2.24 5 5 5Zm0-8c1.65 0 3 1.35 3 3s-1.35 3-3 3s-3-1.35-3-3s1.35-3 3-3" />
  </svg>
<% end %>

<turbo-frame id="secrets-content" src="<%= rows_secrets_path %>">
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden animate-pulse">
    <div class="px-5 py-3 border-b border-gray-800">
      <div class="h-8 w-52 bg-gray-800 rounded-lg"></div>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800">
          <th class="px-4 py-3 w-8"><div class="w-3.5 h-3.5 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-14 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-20 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"><div class="h-3 w-14 bg-gray-700 rounded"></div></th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% 6.times do %>
          <tr>
            <td class="px-4 py-3"><div class="w-3.5 h-3.5 bg-gray-800 rounded"></div></td>
            <td class="px-5 py-3">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-gray-800 rounded"></div>
                <div class="h-3.5 w-36 bg-gray-800 rounded"></div>
              </div>
            </td>
            <td class="px-5 py-3"><div class="h-3 w-32 bg-gray-800 rounded"></div></td>
            <td class="px-5 py-3"><div class="h-4 w-20 bg-gray-800 rounded"></div></td>
            <td class="px-5 py-3 text-right"><div class="h-6 w-16 bg-gray-800 rounded ml-auto"></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
