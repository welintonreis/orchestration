<turbo-frame id="secrets-content">
<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden"
     x-data="{
       selected: [],
       search: '',
       perPage: 10,
       page: 1,
       total: <%= @secrets.size %>,
       toggle(id) { let i = this.selected.indexOf(id); i === -1 ? this.selected.push(id) : this.selected.splice(i, 1); },
       toggleAll(e) { this.selected = e.target.checked ? [<%= raw @secrets.map { |s| "'#{s['ID']}'" }.join(',') %>] : []; },
       matchSearch(name) { return !this.search || name.toLowerCase().includes(this.search.toLowerCase()); }
     }">

  <div class="px-5 py-3 border-b border-gray-800 flex items-center justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-3">
      <input type="text" x-model="search" placeholder="Buscar secrets…"
             class="w-52 px-3 py-1.5 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600">
      <span class="text-xs text-gray-500"
            x-text="selected.length > 0 ? selected.length + ' selecionada(s)' : total + ' secret' + (total === 1 ? '' : 's')"></span>
    </div>
    <% if Current.user&.admin? || Current.user&.operator? %>
      <form action="<%= batch_remove_secrets_path %>" method="post"
            x-show="selected.length > 0" x-cloak x-ref="batchForm">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <template x-for="id in selected" :key="id">
          <input type="hidden" name="ids[]" :value="id">
        </template>
        <button type="button"
                @click="if(confirm('Remover ' + selected.length + ' secret(s)?')) $refs.batchForm.submit()"
                class="px-3 py-1.5 text-xs font-medium bg-red-700 hover:bg-red-600 text-white rounded-lg border border-red-600 transition-colors">
          Remover
        </button>
      </form>
    <% end %>
  </div>

  <% if @secrets.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-700 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-sm text-gray-500">Nenhuma secret encontrada</p>
      <p class="text-xs text-gray-600 mt-1">Secrets do Swarm aparecem aqui</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-left">
          <th class="px-4 py-3 w-8">
            <input type="checkbox"
                   @change="toggleAll($event)"
                   :indeterminate="selected.length > 0 && selected.length < total"
                   :checked="selected.length === total && total > 0"
                   class="w-3.5 h-3.5 rounded border-gray-600 bg-gray-800 text-cyan-500 cursor-pointer accent-cyan-500">
          </th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Criado em</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Labels</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% @secrets.each_with_index do |sec, idx| %>
          <% sec_name = sec.dig("Spec", "Name") || sec["ID"]&.first(12) %>
          <tr class="hover:bg-gray-800/30 transition-colors"
              x-show="matchSearch('<%= j sec_name.to_s %>') && (perPage === 0 || ((<%= idx %>) >= (page - 1) * perPage && (<%= idx %>) < page * perPage))">
            <td class="px-4 py-3 w-8">
              <input type="checkbox"
                     :checked="selected.includes('<%= sec["ID"] %>')"
                     @change="toggle('<%= sec["ID"] %>')"
                     class="w-3.5 h-3.5 rounded border-gray-600 bg-gray-800 text-cyan-500 cursor-pointer accent-cyan-500">
            </td>
            <td class="px-5 py-3">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-yellow-500 flex-shrink-0" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M8 21c2.76 0 5-2.24 5-5c0-1.02-.31-1.96-.83-2.75l3.33-3.33l1.79 1.79l1.41-1.41l-1.79-1.79L18 7.42l2.29 2.29L21.7 8.3l-2.29-2.29l1.29-1.29l-1.41-1.41l-8.54 8.54c-.79-.52-1.74-.83-2.75-.83c-2.76 0-5 2.24-5 5s2.24 5 5 5Zm0-8c1.65 0 3 1.35 3 3s-1.35 3-3 3s-3-1.35-3-3s1.35-3 3-3"/></svg>
                <span class="font-mono text-sm text-gray-200"><%= sec_name %></span>
              </div>
            </td>
            <td class="px-5 py-3 text-xs text-gray-500">
              <% created = sec["CreatedAt"] %>
              <%= created ? Time.parse(created).strftime("%Y-%m-%d %H:%M:%S") : "—" rescue "—" %>
            </td>
            <td class="px-5 py-3">
              <% labels = sec.dig("Spec", "Labels") || {} %>
              <% labels.reject { |k,_| k.start_with?("com.docker") }.each do |k, v| %>
                <span class="inline-block text-[10px] font-mono bg-gray-800 text-gray-400 px-1.5 py-0.5 rounded mr-1"><%= k %>=<%= v %></span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-right">
              <% if Current.user&.admin? || Current.user&.operator? %>
                <%= button_to remove_secret_path(sec["ID"]), method: :delete,
                      class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-red-900/40 text-gray-400 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                      data: { turbo_confirm: "Remover secret #{sec_name}?" } do %>
                  Remover
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination" %>
  <% end %>
</div>
</turbo-frame>
