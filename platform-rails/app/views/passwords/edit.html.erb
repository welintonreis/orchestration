<% page_title "Update password" %>

<div class="text-center mb-8">
  <h1 class="text-2xl font-bold text-text-primary">Update your password</h1>
  <p class="mt-1 text-sm text-text-secondary">Choose a strong new password for your account.</p>
</div>

<div class="bg-surface-raised border border-border rounded-2xl px-8 py-8 shadow-xl">
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
      <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            placeholder: "Enter new password",
            maxlength: 72,
            class: "block w-full rounded-lg bg-surface-inset border border-border-subtle text-text-primary placeholder-text-muted px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
      <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Repeat new password",
            maxlength: 72,
            class: "block w-full rounded-lg bg-surface-inset border border-border-subtle text-text-primary placeholder-text-muted px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition" %>
    </div>

    <div>
      <%= form.submit "Save password", class: "btn-primary w-full justify-center" %>
    </div>
  <% end %>
</div>
