<% page_title "Cloudflare Management" %>
<% page_subtitle "Gerencie registros DNS, roteamento de emails, Turnstile captcha e correlação com containers Swarm" %>

<% active_tab = params[:tab].presence || "dns" %>

<div class="space-y-6" x-data="{
  activeTab: '<%= active_tab %>',
  modalNewRecord: false,
  modalEditRecord: false,
  modalForward: false,
  modalNewEmailRule: false,
  modalEditEmailRule: false,
  modalNewTurnstile: false,
  modalEditTurnstile: false,
  copiedKey: null,
  copyToClipboard(text, id) {
    navigator.clipboard.writeText(text);
    this.copiedKey = id;
    setTimeout(() => { this.copiedKey = null }, 2000);
  },
  editData: { id: '', type: 'A', name: '', content: '', ttl: 1, proxied: false, priority: '', comment: '' },
  editEmailData: { id: '', name: '', custom_address: '', forward_to: '', enabled: true },
  editTurnstileData: { id: '', name: '', domains: '', mode: 'managed', bot_fight_mode: false }
}">

  <%# ── TOP BAR & ZONE SELECTOR ── %>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface-raised p-4 rounded-xl border border-border">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-orange-500/10 text-orange-500 flex items-center justify-center font-bold text-xl">
        ☁
      </div>
      <div>
        <h1 class="text-lg font-bold text-text-primary flex items-center gap-2">
          Cloudflare Management
          <% if @service.configured? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-500/10 text-green-400 border border-green-500/20">API Conectada</span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-red-500/10 text-red-400 border border-red-500/20">Token Não Configurado</span>
          <% end %>
        </h1>
        <p class="text-xs text-text-muted">Zona ativa: <strong class="text-text-primary font-mono"><%= @zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || @current_zone_id || 'Nenhuma' %></strong></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if @zones.many? %>
        <%= form_with url: cloudflare_dns_path, method: :get, local: true, class: "inline-flex items-center" do %>
          <%= hidden_field_tag :tab, active_tab %>
          <%= select_tag :zone_id, options_for_select(@zones.map { |z| [z["name"], z["id"]] }, @current_zone_id), onchange: "this.form.submit()", class: "bg-surface-inset text-text-primary text-xs rounded-lg border border-border px-3 py-2 focus:ring-1 focus:ring-brand" %>
        <% end %>
      <% end %>

      <template x-if="activeTab === 'dns'">
        <div class="flex items-center gap-2">
          <button @click="modalForward = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-inset hover:bg-surface-inset/80 text-text-primary text-xs font-medium border border-border transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            Encaminhar CNAME
          </button>
          <button @click="modalNewRecord = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold shadow-sm transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo Registro DNS
          </button>
        </div>
      </template>

      <template x-if="activeTab === 'email'">
        <button @click="modalNewEmailRule = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold shadow-sm transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nova Regra de Email
        </button>
      </template>

      <template x-if="activeTab === 'turnstile'">
        <button @click="modalNewTurnstile = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold shadow-sm transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Novo Widget Turnstile
        </button>
      </template>
    </div>
  </div>

  <% if @error.present? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl text-sm flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= @error %></span>
    </div>
  <% end %>

  <%# ── TABS NAVIGATION ── %>
  <div class="flex items-center gap-2 border-b border-border pb-1">
    <%= link_to cloudflare_dns_path(zone_id: @current_zone_id, tab: "dns"),
          class: "px-4 py-2 text-xs font-semibold rounded-lg transition-colors flex items-center gap-2 #{active_tab == 'dns' ? 'bg-orange-500/10 text-orange-400 border border-orange-500/20' : 'text-text-muted hover:text-text-primary hover:bg-surface-raised'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
      Registros DNS & Correlação
      <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold bg-surface-inset text-text-muted"><%= @records.size %></span>
    <% end %>

    <%= link_to cloudflare_dns_path(zone_id: @current_zone_id, tab: "email"),
          class: "px-4 py-2 text-xs font-semibold rounded-lg transition-colors flex items-center gap-2 #{active_tab == 'email' ? 'bg-orange-500/10 text-orange-400 border border-orange-500/20' : 'text-text-muted hover:text-text-primary hover:bg-surface-raised'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      Email Routing
    <% end %>

    <%= link_to cloudflare_dns_path(zone_id: @current_zone_id, tab: "turnstile"),
          class: "px-4 py-2 text-xs font-semibold rounded-lg transition-colors flex items-center gap-2 #{active_tab == 'turnstile' ? 'bg-orange-500/10 text-orange-400 border border-orange-500/20' : 'text-text-muted hover:text-text-primary hover:bg-surface-raised'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
      Turnstile (CAPTCHA)
    <% end %>
  </div>

  <% if active_tab == "dns" %>
    <%# ── FILTERS & SEARCH ── %>
    <div class="bg-surface-raised p-4 rounded-xl border border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <%= form_with url: cloudflare_dns_path, method: :get, local: true, class: "w-full flex flex-col sm:flex-row items-center gap-3" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>
        <%= hidden_field_tag :tab, "dns" %>
        <div class="relative w-full sm:w-80">
          <input type="text" name="search" value="<%= @search %>" placeholder="Buscar por host, IP ou destino..." class="w-full bg-surface-inset text-text-primary text-xs rounded-lg border border-border pl-9 pr-3 py-2 focus:ring-1 focus:ring-brand focus:border-brand">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-text-muted absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <%= select_tag :type, options_for_select([["Todos os Tipos", ""], "A", "AAAA", "CNAME", "TXT", "MX", "NS", "SRV"], @type_filter), onchange: "this.form.submit()", class: "bg-surface-inset text-text-primary text-xs rounded-lg border border-border px-3 py-2" %>
          <button type="submit" class="px-3 py-2 bg-surface-inset hover:bg-surface-inset/80 text-text-secondary text-xs rounded-lg border border-border">Filtrar</button>
          <% if @search.present? || @type_filter.present? %>
            <%= link_to "Limpar", cloudflare_dns_path(zone_id: @current_zone_id, tab: "dns"), class: "text-xs text-text-muted hover:text-text-primary" %>
          <% end %>
        </div>
      <% end %>

      <div class="flex items-center gap-3 text-xs text-text-muted whitespace-nowrap self-end md:self-center">
        <% in_use_count = @records.count { |r| r['in_use'] } %>
        <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> <strong><%= in_use_count %></strong> em uso no Swarm</span>
        <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-zinc-500"></span> <strong><%= @records.size - in_use_count %></strong> sem container</span>
      </div>
    </div>

    <%# ── RECORDS TABLE COM CORRELAÇÃO DE CONTAINERS ── %>
    <div class="bg-surface-raised rounded-xl border border-border overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-text-secondary">
          <thead class="bg-surface-inset/50 text-text-muted uppercase text-[10px] tracking-wider border-b border-border">
            <tr>
              <th class="py-3 px-4">Status Swarm</th>
              <th class="py-3 px-4">Tipo</th>
              <th class="py-3 px-4">Nome / Host</th>
              <th class="py-3 px-4">Conteúdo / Destino</th>
              <th class="py-3 px-4">Container / Serviço Conectado</th>
              <th class="py-3 px-4 text-center">Proxy</th>
              <th class="py-3 px-4 text-center">TTL</th>
              <th class="py-3 px-4 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <% if @records.empty? %>
              <tr>
                <td colspan="8" class="py-8 text-center text-text-muted">
                  Nenhum registro DNS encontrado para os critérios selecionados.
                </td>
              </tr>
            <% else %>
              <% @records.each do |record| %>
                <tr class="hover:bg-surface-inset/30 transition-colors group <%= record['in_use'] ? '' : 'opacity-85' %>">
                  <%# Status Swarm / Traefik %>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <% if record['in_use'] %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="Host com rota ativa e escutando tráfego no Docker/Swarm">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Em Uso
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-surface-inset text-text-muted border border-border" title="Nenhum container ou router Traefik local mapeado para este host">
                        <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                        Sem Rota
                      </span>
                    <% end %>
                  </td>

                  <%# Tipo %>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded font-mono font-bold text-[10px]
                      <%= case record['type']
                          when 'A' then 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                          when 'CNAME' then 'bg-purple-500/10 text-purple-400 border border-purple-500/20'
                          when 'TXT' then 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                          when 'MX' then 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                          else 'bg-surface-inset text-text-primary border border-border'
                          end %>">
                      <%= record['type'] %>
                    </span>
                  </td>

                  <%# Nome / Host %>
                  <td class="py-3 px-4 font-mono font-medium text-text-primary max-w-xs truncate" title="<%= record['name'] %>">
                    <%= record['name'] %>
                  </td>

                  <%# Conteúdo / Destino %>
                  <td class="py-3 px-4 font-mono text-text-secondary max-w-sm truncate" title="<%= record['content'] %>">
                    <%= record['content'] %>
                    <% if record['priority'].present? %>
                      <span class="text-text-muted text-[10px] ml-1">(Prio: <%= record['priority'] %>)</span>
                    <% end %>
                  </td>

                  <%# Container / Serviço Swarm Mapeado %>
                  <td class="py-3 px-4">
                    <% if (matched = record['matched_containers']) && matched.any? %>
                      <div class="flex flex-wrap gap-1 items-center">
                        <% matched.each do |target| %>
                          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-surface-inset border border-border text-[11px] font-mono text-text-primary" title="<%= target[:type] == :swarm_service ? 'Serviço Docker Swarm' : 'Container Standalone' %>">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                            <%= target[:name] %>
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-text-muted text-[11px] italic">—</span>
                    <% end %>
                  </td>

                  <%# Proxy %>
                  <td class="py-3 px-4 text-center">
                    <% if record['proxiable'] %>
                      <% if record['proxied'] %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-orange-500/10 text-orange-400 border border-orange-500/20" title="Tráfego roteado via Cloudflare CDN & Segurança">
                          ● Proxied
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-surface-inset text-text-muted border border-border" title="DNS direto sem proxy">
                          ○ DNS Only
                        </span>
                      <% end %>
                    <% else %>
                      <span class="text-text-muted text-[10px]">—</span>
                    <% end %>
                  </td>

                  <%# TTL %>
                  <td class="py-3 px-4 text-center font-mono text-text-muted text-[11px]">
                    <%= record['ttl'] == 1 ? 'Auto' : "#{record['ttl']}s" %>
                  </td>

                  <%# Ações %>
                  <td class="py-3 px-4 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1.5">
                      <button @click="editData = {
                        id: '<%= record['id'] %>',
                        type: '<%= record['type'] %>',
                        name: '<%= j record['name'] %>',
                        content: '<%= j record['content'] %>',
                        ttl: <%= record['ttl'] || 1 %>,
                        proxied: <%= record['proxied'] ? 'true' : 'false' %>,
                        priority: '<%= record['priority'] %>',
                        comment: '<%= j(record['comment'] || '') %>'
                      }; modalEditRecord = true" class="p-1.5 rounded-lg hover:bg-surface-inset text-text-muted hover:text-text-primary transition-colors" title="Editar Registro">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>

                      <%= button_to delete_cloudflare_dns_record_path(record['id'], zone_id: @current_zone_id), method: :delete, data: { turbo_confirm: "Tem certeza que deseja deletar o registro #{record['name']} (#{record['type']})?" }, class: "p-1.5 rounded-lg hover:bg-red-500/10 text-text-muted hover:text-red-400 transition-colors", title: "Deletar Registro" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% elsif active_tab == "email" %>
    <%# ── EMAIL ROUTING VIEW ── %>
    <div class="space-y-4">
      <div class="bg-surface-raised p-5 rounded-xl border border-border">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-sm font-bold text-text-primary flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Cloudflare Email Routing
            </h3>
            <p class="text-xs text-text-muted mt-0.5">
              Crie endereços personalizados (ex: contato@<%= @zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || 'redhusky.com.br' %>) e encaminhe automaticamente para sua caixa de entrada pessoal.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              ● Roteamento Ativo
            </span>
          </div>
        </div>
      </div>

      <%# Regras de Email Table %>
      <div class="bg-surface-raised rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-text-secondary">
            <thead class="bg-surface-inset/50 text-text-muted uppercase text-[10px] tracking-wider border-b border-border">
              <tr>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4">Nome da Regra</th>
                <th class="py-3 px-4">Endereço Personalizado (De)</th>
                <th class="py-3 px-4">Encaminhar Para (Destino)</th>
                <th class="py-3 px-4 text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60">
              <% if (@email_rules || []).empty? %>
                <tr>
                  <td colspan="5" class="py-8 text-center text-text-muted">
                    Nenhuma regra de email cadastrada para este domínio.
                  </td>
                </tr>
              <% else %>
                <% @email_rules.each do |rule| %>
                  <% custom_addr = rule.dig('matchers', 0, 'value') || 'Todos' %>
                  <% forward_to = (rule.dig('actions', 0, 'value') || []).join(', ') %>
                  <tr class="hover:bg-surface-inset/30 transition-colors">
                    <td class="py-3 px-4">
                      <% if rule['enabled'] %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                          Ativo
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-zinc-500/10 text-text-muted border border-border">
                          Pausado
                        </span>
                      <% end %>
                    </td>
                    <td class="py-3 px-4 font-semibold text-text-primary">
                      <%= rule['name'] %>
                    </td>
                    <td class="py-3 px-4 font-mono font-medium text-text-primary">
                      <%= custom_addr %>
                    </td>
                    <td class="py-3 px-4 font-mono text-brand">
                      <%= forward_to %>
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5">
                        <button @click="editEmailData = {
                          id: '<%= rule['id'] %>',
                          name: '<%= j rule['name'] %>',
                          custom_address: '<%= j custom_addr %>',
                          forward_to: '<%= j forward_to %>',
                          enabled: <%= rule['enabled'] ? 'true' : 'false' %>
                        }; modalEditEmailRule = true" class="p-1.5 rounded-lg hover:bg-surface-inset text-text-muted hover:text-text-primary transition-colors" title="Editar Regra">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>

                        <%= button_to delete_cloudflare_email_rule_path(rule['id'], zone_id: @current_zone_id), method: :delete, data: { turbo_confirm: "Deseja remover a regra de email para #{custom_addr}?" }, class: "p-1.5 rounded-lg hover:bg-red-500/10 text-text-muted hover:text-red-400 transition-colors", title: "Deletar Regra" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% elsif active_tab == "turnstile" %>
    <%# ── TURNSTILE VIEW ── %>
    <div class="space-y-4">
      <div class="bg-surface-raised p-5 rounded-xl border border-border">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-sm font-bold text-text-primary flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              Cloudflare Turnstile (Smart CAPTCHA)
            </h3>
            <p class="text-xs text-text-muted mt-0.5">
              Proteja formulários de login e cadastro com verificação inteligente e invisível sem atrito para humanos.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <%= (@turnstile_widgets || []).size %> Widgets Ativos
            </span>
          </div>
        </div>
      </div>

      <%# Turnstile Widgets Table %>
      <div class="bg-surface-raised rounded-xl border border-border overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-text-secondary">
            <thead class="bg-surface-inset/50 text-text-muted uppercase text-[10px] tracking-wider border-b border-border">
              <tr>
                <th class="py-3 px-4">Nome do Widget</th>
                <th class="py-3 px-4">Sitekey (Pública)</th>
                <th class="py-3 px-4">Modo</th>
                <th class="py-3 px-4">Domínios Autorizados</th>
                <th class="py-3 px-4">Bot Fight Mode</th>
                <th class="py-3 px-4 text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60">
              <% if (@turnstile_widgets || []).empty? %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-text-muted">
                    Nenhum widget Turnstile cadastrado nesta conta Cloudflare.
                  </td>
                </tr>
              <% else %>
                <% @turnstile_widgets.each do |widget| %>
                  <% sitekey = widget['sitekey'] %>
                  <% mode = widget['mode'] || 'managed' %>
                  <% domains = widget['domains'] || [] %>
                  <tr class="hover:bg-surface-inset/30 transition-colors">
                    <td class="py-3 px-4 font-semibold text-text-primary">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <%= widget['name'] %>
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      <div class="inline-flex items-center gap-1.5 bg-surface-inset px-2 py-1 rounded border border-border font-mono text-[11px] text-text-primary">
                        <span><%= sitekey %></span>
                        <button type="button" @click="copyToClipboard('<%= sitekey %>', '<%= sitekey %>')" class="text-text-muted hover:text-text-primary transition-colors" title="Copiar Sitekey">
                          <template x-if="copiedKey === '<%= sitekey %>'">
                            <span class="text-emerald-400 font-sans text-[10px]">✓</span>
                          </template>
                          <template x-if="copiedKey !== '<%= sitekey %>'">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                          </template>
                        </button>
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      <% case mode %>
                      <% when "managed" %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                          Managed (Automático)
                        </span>
                      <% when "non-interactive" %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                          Não Interativo
                        </span>
                      <% when "invisible" %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
                          Invisível
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-surface-inset text-text-muted border border-border">
                          <%= mode %>
                        </span>
                      <% end %>
                    </td>
                    <td class="py-3 px-4">
                      <div class="flex flex-wrap gap-1 max-w-xs">
                        <% domains.each do |dom| %>
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-surface-inset text-text-primary font-mono text-[10px] border border-border">
                            <%= dom %>
                          </span>
                        <% end %>
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      <% if widget['bot_fight_mode'] %>
                        <span class="text-emerald-400 font-semibold text-[11px]">Ativado</span>
                      <% else %>
                        <span class="text-text-muted text-[11px]">Desativado</span>
                      <% end %>
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5">
                        <button @click="editTurnstileData = {
                          id: '<%= sitekey %>',
                          name: '<%= j widget['name'] %>',
                          domains: '<%= j domains.join("\n") %>',
                          mode: '<%= j mode %>',
                          bot_fight_mode: <%= widget['bot_fight_mode'] ? 'true' : 'false' %>
                        }; modalEditTurnstile = true" class="p-1.5 rounded-lg hover:bg-surface-inset text-text-muted hover:text-text-primary transition-colors" title="Editar Widget">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>

                        <%= button_to rotate_cloudflare_turnstile_secret_path(sitekey, zone_id: @current_zone_id), method: :post, data: { turbo_confirm: "Deseja rotacionar a Secret Key do Turnstile '#{widget['name']}'? Você precisará atualizar a variável de ambiente nas aplicações que o usam." }, class: "p-1.5 rounded-lg hover:bg-amber-500/10 text-text-muted hover:text-amber-400 transition-colors", title: "Rotacionar Secret Key" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                        <% end %>

                        <%= button_to delete_cloudflare_turnstile_path(sitekey, zone_id: @current_zone_id), method: :delete, data: { turbo_confirm: "Deseja deletar permanentemente o widget Turnstile '#{widget['name']}' (#{sitekey})?" }, class: "p-1.5 rounded-lg hover:bg-red-500/10 text-text-muted hover:text-red-400 transition-colors", title: "Deletar Widget" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
  <div x-show="modalNewRecord" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalNewRecord = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Novo Registro DNS</h3>
        <button @click="modalNewRecord = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: cloudflare_dns_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">Tipo</label>
            <%= select_tag :type, options_for_select(%w[A CNAME TXT MX AAAA NS SRV], "A"), class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono font-bold" %>
          </div>
          <div class="col-span-2">
            <label class="block text-text-muted font-medium mb-1">Nome / Subdomínio (@ para raiz)</label>
            <%= text_field_tag :name, nil, placeholder: "ex: app ou meu-host", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Conteúdo / IP / Alvo</label>
          <%= text_field_tag :content, nil, placeholder: "ex: 167.86.110.111 ou target.domain.com", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">TTL</label>
            <%= select_tag :ttl, options_for_select([["Auto (Padrão)", 1], ["2 min", 120], ["5 min", 300], ["10 min", 600], ["1 hora", 3600]], 1), class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2" %>
          </div>
          <div>
            <label class="block text-text-muted font-medium mb-1">Prioridade (MX/SRV)</label>
            <%= number_field_tag :priority, nil, placeholder: "Opcional (ex: 10)", class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 font-mono" %>
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Comentário / Descrição</label>
          <%= text_field_tag :comment, nil, placeholder: "Opcional: finalidade do registro", class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2" %>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :proxied, "1", false, id: "new_proxied", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="new_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (Cloud Laranja)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalNewRecord = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Salvar Registro</button>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── MODAL: EDITAR REGISTRO DNS ── %>
  <div x-show="modalEditRecord" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalEditRecord = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Editar Registro DNS</h3>
        <button @click="modalEditRecord = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <form :action="'/cloudflare/dns/' + editData.id" method="post" class="p-5 space-y-4 text-xs">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="zone_id" value="<%= @current_zone_id %>">

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">Tipo</label>
            <select name="type" x-model="editData.type" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono font-bold">
              <option value="A">A</option>
              <option value="CNAME">CNAME</option>
              <option value="TXT">TXT</option>
              <option value="MX">MX</option>
              <option value="AAAA">AAAA</option>
              <option value="NS">NS</option>
              <option value="SRV">SRV</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block text-text-muted font-medium mb-1">Nome / Host</label>
            <input type="text" name="name" x-model="editData.name" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Conteúdo / IP / Destino</label>
          <input type="text" name="content" x-model="editData.content" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">TTL</label>
            <select name="ttl" x-model="editData.ttl" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2">
              <option value="1">Auto (Padrão)</option>
              <option value="120">2 min</option>
              <option value="300">5 min</option>
              <option value="600">10 min</option>
              <option value="3600">1 hora</option>
            </select>
          </div>
          <div>
            <label class="block text-text-muted font-medium mb-1">Prioridade</label>
            <input type="number" name="priority" x-model="editData.priority" placeholder="Opcional" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 font-mono">
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Comentário</label>
          <input type="text" name="comment" x-model="editData.comment" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2">
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" name="proxied" value="1" x-model="editData.proxied" id="edit_proxied" class="rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500">
          <label for="edit_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (Cloud Laranja)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalEditRecord = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Atualizar Registro</button>
        </div>
      </form>
    </div>
  </div>

  <%# ── MODAL: NOVO ENCAMINHAMENTO (FORWARD) ── %>
  <div x-show="modalForward" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalForward = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary flex items-center gap-2">
          <span>Criar Encaminhamento DNS / CNAME</span>
        </h3>
        <button @click="modalForward = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: create_cloudflare_dns_forward_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div class="bg-surface-inset/50 p-3 rounded-lg border border-border text-text-muted text-[11px] leading-relaxed">
          Cria um registro <strong>CNAME</strong> de encaminhamento rápido apontando de um subdomínio para um host destino.
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Subdomínio de Origem</label>
          <%= text_field_tag :source_subdomain, nil, placeholder: "ex: link ou portal", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
          <p class="text-[10px] text-text-muted mt-1">Ex: digitar "link" resultará em <code>link.<%= @zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || 'dominio.com' %></code></p>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Host de Destino (Alvo)</label>
          <%= text_field_tag :target_host, nil, placeholder: "ex: app.redhusky.com.br ou s3.amazonaws.com", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :proxied, "1", true, id: "forward_proxied", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="forward_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (HTTPS automático e proteção DDoS)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalForward = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Criar Encaminhamento</button>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── MODAL: NOVA REGRA DE EMAIL ── %>
  <div x-show="modalNewEmailRule" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalNewEmailRule = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Nova Regra de Encaminhamento de Email</h3>
        <button @click="modalNewEmailRule = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: create_cloudflare_email_rule_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div>
          <label class="block text-text-muted font-medium mb-1">Nome da Regra</label>
          <%= text_field_tag :name, nil, placeholder: "ex: Contato Principal", class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand" %>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Endereço Personalizado (De)</label>
          <%= text_field_tag :custom_address, nil, placeholder: "ex: contato@#{@zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || 'redhusky.com.br'}", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Encaminhar Para (Destino Verificado)</label>
          <%= text_field_tag :forward_to, nil, placeholder: "ex: seu-email@gmail.com", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :enabled, "1", true, id: "new_email_enabled", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="new_email_enabled" class="text-text-primary font-medium cursor-pointer">
            Ativar regra imediatamente
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalNewEmailRule = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Salvar Regra</button>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── MODAL: EDITAR REGRA DE EMAIL ── %>
  <div x-show="modalEditEmailRule" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalEditEmailRule = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Editar Regra de Email</h3>
        <button @click="modalEditEmailRule = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <form :action="'/cloudflare/dns/email_rules/' + editEmailData.id" method="post" class="p-5 space-y-4 text-xs">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="zone_id" value="<%= @current_zone_id %>">

        <div>
          <label class="block text-text-muted font-medium mb-1">Nome da Regra</label>
          <input type="text" name="name" x-model="editEmailData.name" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand">
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Endereço Personalizado (De)</label>
          <input type="text" name="custom_address" x-model="editEmailData.custom_address" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Encaminhar Para (Destino)</label>
          <input type="text" name="forward_to" x-model="editEmailData.forward_to" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" name="enabled" value="1" x-model="editEmailData.enabled" id="edit_email_enabled" class="rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500">
          <label for="edit_email_enabled" class="text-text-primary font-medium cursor-pointer">
            Regra ativa
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalEditEmailRule = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Atualizar Regra</button>
        </div>
      </form>
    </div>
  </div>

  <%# ── MODAL: NOVO TURNSTILE WIDGET ── %>
  <div x-show="modalNewTurnstile" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalNewTurnstile = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Novo Widget Turnstile (CAPTCHA)</h3>
        <button @click="modalNewTurnstile = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: create_cloudflare_turnstile_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div>
          <label class="block text-text-muted font-medium mb-1">Nome do Widget / Aplicação</label>
          <%= text_field_tag :name, nil, placeholder: "ex: HuskyOS Login ou Plataforma Admin", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand" %>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Modo de Desafio</label>
          <%= select_tag :mode, options_for_select([["Managed (Recomendado - Cloudflare decide)", "managed"], ["Não Interativo (Sem clique do usuário)", "non-interactive"], ["Invisível (Totalmente transparente)", "invisible"]], "managed"), class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2" %>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Domínios Autorizados (um por linha ou separados por vírgula)</label>
          <%= text_area_tag :domains, "redhusky.com.br\n*.redhusky.com.br", rows: 3, required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
          <p class="text-[10px] text-text-muted mt-1">Ex: <code>redhusky.com.br</code>, <code>*.redhusky.com.br</code></p>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :bot_fight_mode, "1", false, id: "new_turnstile_bot_fight", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="new_turnstile_bot_fight" class="text-text-primary font-medium cursor-pointer">
            Ativar Bot Fight Mode avançado
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalNewTurnstile = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Criar Widget</button>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── MODAL: EDITAR TURNSTILE WIDGET ── %>
  <div x-show="modalEditTurnstile" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalEditTurnstile = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Editar Widget Turnstile</h3>
        <button @click="modalEditTurnstile = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <form :action="'/cloudflare/dns/turnstile/' + editTurnstileData.id" method="post" class="p-5 space-y-4 text-xs">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="zone_id" value="<%= @current_zone_id %>">

        <div>
          <label class="block text-text-muted font-medium mb-1">Nome do Widget</label>
          <input type="text" name="name" x-model="editTurnstileData.name" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand">
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Modo de Desafio</label>
          <select name="mode" x-model="editTurnstileData.mode" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2">
            <option value="managed">Managed (Recomendado - Cloudflare decide)</option>
            <option value="non-interactive">Não Interativo (Sem clique do usuário)</option>
            <option value="invisible">Invisível (Totalmente transparente)</option>
          </select>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Domínios Autorizados</label>
          <textarea name="domains" x-model="editTurnstileData.domains" rows="3" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono"></textarea>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" name="bot_fight_mode" value="1" x-model="editTurnstileData.bot_fight_mode" id="edit_turnstile_bot_fight" class="rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500">
          <label for="edit_turnstile_bot_fight" class="text-text-primary font-medium cursor-pointer">
            Ativar Bot Fight Mode avançado
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalEditTurnstile = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Atualizar Widget</button>
        </div>
      </form>
    </div>
  </div>

</div>
