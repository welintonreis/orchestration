<% page_title "Cloudflare DNS & Encaminhamentos" %>
<% page_subtitle "Gerencie registros DNS, proxies e encaminhamentos em tempo real" %>

<div class="space-y-6" x-data="{
  modalNewRecord: false,
  modalEditRecord: false,
  modalForward: false,
  editData: { id: '', type: 'A', name: '', content: '', ttl: 1, proxied: false, priority: '', comment: '' }
}">

  <%# ── TOP BAR & ZONE SELECTOR ── %>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface-raised p-4 rounded-xl border border-border">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-orange-500/10 text-orange-500 flex items-center justify-center font-bold text-xl">
        ☁
      </div>
      <div>
        <h1 class="text-lg font-bold text-text-primary flex items-center gap-2">
          Cloudflare DNS
          <% if @service.configured? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-500/10 text-green-400 border border-green-500/20">API Conectada</span>
          <% else %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-red-500/10 text-red-400 border border-red-500/20">Token Não Configurado</span>
          <% end %>
        </h1>
        <p class="text-xs text-text-muted">Zona ativa: <%= @zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || @current_zone_id || 'Nenhuma' %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if @zones.many? %>
        <%= form_with url: cloudflare_dns_path, method: :get, local: true, class: "inline-flex items-center" do %>
          <%= select_tag :zone_id, options_for_select(@zones.map { |z| [z["name"], z["id"]] }, @current_zone_id), onchange: "this.form.submit()", class: "bg-surface-inset text-text-primary text-xs rounded-lg border border-border px-3 py-2 focus:ring-1 focus:ring-brand" %>
        <% end %>
      <% end %>

      <button @click="modalForward = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-inset hover:bg-surface-inset/80 text-text-primary text-xs font-medium border border-border transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        Novo Encaminhamento
      </button>

      <button @click="modalNewRecord = true" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold shadow-sm transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Novo Registro DNS
      </button>
    </div>
  </div>

  <% if @error.present? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl text-sm flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= @error %></span>
    </div>
  <% end %>

  <%# ── FILTERS & SEARCH ── %>
  <div class="bg-surface-raised p-4 rounded-xl border border-border flex flex-col md:flex-row items-center justify-between gap-4">
    <%= form_with url: cloudflare_dns_path, method: :get, local: true, class: "w-full flex flex-col sm:flex-row items-center gap-3" do %>
      <%= hidden_field_tag :zone_id, @current_zone_id %>
      <div class="relative w-full sm:w-80">
        <input type="text" name="search" value="<%= @search %>" placeholder="Buscar por host, IP ou destino..." class="w-full bg-surface-inset text-text-primary text-xs rounded-lg border border-border pl-9 pr-3 py-2 focus:ring-1 focus:ring-brand focus:border-brand">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-text-muted absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <%= select_tag :type, options_for_select([["Todos os Tipos", ""], "A", "AAAA", "CNAME", "TXT", "MX", "NS", "SRV"], @type_filter), onchange: "this.form.submit()", class: "bg-surface-inset text-text-primary text-xs rounded-lg border border-border px-3 py-2" %>
        <button type="submit" class="px-3 py-2 bg-surface-inset hover:bg-surface-inset/80 text-text-secondary text-xs rounded-lg border border-border">Filtrar</button>
        <% if @search.present? || @type_filter.present? %>
          <%= link_to "Limpar", cloudflare_dns_path(zone_id: @current_zone_id), class: "text-xs text-text-muted hover:text-text-primary" %>
        <% end %>
      </div>
    <% end %>

    <div class="text-xs text-text-muted whitespace-nowrap self-end md:self-center">
      Total: <strong class="text-text-primary"><%= @records.size %></strong> registros
    </div>
  </div>

  <%# ── RECORDS TABLE ── %>
  <div class="bg-surface-raised rounded-xl border border-border overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-text-secondary">
        <thead class="bg-surface-inset/50 text-text-muted uppercase text-[10px] tracking-wider border-b border-border">
          <tr>
            <th class="py-3 px-4">Tipo</th>
            <th class="py-3 px-4">Nome / Host</th>
            <th class="py-3 px-4">Conteúdo / Destino</th>
            <th class="py-3 px-4 text-center">Proxy</th>
            <th class="py-3 px-4 text-center">TTL</th>
            <th class="py-3 px-4">Comentário</th>
            <th class="py-3 px-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          <% if @records.empty? %>
            <tr>
              <td colspan="7" class="py-8 text-center text-text-muted">
                Nenhum registro DNS encontrado para os critérios selecionados.
              </td>
            </tr>
          <% else %>
            <% @records.each do |record| %>
              <tr class="hover:bg-surface-inset/30 transition-colors group">
                <td class="py-3 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono font-bold text-[10px]
                    <%= case record['type']
                        when 'A' then 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                        when 'CNAME' then 'bg-purple-500/10 text-purple-400 border border-purple-500/20'
                        when 'TXT' then 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                        when 'MX' then 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                        else 'bg-surface-inset text-text-primary border border-border'
                        end %>">
                    <%= record['type'] %>
                  </span>
                </td>
                <td class="py-3 px-4 font-mono font-medium text-text-primary max-w-xs truncate" title="<%= record['name'] %>">
                  <%= record['name'] %>
                </td>
                <td class="py-3 px-4 font-mono text-text-secondary max-w-md truncate" title="<%= record['content'] %>">
                  <%= record['content'] %>
                  <% if record['priority'].present? %>
                    <span class="text-text-muted text-[10px] ml-1">(Prioridade: <%= record['priority'] %>)</span>
                  <% end %>
                </td>
                <td class="py-3 px-4 text-center">
                  <% if record['proxiable'] %>
                    <% if record['proxied'] %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-orange-500/10 text-orange-400 border border-orange-500/20" title="Tráfego roteado via Cloudflare CDN & Segurança">
                        ● Proxied
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-surface-inset text-text-muted border border-border" title="DNS direto sem proxy">
                        ○ DNS Only
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-text-muted text-[10px]">—</span>
                  <% end %>
                </td>
                <td class="py-3 px-4 text-center font-mono text-text-muted text-[11px]">
                  <%= record['ttl'] == 1 ? 'Auto' : "#{record['ttl']}s" %>
                </td>
                <td class="py-3 px-4 text-text-muted text-[11px] max-w-xs truncate" title="<%= record['comment'] %>">
                  <%= record['comment'].presence || '—' %>
                </td>
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5">
                    <button @click="editData = {
                      id: '<%= record['id'] %>',
                      type: '<%= record['type'] %>',
                      name: '<%= j record['name'] %>',
                      content: '<%= j record['content'] %>',
                      ttl: <%= record['ttl'] || 1 %>,
                      proxied: <%= record['proxied'] ? 'true' : 'false' %>,
                      priority: '<%= record['priority'] %>',
                      comment: '<%= j(record['comment'] || '') %>'
                    }; modalEditRecord = true" class="p-1.5 rounded-lg hover:bg-surface-inset text-text-muted hover:text-text-primary transition-colors" title="Editar Registro">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>

                    <%= button_to delete_cloudflare_dns_record_path(record['id'], zone_id: @current_zone_id), method: :delete, data: { turbo_confirm: "Tem certeza que deseja deletar o registro #{record['name']} (#{record['type']})?" }, class: "p-1.5 rounded-lg hover:bg-red-500/10 text-text-muted hover:text-red-400 transition-colors", title: "Deletar Registro" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── MODAL: NOVO REGISTRO DNS ── %>
  <div x-show="modalNewRecord" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalNewRecord = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Novo Registro DNS</h3>
        <button @click="modalNewRecord = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: cloudflare_dns_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">Tipo</label>
            <%= select_tag :type, options_for_select(%w[A CNAME TXT MX AAAA NS SRV], "A"), class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono font-bold" %>
          </div>
          <div class="col-span-2">
            <label class="block text-text-muted font-medium mb-1">Nome / Subdomínio (@ para raiz)</label>
            <%= text_field_tag :name, nil, placeholder: "ex: app ou meu-host", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Conteúdo / IP / Alvo</label>
          <%= text_field_tag :content, nil, placeholder: "ex: 167.86.110.111 ou target.domain.com", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">TTL</label>
            <%= select_tag :ttl, options_for_select([["Auto (Padrão)", 1], ["2 min", 120], ["5 min", 300], ["10 min", 600], ["1 hora", 3600]], 1), class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2" %>
          </div>
          <div>
            <label class="block text-text-muted font-medium mb-1">Prioridade (MX/SRV)</label>
            <%= number_field_tag :priority, nil, placeholder: "Opcional (ex: 10)", class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 font-mono" %>
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Comentário / Descrição</label>
          <%= text_field_tag :comment, nil, placeholder: "Opcional: finalidade do registro", class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2" %>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :proxied, "1", false, id: "new_proxied", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="new_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (Cloud Laranja)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalNewRecord = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Salvar Registro</button>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── MODAL: EDITAR REGISTRO DNS ── %>
  <div x-show="modalEditRecord" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalEditRecord = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary">Editar Registro DNS</h3>
        <button @click="modalEditRecord = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <form :action="'/cloudflare/dns/' + editData.id" method="post" class="p-5 space-y-4 text-xs">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="zone_id" value="<%= @current_zone_id %>">

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">Tipo</label>
            <select name="type" x-model="editData.type" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono font-bold">
              <option value="A">A</option>
              <option value="CNAME">CNAME</option>
              <option value="TXT">TXT</option>
              <option value="MX">MX</option>
              <option value="AAAA">AAAA</option>
              <option value="NS">NS</option>
              <option value="SRV">SRV</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block text-text-muted font-medium mb-1">Nome / Host</label>
            <input type="text" name="name" x-model="editData.name" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Conteúdo / IP / Destino</label>
          <input type="text" name="content" x-model="editData.content" required class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-text-muted font-medium mb-1">TTL</label>
            <select name="ttl" x-model="editData.ttl" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2">
              <option value="1">Auto (Padrão)</option>
              <option value="120">2 min</option>
              <option value="300">5 min</option>
              <option value="600">10 min</option>
              <option value="3600">1 hora</option>
            </select>
          </div>
          <div>
            <label class="block text-text-muted font-medium mb-1">Prioridade</label>
            <input type="number" name="priority" x-model="editData.priority" placeholder="Opcional" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 font-mono">
          </div>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Comentário</label>
          <input type="text" name="comment" x-model="editData.comment" class="w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2">
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" name="proxied" value="1" x-model="editData.proxied" id="edit_proxied" class="rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500">
          <label for="edit_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (Cloud Laranja)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalEditRecord = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Atualizar Registro</button>
        </div>
      </form>
    </div>
  </div>

  <%# ── MODAL: NOVO ENCAMINHAMENTO (FORWARD) ── %>
  <div x-show="modalForward" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs">
    <div @click.away="modalForward = false" class="bg-surface-raised border border-border rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
      <div class="p-5 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-bold text-text-primary flex items-center gap-2">
          <span>Criar Encaminhamento DNS / CNAME</span>
        </h3>
        <button @click="modalForward = false" class="text-text-muted hover:text-text-primary text-sm">✕</button>
      </div>

      <%= form_with url: create_cloudflare_dns_forward_path, method: :post, local: true, class: "p-5 space-y-4 text-xs" do %>
        <%= hidden_field_tag :zone_id, @current_zone_id %>

        <div class="bg-surface-inset/50 p-3 rounded-lg border border-border text-text-muted text-[11px] leading-relaxed">
          Cria um registro <strong>CNAME</strong> de encaminhamento rápido apontando de um subdomínio para um host destino.
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Subdomínio de Origem</label>
          <%= text_field_tag :source_subdomain, nil, placeholder: "ex: link ou portal", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
          <p class="text-[10px] text-text-muted mt-1">Ex: digitar "link" resultará em <code>link.<%= @zones.find { |z| z['id'] == @current_zone_id }&.dig('name') || 'dominio.com' %></code></p>
        </div>

        <div>
          <label class="block text-text-muted font-medium mb-1">Host de Destino (Alvo)</label>
          <%= text_field_tag :target_host, nil, placeholder: "ex: app.redhusky.com.br ou s3.amazonaws.com", required: true, class: "w-full bg-surface-inset text-text-primary rounded-lg border border-border p-2 focus:ring-1 focus:ring-brand font-mono" %>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <%= check_box_tag :proxied, "1", true, id: "forward_proxied", class: "rounded border-border bg-surface-inset text-orange-500 focus:ring-orange-500" %>
          <label for="forward_proxied" class="text-text-primary font-medium cursor-pointer">
            Ativar Proxy Cloudflare (HTTPS automático e proteção DDoS)
          </label>
        </div>

        <div class="pt-4 border-t border-border flex items-center justify-end gap-3">
          <button type="button" @click="modalForward = false" class="px-4 py-2 bg-surface-inset text-text-muted hover:text-text-primary rounded-lg">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg shadow-sm">Criar Encaminhamento</button>
        </div>
      <% end %>
    </div>
  </div>

</div>
