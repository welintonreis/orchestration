<% page_title "Cloudflare Management" %>
<% page_subtitle "Gerencie registros DNS, roteamento de emails, Turnstile captcha e correlação com containers Swarm" %>

<%# Zone list + records are external HTTPS calls and the Swarm correlation adds
    two socket calls on top — all of it lazy so the page paints at once. The
    current tab travels in the src, so the frame loads the tab being viewed. %>
<turbo-frame id="cloudflare-dns-content" refresh="morph"
             src="<%= rows_cloudflare_dns_path(tab: params[:tab], zone_id: params[:zone_id], search: params[:search], type: params[:type]) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar) %>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-20", "w-10", "w-40", "w-40", "w-32", "w-12", "w-12", :actions ],
        rows: 10) %>
</turbo-frame>
