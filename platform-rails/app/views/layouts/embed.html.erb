<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "RedHusky" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function () {
        var theme = localStorage.getItem('theme') || 'orange-dark';
        var mode = localStorage.getItem('theme_mode') || (theme.endsWith('-light') || theme === 'light' ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.toggle('dark', mode === 'dark');
      })();
    </script>
    <%= yield :head %>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full bg-surface text-text-primary antialiased">
    <%= render "shared/flash" %>
    <div class="h-full overflow-y-auto p-3">
      <%= yield %>
    </div>
  </body>
</html>
