<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " — redhusk" : "redhusk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="redhusk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="h-full bg-gray-950 text-gray-100 antialiased">
    <% if controller_name.in?(%w[sessions passwords]) %>
      <%# Auth pages: no sidebar, centered layout %>
      <div class="min-h-full flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </div>
    <% else %>
      <%# App shell with collapsible sidebar %>
      <div class="flex h-full" x-data="{ sidebarOpen: true }">

        <%# ── Sidebar ── %>
        <nav
          class="relative flex flex-col flex-shrink-0 bg-gray-900 border-r border-gray-800 transition-all duration-200 ease-in-out h-screen sticky top-0 overflow-y-auto"
          :class="sidebarOpen ? 'w-64' : 'w-16'"
        >
          <%# Brand %>
          <div class="flex items-center gap-3 px-4 py-5 border-b border-gray-800 min-h-[64px]">
            <%# Docker inline SVG icon %>
            <span class="flex-shrink-0 text-cyan-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 8H12V6h1.5V8zm0-3H12V3h1.5V5zm-3 3H9V6h1.5V8zm0-3H9V3h1.5V5zm-3 3H6V6h1.5V8zm3 3H9V9h1.5v2zm-3 0H6V9h1.5v2zm-3 0H3V9h1.5v2zm9 0H12V9h1.5v2zm3 0H15V9h1.5v2zm1.5 0v2h-1.5v-2H18zm1.5 2c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2v-1h18v1zm-1-3h-1.5V6H18v2z"/>
              </svg>
            </span>
            <span
              class="font-bold text-lg text-white tracking-tight transition-opacity duration-150"
              :class="sidebarOpen ? 'opacity-100' : 'opacity-0 hidden'"
            >redhusk</span>
          </div>

          <%# Toggle button %>
          <button
            @click="sidebarOpen = !sidebarOpen"
            class="absolute top-5 -right-3 z-10 w-6 h-6 bg-gray-700 hover:bg-gray-600 border border-gray-600 rounded-full flex items-center justify-center text-gray-400 hover:text-white transition-colors"
            aria-label="Toggle sidebar"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200" :class="sidebarOpen ? 'rotate-0' : 'rotate-180'" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </button>

          <%# Nav links %>
          <div class="flex-1 flex flex-col gap-1 px-2 py-4 overflow-y-auto">
            <%= nav_link "Dashboard", root_path, icon: :dashboard, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Containers", containers_path, icon: :containers, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Images", images_path, icon: :images, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Volumes", volumes_path, icon: :volumes, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Networks", networks_path, icon: :networks, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Swarm", swarm_path, icon: :swarm, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Git Deploy", git_stacks_path, icon: :git, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Environments", environments_path, icon: :environments, sidebar_open_expr: "sidebarOpen" %>
            <%= nav_link "Alerts", alerts_path, icon: :alerts, sidebar_open_expr: "sidebarOpen" %>
            <% if Current.user&.admin? %>
              <%= nav_link "Users", users_path, icon: :users, sidebar_open_expr: "sidebarOpen" %>
              <%= nav_link "Audit Log", audit_logs_path, icon: :audit, sidebar_open_expr: "sidebarOpen" %>
            <% end %>
          </div>

          <%# User section %>
          <% if Current.user %>
            <div class="border-t border-gray-800 px-2 py-3 flex flex-col gap-1">
              <div
                class="flex items-center gap-2 px-3 py-2 rounded-lg overflow-hidden"
                title="<%= Current.user.email_address %>"
              >
                <span class="flex-shrink-0 w-7 h-7 rounded-full bg-cyan-700 flex items-center justify-center text-xs font-bold text-white uppercase">
                  <%= Current.user.email_address[0] %>
                </span>
                <span
                  class="text-xs text-gray-400 truncate transition-opacity duration-150"
                  :class="sidebarOpen ? 'opacity-100' : 'opacity-0 hidden'"
                >
                  <%= Current.user.email_address %>
                </span>
              </div>
              <%= button_to session_path, method: :delete,
                class: "flex items-center gap-3 w-full px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-red-400 hover:bg-red-950/40 transition-colors text-left" do %>
                <span class="flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                  </svg>
                </span>
                <span :class="sidebarOpen ? 'opacity-100' : 'opacity-0 hidden'" class="transition-opacity duration-150">Sign out</span>
              <% end %>
            </div>
          <% end %>
        </nav>

        <%# ── Main area ── %>
        <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
          <%# Top header %>
          <header class="flex items-center justify-between px-6 py-4 bg-gray-900/60 border-b border-gray-800 backdrop-blur-sm sticky top-0 z-10 min-h-[64px]">
            <h1 class="text-xl font-semibold text-white truncate">
              <%= content_for?(:title) ? yield(:title) : "Dashboard" %>
            </h1>
            <div class="flex items-center gap-3">
              <%# Environment indicator %>
              <% if active_environment.present? %>
                <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-gray-800 border border-gray-700 rounded-lg text-xs text-gray-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 inline-block flex-shrink-0"></span>
                  <span class="font-mono truncate max-w-[120px]"><%= active_environment.name %></span>
                </div>
              <% end %>
              <% if content_for?(:actions) %>
                <%= yield :actions %>
              <% end %>
              <%= render "shared/alert_badge" %>
            </div>
          </header>

          <%# Breadcrumbs %>
          <%= render "shared/breadcrumb" %>

          <%# Flash messages %>
          <%= render "shared/flash" %>

          <%# Page content %>
          <main class="flex-1 overflow-y-auto p-6">
            <%= yield %>
          </main>
        </div>

      </div>
    <% end %>
  </body>
</html>
