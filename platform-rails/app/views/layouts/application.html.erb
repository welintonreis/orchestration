<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " — RedHusky" : "RedHusky" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RedHusky">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="h-full bg-gray-950 text-gray-100 antialiased">
    <% if controller_name.in?(%w[sessions passwords setups]) %>
      <div class="min-h-full flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </div>
    <% else %>
      <%
        env_name = active_environment&.name || "Nenhum"
        user_initial = Current.user&.email_address&.first&.upcase || "?"
        user_email   = Current.user&.email_address || ""
        user_role    = Current.user&.role || ""
        is_admin     = Current.user&.admin?
      %>

      <div class="flex h-full"
           x-data="{
             sb: true,
             profile: false,
             swarm: <%= request.path.start_with?('/swarm') ? 'true' : 'false' %>,
             git: <%= request.path.start_with?('/git') ? 'true' : 'false' %>,
             usuarios: <%= (request.path.start_with?('/users') || request.path.start_with?('/audit') || request.path.start_with?('/teams') || request.path.start_with?('/roles')) ? 'true' : 'false' %>,
             ambiente: <%= (request.path.start_with?('/environments') || request.path.start_with?('/ambiente')) ? 'true' : 'false' %>,
             logs: <%= (request.path.start_with?('/alerts') || request.path.start_with?('/notifications')) ? 'true' : 'false' %>,
             config: <%= request.path.start_with?('/settings') ? 'true' : 'false' %>
           }">

        <%# ══════════════════════════════ SIDEBAR ══════════════════════════════ %>
        <nav class="relative flex flex-col flex-shrink-0 bg-gray-900 border-r border-gray-800 transition-all duration-200 h-screen sticky top-0"
             :class="sb ? 'w-56' : 'w-14'">

          <%# ── Brand ── %>
          <div class="flex items-center gap-2.5 px-3 h-14 border-b border-gray-800 overflow-hidden flex-shrink-0">
            <span class="flex-shrink-0 text-[#2496ED]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
                <path d="M13.983 11.078h2.119a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.119a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 00.186-.186V3.574a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 00.186-.186V6.29a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.887c0 .102.082.186.185.186m-2.93 0h2.12a.186.186 0 00.184-.186V6.29a.185.185 0 00-.185-.185H8.1a.185.185 0 00-.185.185v1.887c0 .102.083.186.185.186m-2.964 0h2.119a.186.186 0 00.185-.186V6.29a.185.185 0 00-.185-.185H5.136a.186.186 0 00-.186.185v1.887c0 .102.084.186.186.186m5.893 2.715h2.118a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.184-.186h-2.12a.186.186 0 00-.186.186v1.887c0 .102.084.185.186.185m-2.92 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185M23.763 9.89c-.065-.051-.672-.51-1.954-.51-.338.001-.676.03-1.01.087-.248-1.7-1.653-2.53-1.716-2.566l-.344-.199-.226.327c-.284.438-.49.922-.612 1.43-.23.97-.09 1.882.403 2.661-.595.332-1.55.413-1.744.42H.751a.751.751 0 00-.75.748 11.376 11.376 0 00.692 4.062c.545 1.428 1.355 2.48 2.41 3.124 1.18.723 3.1 1.137 5.275 1.137.983.003 1.963-.086 2.93-.266a12.248 12.248 0 003.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z"/>
              </svg>
            </span>
            <span class="font-extrabold text-lg tracking-tight whitespace-nowrap overflow-hidden transition-all duration-150"
                  :class="sb ? 'opacity-100 max-w-full' : 'opacity-0 max-w-0 pointer-events-none'">
              <span class="text-red-500">Red</span><span class="text-white">Husky</span>
            </span>
          </div>

          <%# ── Sidebar toggle ── %>
          <button @click="sb = !sb"
                  class="flex items-center border-b border-gray-800 text-gray-500 hover:text-gray-200 hover:bg-gray-800/60 transition-colors"
                  :class="sb ? 'justify-end px-3 py-1.5 w-full' : 'justify-center py-1.5 w-full'">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 flex-shrink-0" :class="sb ? '' : 'rotate-180'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="11 17 6 12 11 7"/>
              <polyline points="18 17 13 12 18 7"/>
            </svg>
          </button>

          <%# ── Scroll area ── %>
          <div class="flex-1 overflow-y-auto overflow-x-hidden py-2">

            <%# Home (environments list) %>
            <%= sidebar_link "Home", environments_path, icon: :home, open: "sb" %>

            <%# ─── Ambiente ativo ─── %>
            <div class="mt-2 mb-1 px-3 flex items-center gap-2 min-h-[24px]">
              <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
              <span class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest truncate transition-all"
                    :class="sb ? 'opacity-100' : 'opacity-0'">
                <%= env_name %>
              </span>
            </div>

            <%= sidebar_link "Dashboard",   root_path,        icon: :dashboard,  open: "sb" %>
            <%= sidebar_link "Stacks",      stacks_path,      icon: :stacks,     open: "sb" %>
            <%= sidebar_link "Serviços",    swarm_services_path, icon: :services, open: "sb" %>
            <%= sidebar_link "Containers",  containers_path,  icon: :containers, open: "sb" %>
            <%= sidebar_link "Imagens",     images_path,      icon: :images,     open: "sb" %>
            <%= sidebar_link "Redes",       networks_path,    icon: :networks,   open: "sb" %>
            <%= sidebar_link "Volumes",     volumes_path,     icon: :volumes,    open: "sb" %>
            <%= sidebar_link "Configs",     configs_path,     icon: :configs,    open: "sb" %>
            <%= sidebar_link "Secrets",     secrets_path,     icon: :secrets,    open: "sb" %>

            <%# Swarm collapsible %>
            <button @click="swarm = !swarm"
                    class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-gray-500 hover:text-gray-300 transition-colors group">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Swarm</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', swarm ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="swarm" x-collapse class="pl-4">
              <%= sidebar_link "Detalhes",    swarm_path,            icon: :sub, open: "sb", exact: true %>
              <%= sidebar_link "Nós",         swarm_nodes_path,      icon: :sub, open: "sb" %>
              <%= sidebar_link "Registries",  swarm_registries_path, icon: :sub, open: "sb" %>
              <%= sidebar_link "Políticas",   swarm_policies_path,   icon: :sub, open: "sb" %>
            </div>

            <%# Git Deploy %>
            <%= sidebar_link "Git Deploy",  git_stacks_path,  icon: :git, open: "sb" %>

            <%# ─── Administração ─── %>
            <div class="mt-3 mb-1 border-t border-gray-800/80 pt-2 px-3">
              <span class="text-[10px] font-semibold text-gray-600 uppercase tracking-widest transition-all"
                    :class="sb ? 'opacity-100' : 'opacity-0'">Administração</span>
            </div>

            <%# Usuários collapsible — admin only %>
            <% if is_admin %>
              <button @click="usuarios = !usuarios"
                      class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-gray-400 hover:text-gray-200 transition-colors">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Usuários</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', usuarios ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="usuarios" x-collapse class="pl-4">
                <%= sidebar_link "Usuários", users_path,  icon: :sub, open: "sb" %>
                <%= sidebar_link "Times",    teams_path,  icon: :sub, open: "sb" %>
                <%= sidebar_link "Funções",  roles_path,  icon: :sub, open: "sb" %>
              </div>
            <% end %>

            <%# Ambiente collapsible %>
            <button @click="ambiente = !ambiente"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-gray-400 hover:text-gray-200 transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Ambiente</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', ambiente ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="ambiente" x-collapse class="pl-4">
              <%= sidebar_link "Grupos",     ambiente_groups_path,   icon: :sub, open: "sb" %>
              <%= sidebar_link "Políticas",  ambiente_policies_path, icon: :sub, open: "sb" %>
              <%= sidebar_link "Tags",       ambiente_tags_path,     icon: :sub, open: "sb" %>
              <%= sidebar_link "Registries", ambiente_registries_path, icon: :sub, open: "sb" %>
              <%= sidebar_link "Licenças",   ambiente_licenses_path, icon: :sub, open: "sb" %>
            </div>

            <%# Logs collapsible %>
            <button @click="logs = !logs"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-gray-400 hover:text-gray-200 transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Logs</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', logs ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="logs" x-collapse class="pl-4">
              <%= sidebar_link "Atividade",     audit_logs_path,    icon: :sub, open: "sb" %>
              <%= sidebar_link "Alertas",       alerts_path,        icon: :sub, open: "sb" %>
              <%= sidebar_link "Notificações",  notifications_path, icon: :sub, open: "sb" %>
            </div>

            <%# Configurações collapsible %>
            <button @click="config = !config"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-gray-400 hover:text-gray-200 transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Configurações</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', config ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="config" x-collapse class="pl-4">
              <%= sidebar_link "Geral",                      settings_general_path,      icon: :sub, open: "sb" %>
              <%= sidebar_link "Autenticação",            settings_auth_path,         icon: :sub, open: "sb" %>
              <%= sidebar_link "Credenciais Compartilhadas", settings_credentials_path, icon: :sub, open: "sb" %>
              <%= sidebar_link "Edge Compute",            settings_edge_path,         icon: :sub, open: "sb" %>
              <%= sidebar_link "Obter Ajuda",             settings_help_path,         icon: :sub, open: "sb" %>
            </div>

          </div><%# end scroll %>

          <%# ── User profile ── %>
          <% if Current.user %>
            <div class="border-t border-gray-800 px-2 py-2 relative" x-data="{ profile: false }">
              <button @click="profile = !profile"
                      class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-800 transition-colors"
                      :title="sb ? '' : '<%= user_email %>'">
                <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center text-xs font-bold text-white shadow">
                  <%= user_initial %>
                </span>
                <span class="flex-1 min-w-0 text-left transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">
                  <span class="block text-xs font-medium text-gray-200 truncate"><%= user_email %></span>
                  <span class="block text-[10px] text-gray-500 capitalize"><%= user_role %></span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0 text-gray-500 transition-all" :class="[sb ? 'opacity-100' : 'opacity-0', profile ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>

              <div x-show="profile"
                   x-transition:enter="transition ease-out duration-100"
                   x-transition:enter-start="opacity-0 -translate-y-1"
                   x-transition:enter-end="opacity-100 translate-y-0"
                   x-transition:leave="transition ease-in duration-75"
                   x-transition:leave-start="opacity-100 translate-y-0"
                   x-transition:leave-end="opacity-0 -translate-y-1"
                   @click.outside="profile = false"
                   class="absolute bottom-full left-2 right-2 mb-1 bg-gray-800 border border-gray-700 rounded-xl shadow-xl overflow-hidden z-30">
                <div class="px-4 py-3 border-b border-gray-700">
                  <div class="text-xs font-semibold text-gray-200 truncate"><%= user_email %></div>
                  <div class="flex items-center gap-1.5 mt-0.5">
                    <% role_dot = is_admin ? "bg-purple-500" : Current.user&.operator? ? "bg-cyan-500" : "bg-gray-500" %>
                    <span class="w-1.5 h-1.5 rounded-full <%= role_dot %> inline-block"></span>
                    <span class="text-[10px] text-gray-400 capitalize"><%= user_role %></span>
                  </div>
                </div>
                <div class="py-1">
                  <% if is_admin %>
                    <%= link_to users_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-300 hover:text-white hover:bg-gray-700/60 transition-colors" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                      </svg>
                      Gerenciar Usuários
                    <% end %>
                  <% end %>
                  <div class="border-t border-gray-700 my-1"></div>
                  <%= button_to session_path, method: :delete,
                        class: "flex items-center gap-3 w-full px-4 py-2.5 text-sm text-gray-400 hover:text-red-400 hover:bg-red-950/40 transition-colors text-left" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Sair
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </nav>

        <%# ══════════════════════════════ MAIN ══════════════════════════════ %>
        <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
          <header class="flex items-center justify-between px-6 bg-gray-900/60 border-b border-gray-800 backdrop-blur-sm sticky top-0 z-10 h-14">
            <h1 class="flex items-center gap-2.5 text-lg font-semibold text-white truncate">
              <% if content_for?(:page_icon) %>
                <span class="flex-shrink-0 text-gray-300 w-7 h-7 flex items-center justify-center"><%= yield(:page_icon) %></span>
              <% end %>
              <%= content_for?(:title) ? yield(:title) : "Dashboard" %>
            </h1>
            <div class="flex items-center gap-3">
              <% if active_environment.present? %>
                <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-gray-800 border border-gray-700 rounded-lg text-xs text-gray-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block flex-shrink-0"></span>
                  <span class="font-mono truncate max-w-[120px]"><%= active_environment.name %></span>
                </div>
              <% end %>
              <% if content_for?(:actions) %>
                <%= yield :actions %>
              <% end %>
              <%= render "shared/alert_badge" %>
            </div>
          </header>

          <% if content_for?(:page_header) %>
            <div class="px-6 py-4 border-b border-gray-800 bg-gray-900/30">
              <%= yield :page_header %>
            </div>
          <% end %>

          <%= render "shared/breadcrumb" %>
          <%= render "shared/flash" %>

          <main class="flex-1 overflow-y-auto p-6">
            <%= yield %>
          </main>
        </div>

      </div>
    <% end %>
  </body>
</html>
