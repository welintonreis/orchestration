<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " — RedHusky" : "RedHusky" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RedHusky">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function () {
        var theme = localStorage.getItem('theme') || 'orange-dark';
        var mode = localStorage.getItem('theme_mode') || (theme.endsWith('-light') || theme === 'light' ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
        if (mode === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <%= yield :head %>
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="/alpine-collapse.min.js"></script>
    <script defer src="/alpine.min.js"></script>
    <script src="/rh-confirm.js"></script>
  </head>

  <body class="h-full bg-surface text-text-primary antialiased">
    <% if controller_name.in?(%w[sessions passwords setups]) %>
      <div class="min-h-full flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </div>
    <% else %>
      <%
        env_name = active_environment&.name || "Nenhum"
        user_initial = Current.user&.email_address&.first&.upcase || "?"
        user_email   = Current.user&.email_address || ""
        user_role    = Current.user&.role || ""
        is_admin     = Current.user&.admin?
      %>

      <div class="flex h-full"
           x-data="{
             sb: true,
             profile: false,
             docker_group: <%= (request.path.start_with?('/containers') || request.path.start_with?('/images') || request.path.start_with?('/networks') || request.path.start_with?('/volumes') || request.path.start_with?('/configs') || request.path.start_with?('/secrets')) ? 'true' : 'false' %>,
             stacks_group: <%= (request.path.start_with?('/stacks') || request.path.start_with?('/app_templates') || request.path.start_with?('/swarm/services')) ? 'true' : 'false' %>,
             infra_group: <%= (request.path.start_with?('/vps_hosts') || request.path.start_with?('/cloudflare_dns') || request.path.start_with?('/seaweedfs')) ? 'true' : 'false' %>,
             swarm: <%= request.path.start_with?('/swarm') ? 'true' : 'false' %>,
             seaweed: <%= request.path.start_with?('/seaweedfs') ? 'true' : 'false' %>,
             git: <%= request.path.start_with?('/git') ? 'true' : 'false' %>,
             usuarios: <%= (request.path.start_with?('/users') || request.path.start_with?('/audit') || request.path.start_with?('/teams') || request.path.start_with?('/roles')) ? 'true' : 'false' %>,
             ambiente: <%= (request.path.start_with?('/environments') || request.path.start_with?('/ambiente')) ? 'true' : 'false' %>,
             logs: <%= (request.path.start_with?('/alerts') || request.path.start_with?('/notifications')) ? 'true' : 'false' %>,
             config: <%= request.path.start_with?('/settings') ? 'true' : 'false' %>
           }">

        <%# ══════════════════════════════ SIDEBAR ══════════════════════════════ %>
        <nav class="relative flex flex-col flex-shrink-0 bg-surface-raised border-r border-border transition-all duration-200 h-screen sticky top-0 w-56"
             :style="sb ? '' : 'width:3.5rem'">

          <%# ── Brand ──
              Static fallback classes (w-10 h-10, px-3 gap-3) match the sb:true
              default below — alpine.min.js loads deferred, so without these
              the nav/img have no width constraint at all until Alpine's
              :class bindings evaluate, causing a visible flash of an
              oversized logo and full-width sidebar on every full page load. %>
          <div class="flex items-center h-14 border-b border-border overflow-hidden flex-shrink-0 transition-all duration-200 px-3 gap-3"
               :class="sb ? '' : 'justify-center'"
               :style="sb ? '' : 'padding-left:0.5rem;padding-right:0.5rem'">

            <img src="/redhusky-logo.png"
                 class="flex-shrink-0 rounded-full transition-all duration-200 w-10 h-10"
                 :style="sb ? '' : 'width:2rem;height:2rem'"
                 alt="RedHusky">

            <span class="min-w-0 leading-tight transition-all duration-200 overflow-hidden whitespace-nowrap flex-1"
                  :class="sb ? 'opacity-100' : 'opacity-0 w-0 pointer-events-none'"
                  style="font-family:'Montserrat',sans-serif">
              <span class="block font-bold text-lg tracking-tight"><span class="text-brand">Red</span><span class="text-text-primary">Husky</span></span>
              <span class="block font-mono text-[8.5px] font-semibold tracking-[0.22em] uppercase text-text-muted">Orchestration</span>
            </span>
          </div>

          <%# ── Sidebar toggle ── %>
          <button @click="sb = !sb"
                  class="flex items-center border-b border-border text-text-muted hover:text-text-primary hover:bg-surface-inset/60 transition-colors justify-end px-3 py-1.5 w-full"
                  :style="sb ? '' : 'justify-content:center'">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 flex-shrink-0" :class="sb ? '' : 'rotate-180'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="11 17 6 12 11 7"/>
              <polyline points="18 17 13 12 18 7"/>
            </svg>
          </button>

          <%# ── Scroll area (scroll-thin: same custom scrollbar Ui::ScrollAreaComponent uses) ── %>
          <div class="flex-1 overflow-y-auto overflow-x-hidden py-2 scroll-thin">

            <%# Home (environments list) %>
            <%= sidebar_link "Home", environments_path, icon: :home, open: "sb" %>

            <%# ─── Ambiente ativo ─── %>
            <div class="mt-2 mb-1 px-3 flex items-center gap-2 min-h-[24px]">
              <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
              <span class="text-[10px] font-semibold text-text-muted uppercase tracking-widest truncate transition-all"
                    :class="sb ? 'opacity-100' : 'opacity-0'">
                <%= env_name %>
              </span>
            </div>

            <%= sidebar_link "Dashboard",   root_path,        icon: :dashboard,   open: "sb" %>
            <%= sidebar_link "Segurança",   security_path,    icon: :auth_shield, open: "sb" %>
            <% if Environment.where(endpoint_type: "kubernetes").exists? %>
              <%# Cross-cluster view — shown regardless of which environment is
                  currently active, since it spans all of them at once. %>
              <%= sidebar_link "Fleet K8s", kube_fleet_path, icon: :nodes, open: "sb" %>
            <% end %>

            <% if active_environment&.kubernetes? %>
              <%# Kubernetes collapsible — replaces the Docker/Swarm nav entirely
                  while a kubernetes environment is active (different API, chrome
                  reused instead: same rows/turbo-frame/table styling). %>
              <button @click="swarm = !swarm"
                      class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-text-muted hover:text-text-secondary transition-colors group">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <%= sidebar_icon(:swarm_hex).html_safe %>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Kubernetes</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', swarm ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="swarm" x-cloak x-collapse class="pl-4">
                <%= sidebar_link "Workloads",  kube_workloads_path,  icon: :services,  open: "sb" %>
                <%= sidebar_link "Pods",       kube_pods_path,       icon: :containers, open: "sb" %>
                <%= sidebar_link "Services",   kube_services_path,   icon: :networks,  open: "sb" %>
                <%= sidebar_link "ConfigMaps", kube_config_maps_path,icon: :configs,   open: "sb" %>
                <%= sidebar_link "Secrets",    kube_secrets_path,    icon: :secrets,   open: "sb" %>
                <%= sidebar_link "Nodes",      kube_nodes_path,      icon: :nodes,     open: "sb" %>
                <%= sidebar_link "Apply",      kube_apply_path,      icon: :stacks,    open: "sb" %>
              </div>
            <% else %>
              <%# ── STACKS collapsible ── %>
              <button @click="stacks_group = !stacks_group"
                      class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-text-muted hover:text-text-secondary transition-colors group">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <%= sidebar_icon(:stacks).html_safe %>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Stacks</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', stacks_group ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="stacks_group" x-cloak x-collapse class="pl-4">
                <%= sidebar_link "Stacks",          stacks_path,          icon: :stacks,     open: "sb" %>
                <%= sidebar_link "App Templates",   app_templates_path,   icon: :stacks,     open: "sb" %>
                <% if runtime_capabilities[:swarm] %>
                  <%= sidebar_link "Serviços",      swarm_services_path,  icon: :services,   open: "sb" %>
                <% end %>
              </div>

              <%# ── DOCKER collapsible ── %>
              <button @click="docker_group = !docker_group"
                      class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-text-muted hover:text-text-secondary transition-colors group">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <%= sidebar_icon(:containers).html_safe %>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Docker</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', docker_group ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="docker_group" x-cloak x-collapse class="pl-4">
                <%= sidebar_link "Containers",  containers_path,  icon: :containers, open: "sb" %>
                <%= sidebar_link "Imagens",     images_path,      icon: :images,     open: "sb" %>
                <%= sidebar_link "Redes",       networks_path,    icon: :networks,   open: "sb" %>
                <%= sidebar_link "Volumes",     volumes_path,     icon: :volumes,    open: "sb" %>
                <% if runtime_capabilities[:swarm] %>
                  <%= sidebar_link "Configs",   configs_path,     icon: :configs,    open: "sb" %>
                  <%= sidebar_link "Secrets",   secrets_path,     icon: :secrets,    open: "sb" %>
                <% end %>
              </div>

              <%# ── INFRAESTRUTURA collapsible ── %>
              <button @click="infra_group = !infra_group"
                      class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-text-muted hover:text-text-secondary transition-colors group">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <%= sidebar_icon(:vps).html_safe %>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Infraestrutura</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', infra_group ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="infra_group" x-cloak x-collapse class="pl-4">
                <% if can?(:admin) %>
                  <%= sidebar_link "VPS Hosts", vps_hosts_path, icon: :vps, open: "sb" %>
                <% end %>
                <%= sidebar_link "Cloudflare DNS", cloudflare_dns_path, icon: :dns, open: "sb" %>

                <%# SeaweedFS S3 sub-collapsible %>
                <button @click="seaweed = !seaweed"
                        class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-text-muted hover:text-text-secondary transition-colors group">
                  <span class="flex-shrink-0 w-4 h-4 flex items-center justify-center">
                    <%= sidebar_icon(:s3_storage).html_safe %>
                  </span>
                  <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">SeaweedFS S3</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', seaweed ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
                <div x-show="seaweed" x-cloak x-collapse class="pl-3">
                  <%= sidebar_link "Identidades & Keys", seaweedfs_path(tab: "identities"), icon: :credentials, open: "sb" %>
                  <%= sidebar_link "Buckets",           seaweedfs_path(tab: "buckets"),    icon: :volumes,     open: "sb" %>
                  <%= sidebar_link "Documentação",      seaweedfs_path(tab: "docs"),       icon: :chat_help,   open: "sb" %>
                </div>
              </div>

              <%= sidebar_link "Quotas de IA", ai_quota_path, icon: :quota, open: "sb" %>

              <% if runtime_capabilities[:swarm] %>
                <%# Swarm collapsible %>
                <button @click="swarm = !swarm"
                        class="w-full flex items-center gap-2.5 px-3 py-2 mt-1 text-sm font-medium text-text-muted hover:text-text-secondary transition-colors group">
                  <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                    <%= sidebar_icon(:swarm_hex).html_safe %>
                  </span>
                  <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Swarm</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', swarm ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
                <div x-show="swarm" x-cloak x-collapse class="pl-4">
                  <%= sidebar_link "Detalhes",    swarm_path,            icon: :details,  open: "sb", exact: true %>
                  <%= sidebar_link "Topologia",   swarm_topology_path,   icon: :topology, open: "sb" %>
                  <%= sidebar_link "Nós",         swarm_nodes_path,      icon: :nodes,    open: "sb" %>
                  <%= sidebar_link "Registries",  swarm_registries_path, icon: :registry, open: "sb" %>
                  <%= sidebar_link "Políticas",   swarm_policies_path,   icon: :policies, open: "sb" %>
                </div>
              <% end %>
            <% end %>

            <%# Git Deploy — acessível via Stacks > Nova Stack %>
            <%# sidebar_link removido: unificado em /stacks %>

            <%# ─── Administração ─── %>
            <div class="mt-3 mb-1 border-t border-border/80 pt-2 px-3">
              <span class="text-[10px] font-semibold text-text-muted uppercase tracking-widest transition-all"
                    :class="sb ? 'opacity-100' : 'opacity-0'">Administração</span>
            </div>

            <%# Usuários collapsible — admin only %>
            <% if is_admin %>
              <button @click="usuarios = !usuarios"
                      class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </span>
                <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Usuários</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', usuarios ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div x-show="usuarios" x-cloak x-collapse class="pl-4">
                <%= sidebar_link "Usuários", users_path,  icon: :user, open: "sb" %>
                <%= sidebar_link "Times",    teams_path,  icon: :user_group, open: "sb" %>
                <%= sidebar_link "Funções",  roles_path,  icon: :roles, open: "sb" %>
              </div>
            <% end %>

            <%# Ambiente collapsible %>
            <button @click="ambiente = !ambiente"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Ambiente</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', ambiente ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="ambiente" x-cloak x-collapse class="pl-4">
              <%= sidebar_link "Grupos",     ambiente_groups_path,   icon: :org_group, open: "sb" %>
              <%= sidebar_link "Políticas",  ambiente_policies_path, icon: :policies, open: "sb" %>
              <%= sidebar_link "Tags",       ambiente_tags_path,     icon: :tags, open: "sb" %>
              <%= sidebar_link "Registries", ambiente_registries_path, icon: :registry, open: "sb" %>
              <%= sidebar_link "Licenças",   ambiente_licenses_path, icon: :license, open: "sb" %>
            </div>

            <%# Logs collapsible %>
            <button @click="logs = !logs"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <%= sidebar_icon(:log_lines).html_safe %>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Logs</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', logs ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="logs" x-cloak x-collapse class="pl-4">
              <%= sidebar_link "Atividade",     audit_logs_path,    icon: :log_lines, open: "sb" %>
              <%= sidebar_link "Alertas",       alerts_path,        icon: :alert_tri,  open: "sb" %>
              <%= sidebar_link "Notificações",  notifications_path, icon: :notif_bell, open: "sb" %>
            </div>

            <%# Configurações collapsible %>
            <button @click="config = !config"
                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors">
              <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <span class="flex-1 text-left truncate transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Configurações</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0 transition-transform" :class="[sb ? 'opacity-100' : 'opacity-0', config ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div x-show="config" x-cloak x-collapse class="pl-4">
              <%= sidebar_link "Geral",                      settings_general_path,      icon: :policies, open: "sb" %>
              <%= sidebar_link "Autenticação",            settings_auth_path,         icon: :auth_shield, open: "sb" %>
              <%= sidebar_link "Credenciais Compartilhadas", settings_credentials_path, icon: :credentials, open: "sb" %>
              <%= sidebar_link "Edge Compute",            settings_edge_path,         icon: :edge, open: "sb" %>
              <%= sidebar_link "Obter Ajuda",             settings_help_path,         icon: :chat_help, open: "sb" %>
            </div>

          </div><%# end scroll %>

          <%# ── Theme toggle (RedHusky / Ice / Light / Dark) ── %>
          <div class="border-t border-border px-2 py-1.5"
               x-data="{
                 themeOpen: false,
                 currentTheme: localStorage.getItem('theme') || 'orange-dark',
                 setTheme(theme) {
                   this.currentTheme = theme;
                   localStorage.setItem('theme', theme);
                   document.documentElement.setAttribute('data-theme', theme);
                   var isDark = !theme.endsWith('-light');
                   localStorage.setItem('theme_mode', isDark ? 'dark' : 'light');
                   document.documentElement.classList.toggle('dark', isDark);
                 }
               }">
            <div class="relative">
              <button @click="themeOpen = !themeOpen"
                      class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-text-muted hover:text-text-primary hover:bg-surface-inset transition-colors"
                      :title="sb ? '' : 'Temas e Cores'">
                <span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l9.75 9.75"/>
                  </svg>
                </span>
                <span class="flex-1 text-left truncate text-sm font-medium transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">Temas</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0 text-text-muted transition-all" :class="[sb ? 'opacity-100' : 'opacity-0', themeOpen ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>

              <div x-show="themeOpen"
                   x-cloak
                   @click.outside="themeOpen = false"
                   class="absolute bottom-full left-0 mb-1 w-48 bg-surface-inset border border-border-subtle rounded-xl shadow-xl p-1.5 z-40 space-y-1 text-xs">
                <div class="px-2 py-1 text-[10px] font-semibold text-text-muted uppercase tracking-wider">RedHusky</div>
                <button @click="setTheme('orange-dark'); themeOpen = false"
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-active/60 transition-colors"
                        :class="currentTheme === 'orange-dark' ? 'text-brand font-medium bg-surface-active/30' : 'text-text-secondary'">
                  <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#E84518] shadow"></span>
                    RedHusky Escuro
                  </span>
                  <span x-show="currentTheme === 'orange-dark'">✓</span>
                </button>
                <button @click="setTheme('orange-light'); themeOpen = false"
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-active/60 transition-colors"
                        :class="currentTheme === 'orange-light' ? 'text-brand font-medium bg-surface-active/30' : 'text-text-secondary'">
                  <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#FF7A4D] shadow"></span>
                    RedHusky Claro
                  </span>
                  <span x-show="currentTheme === 'orange-light'">✓</span>
                </button>

                <div class="border-t border-border-subtle my-1"></div>
                <div class="px-2 py-1 text-[10px] font-semibold text-text-muted uppercase tracking-wider">Azul (Ice)</div>
                <button @click="setTheme('ice-dark'); themeOpen = false"
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-active/60 transition-colors"
                        :class="currentTheme === 'ice-dark' ? 'text-blue-400 font-medium bg-surface-active/30' : 'text-text-secondary'">
                  <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#3B9EFF] shadow"></span>
                    Azul Escuro
                  </span>
                  <span x-show="currentTheme === 'ice-dark'">✓</span>
                </button>
                <button @click="setTheme('ice-light'); themeOpen = false"
                        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-active/60 transition-colors"
                        :class="currentTheme === 'ice-light' ? 'text-blue-500 font-medium bg-surface-active/30' : 'text-text-secondary'">
                  <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#1D7FE8] shadow"></span>
                    Azul Claro
                  </span>
                  <span x-show="currentTheme === 'ice-light'">✓</span>
                </button>
              </div>
            </div>
          </div>

          <%# ── User profile ── %>
          <% if Current.user %>
            <div class="border-t border-border px-2 py-2 relative" x-data="{ profile: false }">
              <button @click="profile = !profile"
                      class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg hover:bg-surface-inset transition-colors"
                      :title="sb ? '' : '<%= user_email %>'">
                <% if Current.user&.has_avatar? %>
                  <img src="<%= Current.user.avatar_data_uri %>" class="flex-shrink-0 w-7 h-7 rounded-full object-cover border border-border shadow" alt="Avatar">
                <% else %>
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-orange-400 to-brand flex items-center justify-center text-xs font-mono font-bold text-white shadow">
                    <%= user_initial %>
                  </span>
                <% end %>
                <span class="flex-1 min-w-0 text-left transition-all" :class="sb ? 'opacity-100' : 'opacity-0 pointer-events-none'">
                  <span class="block text-xs font-medium text-text-primary truncate"><%= user_email %></span>
                  <span class="block font-mono text-[9.5px] font-semibold text-brand capitalize"><%= user_role %></span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0 text-text-muted transition-all" :class="[sb ? 'opacity-100' : 'opacity-0', profile ? 'rotate-180' : '']" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>

              <div x-show="profile"
                   x-cloak
                   x-transition:enter="transition ease-out duration-100"
                   x-transition:enter-start="opacity-0 -translate-y-1"
                   x-transition:enter-end="opacity-100 translate-y-0"
                   x-transition:leave="transition ease-in duration-75"
                   x-transition:leave-start="opacity-100 translate-y-0"
                   x-transition:leave-end="opacity-0 -translate-y-1"
                   @click.outside="profile = false"
                   class="absolute bottom-full left-2 right-2 mb-1 bg-surface-inset border border-border-subtle rounded-xl shadow-xl overflow-hidden z-30">
                <div class="px-4 py-3 border-b border-border-subtle flex items-center gap-3">
                  <% if Current.user&.has_avatar? %>
                    <img src="<%= Current.user.avatar_data_uri %>" class="w-9 h-9 rounded-full object-cover border border-border shrink-0" alt="Avatar">
                  <% end %>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-semibold text-text-primary truncate"><%= user_email %></div>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <% role_dot = is_admin ? "bg-purple-500" : Current.user&.operator? ? "bg-cyan-500" : "bg-gray-500" %>
                      <span class="w-1.5 h-1.5 rounded-full <%= role_dot %> inline-block"></span>
                      <span class="text-[10px] text-text-secondary capitalize"><%= user_role %></span>
                    </div>
                  </div>
                </div>
                <div class="py-1">
                  <% if is_admin %>
                    <%= link_to users_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-text-secondary hover:text-text-primary hover:bg-surface-active/60 transition-colors" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                      </svg>
                      Gerenciar Usuários
                    <% end %>
                  <% end %>
                  <div class="border-t border-border-subtle my-1"></div>
                  <%= button_to session_path, method: :delete,
                        class: "flex items-center gap-3 w-full px-4 py-2.5 text-sm text-text-secondary hover:text-red-600 dark:hover:text-red-400 hover:bg-red-100 dark:bg-red-950/40 transition-colors text-left" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Sair
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </nav>

        <%# ══════════════════════════════ MAIN ══════════════════════════════ %>
        <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
          <header class="flex items-center justify-between px-6 bg-surface-raised/60 border-b border-border backdrop-blur-sm sticky top-0 z-10 min-h-14 py-2 gap-4">
            <%# Lado Esquerdo: Título da Página ou Breadcrumbs principais %>
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <% if content_for?(:page_icon) %>
                <span class="flex-shrink-0 text-brand w-7 h-7 flex items-center justify-center">
                  <%= yield(:page_icon) %>
                </span>
              <% end %>
              <div class="min-w-0">
                <% if content_for?(:title) %>
                  <h1 class="text-base font-semibold text-text-primary leading-tight truncate"><%= yield(:title) %></h1>
                <% end %>
                <% if content_for?(:page_subtitle) %>
                  <p class="text-xs text-text-muted mt-0.5 leading-tight truncate"><%= yield(:page_subtitle) %></p>
                <% end %>
              </div>
            </div>

            <%# Lado Direito: Ações da Página, Ambiente, Sino de Notificações %>
            <div class="flex items-center gap-3 shrink-0">
              <% if active_environment.present? %>
                <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-surface-inset border border-border-subtle rounded-lg text-xs text-text-secondary">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block flex-shrink-0"></span>
                  <span class="font-mono truncate max-w-[120px]"><%= active_environment.name %></span>
                </div>
              <% end %>
              <% if content_for?(:title_actions) %>
                <div class="flex items-center gap-2">
                  <%= yield :title_actions %>
                </div>
              <% end %>
              <% if content_for?(:actions) %>
                <div class="flex items-center gap-2">
                  <%= yield :actions %>
                </div>
              <% end %>
              <%= render "shared/alert_badge" %>
            </div>
          </header>

          <%# ── Auto breadcrumbs ── %>
          <% bc = auto_breadcrumbs %>
          <% if bc.any? %>
            <nav class="flex items-center gap-1 px-6 py-1.5 text-xs border-b border-border/50 bg-surface-raised/30 flex-shrink-0 overflow-x-auto">
              <% bc.each_with_index do |(label, path), i| %>
                <% is_last = i == bc.size - 1 %>
                <% if i > 0 %>
                  <svg class="w-3 h-3 text-brand/70 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>
                <% if is_last %>
                  <span class="text-brand font-medium truncate"><%= label %></span>
                <% elsif path %>
                  <%= link_to label, path, class: "text-text-muted hover:text-brand transition-colors truncate" %>
                <% else %>
                  <span class="text-text-muted truncate"><%= label %></span>
                <% end %>
              <% end %>
            </nav>
          <% end %>

          <% if content_for?(:page_header) %>
            <div class="px-6 py-3 border-b border-border bg-surface-raised/30">
              <%= yield :page_header %>
            </div>
          <% end %>

          <%= render "shared/flash" %>

          <main class="flex-1 min-h-0 <%= content_for?(:main_class) ? yield(:main_class) : 'overflow-y-auto p-6' %>">
            <%= yield %>
          </main>
        </div>

      </div>
    <% end %>

    <%# ── Modal de confirmação ── %>
    <div id="confirm-modal"
         class="fixed inset-0 z-[9999] flex items-center justify-center p-4 hidden"
         role="dialog" aria-modal="true">
      <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="confirm-backdrop"></div>
      <div class="relative bg-surface-raised border border-border-subtle rounded-2xl shadow-2xl w-full max-w-sm">
        <div class="px-6 pt-6 pb-2 flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-red-100 dark:bg-red-900/40 border border-red-300 dark:border-red-800/60 flex items-center justify-center">
            <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base font-semibold text-text-primary" id="confirm-title">Confirmar ação</h3>
            <p class="text-sm text-text-secondary mt-1" id="confirm-message"></p>
          </div>
        </div>
        <div class="px-6 py-4 flex items-center justify-end gap-3">
          <button id="confirm-cancel"
                  class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active rounded-lg border border-border-subtle transition-colors">
            Cancelar
          </button>
          <button id="confirm-ok"
                  class="px-4 py-2 text-sm font-medium text-text-primary bg-red-600 hover:bg-red-500 rounded-lg transition-colors">
            Confirmar
          </button>
        </div>
      </div>
    </div>

  </body>
</html>
