<% if flash[:notice].present? || flash[:alert].present? %>
  <div
    id="flash-messages"
    class="px-6 pt-4"
    data-controller="flash"
    data-flash-delay-value="4000"
  >
    <% if flash[:notice].present? %>
      <div
        id="flash-notice"
        role="alert"
        class="flex items-start gap-3 px-4 py-3 mb-2 rounded-lg bg-green-900/50 border border-green-800 text-green-300 text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        <span><%= flash[:notice] %></span>
        <button
          type="button"
          onclick="this.closest('[role=alert]').remove()"
          class="ml-auto text-green-500 hover:text-green-700 dark:hover:text-green-300 transition-colors"
          aria-label="Dismiss"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div
        id="flash-alert"
        role="alert"
        class="flex items-start gap-3 px-4 py-3 mb-2 rounded-lg bg-red-900/50 border border-red-800 text-red-300 text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span><%= flash[:alert] %></span>
        <button
          type="button"
          onclick="this.closest('[role=alert]').remove()"
          class="ml-auto text-red-500 hover:text-red-700 dark:hover:text-red-300 transition-colors"
          aria-label="Dismiss"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>

  <script>
    (function () {
      var container = document.getElementById('flash-messages');
      if (!container) return;
      setTimeout(function () {
        container.style.transition = 'opacity 0.4s ease';
        container.style.opacity = '0';
        setTimeout(function () { container.remove(); }, 400);
      }, 4000);
    })();
  </script>
<% end %>
