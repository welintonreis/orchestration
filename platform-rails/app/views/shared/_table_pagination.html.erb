<%# Alpine.js pagination footer. Place inside an x-data wrapper with { perPage, page, total }.
    Pass local: { alpine_id: "unique_id" } to scope controls. %>
<div class="px-4 py-3 border-t border-border flex items-center justify-between flex-wrap gap-3">
  <div class="flex items-center gap-2">
    <span class="text-xs text-text-muted">Por página:</span>
    <% [10, 20, 30, 50, 100].each do |n| %>
      <button @click="perPage = <%= n %>; page = 1"
              class="px-2 py-0.5 text-xs rounded transition-colors"
              :class="perPage === <%= n %> ? 'bg-surface-active text-text-primary' : 'text-text-muted hover:text-text-secondary hover:bg-surface-inset'">
        <%= n %>
      </button>
    <% end %>
    <button @click="perPage = 0; page = 1"
            class="px-2 py-0.5 text-xs rounded transition-colors"
            :class="perPage === 0 ? 'bg-surface-active text-text-primary' : 'text-text-muted hover:text-text-secondary hover:bg-surface-inset'">
      Todos
    </button>
  </div>
  <div class="flex items-center gap-1 text-xs text-text-muted">
    <span>
      <span x-text="perPage === 0 ? total : Math.min(page * perPage, total)"></span>
      de <span x-text="total"></span>
    </span>
    <template x-if="perPage > 0 && Math.ceil(total / perPage) > 1">
      <div class="flex items-center gap-1 ml-2">
        <button @click="if(page > 1) page--"
                :disabled="page <= 1"
                class="px-2 py-0.5 rounded text-text-secondary hover:text-text-primary hover:bg-surface-inset disabled:text-text-muted disabled:cursor-not-allowed">‹</button>
        <span class="text-text-secondary" x-text="`${page} / ${Math.ceil(total / perPage)}`"></span>
        <button @click="if(page < Math.ceil(total / perPage)) page++"
                :disabled="page >= Math.ceil(total / perPage)"
                class="px-2 py-0.5 rounded text-text-secondary hover:text-text-primary hover:bg-surface-inset disabled:text-text-muted disabled:cursor-not-allowed">›</button>
      </div>
    </template>
  </div>
</div>
