<% page_title "VPS Hosts" %>
<% page_subtitle "Shell e file explorer com acesso real ao host via SSH/SFTP" %>

<% content_for :title_actions do %>
  <%= render Ui::ButtonComponent.new(url: new_vps_host_path, variant: :solid_cyan, size: :md, label: "+ Adicionar host") %>
<% end %>

<%= form_with url: vps_hosts_path, method: :get, class: "flex gap-3 mb-4" do %>
  <input type="text" name="q" value="<%= params[:q] %>" placeholder="Buscar por nome ou hostname…"
         class="flex-1 max-w-sm px-3 py-1.5 bg-surface-inset border border-border-subtle rounded-lg text-sm text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-600">
  <button type="submit" class="px-3 py-1.5 text-sm font-medium bg-surface-active hover:bg-surface-active-hover text-text-primary rounded-lg border border-border-subtle transition-colors">Buscar</button>
<% end %>

<% if @hosts.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center bg-surface-raised border border-border rounded-xl">
    <svg class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-14 0h14"/>
    </svg>
    <p class="text-text-secondary font-medium mb-1">Nenhum host cadastrado</p>
    <p class="text-sm text-text-muted">Adicione um host para abrir shell e explorar arquivos via SSH.</p>
    <%= render Ui::ButtonComponent.new(url: new_vps_host_path, variant: :solid_cyan, size: :md, label: "+ Adicionar host", css_class: "mt-4") %>
  </div>
<% else %>
  <div class="bg-surface-raised border border-border rounded-xl divide-y divide-border/60">
    <% @hosts.each do |host| %>
      <div class="flex items-center gap-4 px-4 py-3">
        <div class="w-9 h-9 rounded-lg bg-surface-inset flex items-center justify-center text-cyan-600 dark:text-cyan-400 shrink-0">
          <%= action_icon(:terminal, css_class: "w-4.5 h-4.5") %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="font-medium text-text-primary truncate"><%= host.name %></div>
          <div class="text-xs text-text-muted font-mono">
            <%= host.username %>@<%= host.hostname %>:<%= host.port %>
            <span class="mx-1.5">·</span><%= host.auth_method.humanize %>
            <span class="mx-1.5">·</span>credencial: <%= host.shared_credential.name %>
          </div>
        </div>
        <% if host.last_connected_at %>
          <span class="text-xs text-text-muted hidden sm:block"><%= time_ago_in_words(host.last_connected_at) %> atrás</span>
        <% end %>
        <div class="flex items-center gap-1.5 shrink-0">
          <%= button_to "Shell", vps_host_terminal_sessions_path(host), method: :post,
                class: "px-3 py-1.5 text-xs font-medium bg-cyan-100 dark:bg-cyan-500/12 hover:bg-cyan-200 dark:hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-500/30 rounded-lg transition-colors" %>
          <%= render Ui::ButtonComponent.new(url: vps_host_files_path(host), variant: :gray, size: :sm, label: "Arquivos") %>
          <%= render Ui::ButtonComponent.new(url: edit_vps_host_path(host), variant: :gray, icon: :edit) %>
          <%= render Ui::ButtonComponent.new(url: vps_host_path(host), method: :delete, variant: :red, icon: :remove,
                confirm: "Remover host \"#{host.name}\"? Sessões e histórico são apagados junto.") %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
