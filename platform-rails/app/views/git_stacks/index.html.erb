<% page_title "Git Deploy" %>
<% page_subtitle "Deploy de stacks Docker via repositório Git — clone, build e atualização automática" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="#e64a19" d="M13.172 2.828L11.78 4.22l1.91 1.91l2 2A2.986 2.986 0 0 1 20 10.81a3.25 3.25 0 0 1-.31 1.31l2.06 2a2.68 2.68 0 0 1 3.37.57a2.86 2.86 0 0 1 .88 2.117a3.02 3.02 0 0 1-.856 2.109A2.9 2.9 0 0 1 23 19.81a2.93 2.93 0 0 1-2.13-.87a2.694 2.694 0 0 1-.56-3.38l-2-2.06a3 3 0 0 1-.31.12V20a3 3 0 0 1 1.44 1.09a2.92 2.92 0 0 1 .56 1.72a2.88 2.88 0 0 1-.878 2.128a2.98 2.98 0 0 1-2.048.871a2.981 2.981 0 0 1-2.514-4.719A3 3 0 0 1 16 20v-6.38a2.96 2.96 0 0 1-1.44-1.09a2.9 2.9 0 0 1-.56-1.72a2.9 2.9 0 0 1 .31-1.31l-3.9-3.9l-7.579 7.572a4 4 0 0 0-.001 5.658l10.342 10.342a4 4 0 0 0 5.656 0l10.344-10.344a4 4 0 0 0 0-5.656L18.828 2.828a4 4 0 0 0-5.656 0" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= link_to "New Stack", new_git_stack_path, class: "btn-primary" %>
<% end %>

<% if @git_stacks.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
    </svg>
    <p class="text-text-secondary text-sm">No git stacks yet. Create one to deploy from a git repository.</p>
    <%= link_to "New Stack", new_git_stack_path, class: "btn-primary mt-4" %>
  </div>
<% else %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-border bg-white/[0.02]">
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Repositório</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Environment</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Mode</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Sync</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Last Deploy</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Auto-update</th>
          <th class="px-4 py-3 text-[10px] font-mono font-semibold text-text-muted uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% @git_stacks.each do |stack| %>
          <tr class="hover:bg-surface-inset/40 transition-colors">
            <td class="px-4 py-3 text-sm font-medium text-text-primary">
              <%= link_to stack.name, git_stack_path(stack), class: "hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors" %>
            </td>
            <td class="px-4 py-3 text-sm text-text-secondary font-mono truncate max-w-xs"><%= stack.repo_url %></td>
            <td class="px-4 py-3 text-sm text-text-secondary"><%= stack.environment.name %></td>
            <td class="px-4 py-3 text-sm text-text-secondary">
              <%= render Ui::BadgeComponent.new(color: :gray) { stack.deploy_mode } %>
            </td>
            <td class="px-4 py-3 text-sm">
              <%# Status badge: idle→gray, deploying→blue/pulse, deployed→green, failed→red %>
              <% status_color = case stack.status
                when "deploying" then :blue
                when "deployed"  then :green
                when "failed"    then :red
                else                  :gray
                end %>
              <%= render Ui::BadgeComponent.new(color: status_color, dot: true,
                    css_class: (status_color == :blue ? "animate-pulse" : nil)) { stack.status } %>
            </td>
            <td class="px-4 py-3 text-sm">
              <div class="flex items-center gap-1.5">
                <%= sync_status_badge(stack) %>
                <%= health_badge(stack) %>
              </div>
            </td>
            <td class="px-4 py-3 text-sm text-text-secondary"><%= human_age(stack.last_deployed_at) %></td>
            <td class="px-4 py-3 text-sm text-text-secondary">
              <% if stack.auto_update? %>
                <span class="inline-flex items-center gap-1 text-xs text-green-600 dark:text-green-400">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= stack.poll_interval %>s
                </span>
              <% else %>
                <span class="text-xs text-text-muted">off</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= render Ui::ButtonComponent.new(url: git_stack_path(stack), variant: :gray, size: :sm, label: "Show") %>
                <%= render Ui::ButtonComponent.new(url: deploy_git_stack_path(stack), method: :post, variant: :solid_cyan, size: :sm, label: "Deploy") %>
                <%= render Ui::ButtonComponent.new(url: edit_git_stack_path(stack), variant: :gray, size: :sm, label: "Edit") %>
                <%= render Ui::ButtonComponent.new(url: git_stack_path(stack), method: :delete, variant: :solid_red, size: :sm, label: "Delete",
                      confirm: "Delete stack \"#{stack.name}\"? This cannot be undone.") %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
