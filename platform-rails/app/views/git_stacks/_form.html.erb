<div class="max-w-xl">
  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <h2 class="text-base font-semibold text-text-primary mb-6">
      <%= git_stack.new_record? ? "New Git Stack" : "Edit Git Stack" %>
    </h2>

    <%= form_with model: git_stack, class: "space-y-5" do |f| %>
      <%# Validation errors %>
      <% if git_stack.errors.any? %>
        <div class="rounded-lg bg-red-100 dark:bg-red-900/40 border border-red-300 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-300">
          <p class="font-medium mb-1">Please fix the following errors:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% git_stack.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Name %>
      <div>
        <%= f.label :name, "Stack Name", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.text_field :name,
              placeholder: "e.g. my-app",
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
      </div>

      <%# Git source + credentials %>
      <%= render "git_credential_fields", f: f, git_stack: git_stack, git_credentials: @git_credentials %>

      <%# Environment %>
      <div>
        <%= f.label :environment_id, "Environment", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.select :environment_id,
              @environments.map { |e| [e.name, e.id] },
              { prompt: "— Select an environment —" },
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
      </div>

      <%# Fleet deploy target — optional. Deploy still targets Environment above by
          default; setting a group additionally enables "Deploy em Frota" (same
          stack applied to every environment in the group, one at a time). %>
      <div>
        <%= f.label :target_group_id, "Grupo de destino (fleet deploy, opcional)", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.select :target_group_id,
              @environment_groups.map { |g| [g.name, g.id] },
              { prompt: "— Nenhum (deploy só no Environment acima) —", include_blank: false },
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        <p class="mt-1.5 text-xs text-text-muted">Quando definido, "Deploy em Frota" aplica este stack a todos os environments do grupo, um de cada vez.</p>
      </div>

      <%# Compose file %>
      <div>
        <%= f.label :compose_file, "Compose File", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.text_field :compose_file,
              placeholder: "docker-compose.yml",
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        <p class="mt-1.5 text-xs text-text-muted">Relative path from the repository root.</p>
      </div>

      <%# Environment variables (.env) %>
      <div>
        <%= f.label :env_content, "Environment Variables (.env)", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.text_area :env_content,
              rows: 6,
              placeholder: "DATABASE_URL=postgres://user:pass@host:5432/db\nNEXTAUTH_SECRET=...",
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        <p class="mt-1.5 text-xs text-text-muted">Uma variável por linha (formato KEY=VALUE). Escrito como .env ao lado do compose file antes do deploy.</p>
      </div>

      <%# Deploy Mode %>
      <div>
        <%= f.label :deploy_mode, "Deploy Mode", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.select :deploy_mode,
              [["Docker Swarm Stack", "swarm_stack"], ["Docker Compose", "compose"]],
              {},
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
      </div>

      <%# Auto-update %>
      <div class="flex items-center gap-3">
        <%= f.check_box :auto_update,
              class: "h-4 w-4 rounded border-border-subtle bg-surface-sunken text-cyan-600 focus:ring-cyan-600 focus:ring-offset-surface-sunken" %>
        <%= f.label :auto_update, "Enable auto-update (poll for changes)", class: "text-sm text-text-secondary" %>
      </div>

      <%# Poll interval %>
      <div>
        <%= f.label :poll_interval, "Poll Interval (seconds)", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
        <%= f.number_field :poll_interval,
              min: 30,
              step: 1,
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        <p class="mt-1.5 text-xs text-text-muted">Minimum 30 seconds. Only used when auto-update is enabled.</p>
      </div>

      <%# ── Reconcile (GitOps) ── %>
      <div class="border-t border-border-subtle pt-5 space-y-5">
        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Reconcile (GitOps)</h3>

        <%# Self-heal %>
        <div class="flex items-start gap-3">
          <%= f.check_box :self_heal,
                class: "mt-0.5 h-4 w-4 rounded border-border-subtle bg-surface-sunken text-amber-600 focus:ring-amber-600 focus:ring-offset-surface-sunken" %>
          <div>
            <%= f.label :self_heal, "Self-heal — reaplica o Git ao detectar drift", class: "text-sm text-text-secondary" %>
            <p class="text-xs text-text-muted">Requer auto-update. Reverte mudanças manuais no Swarm de volta ao estado do Git.</p>
          </div>
        </div>

        <%# Sync window %>
        <div>
          <%= f.label :sync_window, "Sync Window", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
          <%= f.text_field :sync_window,
                placeholder: "mon-fri 08:00-20:00",
                class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          <p class="mt-1.5 text-xs text-text-muted">Janela em que deploys automáticos/self-heal podem rodar. Vazio = sempre. Deploy manual ignora a janela.</p>
        </div>

        <%# Pre/Post sync hooks %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :pre_sync_cmd, "PreSync Hook", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
            <%= f.text_field :pre_sync_cmd,
                  placeholder: "docker pull …",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
          <div>
            <%= f.label :post_sync_cmd, "PostSync Hook", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
            <%= f.text_field :post_sync_cmd,
                  placeholder: "curl -fsS https://… (smoke test)",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
        </div>
        <p class="text-xs text-text-muted -mt-2">Comandos shell rodados no diretório do compose (com o .env). PreSync que falha aborta o deploy.</p>
      </div>

      <%# ── CI Check (GitLab) ── %>
      <div class="border-t border-border-subtle pt-5 space-y-4">
        <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">CI Check (GitLab)</h3>
        <div class="flex items-start gap-3">
          <%= f.check_box :ci_check_enabled,
                class: "mt-0.5 h-4 w-4 rounded border-border-subtle bg-surface-sunken text-cyan-600 focus:ring-cyan-600 focus:ring-offset-surface-sunken" %>
          <div>
            <%= f.label :ci_check_enabled, "Bloquear deploy se pipeline não passou", class: "text-sm text-text-secondary" %>
            <p class="text-xs text-text-muted">Consulta o GitLab API antes de cada deploy. Deploy só ocorre se o último pipeline da branch estiver em status <code class="text-xs">success</code>.</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :ci_gitlab_url, "GitLab URL", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
            <%= f.url_field :ci_gitlab_url,
                  placeholder: "https://gitlab.redhusky.com.br",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
          <div>
            <%= f.label :ci_project_id, "Project ID ou namespace/projeto", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
            <%= f.text_field :ci_project_id,
                  placeholder: "redhusky/meu-app",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
        </div>
        <div>
          <%= f.label :ci_token_ciphertext, "GitLab Token (read_api scope)", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
          <%= f.password_field :ci_token_ciphertext,
                placeholder: "glpat-...",
                autocomplete: "off",
                class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          <p class="mt-1.5 text-xs text-text-muted">Token com permissão <code class="text-xs">read_api</code> no projeto. Deixe em branco para manter o token atual.</p>
        </div>
      </div>

      <%# Webhook info for new records %>
      <% if git_stack.new_record? %>
        <div class="rounded-lg bg-cyan-100 dark:bg-cyan-950/40 border border-cyan-300 dark:border-cyan-800/40 px-4 py-3">
          <p class="text-xs text-cyan-600 dark:text-cyan-400 font-medium mb-1">Webhook CI/CD</p>
          <p class="text-xs text-text-secondary">
            Após criar a stack, um <strong class="text-text-primary">Webhook URL</strong> único será gerado.
            Use-o em GitHub Actions, GitLab CI, Bitbucket Pipelines ou qualquer sistema de CI/CD para
            acionar o deploy automaticamente quando a branch for atualizada.
          </p>
        </div>
      <% end %>

      <%# Actions %>
      <div class="flex items-center gap-3 pt-2">
        <%= f.submit git_stack.new_record? ? "Create Stack" : "Update Stack",
              class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-500 text-text-primary text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
        <%= link_to "Cancel", git_stacks_path,
              class: "inline-flex items-center px-4 py-2 bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary text-sm font-medium rounded-lg transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
