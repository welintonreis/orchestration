<% page_title "Nova Stack" %>
<% page_subtitle "Adicione uma stack Docker ao ambiente ativo" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="#e64a19" d="M13.172 2.828L11.78 4.22l1.91 1.91l2 2A2.986 2.986 0 0 1 20 10.81a3.25 3.25 0 0 1-.31 1.31l2.06 2a2.68 2.68 0 0 1 3.37.57a2.86 2.86 0 0 1 .88 2.117a3.02 3.02 0 0 1-.856 2.109A2.9 2.9 0 0 1 23 19.81a2.93 2.93 0 0 1-2.13-.87a2.694 2.694 0 0 1-.56-3.38l-2-2.06a3 3 0 0 1-.31.12V20a3 3 0 0 1 1.44 1.09a2.92 2.92 0 0 1 .56 1.72a2.88 2.88 0 0 1-.878 2.128a2.98 2.98 0 0 1-2.048.871a2.981 2.981 0 0 1-2.514-4.719A3 3 0 0 1 16 20v-6.38a2.96 2.96 0 0 1-1.44-1.09a2.9 2.9 0 0 1-.56-1.72a2.9 2.9 0 0 1 .31-1.31l-3.9-3.9l-7.579 7.572a4 4 0 0 0-.001 5.658l10.342 10.342a4 4 0 0 0 5.656 0l10.344-10.344a4 4 0 0 0 0-5.656L18.828 2.828a4 4 0 0 0-5.656 0" />
  </svg>
<% end %>

<div class="max-w-2xl"
     x-data="{
       step: 1,
       source: '',
       deployMode: '<%= @git_stack.deploy_mode.presence || "swarm_stack" %>',
       canNext() {
         if (this.step === 1) return this.source !== '';
         if (this.step === 2) {
           if (this.source === 'git') return true;
           if (this.source === 'yaml') return document.getElementById('yaml_content')?.value?.trim().length > 0;
           if (this.source === 'zip')  return document.getElementById('zip_file')?.files?.length > 0;
         }
         return true;
       },
       next() { if (this.canNext()) this.step++; },
       back() { if (this.step > 1) this.step--; }
     }">

  <%# ── Progress bar ── %>
  <div class="flex items-center gap-2 mb-8">
    <% steps = [
      { n: 1, label: "Origem" },
      { n: 2, label: "Configurar" },
      { n: 3, label: "Deploy" }
    ] %>
    <% steps.each_with_index do |s, i| %>
      <div class="flex items-center gap-2 flex-1">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-colors"
               :class="step > <%= s[:n] %> ? 'bg-green-600 text-text-primary' :
                        step === <%= s[:n] %> ? 'bg-red-600 text-text-primary' :
                        'bg-surface-inset text-text-muted'">
            <template x-if="step > <%= s[:n] %>">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </template>
            <template x-if="step <= <%= s[:n] %>">
              <span><%= s[:n] %></span>
            </template>
          </div>
          <span class="text-xs font-medium transition-colors"
                :class="step === <%= s[:n] %> ? 'text-text-primary' : step > <%= s[:n] %> ? 'text-green-600 dark:text-green-400' : 'text-text-muted'">
            <%= s[:label] %>
          </span>
        </div>
        <% if i < steps.size - 1 %>
          <div class="flex-1 h-px transition-colors ml-2"
               :class="step > <%= s[:n] %> ? 'bg-green-700' : 'bg-surface-inset'"></div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= form_with model: @git_stack, html: { id: "wizard-form" }, class: "space-y-0" do |f| %>
    <%= f.hidden_field :source_type, value: "", "x-bind:value": "source" %>

    <%# ── Validation errors ── %>
    <% if @git_stack.errors.any? %>
      <div class="mb-6 rounded-lg bg-red-900/40 border border-red-800 px-4 py-3 text-sm text-red-300">
        <p class="font-medium mb-1">Corrija os erros abaixo:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% @git_stack.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ══════════════════════════════ STEP 1: SOURCE ══════════════════════════════ %>
    <div x-show="step === 1" class="space-y-4">
      <div class="bg-surface-raised border border-border rounded-xl p-6">
        <h3 class="text-base font-semibold text-text-primary mb-1">Escolha a origem da stack</h3>
        <p class="text-sm text-text-secondary mb-6">Como você quer fornecer o arquivo de configuração Docker?</p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <%# Git option %>
          <label class="group cursor-pointer">
            <input type="radio" name="_source_radio" value="git" x-model="source" class="sr-only">
            <div class="relative flex flex-col items-center gap-3 p-5 rounded-xl border-2 transition-all"
                 :class="source === 'git' ? 'border-red-600 bg-red-950/30' : 'border-border-subtle hover:border-border-subtle bg-surface-inset/30'">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center"
                   :class="source === 'git' ? 'bg-red-900/60' : 'bg-surface-inset'">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
                  <path d="M0 0h32v32H0z" fill="none"/>
                  <path fill="#e64a19" d="M13.172 2.828L11.78 4.22l1.91 1.91l2 2A2.986 2.986 0 0 1 20 10.81a3.25 3.25 0 0 1-.31 1.31l2.06 2a2.68 2.68 0 0 1 3.37.57a2.86 2.86 0 0 1 .88 2.117a3.02 3.02 0 0 1-.856 2.109A2.9 2.9 0 0 1 23 19.81a2.93 2.93 0 0 1-2.13-.87a2.694 2.694 0 0 1-.56-3.38l-2-2.06a3 3 0 0 1-.31.12V20a3 3 0 0 1 1.44 1.09a2.92 2.92 0 0 1 .56 1.72a2.88 2.88 0 0 1-.878 2.128a2.98 2.98 0 0 1-2.048.871a2.981 2.981 0 0 1-2.514-4.719A3 3 0 0 1 16 20v-6.38a2.96 2.96 0 0 1-1.44-1.09a2.9 2.9 0 0 1-.56-1.72a2.9 2.9 0 0 1 .31-1.31l-3.9-3.9l-7.579 7.572a4 4 0 0 0-.001 5.658l10.342 10.342a4 4 0 0 0 5.656 0l10.344-10.344a4 4 0 0 0 0-5.656L18.828 2.828a4 4 0 0 0-5.656 0"/>
                </svg>
              </div>
              <div class="text-center">
                <p class="text-sm font-semibold text-text-primary">Repositório Git</p>
                <p class="text-xs text-text-secondary mt-0.5">GitHub, GitLab, Gitea…</p>
              </div>
              <div class="absolute top-3 right-3 w-4 h-4 rounded-full border-2 transition-all flex items-center justify-center"
                   :class="source === 'git' ? 'border-red-500 bg-red-500' : 'border-border-subtle'">
                <div class="w-1.5 h-1.5 rounded-full bg-white" x-show="source === 'git'"></div>
              </div>
            </div>
          </label>

          <%# YAML editor option %>
          <label class="group cursor-pointer">
            <input type="radio" name="_source_radio" value="yaml" x-model="source" class="sr-only">
            <div class="relative flex flex-col items-center gap-3 p-5 rounded-xl border-2 transition-all"
                 :class="source === 'yaml' ? 'border-red-600 bg-red-950/30' : 'border-border-subtle hover:border-border-subtle bg-surface-inset/30'">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center"
                   :class="source === 'yaml' ? 'bg-red-900/60' : 'bg-surface-inset'">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-yellow-600 dark:text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              </div>
              <div class="text-center">
                <p class="text-sm font-semibold text-text-primary">Editor YAML</p>
                <p class="text-xs text-text-secondary mt-0.5">Cole ou escreva o compose</p>
              </div>
              <div class="absolute top-3 right-3 w-4 h-4 rounded-full border-2 transition-all flex items-center justify-center"
                   :class="source === 'yaml' ? 'border-red-500 bg-red-500' : 'border-border-subtle'">
                <div class="w-1.5 h-1.5 rounded-full bg-white" x-show="source === 'yaml'"></div>
              </div>
            </div>
          </label>

          <%# ZIP option %>
          <label class="group cursor-pointer">
            <input type="radio" name="_source_radio" value="zip" x-model="source" class="sr-only">
            <div class="relative flex flex-col items-center gap-3 p-5 rounded-xl border-2 transition-all"
                 :class="source === 'zip' ? 'border-red-600 bg-red-950/30' : 'border-border-subtle hover:border-border-subtle bg-surface-inset/30'">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center"
                   :class="source === 'zip' ? 'bg-red-900/60' : 'bg-surface-inset'">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
              </div>
              <div class="text-center">
                <p class="text-sm font-semibold text-text-primary">Upload ZIP</p>
                <p class="text-xs text-text-secondary mt-0.5">Envie um pacote compactado</p>
              </div>
              <div class="absolute top-3 right-3 w-4 h-4 rounded-full border-2 transition-all flex items-center justify-center"
                   :class="source === 'zip' ? 'border-red-500 bg-red-500' : 'border-border-subtle'">
                <div class="w-1.5 h-1.5 rounded-full bg-white" x-show="source === 'zip'"></div>
              </div>
            </div>
          </label>
        </div>

        <p class="mt-4 text-xs text-red-600 dark:text-red-400" x-show="source === ''" x-cloak>Selecione uma origem para continuar.</p>
      </div>
    </div>

    <%# ══════════════════════════════ STEP 2: CONFIGURE SOURCE ══════════════════════════════ %>
    <div x-show="step === 2" class="space-y-4">
      <div class="bg-surface-raised border border-border rounded-xl p-6">

        <%# Git source ── %>
        <div x-show="source === 'git'" data-controller="compose-file" data-compose-file-url-value="<%= files_git_stacks_path %>">
          <h3 class="text-base font-semibold text-text-primary mb-1">Repositório Git</h3>
          <p class="text-sm text-text-secondary mb-6">Informe a URL de clone, credenciais e o arquivo compose.</p>
          <div class="space-y-5">
            <%= render "git_credential_fields", f: f, git_stack: @git_stack, git_credentials: @git_credentials %>
            <div class="relative">
              <label class="block text-sm font-medium text-text-secondary mb-1.5">Arquivo Compose</label>
              <div class="relative">
                <%= f.text_field :compose_file,
                      placeholder: "docker-compose.yml",
                      autocomplete: "off",
                      class: "w-full bg-surface-sunken border border-border-subtle rounded-lg pl-3 pr-9 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors",
                      data: { compose_file_target: "input", action: "input->compose-file#filter focus->compose-file#filter blur->compose-file#blur" } %>
                <span data-compose-file-target="indicator" class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center"></span>
              </div>
              <div data-compose-file-target="suggestions" class="hidden absolute z-10 mt-1 w-full bg-surface-raised border border-border-subtle rounded-lg shadow-lg overflow-hidden max-h-48 overflow-y-auto"></div>
              <p class="mt-1 text-xs text-text-muted">Caminho relativo à raiz do repositório. Preencha a URL e credenciais para ver os arquivos disponíveis.</p>
            </div>
          </div>
        </div>

        <%# YAML editor ── %>
        <div x-show="source === 'yaml'">
          <h3 class="text-base font-semibold text-text-primary mb-1">Editor YAML</h3>
          <p class="text-sm text-text-secondary mb-6">Cole ou escreva seu docker-compose.yml diretamente.</p>
          <div class="space-y-5">
            <%= f.text_area :yaml_content,
                  id: "yaml_content",
                  rows: 18,
                  placeholder: "version: '3.8'\nservices:\n  app:\n    image: nginx:latest\n    ports:\n      - \"80:80\"",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-3 text-sm text-green-700 dark:text-green-300 font-mono placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors resize-y" %>
            <p class="text-xs text-text-muted">Conteúdo completo do arquivo docker-compose.yml.</p>
          </div>
        </div>

        <%# ZIP upload ── %>
        <div x-show="source === 'zip'">
          <h3 class="text-base font-semibold text-text-primary mb-1">Upload de ZIP</h3>
          <p class="text-sm text-text-secondary mb-6">Envie um arquivo .zip contendo seu docker-compose.yml.</p>
          <div class="space-y-5">
            <div class="border-2 border-dashed border-border-subtle rounded-xl p-8 text-center hover:border-border-subtle transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-text-muted mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <p class="text-sm text-text-secondary mb-2">Arraste o arquivo ou clique para selecionar</p>
              <label class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 bg-surface-inset hover:bg-surface-active text-text-secondary text-sm rounded-lg border border-border-subtle transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                Selecionar ZIP
                <input type="file" id="zip_file" name="git_stack[zip_file]" accept=".zip" class="sr-only"
                       @change="$el.previousElementSibling.previousElementSibling.textContent = $el.files[0]?.name || 'Nenhum arquivo'">
              </label>
              <p class="text-xs text-text-muted mt-3">Formato .zip • Máximo 50 MB</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-text-secondary mb-1.5">Arquivo Compose dentro do ZIP</label>
              <%= f.text_field :compose_file,
                    placeholder: "docker-compose.yml",
                    class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ══════════════════════════════ STEP 3: DEPLOY SETTINGS ══════════════════════════════ %>
    <div x-show="step === 3" class="space-y-4">
      <div class="bg-surface-raised border border-border rounded-xl p-6">
        <h3 class="text-base font-semibold text-text-primary mb-1">Configurações de Deploy</h3>
        <p class="text-sm text-text-secondary mb-6">Defina nome, ambiente e modo de implantação.</p>

        <div class="space-y-5">
          <%# Name %>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1.5">Nome da Stack</label>
            <%= f.text_field :name,
                  placeholder: "ex: minha-app",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors" %>
          </div>

          <%# Environment %>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1.5">Ambiente</label>
            <%= f.select :environment_id,
                  @environments.map { |e| [e.name, e.id] },
                  { prompt: "— Selecione um ambiente —" },
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors" %>
          </div>

          <%# Deploy mode %>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1.5">Modo de Deploy</label>
            <div class="grid grid-cols-2 gap-3">
              <label class="cursor-pointer">
                <input type="radio" name="git_stack[deploy_mode]" value="swarm_stack" x-model="deployMode" class="sr-only">
                <div class="p-4 rounded-xl border-2 transition-all text-center"
                     :class="deployMode === 'swarm_stack' ? 'border-red-600 bg-red-950/20' : 'border-border-subtle hover:border-border-subtle bg-surface-inset/30'">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mx-auto mb-2 text-red-600 dark:text-red-400" viewBox="7 6 18 19"><path fill="currentColor" d="m22.505 11.637l-5.989-3.5a1 1 0 0 0-1.008-.001l-6.011 3.5A1 1 0 0 0 9 12.5v7a1 1 0 0 0 .497.864l6.011 3.5A.96.96 0 0 0 16 24c.174 0 .36-.045.516-.137l5.989-3.5A1 1 0 0 0 23 19.5v-7a1 1 0 0 0-.495-.863"/></svg>
                  <p class="text-sm font-medium text-text-primary">Swarm Stack</p>
                  <p class="text-xs text-text-secondary mt-0.5">Produção, alta disponibilidade</p>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="git_stack[deploy_mode]" value="compose" x-model="deployMode" class="sr-only">
                <div class="p-4 rounded-xl border-2 transition-all text-center"
                     :class="deployMode === 'compose' ? 'border-red-600 bg-red-950/20' : 'border-border-subtle hover:border-border-subtle bg-surface-inset/30'">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mx-auto mb-2 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
                  <p class="text-sm font-medium text-text-primary">Docker Compose</p>
                  <p class="text-xs text-text-secondary mt-0.5">Dev/staging, nó único</p>
                </div>
              </label>
            </div>
          </div>

          <%# Environment variables (.env) %>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1.5">Variáveis de Ambiente (.env)</label>
            <%= f.text_area :env_content,
                  rows: 6,
                  placeholder: "DATABASE_URL=postgres://user:pass@host:5432/db\nNEXTAUTH_SECRET=...",
                  class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 transition-colors" %>
            <p class="mt-1.5 text-xs text-text-muted">Uma variável por linha (formato KEY=VALUE). Escrito como .env ao lado do compose file antes do deploy.</p>
          </div>

          <%# Auto-update %>
          <div class="flex items-start gap-3 p-4 bg-surface-inset/30 rounded-xl border border-border-subtle">
            <%= f.check_box :auto_update,
                  { class: "mt-0.5 h-4 w-4 rounded border-border-subtle bg-surface-sunken text-red-600 focus:ring-red-600 focus:ring-offset-surface-sunken flex-shrink-0" },
                  true, false %>
            <div>
              <label for="git_stack_auto_update" class="text-sm font-medium text-text-primary cursor-pointer">Atualização automática</label>
              <p class="text-xs text-text-muted mt-0.5">Monitora o repositório e faz redeploy quando detectar mudanças.</p>
            </div>
          </div>

          <%# Webhook info %>
          <div class="rounded-lg bg-cyan-950/40 border border-cyan-800/40 px-4 py-3">
            <p class="text-xs text-cyan-600 dark:text-cyan-400 font-medium mb-1">Webhook CI/CD</p>
            <p class="text-xs text-text-secondary">
              Após criar a stack, um <strong class="text-text-primary">Webhook URL</strong> único será gerado.
              Configure-o no GitHub Actions, GitLab CI ou qualquer sistema CI/CD para acionar deploys automáticos.
            </p>
          </div>
        </div>
      </div>
    </div>

    <%# ══════════════════════════════ NAVIGATION ══════════════════════════════
        Anterior/Cancelar swap via x-show depending on step, same for
        Próximo/Criar Stack. Both pairs share one fixed width so they sit
        evenly side by side below the form without stretching full-width. %>
    <div class="flex items-center justify-center gap-3 pt-2">
      <button type="button" @click="back()" x-show="step > 1"
              class="inline-flex items-center justify-center gap-2 w-36 px-4 py-2 bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary text-sm font-medium rounded-lg transition-colors border border-border-subtle">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Anterior
      </button>
      <%= link_to "Cancelar", git_stacks_path, x_show: "step === 1",
            class: "inline-flex items-center justify-center w-36 px-4 py-2 bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary text-sm font-medium rounded-lg transition-colors border border-border-subtle" %>

      <button type="button" @click="next()" x-show="step < 3"
              :disabled="!canNext()"
              class="inline-flex items-center justify-center gap-2 w-36 px-5 py-2 bg-red-600 hover:bg-red-500 disabled:bg-surface-active disabled:text-text-muted text-text-primary text-sm font-medium rounded-lg transition-colors">
        Próximo
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
      <button type="submit" form="wizard-form" x-show="step === 3"
              class="inline-flex items-center justify-center gap-2 w-36 px-5 py-2 bg-red-600 hover:bg-red-500 text-text-primary text-sm font-medium rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Criar Stack
      </button>
    </div>
  <% end %>
</div>
