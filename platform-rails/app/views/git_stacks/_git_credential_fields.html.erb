<%# Locals: f (form builder), git_stack, git_credentials %>
<div class="space-y-5"
     x-data="{ credMode: '<%= git_stack.git_credential_id.present? ? "saved" : (git_stack.username.present? ? "inline" : "saved") %>', saveCred: false }">
  <div>
    <%= f.label :repo_url, "URL do repositório (clone)", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
    <%= f.text_field :repo_url,
          placeholder: "https://github.com/org/repo.git",
          class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors",
          data: { compose_file_target: "repoUrl", action: "input->compose-file#scheduleLoad" } %>
  </div>

  <div>
    <%= f.label :branch, "Branch", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
    <%= f.text_field :branch,
          placeholder: "main",
          value: git_stack.branch.presence || "main",
          class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors",
          data: { compose_file_target: "branch", action: "input->compose-file#scheduleLoad" } %>
  </div>

  <div>
    <label class="block text-sm font-medium text-text-secondary mb-1.5">Credenciais de acesso</label>
    <div class="grid grid-cols-3 gap-2 mb-3">
      <button type="button" @click="credMode = 'saved'"
              class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors"
              :class="credMode === 'saved' ? 'border-brand bg-orange-100 dark:bg-brand/12 text-text-primary' : 'border-border-subtle text-text-secondary hover:border-border-subtle'">
        Credencial salva
      </button>
      <button type="button" @click="credMode = 'inline'"
              class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors"
              :class="credMode === 'inline' ? 'border-brand bg-orange-100 dark:bg-brand/12 text-text-primary' : 'border-border-subtle text-text-secondary hover:border-border-subtle'">
        Preencher agora
      </button>
      <button type="button" @click="credMode = 'none'"
              class="px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors"
              :class="credMode === 'none' ? 'border-brand bg-orange-100 dark:bg-brand/12 text-text-primary' : 'border-border-subtle text-text-secondary hover:border-border-subtle'">
        Repositório público
      </button>
    </div>

    <div x-show="credMode === 'saved'">
      <%= f.select :git_credential_id,
            git_credentials.map { |c| ["#{c.name} (#{c.site})", c.id] },
            { include_blank: "— Selecione uma credencial —" },
            class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors",
            data: { compose_file_target: "credentialSelect", action: "change->compose-file#scheduleLoad" } %>
      <% if git_credentials.empty? %>
        <p class="mt-1.5 text-xs text-yellow-500">Nenhuma credencial salva ainda — use "Preencher agora".</p>
      <% end %>
      <p class="mt-1.5 text-xs text-text-muted">
        <%= link_to "Gerenciar credenciais salvas", git_credentials_path, target: "_blank", class: "underline hover:text-text-secondary" %>
      </p>
    </div>

    <div x-show="credMode === 'inline'" class="space-y-3">
      <%= f.text_field :username,
            placeholder: "usuário / e-mail",
            class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors",
            data: { compose_file_target: "username", action: "input->compose-file#scheduleLoad" } %>
      <%= f.password_field :token_ciphertext,
            placeholder: "token / senha de acesso",
            value: git_stack.token_ciphertext,
            class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors",
            data: { compose_file_target: "token", action: "input->compose-file#scheduleLoad" } %>
      <label class="flex items-center gap-2 text-sm text-text-secondary cursor-pointer">
        <input type="checkbox" name="git_stack[save_credential]" value="1" x-model="saveCred"
               class="h-4 w-4 rounded border-border-subtle bg-surface-sunken text-brand focus:ring-brand focus:ring-offset-surface-sunken">
        Salvar credenciais para deploy futuro
      </label>
      <div x-show="saveCred">
        <%= f.text_field :new_credential_name,
              placeholder: "Nome da credencial (ex: GitLab Redhusky)",
              class: "w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-colors" %>
      </div>
    </div>

    <p x-show="credMode === 'none'" class="text-xs text-text-muted">Sem credenciais — funciona apenas para repositórios públicos.</p>
  </div>
</div>
