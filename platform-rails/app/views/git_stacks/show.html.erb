<% page_title @git_stack.name %>

<% content_for :title_actions do %>
  <%= button_to "Deploy Now", deploy_git_stack_path(@git_stack), method: :post,
        class: "inline-flex items-center gap-2 bg-cyan-700 hover:bg-cyan-600 text-text-primary text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
  <% if @git_stack.fleet? %>
    <%= button_to "Deploy em Frota (#{@git_stack.target_group.name})", deploy_fleet_git_stack_path(@git_stack), method: :post,
          data: { turbo_confirm: "Deployar \"#{@git_stack.name}\" em todos os environments do grupo \"#{@git_stack.target_group.name}\"?" },
          class: "inline-flex items-center gap-2 bg-amber-700 hover:bg-amber-600 text-text-primary text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
  <% end %>
  <%= link_to "Edit", edit_git_stack_path(@git_stack),
        class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
<% end %>

<%# Status badge %>
<% status_class = case @git_stack.status
  when "idle"      then "bg-surface-inset text-text-secondary"
  when "deploying" then "bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 border border-blue-300 dark:border-blue-800/60 animate-pulse"
  when "deployed"  then "bg-green-100 dark:bg-green-900/40 text-green-600 dark:text-green-400 border border-green-300 dark:border-green-800/60"
  when "failed"    then "bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 border border-red-300 dark:border-red-800/60"
  else                  "bg-surface-inset text-text-secondary"
  end %>

<%# Auto-refreshes (via Turbo Frame) while a deploy is in progress, so the
    status badge and Deploy Output panel below pick up the background
    job's result without the user having to hit F5. Once the response
    comes back with a non-"deploying" status, this data-controller
    attribute is gone from the replacement frame and polling stops. %>
<%= turbo_frame_tag "git-stack-status",
      src: git_stack_path(@git_stack),
      data: (@git_stack.status == "deploying" ? { controller: "metrics-refresh", "metrics-refresh-interval-value": 3000 } : {}) do %>

<div class="flex items-center gap-3 mb-6 flex-wrap">
  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= status_class %>">
    <%= @git_stack.status %>
  </span>
  <%= sync_status_badge(@git_stack) %>
  <%= health_badge(@git_stack) %>
  <% if @git_stack.last_deployed_at %>
    <span class="text-sm text-text-muted">Last deployed <%= human_age(@git_stack.last_deployed_at) %></span>
  <% end %>
</div>

<%# ── Reconcile / drift panel (Argo-style) ── %>
<div class="bg-surface-raised border border-border rounded-xl p-5 mb-6">
  <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
    <div>
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Reconcile</h2>
      <% if @git_stack.last_drift_at %>
        <p class="text-xs text-text-muted mt-1">Verificado <%= human_age(@git_stack.last_drift_at) %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to "Verificar Drift", refresh_drift_git_stack_path(@git_stack), method: :post,
            class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary text-sm font-medium px-3 py-1.5 rounded-lg transition-colors" %>
      <% if @git_stack.out_of_sync? %>
        <%= button_to "Sync", sync_git_stack_path(@git_stack), method: :post,
              data: { turbo_confirm: "Aplicar estado do Git e reconciliar \"#{@git_stack.name}\"?" },
              class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium px-3 py-1.5 rounded-lg transition-colors" %>
      <% end %>
    </div>
  </div>

  <% drift_services = @git_stack.drift["services"] %>
  <% if @git_stack.drift["error"].present? %>
    <p class="text-sm text-red-600 dark:text-red-400 font-mono">Erro ao verificar: <%= @git_stack.drift["error"] %></p>
  <% elsif @git_stack.sync_status == "unknown" %>
    <p class="text-sm text-text-muted">Sem verificação ainda. Clique em “Verificar Drift”.</p>
  <% elsif drift_services.blank? %>
    <p class="text-sm text-green-600 dark:text-green-400">Em sincronia com o Git — nenhuma divergência.</p>
  <% else %>
    <div class="space-y-3">
      <% drift_services.each do |entry| %>
        <div class="border border-border-subtle rounded-lg overflow-hidden">
          <div class="flex items-center justify-between gap-2 px-3 py-2 bg-surface-inset">
            <span class="text-sm font-mono text-text-primary"><%= entry["service"] %></span>
            <span class="text-xs text-amber-600 dark:text-amber-400"><%= drift_state_label(entry) %></span>
          </div>
          <% if entry["fields"].present? %>
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-text-muted text-left">
                  <th class="px-3 py-1.5 font-medium">Campo</th>
                  <th class="px-3 py-1.5 font-medium">Desejado (Git)</th>
                  <th class="px-3 py-1.5 font-medium">Live (Swarm)</th>
                </tr>
              </thead>
              <tbody>
                <% entry["fields"].each do |field, vals| %>
                  <tr class="border-t border-border-subtle align-top">
                    <td class="px-3 py-1.5 text-text-secondary"><%= field %></td>
                    <td class="px-3 py-1.5 text-green-600 dark:text-green-400 break-all"><%= vals["desired"].inspect %></td>
                    <td class="px-3 py-1.5 text-red-600 dark:text-red-400 break-all"><%= vals["live"].inspect %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%# ── Revision history + rollback ── %>
<% if @git_stack.revisions.any? %>
  <div class="bg-surface-raised border border-border rounded-xl p-5 mb-6">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Histórico de Revisões</h2>
    <div class="space-y-2">
      <% @git_stack.revisions.limit(10).each_with_index do |rev, i| %>
        <div class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg bg-surface-inset/50 border border-border-subtle">
          <div class="flex items-center gap-3 min-w-0">
            <span class="font-mono text-sm text-text-primary"><%= rev.short_sha.presence || "—" %></span>
            <span class="text-xs px-2 py-0.5 rounded-full <%= rev.result == 'success' ? 'text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-900/40' : 'text-red-600 dark:text-red-400 bg-red-100 dark:bg-red-900/40' %>"><%= rev.result %></span>
            <% if rev.deployed_at %><span class="text-xs text-text-muted truncate"><%= human_age(rev.deployed_at) %></span><% end %>
            <% if i.zero? %><span class="text-[10px] uppercase tracking-widest text-cyan-600 dark:text-cyan-400">atual</span><% end %>
          </div>
          <% if i.positive? && rev.result == "success" && rev.sha.present? %>
            <%= button_to "Rollback", rollback_git_stack_path(@git_stack, sha: rev.sha), method: :post,
                  data: { turbo_confirm: "Rollback para #{rev.short_sha}? Isso reimplanta a versão anterior." },
                  class: "flex-shrink-0 text-xs text-text-secondary hover:text-text-primary px-2.5 py-1 rounded-lg bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <%# Left column: details %>
  <div class="space-y-4">

    <div class="bg-surface-raised border border-border rounded-xl p-5">
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Stack Details</h2>
      <dl class="space-y-3">
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Repositório</dt>
          <dd class="text-sm text-text-primary text-right font-medium font-mono break-all"><%= @git_stack.repo_url %></dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Branch</dt>
          <dd class="text-sm text-text-secondary font-mono text-right"><%= @git_stack.branch %></dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Credencial</dt>
          <dd class="text-sm text-text-primary text-right font-medium">
            <%= @git_stack.git_credential&.name || "— (público / inline)" %>
          </dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Environment</dt>
          <dd class="text-sm text-text-primary text-right"><%= @git_stack.environment.name %></dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Compose File</dt>
          <dd class="text-sm text-text-secondary font-mono text-right"><%= @git_stack.compose_file %></dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Deploy Mode</dt>
          <dd class="text-sm text-text-secondary font-mono text-right"><%= @git_stack.deploy_mode %></dd>
        </div>
        <div class="flex items-start justify-between gap-4">
          <dt class="text-sm text-text-muted flex-shrink-0">Auto-update</dt>
          <dd class="text-sm text-right">
            <% if @git_stack.auto_update? %>
              <span class="text-green-600 dark:text-green-400">Enabled</span>
              <span class="text-text-muted text-xs ml-1">(every <%= @git_stack.poll_interval %>s)</span>
            <% else %>
              <span class="text-text-muted">Disabled</span>
            <% end %>
          </dd>
        </div>
        <% if @git_stack.last_commit_sha.present? %>
          <div class="flex items-start justify-between gap-4">
            <dt class="text-sm text-text-muted flex-shrink-0">Last Commit</dt>
            <dd class="text-sm text-text-secondary font-mono text-right"><%= @git_stack.last_commit_sha.first(12) %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <%# Webhook URL + CI/CD %>
    <div class="bg-surface-raised border border-border rounded-xl p-5" x-data="{ tab: 'github' }">
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3">Webhook CI/CD</h2>
      <p class="text-xs text-text-muted mb-3">POST para esta URL para disparar deploy automático (token no próprio endpoint, sem auth adicional).</p>
      <div class="flex items-center gap-2 mb-4">
        <code id="webhook-url" class="flex-1 text-xs font-mono bg-surface-sunken border border-border rounded-lg px-3 py-2 text-cyan-600 dark:text-cyan-400 break-all">
          <%= @git_stack.webhook_url(request.base_url) %>
        </code>
        <button
          onclick="navigator.clipboard.writeText(document.getElementById('webhook-url').textContent.trim()); this.textContent = 'Copiado!'; setTimeout(() => this.textContent = 'Copiar', 2000)"
          class="flex-shrink-0 text-xs text-text-secondary hover:text-text-primary px-3 py-2 rounded-lg bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors"
        >Copiar</button>
      </div>

      <%# CI snippets %>
      <div class="space-y-2">
        <div class="flex gap-1 border-b border-border mb-3">
          <% [["github", "GitHub Actions"], ["gitlab", "GitLab CI"], ["curl", "cURL"]].each do |key, label| %>
            <button @click="tab = '<%= key %>'"
                    class="px-3 py-1.5 text-xs font-medium rounded-t transition-colors"
                    :class="tab === '<%= key %>' ? 'bg-surface-inset text-text-primary' : 'text-text-muted hover:text-text-secondary'">
              <%= label %>
            </button>
          <% end %>
        </div>

        <div x-show="tab === 'github'">
          <pre class="text-[10px] font-mono bg-surface-sunken border border-border rounded-lg p-3 text-text-secondary overflow-x-auto whitespace-pre"><%= <<~YAML
# .github/workflows/deploy.yml
on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger RedHusky deploy
        run: |
          curl -X POST #{@git_stack.webhook_url(request.base_url)}
YAML
          %></pre>
        </div>

        <div x-show="tab === 'gitlab'" style="display:none">
          <pre class="text-[10px] font-mono bg-surface-sunken border border-border rounded-lg p-3 text-text-secondary overflow-x-auto whitespace-pre"><%= <<~YAML
# .gitlab-ci.yml
deploy:
  stage: deploy
  only:
    - main
  script:
    - curl -X POST #{@git_stack.webhook_url(request.base_url)}
YAML
          %></pre>
        </div>

        <div x-show="tab === 'curl'" style="display:none">
          <pre class="text-[10px] font-mono bg-surface-sunken border border-border rounded-lg p-3 text-text-secondary overflow-x-auto whitespace-pre">curl -X POST <%= @git_stack.webhook_url(request.base_url) %></pre>
        </div>
      </div>
    </div>

  </div>

  <%# Right column: deploy output %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Deploy Output</h2>
    <pre data-controller="autoscroll" class="text-xs font-mono text-text-secondary bg-surface-sunken border border-border rounded-lg p-4 overflow-x-auto whitespace-pre-wrap break-words min-h-[200px] max-h-[500px] overflow-y-auto"><%= @git_stack.last_deploy_output.presence || "No deploys yet." %></pre>
  </div>

</div>
<% end %>
