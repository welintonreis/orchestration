<% page_title "Segurança" %>
<% page_subtitle "Monitoria de exposição da VPS — portas públicas e serviços alcançáveis pela internet" %>
<%= stylesheet_link_tag "jsvectormap" %>

<% content_for :page_icon do %>
  <%= sidebar_icon(:auth_shield, css_class: "w-7 h-7").html_safe %>
<% end %>

<%# A full /proc scan plus two Docker socket calls — everything below the
    header is lazy so the page never sits blank waiting on the audit. %>
<turbo-frame id="security-content" refresh="morph" src="<%= rows_security_path %>">
  <%= render Ui::SkeletonComponent.new(:stats, count: 4,
        grid: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6") %>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-16", "w-12", "w-10", "w-28", "w-24", "w-32", "w-28", "w-40" ],
        rows: 10) %>
</turbo-frame>
