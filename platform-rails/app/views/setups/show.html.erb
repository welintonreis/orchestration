<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Setup — Redhusk Orchestration</title>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="h-full bg-gray-950 text-white flex items-center justify-center px-4">

  <div class="w-full max-w-md">
    <!-- Logo / Brand -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-red-600 mb-4">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Initial Setup</h1>
      <p class="mt-1 text-sm text-gray-400">Create your administrator account to get started</p>
    </div>

    <!-- Card -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl px-8 py-8 shadow-xl">

      <% if @user.errors.any? %>
        <div class="mb-6 rounded-lg bg-red-900/40 border border-red-700 px-4 py-3 text-sm text-red-300">
          <ul class="list-disc list-inside space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: setup_path, method: :post, class: "space-y-5" do |f| %>

        <div>
          <%= label_tag :email_address, "Email address", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= email_field_tag :email_address,
                params[:email_address],
                required: true,
                autofocus: true,
                autocomplete: "email",
                placeholder: "admin@example.com",
                class: "block w-full rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" %>
        </div>

        <div>
          <%= label_tag :password, "Password", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= password_field_tag :password,
                nil,
                required: true,
                autocomplete: "new-password",
                placeholder: "Min 12 characters recommended",
                maxlength: 72,
                class: "block w-full rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" %>
        </div>

        <div>
          <%= label_tag :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= password_field_tag :password_confirmation,
                nil,
                required: true,
                autocomplete: "new-password",
                placeholder: "Repeat your password",
                maxlength: 72,
                class: "block w-full rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" %>
        </div>

        <div class="pt-2">
          <%= submit_tag "Create account & continue",
                class: "w-full rounded-lg bg-red-600 hover:bg-red-500 active:bg-red-700 text-white font-semibold text-sm px-4 py-2.5 transition cursor-pointer" %>
        </div>

      <% end %>
    </div>

    <!-- Footer note -->
    <p class="text-center text-xs text-gray-600 mt-6">
      A local Docker environment will be configured automatically.
    </p>
  </div>

</body>
</html>
