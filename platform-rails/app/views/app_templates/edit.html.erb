<% page_title "Editar #{@app_template.name}" %>

<div class="mb-4">
  <%= link_to app_template_path(@app_template), class: "flex items-center gap-1 text-xs text-text-muted hover:text-text-secondary" do %>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <%= @app_template.name %>
  <% end %>
</div>

<div class="bg-surface-raised border border-border rounded-xl p-5 max-w-2xl">
  <%= render "form", app_template: @app_template, url: app_template_path(@app_template) %>
</div>
