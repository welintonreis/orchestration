<%#
  Locals:
    label     — short label (e.g. "CPU", "RAM")
    value     — Float percentage 0-100
    sparkline — optional HTML-safe SVG string from sparkline_svg helper
%>
<% pct = value.to_f.clamp(0, 100) %>
<% bar_color = pct >= 80 ? "bg-red-400" : pct >= 60 ? "bg-yellow-400" : "bg-green-400" %>
<div class="space-y-1">
  <div class="flex items-center gap-3">
    <span class="text-sm text-text-secondary w-12 flex-shrink-0 flex items-center gap-1">
      <% if local_assigns[:icon].present? %><%= icon %><% else %><%= label %><% end %>
    </span>
    <div class="flex-1 bg-surface-inset rounded-full h-2">
      <div class="h-2 rounded-full <%= bar_color %> transition-all duration-500" style="width: <%= pct %>%"></div>
    </div>
    <span class="text-sm font-mono w-14 text-right <%= percent_color(pct) %>">
      <%= pct.round(1) %>%
    </span>
  </div>
  <% if local_assigns[:sparkline].present? %>
    <div class="pl-12 pr-14 opacity-60">
      <%= sparkline %>
    </div>
  <% end %>
</div>
