<%#
  Locals:
    count       — main number (Integer or String)
    label       — card title (String)
    sub         — sub-text line (String, optional)
    link_path   — href for the card wrapper (String, optional)
    inactive    — if true, render dimmed "Swarm inactive" style (Boolean, optional)
%>
<% inactive ||= false %>
<% card_classes = inactive ? "bg-gray-900/50 border border-gray-800/50 rounded-xl p-5 opacity-60" : "bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-700 transition-colors" %>

<% if local_assigns[:link_path] && !inactive %>
  <%= link_to link_path, class: "block #{card_classes}" do %>
    <div class="text-3xl font-bold text-white"><%= count %></div>
    <div class="text-sm text-gray-400 mt-1"><%= label %></div>
    <% if local_assigns[:sub] %>
      <div class="text-xs text-gray-500 mt-2"><%= sub %></div>
    <% end %>
  <% end %>
<% else %>
  <div class="<%= card_classes %>">
    <div class="text-3xl font-bold <%= inactive ? 'text-gray-600' : 'text-white' %>">
      <%= inactive ? "—" : count %>
    </div>
    <div class="text-sm <%= inactive ? 'text-gray-600' : 'text-gray-400' %> mt-1"><%= label %></div>
    <% if local_assigns[:sub] %>
      <div class="text-xs <%= inactive ? 'text-gray-700' : 'text-gray-500' %> mt-2"><%= sub %></div>
    <% end %>
  </div>
<% end %>
