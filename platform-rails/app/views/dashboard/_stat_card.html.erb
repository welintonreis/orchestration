<%#
  Locals:
    count       — main number (Integer or String)
    label       — card title (String)
    sub         — sub-text line (String, optional)
    link_path   — href for the card wrapper (String, optional)
    inactive    — if true, render dimmed "Swarm inactive" style (Boolean, optional)
    icon        — symbol key in SIDEBAR_ICONS hash (optional)
%>
<% inactive ||= false %>
<% card_classes = inactive ? "bg-surface-raised/50 border border-border/50 rounded-xl p-5 opacity-60" : "bg-surface-raised border border-border rounded-xl p-5 hover:border-border-subtle transition-colors" %>
<% icon_html = local_assigns[:icon] ? sidebar_icon(icon, css_class: "w-5 h-5 #{inactive ? 'text-text-muted' : 'text-text-muted'}") : nil %>

<% if local_assigns[:link_path] && !inactive %>
  <%= link_to link_path, class: "block #{card_classes}" do %>
    <div class="flex items-start justify-between">
      <div class="text-3xl font-bold text-text-primary"><%= count %></div>
      <% if icon_html %><span class="flex-shrink-0"><%= icon_html %></span><% end %>
    </div>
    <div class="text-sm text-text-secondary mt-1"><%= label %></div>
    <% if local_assigns[:sub] %>
      <div class="text-xs text-text-muted mt-2"><%= sub %></div>
    <% end %>
  <% end %>
<% else %>
  <div class="<%= card_classes %>">
    <div class="flex items-start justify-between">
      <div class="text-3xl font-bold <%= inactive ? 'text-text-muted' : 'text-text-primary' %>">
        <%= inactive ? "—" : count %>
      </div>
      <% if icon_html %><span class="flex-shrink-0"><%= icon_html %></span><% end %>
    </div>
    <div class="text-sm <%= inactive ? 'text-text-muted' : 'text-text-secondary' %> mt-1"><%= label %></div>
    <% if local_assigns[:sub] %>
      <div class="text-xs <%= inactive ? 'text-text-muted' : 'text-text-muted' %> mt-2"><%= sub %></div>
    <% end %>
  </div>
<% end %>
