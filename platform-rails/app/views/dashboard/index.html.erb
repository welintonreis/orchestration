<% page_title "Dashboard" %>
<% page_subtitle "Visão geral do ambiente Docker — métricas, alertas e status dos serviços" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none" />
    <path fill="currentColor" d="M9 8.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M6 13a1 1 0 1 0 0-2a1 1 0 0 0 0 2m12 0a1 1 0 1 0 0-2a1 1 0 0 0 0 2m-2-3.5a1 1 0 1 0 0-2a1 1 0 0 0 0 2" opacity=".5" />
    <path fill="currentColor" d="m15.943 10.498l-4.055 4.505A2 2 0 0 0 10 17h4a2 2 0 0 0-.603-1.431l3.66-4.067a.75.75 0 1 0-1.114-1.004M5 15.25a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5zm14.75.75a.75.75 0 0 0-.75-.75h-1.5a.75.75 0 0 0 0 1.5H19a.75.75 0 0 0 .75-.75m-7-10a.75.75 0 0 0-1.5 0v1.5a.75.75 0 0 0 1.5 0z" />
    <path fill="currentColor" d="M12 3.25C6.063 3.25 1.25 8.063 1.25 14c0 1.498.307 2.927.862 4.224l.005.012c.215.502.363.848.817 1.332c.183.195.439.39.677.548c.238.157.519.315.77.407c.624.227 1.168.227 1.937.227h11.364c.769 0 1.313 0 1.937-.227c.252-.092.532-.25.77-.407s.494-.353.677-.548c.454-.484.603-.83.817-1.332l.005-.012c.555-1.297.862-2.726.862-4.224c0-5.937-4.813-10.75-10.75-10.75M2.75 14a9.25 9.25 0 0 1 18.5 0c0 1.292-.264 2.52-.741 3.634c-.204.477-.267.62-.536.907c-.071.075-.22.197-.41.323c-.19.125-.36.214-.458.25c-.352.128-.632.136-1.502.136H6.397c-.87 0-1.15-.008-1.502-.136a2.6 2.6 0 0 1-.458-.25a2.6 2.6 0 0 1-.41-.323c-.269-.287-.332-.43-.536-.907A9.2 9.2 0 0 1 2.75 14" />
  </svg>
<% end %>

<%# ── Derived counts ── %>
<% running_count  = @containers.count { |c| c["State"] == "running" } %>
<% paused_count   = @containers.count { |c| c["State"] == "paused" } %>
<% stopped_count  = @containers.count { |c| c["State"] == "exited" } %>

<%# ══════════════════════════════════════════════════════════ %>
<%# Row 1 — Stat cards                                        %>
<%# ══════════════════════════════════════════════════════════ %>
<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">

  <%# Containers %>
  <%= render "dashboard/stat_card",
        count:     @containers.size,
        label:     "Containers",
        sub:       "#{running_count} running · #{stopped_count} stopped",
        link_path: containers_path,
        icon:      :containers %>

  <%# Images %>
  <%= render "dashboard/stat_card",
        count:     @images.size,
        label:     "Images",
        link_path: images_path,
        icon:      :images %>

  <%# Volumes %>
  <%= render "dashboard/stat_card",
        count:     @volumes.size,
        label:     "Volumes",
        link_path: volumes_path,
        icon:      :volumes %>

  <%# Networks %>
  <%= render "dashboard/stat_card",
        count:     @networks.size,
        label:     "Networks",
        link_path: networks_path,
        icon:      :networks %>

  <%# Services — only meaningful when Swarm is active %>
  <% if @swarm_active %>
    <%= render "dashboard/stat_card",
          count:     @services.size,
          label:     "Services",
          sub:       "Swarm active",
          link_path: swarm_path,
          icon:      :services %>
  <% else %>
    <%= render "dashboard/stat_card",
          count:     0,
          label:     "Services",
          sub:       "Swarm inactive",
          inactive:  true,
          icon:      :services %>
  <% end %>

  <%# Nodes — only meaningful when Swarm is active %>
  <% if @swarm_active %>
    <%= render "dashboard/stat_card",
          count:     @nodes.size,
          label:     "Nodes",
          link_path: swarm_path,
          icon:      :nodes %>
  <% else %>
    <%= render "dashboard/stat_card",
          count:     0,
          label:     "Nodes",
          sub:       "Swarm inactive",
          inactive:  true,
          icon:      :nodes %>
  <% end %>

</div>

<%# ══════════════════════════════════════════════════════════ %>
<%# Row 2 — Docker Info + Host Metrics                        %>
<%# ══════════════════════════════════════════════════════════ %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

  <%# Docker Info card %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-4">Docker Info</h2>
    <dl class="space-y-3">

      <div class="flex items-center justify-between">
        <dt class="text-sm text-text-muted">Version</dt>
        <dd class="text-sm font-mono text-text-primary"><%= @docker_info["ServerVersion"] || "—" %></dd>
      </div>

      <div class="flex items-center justify-between">
        <dt class="text-sm text-text-muted">OS</dt>
        <dd class="text-sm text-text-primary truncate max-w-[60%] text-right"><%= @docker_info["OperatingSystem"] || "—" %></dd>
      </div>

      <div class="flex items-center justify-between">
        <dt class="text-sm text-text-muted">Architecture</dt>
        <dd class="text-sm font-mono text-text-primary"><%= @docker_info["Architecture"] || "—" %></dd>
      </div>

      <div class="flex items-center justify-between">
        <dt class="text-sm text-text-muted">Swarm</dt>
        <dd>
          <% if @swarm_active %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-cyan-900/60 text-cyan-300 border border-cyan-800/60">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 inline-block"></span>
              Active
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-surface-inset text-text-secondary border border-border-subtle">
              <span class="w-1.5 h-1.5 rounded-full bg-gray-500 inline-block"></span>
              Inactive
            </span>
          <% end %>
        </dd>
      </div>

      <div class="border-t border-border pt-3 grid grid-cols-2 gap-3">
        <div>
          <div class="text-xs text-text-muted mb-1">CPUs</div>
          <div class="text-lg font-bold text-text-primary"><%= @docker_info["NCPU"] || "—" %></div>
        </div>
        <div>
          <div class="text-xs text-text-muted mb-1">Memory</div>
          <div class="text-lg font-bold text-text-primary"><%= human_bytes(@docker_info["MemTotal"].to_i) %></div>
        </div>
      </div>

      <div class="border-t border-border pt-3">
        <div class="text-xs text-text-muted mb-2">Containers</div>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-400 inline-block"></span>
            <span class="text-sm text-text-secondary"><%= @docker_info["ContainersRunning"] || running_count %> running</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-yellow-400 inline-block"></span>
            <span class="text-sm text-text-secondary"><%= @docker_info["ContainersPaused"] || paused_count %> paused</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-gray-500 inline-block"></span>
            <span class="text-sm text-text-secondary"><%= @docker_info["ContainersStopped"] || stopped_count %> stopped</span>
          </div>
        </div>
      </div>

      <%# ── Resource donut gauges — live via HostStatsChannel ── %>
      <% donut_r = 16 %>
      <% donut_c = (2 * Math::PI * donut_r).round(3) %>
      <%
        gauges = [
          { key: "cpu",  label: "CPU",  color: "#39FF14", value: @latest_metric&.cpu_percent  },
          { key: "ram",  label: "RAM",  color: "#22d3ee", value: @latest_metric&.ram_percent  },
          { key: "disk", label: "Disk", color: "#e8f4f8", value: @latest_metric&.disk_percent },
          { key: "swap", label: "Swap", color: "#f97316", value: @latest_metric&.swap_percent },
        ]
      %>

      <div class="border-t border-border pt-3"
           data-controller="host-stats"
           data-host-stats-circumference-value="<%= donut_c %>">

        <div class="grid grid-cols-4 gap-2">
          <% gauges.each do |g| %>
            <% pct = g[:value] ? [[g[:value], 0].max, 100].min : 0 %>
            <% offset = (donut_c * (1 - pct / 100.0)).round(3) %>
            <div class="flex flex-col items-center">
              <div class="relative w-16 h-16">
                <svg viewBox="0 0 40 40" class="w-16 h-16 -rotate-90">
                  <circle cx="20" cy="20" r="<%= donut_r %>" fill="none" stroke="#1f2937" stroke-width="4"></circle>
                  <circle cx="20" cy="20" r="<%= donut_r %>" fill="none" stroke="<%= g[:color] %>" stroke-width="4"
                          stroke-linecap="round"
                          stroke-dasharray="<%= donut_c %>"
                          stroke-dashoffset="<%= g[:value] ? offset : donut_c %>"
                          data-host-stats-target="<%= g[:key] %>Circle"></circle>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-[11px] font-mono font-semibold" style="color:<%= g[:color] %>"
                        data-host-stats-target="<%= g[:key] %>Pct"><%= g[:value] ? ("%.0f" % g[:value]) : "—" %>%</span>
                </div>
              </div>
              <span class="text-xs text-text-muted mt-1"><%= g[:label] %></span>
            </div>
          <% end %>
        </div>

      </div>

      <%# ── Uptime / Last reboot ── %>
      <div class="border-t border-border pt-3 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-muted">Último Boot</span>
          <span class="text-xs font-mono text-text-secondary"><%= @last_boot_at.strftime("%d/%m/%Y %H:%M") %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-muted">Uptime</span>
          <% ud = @uptime_secs / 86400; uh = (@uptime_secs % 86400) / 3600; um = (@uptime_secs % 3600) / 60 %>
          <span class="text-xs font-mono font-bold text-text-primary tracking-wider">
            <%= "%02dD %02dH %02dMIN" % [ud, uh, um] %>
          </span>
        </div>
      </div>

    </dl>
  </div>

  <%# Top Processes card — auto-refreshes via Turbo Frame every 10s %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3">Top Processes</h2>
    <%= turbo_frame_tag "top-processes",
          src: metrics_processes_path,
          data: { controller: "metrics-refresh", "metrics-refresh-interval-value": 10000 } do %>
      <div class="flex items-center justify-center h-40 text-sm text-text-muted">Carregando...</div>
    <% end %>
  </div>

</div>

<%# ══════════════════════════════════════════════════════════ %>
<%# Row 3 — Recent Alerts (only if there are unread alerts)   %>
<%# ══════════════════════════════════════════════════════════ %>
<% if @unread_alerts.any? %>
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">
        Recent Alerts
        <span class="ml-2 inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-900/60 text-red-300 text-xs font-bold border border-red-800/60">
          <%= @unread_count > 99 ? "99+" : @unread_count %>
        </span>
      </h2>
      <%= link_to "View all", alerts_path, class: "text-xs text-cyan-400 hover:text-cyan-300 transition-colors" %>
    </div>

    <div class="divide-y divide-border">
      <% @unread_alerts.each do |alert| %>
        <div class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">

          <%# Level badge %>
          <% badge_classes = case alert.level
             when "critical" then "bg-red-900/60 text-red-300 border-red-800/60"
             when "warning"  then "bg-yellow-900/60 text-yellow-300 border-yellow-800/60"
             else                 "bg-blue-900/60 text-blue-300 border-blue-800/60"
             end %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border flex-shrink-0 mt-0.5 <%= badge_classes %>">
            <%= alert.level %>
          </span>

          <%# Resource + message %>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2">
              <span class="text-xs font-mono text-text-muted flex-shrink-0"><%= alert.resource %></span>
            </div>
            <p class="text-sm text-text-secondary truncate"><%= alert.message %></p>
          </div>

          <%# Time ago %>
          <span class="text-xs text-text-muted flex-shrink-0 whitespace-nowrap"><%= human_age(alert.created_at) %></span>

        </div>
      <% end %>
    </div>
  </div>
<% end %>
