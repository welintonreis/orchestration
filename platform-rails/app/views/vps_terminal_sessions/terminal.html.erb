<% page_title "Shell — #{@host.name}" %>
<% content_for :main_class, "overflow-hidden" %>
<meta name="turbo-cache-control" content="no-cache">

<div class="flex flex-col rounded-xl overflow-hidden border border-border bg-[#0d1117]" style="height: calc(100vh - 128px)">
  <div class="flex items-center gap-3 px-3 py-2 bg-surface-raised/90 border-b border-border shrink-0 flex-wrap gap-y-2">
    <%= render Ui::ButtonComponent.new(url: vps_hosts_path, variant: :gray, size: :sm) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7-7 7 7 7"/>
      </svg>
      Voltar
    <% end %>
    <span class="w-px h-4 bg-surface-active shrink-0"></span>
    <%= action_icon(:terminal, css_class: "w-4 h-4 text-green-500 shrink-0") %>
    <span class="text-xs font-mono text-text-secondary"><%= @host.username %>@<%= @host.hostname %></span>
    <span class="flex-1"></span>
    <%= link_to vps_host_files_path(@host), class: "px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors" do %>
      Arquivos
    <% end %>
  </div>

  <div data-controller="vps-terminal"
       data-vps-terminal-session-token-value="<%= @session.token %>"
       data-vps-terminal-session-id-value="<%= @session.id %>"
       data-vps-terminal-host-id-value="<%= @host.id %>"
       class="flex-1 min-h-0 flex flex-col">
    <span data-vps-terminal-target="status" class="flex items-center gap-1.5 px-3 py-1 text-[10px] text-text-muted uppercase tracking-widest shrink-0 bg-surface-raised/60">
      <span data-status-dot class="w-2 h-2 rounded-full bg-yellow-400 shrink-0"></span>
      <span data-status-label>Conectando…</span>
    </span>
    <div data-vps-terminal-target="container" class="w-full flex-1 min-h-0 p-1"></div>
  </div>
</div>
