<% page_title "Shell — #{@host.name}" %>
<% content_for :main_class, "p-4 overflow-hidden flex flex-col min-h-0" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "xterm" %>
<% end %>
<meta name="turbo-cache-control" content="no-cache">

<div class="h-full flex-1 min-h-0 flex flex-col rounded-xl overflow-hidden border border-border bg-surface-sunken"
     data-controller="vps-terminal-tabs"
     data-vps-terminal-tabs-active-value="<%= @session.id %>">

  <%# ── Tab bar ── %>
  <div class="flex items-stretch h-10 bg-surface-raised/90 border-b border-border shrink-0 overflow-x-auto">
    <%= render Ui::ButtonComponent.new(url: vps_hosts_path, variant: :gray, size: :sm, css_class: "m-1.5 shrink-0") do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7-7 7 7 7"/>
      </svg>
      Voltar
    <% end %>

    <span class="w-px h-5 bg-border self-center mx-1 shrink-0"></span>

    <% @open_sessions.each do |s| %>
      <div class="flex items-center group shrink-0 px-3 cursor-pointer border-r border-border/50 text-xs font-mono transition-colors"
           data-vps-terminal-tabs-target="tab"
           data-session-id="<%= s.id %>"
           data-host-id="<%= s.vps_host_id %>"
           data-action="click->vps-terminal-tabs#activate">
        <span class="w-2 h-2 rounded-full <%= s.connected? ? "bg-green-400" : "bg-yellow-400" %> shrink-0 mr-2"></span>
        <span class="truncate max-w-[140px]"><%= s.vps_host.name %></span>
        <span class="text-text-muted text-[10px] ml-1">#<%= s.id %></span>
        <button type="button"
                data-action="click->vps-terminal-tabs#closeSession"
                data-session-id="<%= s.id %>"
                data-host-id="<%= s.vps_host_id %>"
                class="ml-2 w-4 h-4 rounded flex items-center justify-center text-text-muted hover:text-red-400 opacity-0 group-hover:opacity-100 hover:!opacity-100 transition-opacity"
                title="Fechar sessão">
          ×
        </button>
      </div>
    <% end %>

    <%# New session on the same host — forces a fresh slot (own remote shell)
        instead of the reuse-most-recent default. %>
    <%= button_to vps_host_terminal_sessions_path(@host, new: 1),
                  method: :post,
                  form_class: "shrink-0 flex",
                  class: "px-3 flex items-center text-text-muted hover:text-text-primary hover:bg-surface-raised border-r border-border/50 text-sm transition-colors",
                  title: "Nova sessão neste host" do %>
      +
    <% end %>

    <div class="flex-1"></div>
  </div>

  <%# ── Body: terminal panes + optional files split ── %>
  <div class="flex-1 min-h-0 flex">
    <%# min-w-0: a flex item defaults to min-width:auto, so this column refused
        to shrink below the xterm canvas's own width and pushed the files pane
        off the right edge (names visibly clipped). It also left the terminal
        half-shrunk, which fed the refit churn on open. %>
    <%# overflow-hidden: the refit is debounced, so for a few frames after the
        split starts opening the xterm canvas is still at its old, wider size.
        Without a clip it paints straight over the files pane. %>
    <div class="flex-1 min-h-0 min-w-0 overflow-hidden flex flex-col">
      <% @open_sessions.each do |s| %>
        <%= render "vps_terminal_sessions/pane", session: s, active_session: @session %>
      <% end %>
    </div>

    <%# Drag handle — resizes the files split via vps-terminal-tabs#startResize.
        Width/opacity driven by inline style (see toggleFiles) so opening
        animates instead of an instant display:none snap. %>
    <div data-vps-terminal-tabs-target="resizeHandle" data-action="mousedown->vps-terminal-tabs#startResize"
         style="width:0" class="opacity-0 shrink-0 cursor-col-resize bg-border hover:bg-brand/60 overflow-hidden transition-[width,opacity] duration-[30ms] ease-out"></div>

    <%# Files split — collapsed to 0 width until toggled, iframe src set lazily on first open %>
    <div data-vps-terminal-tabs-target="filesPane" style="width:0;min-width:0"
         class="opacity-0 shrink-0 flex flex-col border-l border-border overflow-hidden transition-[width,min-width,opacity] duration-[30ms] ease-out">
      <div class="flex items-center justify-between px-3 h-10 bg-surface-raised/90 border-b border-border shrink-0">
        <span class="text-[11px] font-medium text-text-muted">Arquivos</span>
        <button type="button" data-action="click->vps-terminal-tabs#toggleFiles" class="text-text-muted hover:text-text-primary" title="Fechar painel">✕</button>
      </div>
      <%# turbo-frame, not iframe — a real iframe does a full document nav (fresh
          <html>, fresh JS boot); a turbo-frame fetches and splices in only the
          matching #id subtree into this page's own already-booted runtime. %>
      <turbo-frame id="vps-files-frame" data-vps-terminal-tabs-target="filesFrame" class="flex-1 min-h-0 w-full flex flex-col overflow-hidden bg-surface"></turbo-frame>
    </div>
  </div>
</div>
