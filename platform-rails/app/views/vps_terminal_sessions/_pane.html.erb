<%# One terminal pane: toolbar + xterm %>
<div class="h-full flex-col <%= session.id == active_session.id ? "flex" : "hidden" %>"
     style="flex: 1 1 auto; min-height: 0;"
     data-vps-terminal-tabs-target="pane"
     data-session-id="<%= session.id %>"
     data-host-id="<%= session.vps_host_id %>"
     data-controller="vps-terminal"
     data-vps-terminal-session-token-value="<%= session.token %>"
     data-vps-terminal-session-id-value="<%= session.id %>"
     data-vps-terminal-host-id-value="<%= session.vps_host_id %>">

  <div class="flex items-center gap-3 px-3 h-10 bg-surface-raised/90 border-b border-border shrink-0 overflow-x-auto">
    <div class="flex items-center gap-2" data-vps-terminal-target="status">
      <span data-status-dot class="w-2 h-2 rounded-full <%= session.connected? ? "bg-green-400" : "bg-yellow-400" %> shrink-0"></span>
      <span data-status-label class="text-[11px] text-text-muted"><%= session.connected? ? "Conectado" : "Conectando…" %></span>
    </div>

    <span class="w-px h-4 bg-surface-active shrink-0"></span>
    <%= action_icon(:terminal, css_class: "w-4 h-4 text-orange-500 dark:text-brand shrink-0") %>
    <span class="text-xs font-mono text-text-secondary"><%= session.vps_host.username %>@<%= session.vps_host.hostname %>:<%= session.vps_host.port %></span>

    <div class="flex-1"></div>

    <%# The shell runs under tmux with `mouse on` (screen survives reattach, wheel
        scrolls the pane). That eats a plain drag-select, so selecting needs Shift.
        Saying it here is the whole fix for "não dá pra copiar" — the behavior was
        always available, just invisible. %>
    <span class="hidden md:flex items-center gap-1.5 text-[11px] text-text-muted shrink-0"
          title="O shell roda em tmux com mouse ligado (a roda rola o painel e a tela volta inteira ao reconectar). Segure Shift e arraste para selecionar — ao soltar, o texto já vai pra área de transferência.">
      <kbd class="px-1.5 py-0.5 rounded border border-border-subtle bg-surface-inset font-sans text-[10px] leading-none">Shift</kbd>
      <span>+ arrastar para copiar</span>
    </span>

    <button type="button" data-action="click->vps-terminal-tabs#toggleFiles mouseenter->vps-terminal-tabs#prefetchFiles"
            data-host-id="<%= session.vps_host_id %>"
            data-files-url="<%= vps_host_files_path(session.vps_host, embed: 1) %>"
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle transition-colors"
            title="Dividir tela com o explorador de arquivos">
      ⬒ Arquivos
    </button>

    <button type="button"
            data-action="click->vps-terminal-tabs#closeSession"
            data-session-id="<%= session.id %>"
            data-host-id="<%= session.vps_host_id %>"
            class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-red-400 hover:text-red-300 bg-surface-inset hover:bg-red-500/10 border border-border-subtle transition-colors"
            title="Encerrar sessão">
      Encerrar
    </button>
  </div>

  <div data-vps-terminal-target="container" class="w-full flex-1 min-h-0 p-1"></div>
</div>
