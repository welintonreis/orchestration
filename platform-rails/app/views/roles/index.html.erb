<% content_for :title, "Funções e Permissões" %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-white">Funções e Permissões</h2>
  <p class="text-sm text-gray-400 mt-0.5">Matriz de controle de acesso baseado em funções (RBAC)</p>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <% [["viewer", "Viewer", "bg-gray-700", @users_by_role["viewer"].to_i], ["operator", "Operator", "bg-cyan-900/50 border-cyan-800/50", @users_by_role["operator"].to_i], ["admin", "Admin", "bg-purple-900/50 border-purple-800/50", @users_by_role["admin"].to_i]].each do |key, label, cls, count| %>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex px-2 py-0.5 rounded text-xs font-semibold <%= cls %> border text-gray-200"><%= label %></span>
      </div>
      <p class="text-2xl font-bold text-white"><%= count %></p>
      <p class="text-xs text-gray-500">usuário(s)</p>
    </div>
  <% end %>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-800">
    <h3 class="text-sm font-semibold text-gray-200">Permissões por Recurso</h3>
  </div>
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-gray-500 uppercase border-b border-gray-800">
        <th class="px-4 py-3 text-left">Recurso / Ação</th>
        <th class="px-4 py-3 text-center">Viewer</th>
        <th class="px-4 py-3 text-center">Operator</th>
        <th class="px-4 py-3 text-center">Admin</th>
      </tr>
    </thead>
    <tbody>
      <% @permissions.each do |perm| %>
        <tr class="border-b border-gray-800/50 hover:bg-gray-800/20">
          <td class="px-4 py-3 text-gray-200 font-medium"><%= perm[:resource] %></td>
          <td class="px-4 py-3 text-center">
            <% if perm[:view] %>
              <svg class="w-4 h-4 text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <% else %>
              <svg class="w-4 h-4 text-gray-700 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center">
            <% if perm[:operator] %>
              <svg class="w-4 h-4 text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <% else %>
              <svg class="w-4 h-4 text-gray-700 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center">
            <svg class="w-4 h-4 text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-4 p-4 bg-gray-900 border border-gray-800 rounded-xl">
  <h3 class="text-sm font-semibold text-gray-200 mb-2">Sobre as Funções</h3>
  <div class="space-y-2 text-xs text-gray-400">
    <p><span class="text-gray-200 font-medium">Viewer</span> — acesso somente leitura a todos os recursos do ambiente ativo.</p>
    <p><span class="text-gray-200 font-medium">Operator</span> — pode iniciar, parar, escalar e fazer deploy. Não pode gerenciar usuários ou configurações do sistema.</p>
    <p><span class="text-gray-200 font-medium">Admin</span> — acesso total, incluindo gerenciamento de usuários, ambientes e configurações do sistema.</p>
  </div>
</div>
