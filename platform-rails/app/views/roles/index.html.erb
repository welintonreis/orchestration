<% content_for :title, "Funções e Permissões" %>
<% page_subtitle "Papéis de acesso e permissões por recurso e ambiente" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="currentColor" d="M19.307 3.21a2.91 2.91 0 1 0-.223 1.94a11.64 11.64 0 0 1 8.232 7.049l1.775-.698a13.58 13.58 0 0 0-9.784-8.291m-2.822 1.638a.97.97 0 1 1 0-1.939a.97.97 0 0 1 0 1.94m-4.267.805l-.717-1.774a13.58 13.58 0 0 0-8.291 9.784a2.91 2.91 0 1 0 1.94.223a11.64 11.64 0 0 1 7.068-8.233m-8.34 11.802a.97.97 0 1 1 0-1.94a.97.97 0 0 1 0 1.94m12.607 8.727a2.91 2.91 0 0 0-2.599 1.62a11.64 11.64 0 0 1-8.233-7.05l-1.774.717a13.58 13.58 0 0 0 9.813 8.291a2.91 2.91 0 1 0 2.793-3.578m0 3.879a.97.97 0 1 1 0-1.94a.97.97 0 0 1 0 1.94M32 16.485a2.91 2.91 0 1 0-4.199 2.599a11.64 11.64 0 0 1-7.05 8.232l.718 1.775a13.58 13.58 0 0 0 8.291-9.813A2.91 2.91 0 0 0 32 16.485m-2.91.97a.97.97 0 1 1 0-1.94a.97.97 0 0 1 0 1.94" />
    <path fill="currentColor" d="M19.19 16.35a3.879 3.879 0 1 0-5.42 0a4.85 4.85 0 0 0-2.134 4.014v1.939h9.697v-1.94a4.85 4.85 0 0 0-2.143-4.014m-4.645-2.774a1.94 1.94 0 1 1 3.88 0a1.94 1.94 0 0 1-3.88 0m-.97 6.788a2.91 2.91 0 1 1 5.819 0z" />
  </svg>
<% end %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-text-primary">Funções e Permissões</h2>
  <p class="text-sm text-text-secondary mt-0.5">Matriz de controle de acesso baseado em funções (RBAC)</p>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <% [["viewer", "Viewer", "bg-surface-active", @users_by_role["viewer"].to_i], ["operator", "Operator", "bg-cyan-100 dark:bg-cyan-900/50 border-cyan-300 dark:border-cyan-800/50", @users_by_role["operator"].to_i], ["admin", "Admin", "bg-purple-100 dark:bg-purple-900/50 border-purple-300 dark:border-purple-800/50", @users_by_role["admin"].to_i]].each do |key, label, cls, count| %>
    <div class="bg-surface-raised border border-border rounded-xl p-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex px-2 py-0.5 rounded text-xs font-semibold <%= cls %> border text-text-primary"><%= label %></span>
      </div>
      <p class="text-2xl font-bold text-text-primary"><%= count %></p>
      <p class="text-xs text-text-muted">usuário(s)</p>
    </div>
  <% end %>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <div class="px-4 py-3 border-b border-border">
    <h3 class="text-sm font-semibold text-text-primary">Permissões por Recurso</h3>
  </div>
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-text-muted uppercase border-b border-border">
        <th class="px-4 py-3 text-left">Recurso / Ação</th>
        <th class="px-4 py-3 text-center">Viewer</th>
        <th class="px-4 py-3 text-center">Operator</th>
        <th class="px-4 py-3 text-center">Admin</th>
      </tr>
    </thead>
    <tbody>
      <% @permissions.each do |perm| %>
        <tr class="border-b border-border/50 hover:bg-surface-inset/20">
          <td class="px-4 py-3 text-text-primary font-medium"><%= perm[:resource] %></td>
          <td class="px-4 py-3 text-center">
            <% if perm[:view] %>
              <svg class="w-4 h-4 text-green-600 dark:text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <% else %>
              <svg class="w-4 h-4 text-text-muted mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center">
            <% if perm[:operator] %>
              <svg class="w-4 h-4 text-green-600 dark:text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <% else %>
              <svg class="w-4 h-4 text-text-muted mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center">
            <svg class="w-4 h-4 text-green-600 dark:text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-4 p-4 bg-surface-raised border border-border rounded-xl">
  <h3 class="text-sm font-semibold text-text-primary mb-2">Sobre as Funções</h3>
  <div class="space-y-2 text-xs text-text-secondary">
    <p><span class="text-text-primary font-medium">Viewer</span> — acesso somente leitura a todos os recursos do ambiente ativo.</p>
    <p><span class="text-text-primary font-medium">Operator</span> — pode iniciar, parar, escalar e fazer deploy. Não pode gerenciar usuários ou configurações do sistema.</p>
    <p><span class="text-text-primary font-medium">Admin</span> — acesso total, incluindo gerenciamento de usuários, ambientes e configurações do sistema.</p>
  </div>
</div>
