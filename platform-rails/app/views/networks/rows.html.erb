<turbo-frame id="networks-content">
<% if @networks.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <p class="text-gray-400 text-sm">Nenhuma rede encontrada.</p>
  </div>
<% else %>
<div x-data="{
  perPage: 10, page: 1, total: <%= @networks.size %>,
  search: '',
  selected: [],
  expanded: {},
  addModal: false,
  toggle(id) {
    if (this.selected.includes(id)) { this.selected = this.selected.filter(s => s !== id); }
    else { this.selected.push(id); }
  },
  toggleAll() {
    const ids = Array.from(this.$refs.tbody.querySelectorAll('[data-net-id]')).map(el => el.dataset.netId);
    this.selected = ids.every(id => this.selected.includes(id)) ? [] : ids;
  },
  matchesSearch(name) {
    return !this.search || name.toLowerCase().includes(this.search.toLowerCase());
  }
}">

  <div class="mb-3 flex items-center justify-between gap-3 flex-wrap">
    <div class="relative flex-1 max-w-xs">
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
      </svg>
      <%= render Ui::InputComponent.new(name: "network_search", placeholder: "Search...",
            css_class: "w-full pl-8 pr-3 py-1.5 rounded-lg placeholder-gray-600",
            html_attrs: { "x-model" => "search" }) %>
    </div>
    <div class="flex items-center gap-2">
      <span x-show="selected.length > 0" class="text-xs text-gray-400 whitespace-nowrap" x-text="selected.length + ' selecionada(s)'"></span>
      <% if Current.user&.admin? || Current.user&.operator? %>
        <form method="post" action="<%= networks_path %>"
              data-turbo-confirm="Remover redes selecionadas?"
              x-show="selected.length > 0">
          <input type="hidden" name="_method" value="delete">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <template x-for="id in selected" :key="id">
            <input type="hidden" name="ids[]" :value="id">
          </template>
          <button type="submit"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-red-700 hover:bg-red-600 text-white rounded-lg transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            Remover
          </button>
        </form>
        <button @click="addModal = true"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-gray-700 hover:bg-gray-600 text-gray-200 rounded-lg transition-colors border border-gray-600">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Adicionar
        </button>
      <% end %>
    </div>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-800/50">
          <tr>
            <th class="px-3 py-3 w-8"></th>
            <th class="px-3 py-3 w-8">
              <%= render Ui::CheckboxComponent.new(size: "w-4 h-4", color: :red, html_attrs: { "@change" => "toggleAll()" }) %>
            </th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Name</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Stack</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Driver</th>
            <th class="px-3 py-3 text-center text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Attachable</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">IPAM Driver</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">IPv4 Subnet</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">IPv4 Gateway</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">IPv6 Subnet</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">IPv6 Gateway</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Node</th>
            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Ownership</th>
            <th class="px-3 py-3 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800" x-ref="tbody">
          <% @networks.each_with_index do |n, idx| %>
            <% net_id = n["Id"] %>
            <tr class="hover:bg-gray-800/30 transition-colors"
                data-net-id="<%= net_id %>"
                x-show="matchesSearch('<%= j(n["Name"]) %>') && (perPage === 0 || (<%= idx %> >= (page-1)*perPage && <%= idx %> < page*perPage))">
              <td class="px-3 py-3 text-center">
                <% containers = n["_containers"] || [] %>
                <% if containers.any? %>
                  <button @click="expanded['<%= net_id %>'] = !expanded['<%= net_id %>']"
                          class="text-gray-500 hover:text-gray-300 transition-colors">
                    <svg class="w-3.5 h-3.5 transition-transform"
                         :class="expanded['<%= net_id %>'] ? 'rotate-90' : ''"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                  </button>
                <% else %>
                  <span class="w-3.5 h-3.5 inline-block"></span>
                <% end %>
              </td>
              <td class="px-3 py-3">
                <%= render Ui::CheckboxComponent.new(size: "w-4 h-4", color: :red, html_attrs: {
                      ":checked" => "selected.includes('#{net_id}')",
                      "@change" => "toggle('#{net_id}')",
                    }) %>
              </td>
              <td class="px-3 py-3">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0 text-cyan-500/70" viewBox="0 0 256 256">
                    <path d="M0 0h256v256H0z" fill="none"/>
                    <path fill="currentColor" d="M232 114h-98V86h10a14 14 0 0 0 14-14V40a14 14 0 0 0-14-14h-32a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h10v28H24a6 6 0 0 0 0 12h34v36H48a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h32a14 14 0 0 0 14-14v-32a14 14 0 0 0-14-14H70v-36h116v18a6 6 0 0 0 12 0v-18h34a6 6 0 0 0 0-12M110 72V40a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2v32a2 2 0 0 1-2 2h-32a2 2 0 0 1-2-2M82 176v32a2 2 0 0 1-2 2H48a2 2 0 0 1-2-2v-32a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2m138.24-3.76L200.48 192l19.76 19.76a6 6 0 1 1-8.48 8.48L192 200.48l-19.76 19.76a6 6 0 0 1-8.48-8.48L183.52 192l-19.76-19.76a6 6 0 0 1 8.48-8.48L192 183.52l19.76-19.76a6 6 0 0 1 8.48 8.48"/>
                  </svg>
                  <span class="font-medium text-gray-200 whitespace-nowrap"><%= n["Name"] %></span>
                  <% if n["_protected"] %>
                    <%= render(Ui::BadgeComponent.new(color: "bg-blue-900/40 text-blue-400 border-blue-800/50", size: :xs, css_class: "whitespace-nowrap")) { "System" } %>
                  <% end %>
                </div>
              </td>
              <td class="px-3 py-3 whitespace-nowrap">
                <% if n["_stack"] %>
                  <%= render(Ui::BadgeComponent.new(color: "bg-gray-800 text-gray-300 border-gray-700")) { n["_stack"] } %>
                <% else %>
                  <span class="text-gray-600">—</span>
                <% end %>
              </td>
              <td class="px-3 py-3 whitespace-nowrap">
                <%
                  driver_color = case n["Driver"]
                                 when "overlay" then "bg-purple-900/40 text-purple-300 border-purple-800/40"
                                 when "bridge"  then "bg-cyan-900/40 text-cyan-300 border-cyan-800/40"
                                 when "host"    then "bg-orange-900/40 text-orange-300 border-orange-800/40"
                                 else                "bg-gray-800 text-gray-400 border-gray-700"
                                 end
                %>
                <%= render(Ui::BadgeComponent.new(color: driver_color)) { n["Driver"] } %>
              </td>
              <td class="px-3 py-3 text-center">
                <% if n["Attachable"] %>
                  <svg class="w-5 h-5 text-green-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <% else %>
                  <svg class="w-5 h-5 text-gray-700 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                <% end %>
              </td>
              <td class="px-3 py-3 text-gray-400 text-xs whitespace-nowrap"><%= n.dig("IPAM", "Driver") || "default" %></td>
              <td class="px-3 py-3 font-mono text-gray-300 text-xs whitespace-nowrap"><%= n["_ipv4"]["Subnet"] || "—" %></td>
              <td class="px-3 py-3 font-mono text-gray-300 text-xs whitespace-nowrap"><%= n["_ipv4"]["Gateway"] || "—" %></td>
              <td class="px-3 py-3 font-mono text-gray-400 text-xs whitespace-nowrap"><%= n["_ipv6"]["Subnet"] || "—" %></td>
              <td class="px-3 py-3 font-mono text-gray-400 text-xs whitespace-nowrap"><%= n["_ipv6"]["Gateway"] || "—" %></td>
              <td class="px-3 py-3 text-gray-400 text-xs whitespace-nowrap"><%= @node_name %></td>
              <td class="px-3 py-3 whitespace-nowrap">
                <%
                  ownership_color = n["_ownership"] == "public" ? "bg-gray-800 text-gray-400 border-gray-700" : "bg-indigo-900/40 text-indigo-300 border-indigo-800/40"
                %>
                <%= render(Ui::BadgeComponent.new(color: ownership_color, size: :xs)) { n["_ownership"] } %>
              </td>
              <td class="px-3 py-3 text-right whitespace-nowrap">
                <% if n["_protected"] %>
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs bg-gray-800/60 text-gray-600 border border-gray-800 cursor-not-allowed">Protected</span>
                <% else %>
                  <%= render Ui::ButtonComponent.new(url: remove_network_path(net_id), method: :delete,
                        variant: "bg-red-900/30 text-red-400 border-red-800/50 hover:bg-red-900/60 hover:text-red-300",
                        size: :sm, icon: :remove, label: "Remover",
                        confirm: "Remover rede \"#{n["Name"]}\"?") %>
                <% end %>
              </td>
            </tr>

            <% containers = n["_containers"] || [] %>
            <% if containers.any? %>
              <tr x-show="expanded['<%= net_id %>'] && matchesSearch('<%= j(n["Name"]) %>') && (perPage === 0 || (<%= idx %> >= (page-1)*perPage && <%= idx %> < page*perPage))"
                  x-cloak>
                <td colspan="14" class="px-0 py-0 bg-gray-950/60 border-t border-gray-800/50">
                  <div class="px-8 py-3">
                    <p class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2">Containers nesta rede (<%= containers.size %>)</p>
                    <table class="w-full text-xs">
                      <thead>
                        <tr class="text-[10px] text-gray-600 uppercase">
                          <th class="py-1.5 text-left pr-4 font-semibold">Container</th>
                          <th class="py-1.5 text-left pr-4 font-semibold">IPv4</th>
                          <th class="py-1.5 text-left pr-4 font-semibold">IPv6</th>
                          <th class="py-1.5 text-left pr-4 font-semibold">MAC</th>
                          <th class="py-1.5 text-left font-semibold">Endpoint ID</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-gray-800/50">
                        <% containers.each do |c| %>
                          <tr class="hover:bg-gray-800/20">
                            <td class="py-2 pr-4 font-medium text-gray-300 whitespace-nowrap">
                              <div class="flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
                                <%= c["Name"] %>
                              </div>
                            </td>
                            <td class="py-2 pr-4 font-mono text-gray-400 whitespace-nowrap"><%= c["IPv4Address"].presence || "—" %></td>
                            <td class="py-2 pr-4 font-mono text-gray-500 whitespace-nowrap"><%= c["IPv6Address"].presence || "—" %></td>
                            <td class="py-2 pr-4 font-mono text-gray-600 whitespace-nowrap"><%= c["MacAddress"].presence || "—" %></td>
                            <td class="py-2 font-mono text-gray-700 text-[10px] whitespace-nowrap"><%= c["EndpointID"]&.first(16) %>&hellip;</td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/table_pagination" %>
  </div>

  <div x-show="addModal" x-cloak
       class="fixed inset-0 z-50 flex items-center justify-center p-4"
       @keydown.escape.window="addModal = false">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="addModal = false"></div>
    <div class="relative bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl w-full max-w-md">
      <div class="px-6 py-4 border-b border-gray-800 flex items-center justify-between">
        <h3 class="text-base font-semibold text-white">Nova Rede</h3>
        <button @click="addModal = false" class="text-gray-500 hover:text-gray-300">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <%= form_with url: networks_path, method: :post, data: { turbo: false }, class: "px-6 py-5 space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Nome</label>
          <%= f.text_field :name, placeholder: "minha-rede", required: true,
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Driver</label>
          <%= f.select :driver, [["bridge", "bridge"], ["overlay", "overlay"], ["macvlan", "macvlan"], ["ipvlan", "ipvlan"]],
                { selected: "bridge" },
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 focus:outline-none focus:border-cyan-600" %>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Subnet (opcional)</label>
            <%= f.text_field :subnet, placeholder: "192.168.100.0/24",
                  class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600" %>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Gateway (opcional)</label>
            <%= f.text_field :gateway, placeholder: "192.168.100.1",
                  class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-cyan-600" %>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :attachable, { class: "w-4 h-4 rounded border-gray-600 bg-gray-800 text-cyan-500 focus:ring-0 cursor-pointer" }, "1", "0" %>
          <label class="text-sm text-gray-400">Attachable</label>
        </div>
        <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-800">
          <button type="button" @click="addModal = false" class="px-4 py-2 text-sm text-gray-400 hover:text-gray-200 transition-colors">Cancelar</button>
          <%= f.submit "Criar Rede", class: "px-4 py-2 text-sm font-medium bg-red-600 hover:bg-red-500 text-white rounded-lg transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

</div>
<% end %>
</turbo-frame>
