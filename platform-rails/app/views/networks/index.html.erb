<% page_title "Networks" %>
<% page_subtitle "Redes Docker configuradas — bridge, overlay e custom" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 256 256">
    <path d="M0 0h256v256H0z" fill="none" />
    <path fill="currentColor" d="M232 114h-98V86h10a14 14 0 0 0 14-14V40a14 14 0 0 0-14-14h-32a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h10v28H24a6 6 0 0 0 0 12h34v36H48a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h32a14 14 0 0 0 14-14v-32a14 14 0 0 0-14-14H70v-36h116v18a6 6 0 0 0 12 0v-18h34a6 6 0 0 0 0-12M110 72V40a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2v32a2 2 0 0 1-2 2h-32a2 2 0 0 1-2-2M82 176v32a2 2 0 0 1-2 2H48a2 2 0 0 1-2-2v-32a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2m138.24-3.76L200.48 192l19.76 19.76a6 6 0 1 1-8.48 8.48L192 200.48l-19.76 19.76a6 6 0 0 1-8.48-8.48L183.52 192l-19.76-19.76a6 6 0 0 1 8.48-8.48L192 183.52l19.76-19.76a6 6 0 0 1 8.48 8.48" />
  </svg>
<% end %>

<turbo-frame id="networks-content" src="<%= rows_networks_path %>">
  <div class="mb-3 flex items-center justify-between gap-3 animate-pulse">
    <div class="h-8 w-64 bg-surface-inset rounded-lg"></div>
    <div class="h-8 w-28 bg-surface-inset rounded-lg"></div>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden animate-pulse">
    <table class="w-full text-sm">
      <thead class="bg-surface-inset/50">
        <tr>
          <th class="px-3 py-3 w-8"></th>
          <th class="px-3 py-3 w-8"><div class="w-4 h-4 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-16 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-12 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-12 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-16 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-20 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"><div class="h-3 w-16 bg-surface-active rounded"></div></th>
          <th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% 6.times do %>
          <tr>
            <td class="px-3 py-3"></td>
            <td class="px-3 py-3"><div class="w-4 h-4 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-3.5 w-32 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-3 w-16 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-5 w-14 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-4 w-4 bg-surface-inset rounded mx-auto"></div></td>
            <td class="px-3 py-3"><div class="h-3 w-20 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-3 w-24 bg-surface-inset rounded"></div></td>
            <td class="px-3 py-3"><div class="h-6 w-16 bg-surface-inset rounded ml-auto"></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
