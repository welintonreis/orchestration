<% page_title "Networks" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 256 256">
    <path d="M0 0h256v256H0z" fill="none" />
    <path fill="currentColor" d="M232 114h-98V86h10a14 14 0 0 0 14-14V40a14 14 0 0 0-14-14h-32a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h10v28H24a6 6 0 0 0 0 12h34v36H48a14 14 0 0 0-14 14v32a14 14 0 0 0 14 14h32a14 14 0 0 0 14-14v-32a14 14 0 0 0-14-14H70v-36h116v18a6 6 0 0 0 12 0v-18h34a6 6 0 0 0 0-12M110 72V40a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2v32a2 2 0 0 1-2 2h-32a2 2 0 0 1-2-2M82 176v32a2 2 0 0 1-2 2H48a2 2 0 0 1-2-2v-32a2 2 0 0 1 2-2h32a2 2 0 0 1 2 2m138.24-3.76L200.48 192l19.76 19.76a6 6 0 1 1-8.48 8.48L192 200.48l-19.76 19.76a6 6 0 0 1-8.48-8.48L183.52 192l-19.76-19.76a6 6 0 0 1 8.48-8.48L192 183.52l19.76-19.76a6 6 0 0 1 8.48 8.48" />
  </svg>
<% end %>
<% protected_names = %w[bridge host none] %>

<% if @networks.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
    </svg>
    <p class="text-gray-400 text-sm">No networks found.</p>
  </div>
<% else %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden"
       x-data="{ perPage: 10, page: 1, total: <%= @networks.size %> }">
    <table class="w-full text-sm">
      <thead class="bg-gray-800/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">ID</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Driver</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Scope</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Containers</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @networks.each_with_index do |n, idx| %>
          <% protected_network = protected_names.include?(n["Name"]) %>
          <tr class="hover:bg-gray-800/30 transition-colors"
              x-show="perPage === 0 || ((<%= idx %>) >= (page - 1) * perPage && (<%= idx %>) < page * perPage)">
            <td class="px-4 py-3 font-medium text-gray-200">
              <%= n["Name"] %>
              <% if protected_network %>
                <span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-blue-900/40 text-blue-400 border border-blue-800/50">built-in</span>
              <% end %>
            </td>
            <td class="px-4 py-3 font-mono text-gray-400 text-xs"><%= n["Id"]&.first(12) %></td>
            <td class="px-4 py-3 text-gray-300"><%= n["Driver"] %></td>
            <td class="px-4 py-3 text-gray-400"><%= n["Scope"] %></td>
            <td class="px-4 py-3 text-gray-400"><%= n["Containers"]&.size || 0 %></td>
            <td class="px-4 py-3">
              <% if protected_network %>
                <span class="inline-flex items-center px-3 py-1 rounded text-xs font-medium bg-orange-900/30 text-orange-400 border border-orange-800/50 cursor-not-allowed">Protected</span>
              <% else %>
                <%= button_to "Remove",
                      remove_network_path(n["Id"]),
                      method: :delete,
                      data: { turbo_confirm: "Remove network \"#{n["Name"]}\"? This cannot be undone." },
                      class: "inline-flex items-center px-3 py-1 rounded text-xs font-medium bg-red-900/40 text-red-400 border border-red-800/60 hover:bg-red-900/70 hover:text-red-300 transition-colors" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination" %>
  </div>
<% end %>
