<% content_for :title, "Times" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Times</h2>
    <p class="text-sm text-gray-400 mt-0.5">Organize usuários em grupos de acesso</p>
  </div>
  <%= link_to new_team_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Novo Time
  <% end %>
</div>

<% if @teams.empty? %>
  <div class="text-center py-16 text-gray-500">
    <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <p>Nenhum time criado</p>
    <%= link_to "Criar primeiro time", new_team_path, class: "text-cyan-400 hover:text-cyan-300 text-sm mt-1 inline-block" %>
  </div>
<% else %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @teams.each do |team| %>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-700 transition-colors">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-600 to-cyan-800 flex items-center justify-center text-white font-bold text-sm">
              <%= team.name.first(2).upcase %>
            </div>
            <div>
              <h3 class="font-semibold text-white"><%= team.name %></h3>
              <p class="text-xs text-gray-500"><%= team.users.count %> membro(s)</p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <%= link_to edit_team_path(team), class: "p-1.5 rounded hover:bg-gray-800 text-gray-400 hover:text-white transition-colors", title: "Editar" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <% end %>
            <%= button_to team_path(team), method: :delete, data: { turbo_confirm: "Remover time #{team.name}?" }, class: "p-1.5 rounded hover:bg-red-950 text-gray-400 hover:text-red-400 transition-colors", title: "Remover" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          </div>
        </div>
        <% if team.description.present? %>
          <p class="text-xs text-gray-400 mb-3 line-clamp-2"><%= team.description %></p>
        <% end %>
        <div class="flex items-center gap-1.5 flex-wrap">
          <% team.users.first(5).each do |user| %>
            <span class="w-7 h-7 rounded-full bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center text-xs font-semibold text-white" title="<%= user.email_address %>">
              <%= user.email_address.first.upcase %>
            </span>
          <% end %>
          <% extra = team.users.count - 5 %>
          <% if extra > 0 %>
            <span class="text-xs text-gray-500">+<%= extra %></span>
          <% end %>
        </div>
        <%= link_to team_path(team), class: "block mt-3 text-xs text-cyan-400 hover:text-cyan-300" do %>
          Gerenciar membros →
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
