<% content_for :title, "Times" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Times</h2>
    <p class="text-sm text-text-secondary mt-0.5">Organize usuários em grupos de acesso</p>
  </div>
  <%= link_to new_team_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Novo Time
  <% end %>
</div>

<% if @teams.empty? %>
  <div class="text-center py-16 text-text-muted">
    <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <p>Nenhum time criado</p>
    <%= link_to "Criar primeiro time", new_team_path, class: "text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 text-sm mt-1 inline-block" %>
  </div>
<% else %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @teams.each do |team| %>
      <div class="bg-surface-raised border border-border rounded-xl p-5 hover:border-border-subtle transition-colors">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-600 to-cyan-800 flex items-center justify-center text-text-primary font-bold text-sm">
              <%= team.name.first(2).upcase %>
            </div>
            <div>
              <h3 class="font-semibold text-text-primary"><%= team.name %></h3>
              <p class="text-xs text-text-muted"><%= team.users.count %> membro(s)</p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <%= render Ui::ButtonComponent.new(url: edit_team_path(team), variant: :gray, icon: :edit, title: "Editar") %>
            <%= render Ui::ButtonComponent.new(url: team_path(team), method: :delete, variant: :red, icon: :remove, title: "Remover",
                  confirm: "Remover time #{team.name}?") %>
          </div>
        </div>
        <% if team.description.present? %>
          <p class="text-xs text-text-secondary mb-3 line-clamp-2"><%= team.description %></p>
        <% end %>
        <div class="flex items-center gap-1.5 flex-wrap">
          <% team.users.first(5).each do |user| %>
            <span class="w-7 h-7 rounded-full bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center text-xs font-semibold text-text-primary" title="<%= user.email_address %>">
              <%= user.email_address.first.upcase %>
            </span>
          <% end %>
          <% extra = team.users.count - 5 %>
          <% if extra > 0 %>
            <span class="text-xs text-text-muted">+<%= extra %></span>
          <% end %>
        </div>
        <%= link_to team_path(team), class: "block mt-3 text-xs text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300" do %>
          Gerenciar membros →
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
