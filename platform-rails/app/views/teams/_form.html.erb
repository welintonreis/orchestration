<%= form_with model: team, local: true do |f| %>
  <% if team.errors.any? %>
    <div class="mb-4 p-3 bg-red-950/50 border border-red-800/60 rounded-lg text-sm text-red-400">
      <% team.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, "Nome", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_field :name, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500", placeholder: "ex: DevOps" %>
  </div>

  <div class="mb-5">
    <%= f.label :description, "Descrição", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500", placeholder: "Descrição opcional do time..." %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit team.new_record? ? "Criar Time" : "Salvar", class: "btn-primary" %>
    <%= link_to "Cancelar", teams_path, class: "btn-secondary" %>
  </div>
<% end %>
