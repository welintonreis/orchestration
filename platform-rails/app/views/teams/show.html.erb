<% content_for :title, @team.name %>

<div class="flex items-center justify-between mb-6">
  <div>
    <div class="flex items-center gap-2 text-sm text-text-muted mb-1">
      <%= link_to "Times", teams_path, class: "hover:text-text-secondary" %>
      <span>/</span>
      <span class="text-text-secondary"><%= @team.name %></span>
    </div>
    <h2 class="text-xl font-bold text-text-primary"><%= @team.name %></h2>
    <% if @team.description.present? %>
      <p class="text-sm text-text-secondary mt-0.5"><%= @team.description %></p>
    <% end %>
  </div>
  <%= link_to edit_team_path(@team), class: "btn-secondary" do %>Editar<% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# Members list %>
  <div class="lg:col-span-2 bg-surface-raised border border-border rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-border flex items-center justify-between">
      <h3 class="text-sm font-semibold text-text-primary">Membros (<%= @members.count %>)</h3>
    </div>
    <% if @members.empty? %>
      <p class="text-center py-8 text-text-muted text-sm">Nenhum membro ainda</p>
    <% else %>
      <table class="w-full text-sm">
        <thead><tr class="text-xs text-text-muted uppercase border-b border-border">
          <th class="px-4 py-2 text-left">Usuário</th>
          <th class="px-4 py-2 text-left">Função</th>
          <th class="px-4 py-2 text-right">Ações</th>
        </tr></thead>
        <tbody>
          <% @members.each do |membership| %>
            <tr class="border-b border-border/50 hover:bg-surface-inset/30">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="w-7 h-7 rounded-full bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center text-xs font-semibold text-text-primary">
                    <%= membership.user.email_address.first.upcase %>
                  </span>
                  <span class="text-text-primary"><%= membership.user.email_address %></span>
                </div>
              </td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= membership.role == 'lead' ? 'bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 border border-purple-300 dark:border-purple-800/50' : 'bg-surface-inset text-text-secondary border border-border-subtle' %>">
                  <%= membership.role == 'lead' ? 'Líder' : 'Membro' %>
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <%= button_to remove_member_team_path(@team, user_id: membership.user_id), method: :delete,
                    data: { turbo_confirm: "Remover #{membership.user.email_address}?" },
                    class: "text-xs text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300" do %>Remover<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Add member %>
  <div class="bg-surface-raised border border-border rounded-xl p-4">
    <h3 class="text-sm font-semibold text-text-primary mb-3">Adicionar Membro</h3>
    <% if @other_users.empty? %>
      <p class="text-xs text-text-muted">Todos os usuários já estão no time.</p>
    <% else %>
      <%= form_with url: add_member_team_path(@team), method: :post, local: true do |f| %>
        <div class="mb-3">
          <%= f.select :user_id,
              options_for_select(@other_users.map { |u| [u.email_address, u.id] }),
              {},
              class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
        </div>
        <div class="mb-3">
          <%= f.select :role,
              options_for_select([["Membro", "member"], ["Líder", "lead"]], "member"),
              {},
              class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
        </div>
        <%= f.submit "Adicionar", class: "w-full btn-primary text-sm py-2" %>
      <% end %>
    <% end %>
  </div>
</div>
