<% page_title "Topologia" %>
<% page_subtitle "Mapa do cluster — nós, stacks, serviços e containers (incluindo finalizados)" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 16 16">
    <path d="M0 0h16v16H0z" fill="none" />
    <path fill="currentColor" d="M6.256 1.922A3.27 3.27 0 0 1 9.124 6.76l1.6 1.222a2.414 2.414 0 1 1-.533.746L8.575 7.495a3.26 3.26 0 0 1-3.179.85l-.662 1.706c.556.405.919 1.06.919 1.8a2.227 2.227 0 1 1-1.756-2.176l.657-1.692a3.27 3.27 0 0 1 1.702-6.06m-2.83 8.618a1.311 1.311 0 1 0 .001 2.622a1.311 1.311 0 0 0-.001-2.622m8.96-2.307a1.497 1.497 0 1 0 .002 2.995a1.497 1.497 0 0 0-.002-2.995M6.256 2.84a2.353 2.353 0 1 0 0 4.706a2.353 2.353 0 0 0 0-4.706" clip-rule="evenodd" />
  </svg>
<% end %>

<% if @topology.blank? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    <p class="text-text-secondary text-sm">Nenhum nó encontrado neste cluster Swarm.</p>
  </div>
<% else %>
  <div class="space-y-12">
    <% @topology.each do |entry| %>
      <% node = entry[:node] %>
      <% role = node.dig("Spec", "Role") %>
      <% availability = node.dig("Spec", "Availability") %>
      <% state = node.dig("Status", "State") %>
      <% state_class = state == "ready" ? "bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400 border-green-300 dark:border-green-800/60" : "bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400 border-red-300 dark:border-red-800/60" %>

      <%# ── Node box (root) ── %>
      <div class="flex flex-col items-center">
        <div class="inline-flex items-center gap-3 bg-surface-raised border-2 border-border-subtle rounded-xl px-6 py-4 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 0a3 3 0 100 6m0-6H5.25"/>
          </svg>
          <div class="text-left">
            <p class="text-sm font-semibold text-text-primary"><%= node.dig("Description", "Hostname") %></p>
            <p class="text-xs text-text-muted"><%= role %> · <%= availability %></p>
          </div>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border <%= state_class %>"><%= state %></span>
        </div>

        <% if entry[:stacks].empty? %>
          <p class="text-sm text-text-muted mt-6">Nenhuma stack agendada neste nó.</p>
        <% else %>
          <%# trunk line from node down to the stacks row %>
          <div class="w-px h-8 bg-border-subtle"></div>
          <% if entry[:stacks].size > 1 %>
            <div class="h-px bg-border-subtle" style="width: calc(100% - 4rem); max-width: 100%;"></div>
          <% end %>

          <div class="overflow-x-auto w-full">
            <div class="inline-flex gap-6 px-4 pb-2" style="min-width: 100%; justify-content: <%= entry[:stacks].size > 3 ? 'flex-start' : 'center' %>;">
              <% entry[:stacks].each do |stack| %>
                <%# ── Stack column ── %>
                <div class="flex flex-col items-center w-56 flex-shrink-0">
                  <div class="w-px h-6 bg-border-subtle"></div>
                  <div class="w-full bg-surface-raised border border-border rounded-lg px-4 py-2.5 text-center shadow-sm">
                    <p class="text-sm font-semibold text-text-primary truncate"><%= stack[:name] %></p>
                    <p class="text-[11px] text-text-muted"><%= stack[:services].size %> serviço(s)</p>
                  </div>

                  <% if stack[:services].any? %>
                    <div class="w-px h-6 bg-border-subtle"></div>
                    <div class="w-full bg-surface/60 border border-border rounded-lg p-3 space-y-4">
                      <% stack[:services].each do |svc_entry| %>
                        <% svc = svc_entry[:service] %>
                        <% svc_name = svc&.dig("Spec", "Name") || "(serviço removido)" %>
                        <div class="flex flex-col items-center">
                          <div class="w-full bg-surface-inset border border-border-subtle rounded-md px-3 py-1.5 text-center">
                            <p class="text-xs font-medium text-text-secondary truncate flex items-center justify-center gap-1.5">
                              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
                              <%= svc_name %>
                            </p>
                          </div>
                          <div class="w-px h-3 bg-border-subtle"></div>
                          <div class="flex flex-wrap gap-1 justify-center">
                            <% svc_entry[:containers].each do |task| %>
                              <% task_state = task.dig("Status", "State") %>
                              <% dead = !%w[running starting].include?(task_state) %>
                              <% dot_class = case task_state
                                   when "running"  then "bg-green-400"
                                   when "starting" then "bg-blue-400"
                                   when "failed"   then "bg-red-400"
                                   else                 "bg-gray-500"
                                   end %>
                              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-border-subtle text-[10px] font-mono <%= dead ? 'text-text-muted opacity-70' : 'text-text-secondary' %>"
                                    title="<%= task_state %><%= task.dig('Status', 'Err').present? ? " — #{task.dig('Status', 'Err')}" : '' %>">
                                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= dot_class %>"></span>
                                <span class="<%= dead ? 'line-through' : '' %>">
                                  <%= task.dig("Status", "ContainerStatus", "ContainerID")&.first(8) || task["ID"].first(8) %>
                                </span>
                              </span>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Legend ── %>
  <div class="flex items-center gap-5 mt-8 px-1 text-xs text-text-muted">
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-400"></span> running</span>
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-400"></span> starting</span>
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-400"></span> failed</span>
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-gray-500"></span> <span class="line-through">finalizado</span></span>
  </div>
<% end %>
