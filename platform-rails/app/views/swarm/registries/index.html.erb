<% content_for :title, "Registries do Swarm" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Registries do Swarm</h2>
    <p class="text-sm text-gray-400 mt-0.5">Registries de imagens Docker disponíveis para o cluster</p>
  </div>
  <%= link_to new_swarm_registry_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Adicionar Registry
  <% end %>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden" x-data="{ perPage: 10, page: 1, total: <%= @registries.count %> }">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-gray-500 uppercase border-b border-gray-800">
        <th class="px-4 py-3 text-left">Nome</th>
        <th class="px-4 py-3 text-left">URL</th>
        <th class="px-4 py-3 text-left">Usuário</th>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @registries.empty? %>
        <tr><td colspan="4" class="px-4 py-12 text-center text-gray-500">Nenhum registry configurado</td></tr>
      <% else %>
        <% @registries.each_with_index do |reg, idx| %>
          <tr class="border-b border-gray-800/50 hover:bg-gray-800/20"
              x-show="perPage === 0 || (idx >= (page-1)*perPage && idx < page*perPage)"
              x-data="{ idx: <%= idx %> }">
            <td class="px-4 py-3 font-medium text-gray-200"><%= reg.name %></td>
            <td class="px-4 py-3 font-mono text-xs text-gray-400"><%= reg.url %></td>
            <td class="px-4 py-3 text-gray-400"><%= reg.username.presence || "—" %></td>
            <td class="px-4 py-3 text-right flex items-center gap-2 justify-end">
              <%= link_to edit_swarm_registry_path(reg), class: "p-1.5 rounded hover:bg-gray-800 text-gray-400 hover:text-white transition-colors", title: "Editar" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to swarm_registry_path(reg), method: :delete, data: { turbo_confirm: "Remover registry #{reg.name}?" }, class: "p-1.5 rounded hover:bg-red-950 text-gray-400 hover:text-red-400 transition-colors", title: "Remover" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <% if @registries.count > 10 %>
    <%= render "shared/table_pagination" %>
  <% end %>
</div>
