<% content_for :title, "Registries do Swarm" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Registries do Swarm</h2>
    <p class="text-sm text-text-secondary mt-0.5">Registries de imagens Docker disponíveis para o cluster</p>
  </div>
  <%= link_to new_swarm_registry_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Adicionar Registry
  <% end %>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden" x-data="{ perPage: 10, page: 1, total: <%= @registries.count %> }">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-text-muted uppercase border-b border-border">
        <th class="px-4 py-3 text-left">Nome</th>
        <th class="px-4 py-3 text-left">URL</th>
        <th class="px-4 py-3 text-left">Tipo</th>
        <th class="px-4 py-3 text-left">Acesso</th>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @registries.empty? %>
        <tr><td colspan="5" class="px-4 py-12 text-center text-text-muted">Nenhum registry configurado</td></tr>
      <% else %>
        <% @registries.each_with_index do |reg, idx| %>
          <tr class="border-b border-border/50 hover:bg-surface-inset/20"
              x-show="perPage === 0 || (<%= idx %> >= (page-1)*perPage && <%= idx %> < page*perPage)">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 flex-shrink-0 rounded bg-surface-inset border border-border-subtle/60 flex items-center justify-center">
                  <%= sidebar_icon(:registry).html_safe %>
                </div>
                <span class="font-medium text-text-primary"><%= reg.name %></span>
              </div>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-text-secondary"><%= reg.display_url %></td>
            <td class="px-4 py-3">
              <% if reg.searchable? %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 border border-cyan-700/30">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <%= reg.api_label %>
                </span>
              <% else %>
                <span class="text-xs text-text-muted">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if reg.public? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 border border-green-700/30">Público</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-surface-inset text-text-muted border border-border-subtle">Privado · <%= reg.username.presence || "—" %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center gap-1 justify-end">
                <%= link_to edit_swarm_registry_path(reg), class: "p-1.5 rounded hover:bg-surface-inset text-text-secondary hover:text-text-primary transition-colors", title: "Editar" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <% end %>
                <%= button_to swarm_registry_path(reg), method: :delete, data: { turbo_confirm: "Remover registry #{reg.name}?" }, class: "p-1.5 rounded hover:bg-red-950 text-text-secondary hover:text-red-600 dark:hover:text-red-400 transition-colors", title: "Remover" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <% if @registries.count > 10 %>
    <%= render "shared/table_pagination" %>
  <% end %>
</div>
