<% content_for :title, "Editar Registry" %>
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <%= link_to "Registries", swarm_registries_path, class: "hover:text-gray-300" %> <span>/</span> <span class="text-gray-300">Editar</span>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h2 class="text-lg font-semibold text-white mb-5">Editar: <%= @registry.name %></h2>
    <%= render "form", registry: @registry %>
  </div>
</div>
