<% page_title "Swarm Nodes" %>
<% page_subtitle "Nós do cluster Swarm — disponibilidade, papel e recursos de cada host" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="currentColor" d="M17 13V6H8v16h16v-9Zm-7-5h5v5h-5Zm0 7h5v5h-5Zm12 5h-5v-5h5Z" />
    <path fill="currentColor" d="M28 11h-9V2h9Zm-7-2h5V4h-5Zm7 11h-2v2h2v6H4v-6h2v-2H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h24a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2" />
    <circle cx="7" cy="25" r="1" fill="currentColor" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= link_to swarm_path,
        class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-primary text-sm font-medium px-4 py-2 rounded-lg border border-border-subtle transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
    </svg>
    Services
  <% end %>
<% end %>

<%# The node list is a socket call; lazy-load it so the header paints first.
    Column widths mirror the real table so nothing jumps on swap. %>
<turbo-frame id="nodes-content" refresh="morph" src="<%= rows_swarm_nodes_path %>">
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-40", "w-16", "w-14", "w-16", "w-20", "w-28", "w-16" ], rows: 5) %>
</turbo-frame>
