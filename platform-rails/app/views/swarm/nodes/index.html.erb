<% page_title "Swarm Nodes" %>

<% content_for :actions do %>
  <%= link_to swarm_path,
        class: "inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-gray-200 text-sm font-medium px-4 py-2 rounded-lg border border-gray-700 transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
    </svg>
    Services
  <% end %>
<% end %>

<% if @nodes.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    <p class="text-gray-400 text-sm">No nodes found in this Swarm cluster.</p>
  </div>
<% else %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-800/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Hostname</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Role</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Availability</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Engine</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Address</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Leader</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @nodes.each do |n| %>
          <%
            hostname     = n.dig("Description", "Hostname") || "—"
            role         = n.dig("Spec", "Role") || "—"
            status_state = n.dig("Status", "State") || "—"
            availability = n.dig("Spec", "Availability") || "—"
            engine_ver   = n.dig("Description", "Engine", "EngineVersion") || "—"
            address      = n.dig("Status", "Addr") || "—"
            is_leader    = n.dig("ManagerStatus", "Leader") == true

            role_classes = role == "manager" \
              ? "bg-cyan-900/60 text-cyan-300 border-cyan-800/60" \
              : "bg-gray-800 text-gray-400 border-gray-700"

            status_classes = status_state == "ready" \
              ? "bg-green-900/60 text-green-300 border-green-800/60" \
              : "bg-red-900/60 text-red-300 border-red-800/60"

            avail_classes = case availability
              when "active" then "bg-green-900/60 text-green-300 border-green-800/60"
              when "drain"  then "bg-yellow-900/60 text-yellow-300 border-yellow-800/60"
              else               "bg-red-900/60 text-red-300 border-red-800/60"
            end
          %>
          <tr class="hover:bg-gray-800/30 transition-colors">
            <td class="px-4 py-3 font-mono text-gray-100 font-medium"><%= hostname %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= role_classes %>">
                <%= role %>
              </span>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium border <%= status_classes %>">
                <span class="w-1.5 h-1.5 rounded-full inline-block <%= status_state == "ready" ? "bg-green-400" : "bg-red-400" %>"></span>
                <%= status_state %>
              </span>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= avail_classes %>">
                <%= availability %>
              </span>
            </td>
            <td class="px-4 py-3 font-mono text-gray-400 text-xs"><%= engine_ver %></td>
            <td class="px-4 py-3 font-mono text-gray-400 text-xs"><%= address %></td>
            <td class="px-4 py-3">
              <% if is_leader %>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-medium bg-yellow-900/60 text-yellow-300 border border-yellow-800/60">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  Leader
                </span>
              <% else %>
                <span class="text-gray-600">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
