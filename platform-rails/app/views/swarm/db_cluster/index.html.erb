<% page_title "Cluster de Bancos" %>
<% page_subtitle "Topologia HAProxy → PgBouncer → Postgres e estatísticas por banco" %>

<% content_for :page_icon do %>
  <%= sidebar_icon(:s3_storage, css_class: "w-7 h-7") %>
<% end %>

<div data-controller="metrics-refresh"
     data-metrics-refresh-frame-value="db-cluster-content"
     x-data="{
       interval: sessionStorage.getItem('dbClusterInterval') || '30000',
       search: sessionStorage.getItem('dbClusterSearch') || '',
       serverFilter: sessionStorage.getItem('dbClusterServerFilter') || 'all',
       setInterval(v) { this.interval = v; sessionStorage.setItem('dbClusterInterval', v);
                        this.$el.dataset.metricsRefreshIntervalValue = v },
       setSearch(v) { this.search = v; sessionStorage.setItem('dbClusterSearch', v) },
       setServerFilter(v) { this.serverFilter = v; sessionStorage.setItem('dbClusterServerFilter', v) }
     }"
     x-init="$el.dataset.metricsRefreshIntervalValue = interval">

<div class="flex items-center justify-between mb-4 flex-wrap gap-3">
  <%# Table filters — applied client-side via x-show on rows.html.erb, so
      they survive turbo-frame auto-refreshes without a round-trip. %>
  <div class="flex items-center gap-3">
    <div class="relative">
      <input type="text" placeholder="Buscar banco ou dono..."
             @input="setSearch($event.target.value)"
             :value="search"
             class="bg-surface-inset border border-border-subtle rounded-lg pl-8 pr-3 py-1.5 text-xs text-text-secondary placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-brand w-56 transition-colors">
      <svg class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5A6.5 6.5 0 114 10.5a6.5 6.5 0 0113 0z"/>
      </svg>
    </div>
    <div class="flex items-center gap-1 bg-surface-inset border border-border-subtle rounded-lg p-1">
      <button @click="setServerFilter('all')"
              :class="serverFilter === 'all' ? 'bg-surface-raised shadow-sm text-text-primary' : 'text-text-muted hover:text-text-primary'"
              class="px-3 py-1 rounded text-xs font-medium transition-colors">Todos</button>
      <button @click="setServerFilter('master')"
              :class="serverFilter === 'master' ? 'bg-surface-raised shadow-sm text-text-primary' : 'text-text-muted hover:text-text-primary'"
              class="px-3 py-1 rounded text-xs font-medium transition-colors">master</button>
      <button @click="setServerFilter('analytics')"
              :class="serverFilter === 'analytics' ? 'bg-surface-raised shadow-sm text-text-primary' : 'text-text-muted hover:text-text-primary'"
              class="px-3 py-1 rounded text-xs font-medium transition-colors">analytics</button>
      <button @click="setServerFilter('redis')"
              :class="serverFilter === 'redis' ? 'bg-surface-raised shadow-sm text-text-primary' : 'text-text-muted hover:text-text-primary'"
              class="px-3 py-1 rounded text-xs font-medium transition-colors">redis</button>
      <button @click="setServerFilter('rabbitmq')"
              :class="serverFilter === 'rabbitmq' ? 'bg-surface-raised shadow-sm text-text-primary' : 'text-text-muted hover:text-text-primary'"
              class="px-3 py-1 rounded text-xs font-medium transition-colors">rabbitmq</button>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <span class="text-xs text-text-muted">Atualizar:</span>
    <div class="relative">
      <select @change="setInterval($event.target.value)"
              :value="interval"
              class="appearance-none bg-surface-inset border border-border-subtle rounded-lg pl-3 pr-7 py-1 text-xs text-text-secondary focus:outline-none focus:ring-1 focus:ring-orange-500 dark:focus:ring-brand cursor-pointer transition-colors">
        <option value="15000">15s</option>
        <option value="30000">30s</option>
        <option value="60000">1 min</option>
        <option value="0">Pausado</option>
      </select>
      <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
    <span class="w-1.5 h-1.5 rounded-full transition-colors" :class="interval === '0' ? 'bg-text-muted' : 'bg-green-400 animate-pulse'"></span>
  </div>
</div>

<%# Consulta ao vivo (introspecção SQL nos hosts + geração da topologia) —
    pode levar um instante com muitos bancos no master. Ver
    Swarm::DbClusterController#rows / DbClusterInspectorService. %>
<turbo-frame id="db-cluster-content" target="_top" src="<%= rows_swarm_db_cluster_path %>">
  <div class="space-y-12">
    <%= render Ui::SkeletonComponent.new(:detail) %>
    <%= render Ui::SkeletonComponent.new(:detail) %>
  </div>
</turbo-frame>
</div>
