<% page_title "Swarm" %>
<% page_subtitle "Visão geral do cluster Swarm — nós, serviços e saúde da orquestração" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="currentColor" d="M17 13V6H8v16h16v-9Zm-7-5h5v5h-5Zm0 7h5v5h-5Zm12 5h-5v-5h5Z" />
    <path fill="currentColor" d="M28 11h-9V2h9Zm-7-2h5V4h-5Zm7 11h-2v2h2v6H4v-6h2v-2H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h24a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2" />
    <circle cx="7" cy="25" r="1" fill="currentColor" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= link_to swarm_services_path,
        class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-primary text-sm font-medium px-4 py-2 rounded-lg border border-border-subtle transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
    </svg>
    Serviços
  <% end %>
  <%= link_to swarm_nodes_path,
        class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-primary text-sm font-medium px-4 py-2 rounded-lg border border-border-subtle transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    Nós
  <% end %>
<% end %>

<%# swarm_info + nodes + info are three serial socket calls; behind a lazy
    frame the page paints at once — see Swarm::DashboardController#rows. %>
<turbo-frame id="swarm-content" refresh="morph" src="<%= rows_swarm_path %>">
  <%= render Ui::SkeletonComponent.new(:stats, count: 4, grid: "grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6") %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <%= render Ui::SkeletonComponent.new(:detail) %>
    <%= render Ui::SkeletonComponent.new(:detail) %>
  </div>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-32", "w-16", "w-14", "w-20", "w-16", "w-28" ], rows: 4) %>
</turbo-frame>
