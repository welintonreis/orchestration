<% page_title "Swarm Services" %>
<% page_subtitle "Serviços em execução no cluster — réplicas, imagem e política de restart" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="currentColor" d="m22.505 11.637l-5.989-3.5a1 1 0 0 0-1.008-.001l-6.011 3.5A1 1 0 0 0 9 12.5v7a1 1 0 0 0 .497.864l6.011 3.5A.96.96 0 0 0 16 24c.174 0 .36-.045.516-.137l5.989-3.5A1 1 0 0 0 23 19.5v-7a1 1 0 0 0-.495-.863m-6.494-1.48l4.007 2.343l-4.007 2.342l-4.023-2.342zM11 14.24l4 2.33v4.685l-4-2.33zm6 7.025v-4.683l4-2.338v4.683z" />
    <path fill="currentColor" d="M16 1a1 1 0 0 0-.504.136l-12 7A1 1 0 0 0 3 9v14a1 1 0 0 0 .496.864l12 7a1 1 0 0 0 1.008 0l11-6.417l-1.008-1.727L16 28.842L5 22.426V9.575l11-6.417l11 6.416V17h2V9a1 1 0 0 0-.496-.864l-12-7A1 1 0 0 0 16 1" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= link_to swarm_nodes_path,
        class: "inline-flex items-center gap-2 bg-surface-inset hover:bg-surface-active text-text-primary text-sm font-medium px-4 py-2 rounded-lg border border-border-subtle transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    View Nodes
  <% end %>
<% end %>

<turbo-frame id="services-content" src="<%= rows_swarm_services_path %>">
  <%# Skeleton — summary cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 animate-pulse">
    <% 3.times do %>
      <div class="bg-surface-raised border border-border rounded-xl p-5">
        <div class="h-8 w-12 bg-surface-inset rounded mb-2"></div>
        <div class="h-3 w-24 bg-surface-inset rounded"></div>
      </div>
    <% end %>
  </div>

  <%# Skeleton — table %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden animate-pulse">
    <div class="px-4 py-3 border-b border-border">
      <div class="h-8 w-52 bg-surface-inset rounded"></div>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-surface-inset/50">
        <tr>
          <th class="px-4 py-3 w-8"><div class="w-3.5 h-3.5 bg-surface-active rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-16 bg-surface-active rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-20 bg-surface-active rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-14 bg-surface-active rounded"></div></th>
          <th class="px-4 py-3"><div class="h-3 w-16 bg-surface-active rounded"></div></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <% 8.times do %>
          <tr>
            <td class="px-4 py-3"><div class="w-3.5 h-3.5 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-surface-inset rounded flex-shrink-0"></div>
                <div class="h-3.5 w-36 bg-surface-inset rounded"></div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-3 w-48 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3"><div class="h-5 w-14 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-16 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <div class="h-6 w-14 bg-surface-inset rounded"></div>
                <div class="h-6 w-16 bg-surface-inset rounded"></div>
                <div class="h-6 w-20 bg-surface-inset rounded"></div>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
