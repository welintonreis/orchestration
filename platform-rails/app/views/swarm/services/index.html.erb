<% page_title "Swarm Services" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 32 32">
    <path d="M0 0h32v32H0z" fill="none" />
    <path fill="currentColor" d="m22.505 11.637l-5.989-3.5a1 1 0 0 0-1.008-.001l-6.011 3.5A1 1 0 0 0 9 12.5v7a1 1 0 0 0 .497.864l6.011 3.5A.96.96 0 0 0 16 24c.174 0 .36-.045.516-.137l5.989-3.5A1 1 0 0 0 23 19.5v-7a1 1 0 0 0-.495-.863m-6.494-1.48l4.007 2.343l-4.007 2.342l-4.023-2.342zM11 14.24l4 2.33v4.685l-4-2.33zm6 7.025v-4.683l4-2.338v4.683z" />
    <path fill="currentColor" d="M16 1a1 1 0 0 0-.504.136l-12 7A1 1 0 0 0 3 9v14a1 1 0 0 0 .496.864l12 7a1 1 0 0 0 1.008 0l11-6.417l-1.008-1.727L16 28.842L5 22.426V9.575l11-6.417l11 6.416V17h2V9a1 1 0 0 0-.496-.864l-12-7A1 1 0 0 0 16 1" />
  </svg>
<% end %>

<% content_for :actions do %>
  <%= link_to swarm_nodes_path,
        class: "inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-gray-200 text-sm font-medium px-4 py-2 rounded-lg border border-gray-700 transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    View Nodes
  <% end %>
<% end %>

<%# ── Summary cards ── %>
<% managers_count = @nodes.count { |n| n.dig("Spec", "Role") == "manager" } %>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <div class="text-3xl font-bold text-white"><%= @services.size %></div>
    <div class="text-sm text-gray-400 mt-1">Total Services</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <div class="text-3xl font-bold text-white"><%= @nodes.size %></div>
    <div class="text-sm text-gray-400 mt-1">Total Nodes</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <div class="text-3xl font-bold text-white"><%= managers_count %></div>
    <div class="text-sm text-gray-400 mt-1">Managers</div>
  </div>
</div>

<%# ── Services table ── %>
<% if @services.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
    </svg>
    <p class="text-gray-400 text-sm">No services deployed.</p>
  </div>
<% else %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden"
       x-data="{ perPage: 10, page: 1, total: <%= @services.size %> }">
    <table class="w-full text-sm">
      <thead class="bg-gray-800/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Image</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Mode</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Replicas</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Updated</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @services.each_with_index do |s, idx| %>
          <%
            service_name  = s.dig("Spec", "Name") || "—"
            raw_image     = s.dig("Spec", "TaskTemplate", "ContainerSpec", "Image") || ""
            image         = raw_image.split("@").first
            mode_key      = s.dig("Spec", "Mode")&.keys&.first || "—"
            running       = s.dig("ServiceStatus", "RunningTasks") || 0
            desired       = s.dig("ServiceStatus", "DesiredTasks") || s.dig("Spec", "Mode", "Replicated", "Replicas") || 0
            global_mode   = mode_key.downcase == "global"

            if global_mode
              replicas_label = "global"
              replicas_color = "text-gray-300"
            else
              replicas_label = "#{running}/#{desired}"
              replicas_color = (running.to_i >= desired.to_i && desired.to_i > 0) ? "text-green-400" : "text-red-400"
            end

            updated_at = (Time.parse(s["UpdatedAt"]) rescue nil)
            current_replicas = s.dig("Spec", "Mode", "Replicated", "Replicas").to_i
          %>
          <tr class="hover:bg-gray-800/30 transition-colors"
              x-data="{ scaleInput: <%= current_replicas %> }"
              x-show="perPage === 0 || ((<%= idx %>) >= (page - 1) * perPage && (<%= idx %>) < page * perPage)">
            <td class="px-4 py-3 font-mono text-gray-100 font-medium"><%= service_name %></td>
            <td class="px-4 py-3 font-mono text-gray-400 text-xs truncate max-w-xs"><%= image %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">
                <%= mode_key %>
              </span>
            </td>
            <td class="px-4 py-3 font-mono font-semibold <%= replicas_color %>"><%= replicas_label %></td>
            <td class="px-4 py-3 text-gray-400 text-xs"><%= updated_at ? human_age(updated_at) : "—" %></td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <% unless global_mode %>
                  <%= form_with url: scale_swarm_service_path(id: s["ID"]), method: :post,
                                class: "flex items-center gap-1" do |f| %>
                    <input type="number" name="replicas"
                           x-model="scaleInput"
                           min="0" max="99"
                           class="w-14 px-1.5 py-1 text-xs bg-gray-800 border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-cyan-600 text-center">
                    <button type="submit"
                            class="px-2 py-1 text-xs font-medium bg-cyan-800/40 hover:bg-cyan-700/50 text-cyan-300 border border-cyan-700/50 rounded transition-colors whitespace-nowrap">
                      Escalar
                    </button>
                  <% end %>
                <% end %>
                <%= button_to drain_swarm_service_path(id: s["ID"]),
                              method: :post,
                              class: "px-2 py-1 text-xs font-medium bg-orange-900/30 hover:bg-orange-800/40 text-orange-400 border border-orange-800/40 rounded transition-colors whitespace-nowrap",
                              form: { data: { turbo_confirm: "Desidratar #{service_name}? Zera réplicas." } } do %>
                  Desidratar
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination" %>
  </div>
<% end %>
