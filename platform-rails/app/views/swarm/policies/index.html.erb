<% content_for :title, "Políticas do Swarm" %>
<% page_subtitle "Regras de placement, restrições e configurações de orquestração do Swarm" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 48 48">
    <path d="M0 0h48v48H0z" fill="none" />
    <g fill="currentColor">
      <path d="M18 11a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H19a1 1 0 0 1-1-1m-3 5a1 1 0 1 0 0 2h18a1 1 0 1 0 0-2zm-1 5a1 1 0 0 1 1-1h18a1 1 0 1 1 0 2H15a1 1 0 0 1-1-1m1 3a1 1 0 1 0 0 2h18a1 1 0 1 0 0-2z" />
      <path fill-rule="evenodd" d="M38 36a4 4 0 0 1-4 4h-3v4l-3-1.5l-3 1.5v-4H14a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4h20a4 4 0 0 1 4 4zM14 6a2 2 0 0 0-2 2v28a2 2 0 0 0 2 2h11v-2.354a4 4 0 1 1 6 0V38h3a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zm15 30.874a4 4 0 0 1-2 0v3.89l1-.5l1 .5zM28 35a2 2 0 1 0 0-4a2 2 0 0 0 0 4" clip-rule="evenodd" />
    </g>
  </svg>
<% end %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-text-primary">Políticas de Placement</h2>
  <p class="text-sm text-text-secondary mt-0.5">Constraints e preferências de agendamento de tarefas nos serviços Swarm</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
  <div class="bg-surface-raised border border-border rounded-xl p-4">
    <p class="text-xs text-text-muted uppercase tracking-wider mb-1">Regras Ativas</p>
    <p class="text-2xl font-bold text-text-primary"><%= @placement_rules.count %></p>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-4">
    <p class="text-xs text-text-muted uppercase tracking-wider mb-1">Nós no Cluster</p>
    <p class="text-2xl font-bold text-text-primary"><%= @nodes.count %></p>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-4">
    <p class="text-xs text-text-muted uppercase tracking-wider mb-1">Labels de Nó</p>
    <p class="text-2xl font-bold text-text-primary"><%= @node_labels.count %></p>
    <p class="text-xs text-text-muted truncate"><%= @node_labels.first(3).join(", ") %></p>
  </div>
</div>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden mb-6">
  <div class="px-4 py-3 border-b border-border flex items-center justify-between">
    <h3 class="text-sm font-semibold text-text-primary">Regras de Placement por Serviço</h3>
  </div>
  <% if @placement_rules.empty? %>
    <div class="text-center py-12 text-text-muted">
      <p class="text-sm">Nenhuma regra de placement configurada</p>
      <p class="text-xs mt-1 text-text-muted">Configure placement constraints nas specs dos serviços Docker</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-xs text-text-muted uppercase border-b border-border">
          <th class="px-4 py-3 text-left">Serviço</th>
          <th class="px-4 py-3 text-left">Tipo</th>
          <th class="px-4 py-3 text-left">Regra</th>
        </tr>
      </thead>
      <tbody>
        <% @placement_rules.each do |rule| %>
          <tr class="border-b border-border/50 hover:bg-surface-inset/20">
            <td class="px-4 py-3 font-mono text-xs text-text-secondary"><%= rule[:service] %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= rule[:type] == 'Constraint' ? 'bg-orange-900/30 text-orange-300 border border-orange-800/50' : 'bg-blue-900/30 text-blue-300 border border-blue-800/50' %>">
                <%= rule[:type] %>
              </span>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-text-secondary"><%= rule[:rule] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<div class="bg-surface-raised border border-border rounded-xl p-4">
  <h3 class="text-sm font-semibold text-text-primary mb-3">Labels dos Nós</h3>
  <% if @node_labels.empty? %>
    <p class="text-xs text-text-muted">Nenhum label configurado nos nós</p>
  <% else %>
    <div class="flex flex-wrap gap-2">
      <% @node_labels.each do |label| %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-surface-inset text-text-secondary border border-border-subtle">
          <%= label %>
        </span>
      <% end %>
    </div>
  <% end %>
  <p class="text-xs text-text-muted mt-3">Use esses labels como constraints: <code class="text-text-secondary">node.labels.&lt;label&gt; == value</code></p>
</div>
