<% page_title "Fleet" %>
<% page_subtitle "Visão consolidada de todos os clusters Kubernetes registrados" %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <% if @rows.empty? %>
    <div class="py-16 text-center text-sm text-text-muted">Nenhum environment Kubernetes cadastrado ainda.</div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Cluster</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Status</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Versão</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nodes</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Pods falhando</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Deployments degradados</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @rows.each do |row| %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-5 py-3 font-mono text-text-primary"><%= row[:environment].name %></td>
            <td class="px-5 py-3">
              <% if row[:online] %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300 border border-green-300 dark:border-green-800/50">Online</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300 border border-red-300 dark:border-red-800/50" title="<%= row[:error] %>">Offline</span>
              <% end %>
            </td>
            <% if row[:online] %>
              <td class="px-5 py-3 text-text-secondary text-xs"><%= row[:version] %></td>
              <td class="px-5 py-3 text-text-secondary"><%= row[:nodes_ready] %>/<%= row[:nodes_total] %></td>
              <td class="px-5 py-3 <%= row[:pods_failed] > 0 ? 'text-red-600 dark:text-red-400' : 'text-text-secondary' %>"><%= row[:pods_failed] %></td>
              <td class="px-5 py-3 <%= row[:deployments_degraded] > 0 ? 'text-amber-600 dark:text-amber-400' : 'text-text-secondary' %>"><%= row[:deployments_degraded] %></td>
            <% else %>
              <td class="px-5 py-3 text-text-muted" colspan="4">—</td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
