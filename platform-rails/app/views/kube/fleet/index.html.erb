<% page_title "Fleet" %>
<% page_subtitle "Visão consolidada de todos os clusters Kubernetes registrados" %>

<% if @environments.empty? %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
    <div class="py-16 text-center text-sm text-text-muted">Nenhum environment Kubernetes cadastrado ainda.</div>
  </div>
<% else %>
  <%# Each cluster costs 4 API calls, and an offline one holds the request for
    PROBE_TIMEOUT — load it behind a skeleton so the table paints at once. %>
  <turbo-frame id="fleet-content" refresh="morph" src="<%= kube_rows_fleet_path %>">
    <%= render Ui::SkeletonComponent.new(:table,
          columns: [ "w-32", "w-16", "w-20", "w-12", "w-8", "w-8" ],
          rows: @environments.size) %>
  </turbo-frame>
<% end %>
