<% page_title "Secrets" %>
<% page_subtitle "Secrets no namespace #{@namespace}" %>

<%= render "kube/namespace_selector" %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <div class="px-5 py-4 border-b border-border flex items-center justify-between">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Secrets</h2>
    <span class="text-xs text-text-muted"><%= @secrets.size %> item<%= @secrets.size == 1 ? "" : "s" %></span>
  </div>

  <% if @secrets.empty? %>
    <div class="py-16 text-center text-sm text-text-muted">Nenhum Secret encontrado</div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Tipo</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Chaves</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @secrets.each do |secret| %>
          <% name = secret.dig("metadata", "name") %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-5 py-3 font-mono text-text-primary"><%= name %></td>
            <td class="px-5 py-3 text-text-secondary text-xs"><%= secret["type"] %></td>
            <td class="px-5 py-3 text-text-secondary font-mono text-xs"><%= (secret["data"] || {}).keys.join(", ") %></td>
            <td class="px-5 py-3 text-right">
              <% if Current.user&.admin? || Current.user&.operator? %>
                <%= button_to "Remover", kube_secret_path(name, ns: @namespace), method: :delete,
                      data: { turbo_confirm: "Remover Secret #{name}?" },
                      class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-red-100 dark:bg-red-900/40 text-text-secondary hover:text-red-600 dark:hover:text-red-400 border border-border-subtle hover:border-red-300 dark:border-red-800 transition-colors" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
