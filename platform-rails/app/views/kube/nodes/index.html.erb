<% page_title "Nodes" %>
<% page_subtitle "Nodes do cluster" %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <div class="px-5 py-4 border-b border-border flex items-center justify-between">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Nodes</h2>
    <span class="text-xs text-text-muted"><%= @nodes.size %> item<%= @nodes.size == 1 ? "" : "s" %></span>
  </div>

  <% if @nodes.empty? %>
    <div class="py-16 text-center text-sm text-text-muted">Nenhum node encontrado</div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Status</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Versão</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">CPU/Mem alocável</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @nodes.each do |node| %>
          <% name = node.dig("metadata", "name") %>
          <% ready = node.dig("status", "conditions")&.find { |c| c["type"] == "Ready" } %>
          <% ready_class = ready&.dig("status") == "True" ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400" %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-5 py-3 font-mono text-text-primary"><%= name %></td>
            <td class="px-5 py-3 <%= ready_class %>"><%= ready&.dig("status") == "True" ? "Ready" : "NotReady" %></td>
            <td class="px-5 py-3 text-text-secondary text-xs"><%= node.dig("status", "nodeInfo", "kubeletVersion") %></td>
            <td class="px-5 py-3 text-text-secondary text-xs"><%= node.dig("status", "allocatable", "cpu") %> / <%= node.dig("status", "allocatable", "memory") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% unless @top_pods.present? %>
    <div class="px-5 py-3 text-xs text-text-muted border-t border-border">metrics-server não detectado — colunas de uso ao vivo indisponíveis.</div>
  <% end %>
</div>
