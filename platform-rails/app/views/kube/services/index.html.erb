<% page_title "Services" %>
<% page_subtitle "Services no namespace #{@namespace}" %>

<%# Namespaces + services are two serial API calls. The namespace picker
    needs the namespace list, another API call, so it rides inside the
    frame; target="_top" keeps its submit a full-page visit, which is what
    keeps the URL and the subtitle in sync. See
    Kube::ServicesController#rows. %>
<turbo-frame id="services-content" refresh="morph" target="_top" src="<%= kube_rows_services_path(ns: @namespace) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar, css_class: "mb-4") %>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-40", "w-20", "w-24", "w-28", :actions ], rows: 6) %>
</turbo-frame>
