<% page_title "ConfigMaps" %>
<% page_subtitle "ConfigMaps no namespace #{@namespace}" %>

<%# Namespaces + configmaps are two serial API calls. The namespace picker
    needs the namespace list, another API call, so it rides inside the
    frame; target="_top" keeps its submit a full-page visit, which is what
    keeps the URL and the subtitle in sync. See
    Kube::ConfigMapsController#rows. %>
<turbo-frame id="configmaps-content" refresh="morph" target="_top" src="<%= kube_rows_config_maps_path(ns: @namespace) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar, css_class: "mb-4") %>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-40", "w-56", :actions ], rows: 6) %>
</turbo-frame>
