<% page_title "Apply Manifest" %>
<% page_subtitle "kubectl apply -f - contra o cluster do environment ativo" %>

<div class="bg-surface-raised border border-border rounded-xl p-6">
  <%= form_with url: kube_apply_path, method: :post, local: true do %>
    <textarea name="yaml_content" rows="18" placeholder="apiVersion: apps/v1&#10;kind: Deployment&#10;..."
      class="w-full bg-surface-sunken border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary placeholder-text-muted font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors"><%= params[:yaml_content] %></textarea>
    <div class="mt-4">
      <button type="submit" class="btn-primary">Apply</button>
    </div>
  <% end %>

  <% if @output %>
    <div class="mt-6">
      <h3 class="text-sm font-semibold text-text-primary mb-2">Output</h3>
      <pre class="bg-surface-sunken border border-border-subtle rounded-lg p-4 text-xs font-mono whitespace-pre-wrap overflow-auto max-h-96"><%= @output %></pre>
    </div>
  <% end %>
</div>
