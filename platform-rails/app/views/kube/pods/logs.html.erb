<% page_title "Logs — #{@pod_name}" %>

<% content_for :title_actions do %>
  <div class="flex items-center gap-2 flex-wrap">
    <div class="flex items-center gap-1 bg-surface-inset rounded-lg p-1">
      <% [100, 200, 500, 1000].each do |n| %>
        <%= link_to n, kube_pod_logs_path(@pod_name, ns: @namespace, tail: n, container: params[:container]),
              class: "px-2.5 py-1 rounded text-xs font-medium transition-colors #{@tail == n ? 'bg-surface-active text-text-primary' : 'text-text-secondary hover:text-text-primary'}" %>
      <% end %>
    </div>
    <%= link_to kube_pods_path(ns: @namespace),
          class: "px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary bg-surface-inset hover:bg-surface-active border border-border-subtle rounded-lg transition-colors" do %>
      ← Pods
    <% end %>
  </div>
<% end %>

<div class="bg-surface-sunken border border-border rounded-xl overflow-hidden">
  <pre class="overflow-auto p-4 text-xs font-mono leading-5 min-h-[200px] max-h-[calc(100vh-260px)]"><%= @logs %></pre>
</div>
