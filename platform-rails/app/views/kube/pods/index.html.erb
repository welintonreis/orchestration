<% page_title "Pods" %>
<% page_subtitle "Pods no namespace #{@namespace}" %>

<%# Namespaces + pods are two serial API calls. The namespace picker needs
    the namespace list, another API call, so it rides inside the frame;
    target="_top" keeps its submit a full-page visit, which is what keeps
    the URL and the subtitle in sync. See Kube::PodsController#rows. %>
<turbo-frame id="pods-content" refresh="morph" target="_top" src="<%= kube_rows_pods_path(ns: @namespace) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar, css_class: "mb-4") %>
  <%= render Ui::SkeletonComponent.new(:table,
        columns: [ "w-48", "w-16", "w-8", "w-32", :actions ], rows: 8) %>
</turbo-frame>
