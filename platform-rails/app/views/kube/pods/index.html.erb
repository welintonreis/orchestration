<% page_title "Pods" %>
<% page_subtitle "Pods no namespace #{@namespace}" %>

<%= render "kube/namespace_selector" %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <div class="px-5 py-4 border-b border-border flex items-center justify-between">
    <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider">Pods</h2>
    <span class="text-xs text-text-muted"><%= @pods.size %> item<%= @pods.size == 1 ? "" : "s" %></span>
  </div>

  <% if @pods.empty? %>
    <div class="py-16 text-center text-sm text-text-muted">Nenhum pod encontrado neste namespace</div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left">
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Fase</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Restarts</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Node</th>
          <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% @pods.each do |pod| %>
          <% name = pod.dig("metadata", "name") %>
          <% phase = pod.dig("status", "phase") %>
          <% restarts = pod.dig("status", "containerStatuses")&.sum { |c| c["restartCount"].to_i } || 0 %>
          <% phase_class = { "Running" => "text-green-600 dark:text-green-400", "Pending" => "text-amber-600 dark:text-amber-400", "Failed" => "text-red-600 dark:text-red-400" }[phase] || "text-text-secondary" %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-5 py-3 font-mono text-text-primary"><%= name %></td>
            <td class="px-5 py-3 <%= phase_class %>"><%= phase %></td>
            <td class="px-5 py-3 text-text-secondary"><%= restarts %></td>
            <td class="px-5 py-3 text-text-secondary"><%= pod.dig("spec", "nodeName") %></td>
            <td class="px-5 py-3 text-right space-x-2">
              <%= link_to "Logs", kube_pod_logs_path(name, ns: @namespace), class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
              <%= link_to "Terminal", kube_pod_terminal_path(name, ns: @namespace), class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
              <% if Current.user&.admin? || Current.user&.operator? %>
                <%= button_to "Remover", kube_pod_path(name, ns: @namespace), method: :delete,
                      class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-red-100 dark:bg-red-900/40 text-text-secondary hover:text-red-600 dark:hover:text-red-400 border border-border-subtle hover:border-red-300 dark:border-red-800 transition-colors",
                      data: { turbo_confirm: "Remover pod #{name}?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
