<% page_title "Workloads" %>
<% page_subtitle "Deployments, StatefulSets e DaemonSets no namespace #{@namespace}" %>

<%# Deployments + StatefulSets + DaemonSets are three serial API calls. The
    namespace picker needs the namespace list, another API call, so it rides
    inside the frame; target="_top" keeps its submit a full-page visit,
    which is what keeps the URL and the subtitle in sync. See
    Kube::WorkloadsController#rows. %>
<turbo-frame id="workloads-content" refresh="morph" target="_top" src="<%= kube_rows_workloads_path(ns: @namespace) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar, css_class: "mb-4") %>
  <% 3.times do %>
    <%= render Ui::SkeletonComponent.new(:table,
          columns: [ "w-40", "w-56", "w-12", :actions ], rows: 3, css_class: "mb-6") %>
  <% end %>
</turbo-frame>
