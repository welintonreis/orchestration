<% page_title "Workloads" %>
<% page_subtitle "Deployments, StatefulSets e DaemonSets no namespace #{@namespace}" %>

<%= render "kube/namespace_selector" %>

<% [["Deployments", @deployments, "deployment"], ["StatefulSets", @statefulsets, "statefulset"], ["DaemonSets", @daemonsets, "daemonset"]].each do |title, items, kind| %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider"><%= title %></h2>
      <span class="text-xs font-mono text-text-muted"><%= items.size %> item<%= items.size == 1 ? "" : "s" %></span>
    </div>

    <% if items.empty? %>
      <div class="py-10 text-center text-sm text-text-muted">Nenhum encontrado</div>
    <% else %>
      <%= render Ui::TableComponent.new(headers: ["Nome", "Imagem", "Réplicas", { label: "Ações", align: :right }]) do %>
        <% items.each do |w| %>
          <% name = w.dig("metadata", "name") %>
          <% image = w.dig("spec", "template", "spec", "containers", 0, "image") %>
          <% ready = w.dig("status", "readyReplicas").to_i %>
          <% desired = w.dig("spec", "replicas").to_i %>
          <tr class="hover:bg-surface-inset/30 transition-colors">
            <td class="px-4 py-3 font-mono text-text-primary"><%= name %></td>
            <td class="px-4 py-3 text-text-secondary font-mono text-xs"><%= image %></td>
            <td class="px-4 py-3 text-text-secondary font-mono text-xs"><%= ready %>/<%= desired %></td>
            <td class="px-4 py-3 text-right">
              <% if Current.user&.admin? || Current.user&.operator? %>
                <div class="flex items-center justify-end gap-2">
                  <%= render Ui::ButtonComponent.new(url: kube_workload_scale_path(kind: kind, name: name, ns: @namespace, replicas: [desired - 1, 0].max), method: :post,
                        variant: :gray, size: :sm, label: "Scale −1") %>
                  <%= render Ui::ButtonComponent.new(url: kube_workload_scale_path(kind: kind, name: name, ns: @namespace, replicas: desired + 1), method: :post,
                        variant: :gray, size: :sm, label: "Scale +1") %>
                  <%= render Ui::ButtonComponent.new(url: kube_workload_restart_path(kind: kind, name: name, ns: @namespace), method: :post,
                        variant: :cyan, icon: :restart, title: "Restart", confirm: "Restart #{name}?") %>
                  <%= render Ui::ButtonComponent.new(url: kube_workload_path(kind: kind, name: name, ns: @namespace), method: :delete,
                        variant: :red, icon: :remove, title: "Remover", confirm: "Remover #{name}?") %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
