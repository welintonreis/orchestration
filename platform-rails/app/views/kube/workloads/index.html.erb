<% page_title "Workloads" %>
<% page_subtitle "Deployments, StatefulSets e DaemonSets no namespace #{@namespace}" %>

<%= render "kube/namespace_selector" %>

<% [["Deployments", @deployments, "deployment"], ["StatefulSets", @statefulsets, "statefulset"], ["DaemonSets", @daemonsets, "daemonset"]].each do |title, items, kind| %>
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <h2 class="text-sm font-semibold text-text-secondary uppercase tracking-wider"><%= title %></h2>
      <span class="text-xs text-text-muted"><%= items.size %> item<%= items.size == 1 ? "" : "s" %></span>
    </div>

    <% if items.empty? %>
      <div class="py-10 text-center text-sm text-text-muted">Nenhum encontrado</div>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Nome</th>
            <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Imagem</th>
            <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Réplicas</th>
            <th class="px-5 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          <% items.each do |w| %>
            <% name = w.dig("metadata", "name") %>
            <% image = w.dig("spec", "template", "spec", "containers", 0, "image") %>
            <% ready = w.dig("status", "readyReplicas").to_i %>
            <% desired = w.dig("spec", "replicas").to_i %>
            <tr class="hover:bg-surface-inset/30 transition-colors">
              <td class="px-5 py-3 font-mono text-text-primary"><%= name %></td>
              <td class="px-5 py-3 text-text-secondary font-mono text-xs"><%= image %></td>
              <td class="px-5 py-3 text-text-secondary"><%= ready %>/<%= desired %></td>
              <td class="px-5 py-3 text-right space-x-2">
                <% if Current.user&.admin? || Current.user&.operator? %>
                  <%= button_to "Scale −1", kube_workload_scale_path(kind: kind, name: name, ns: @namespace), method: :post, params: { replicas: [desired - 1, 0].max },
                        class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
                  <%= button_to "Scale +1", kube_workload_scale_path(kind: kind, name: name, ns: @namespace), method: :post, params: { replicas: desired + 1 },
                        class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
                  <%= button_to "Restart", kube_workload_restart_path(kind: kind, name: name, ns: @namespace), method: :post,
                        data: { turbo_confirm: "Restart #{name}?" },
                        class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
                  <%= button_to "Remover", kube_workload_path(kind: kind, name: name, ns: @namespace), method: :delete,
                        data: { turbo_confirm: "Remover #{name}?" },
                        class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-red-100 dark:bg-red-900/40 text-text-secondary hover:text-red-600 dark:hover:text-red-400 border border-border-subtle hover:border-red-300 dark:border-red-800 transition-colors" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
