<% page_title "Sign in" %>

<!-- Logo / Brand -->
<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-red-600 mb-4">
    <svg class="w-8 h-8 text-text-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
    </svg>
  </div>
  <h1 class="text-2xl font-bold text-text-primary">Redhusk Orchestration</h1>
  <p class="mt-1 text-sm text-text-secondary">Sign in to your account</p>
</div>

<!-- Card -->
<div class="bg-surface-raised border border-border rounded-2xl px-8 py-8 shadow-xl">

  <%= form_with url: session_url, class: "space-y-5" do |form| %>

    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "you@example.com",
            value: params[:email_address],
            class: "block w-full rounded-lg bg-surface-inset border border-border-subtle text-text-primary placeholder-text-muted px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "block text-sm font-medium text-text-secondary mb-1.5" %>
      <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            placeholder: "Your password",
            maxlength: 72,
            class: "block w-full rounded-lg bg-surface-inset border border-border-subtle text-text-primary placeholder-text-muted px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" %>
    </div>

    <div class="flex items-center justify-between pt-1">
      <%= form.submit "Sign in",
            class: "rounded-lg bg-red-600 hover:bg-red-500 active:bg-red-700 text-text-primary font-semibold text-sm px-5 py-2.5 transition cursor-pointer" %>
      <%= link_to "Forgot password?", new_password_path,
            class: "text-sm text-text-secondary hover:text-text-primary transition" %>
    </div>

  <% end %>
</div>
