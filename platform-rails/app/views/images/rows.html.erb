<turbo-frame id="images-content">
<%
  grouped = @images.group_by do |img|
    raw = img["RepoTags"]&.first || "<none>:<none>"
    raw == "<none>:<none>" ? "<none>" : raw.split(":")[0..-2].join(":")
  end.sort_by { |repo, _| repo }

  all_ids = @images.map { |i| i["Id"] }
  all_ids_js = "[#{all_ids.map { |id| "'#{id}'" }.join(',')}]"
%>

<% if @images.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>
    <p class="text-gray-400 text-sm">No images found.</p>
    <p class="text-gray-600 text-xs mt-1">Pull an image with <span class="font-mono text-gray-500">docker pull &lt;name&gt;</span></p>
  </div>
<% else %>
  <div x-data="{
    selected: [],
    toggle(id) {
      if (this.selected.includes(id)) {
        this.selected = this.selected.filter(s => s !== id);
      } else {
        this.selected.push(id);
      }
    },
    toggleGroup(ids) {
      const all = ids.every(id => this.selected.includes(id));
      if (all) {
        this.selected = this.selected.filter(id => !ids.includes(id));
      } else {
        ids.forEach(id => { if (!this.selected.includes(id)) this.selected.push(id); });
      }
    },
    toggleAll(ids) {
      const allSelected = ids.every(id => this.selected.includes(id));
      this.selected = allSelected ? [] : [...ids];
    },
    groupSelected(ids) { return ids.length > 0 && ids.every(id => this.selected.includes(id)); },
    groupIndeterminate(ids) {
      const count = ids.filter(id => this.selected.includes(id)).length;
      return count > 0 && count < ids.length;
    }
  }">

    <div x-show="selected.length > 0"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 -translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         class="mb-4 flex items-center justify-between bg-red-950/40 border border-red-800/50 rounded-xl px-4 py-3">
      <span class="text-sm text-red-300">
        <span x-text="selected.length"></span> imagem(ns) selecionada(s)
      </span>
      <form method="post" action="<%= batch_remove_images_path %>"
            x-ref="batchForm"
            data-turbo-confirm="Remover as imagens selecionadas? Esta ação não pode ser desfeita.">
        <input type="hidden" name="_method" value="delete">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <template x-for="id in selected" :key="id">
          <input type="hidden" name="ids[]" :value="id">
        </template>
        <button type="submit"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-red-700/50 hover:bg-red-600/60 text-red-200 border border-red-600/60 rounded-lg transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Remover selecionadas
        </button>
      </form>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-800 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <input type="checkbox"
                 class="w-4 h-4 rounded border-gray-600 bg-gray-800 text-cyan-500 focus:ring-0 cursor-pointer"
                 :checked="<%= all_ids_js %>.every(id => selected.includes(id))"
                 :indeterminate="selected.length > 0 && !<%= all_ids_js %>.every(id => selected.includes(id))"
                 @change="toggleAll(<%= all_ids_js %>)">
          <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">
            <%= grouped.size %> repositório<%= grouped.size == 1 ? "" : "s" %> · <%= @images.size %> imagem<%= @images.size == 1 ? "" : "ns" %>
          </span>
        </div>
        <% orphan_ids = @images.select { |i| i["_unused"] }.map { |i| i["Id"] } %>
        <% if orphan_ids.any? && (Current.user&.admin? || Current.user&.operator?) %>
          <form method="post" action="<%= batch_remove_images_path %>"
                data-turbo-confirm="Remover <%= orphan_ids.size %> imagem(ns) não utilizada(s)? Esta ação não pode ser desfeita.">
            <input type="hidden" name="_method" value="delete">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <% orphan_ids.each do |id| %>
              <input type="hidden" name="ids[]" value="<%= id %>">
            <% end %>
            <button type="submit"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-orange-900/40 hover:bg-orange-800/50 text-orange-300 border border-orange-700/40 rounded-lg transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Limpar <%= orphan_ids.size %> órfã<%= orphan_ids.size == 1 ? "" : "s" %>
            </button>
          </form>
        <% end %>
      </div>

      <table class="w-full text-xs">
        <thead>
          <tr class="bg-gray-800/40 border-b border-gray-800/60">
            <th class="w-10 pl-4 pr-2 py-2"></th>
            <th class="w-7 py-2"></th>
            <th class="px-4 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Tag</th>
            <th class="px-4 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Tamanho</th>
            <th class="px-4 py-2 text-left text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Criado</th>
            <th class="px-4 py-2 text-right text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>

        <% grouped.each do |repo, imgs| %>
          <% group_ids = imgs.map { |i| i["Id"] }
             group_ids_js = "[#{group_ids.map { |id| "'#{id}'" }.join(',')}]" %>
          <tbody x-data="{ open: false }" class="border-t border-gray-800/60">
            <tr class="hover:bg-gray-800/30 transition-colors cursor-pointer" @click="open = !open">
              <td class="pl-4 pr-2 py-3" @click.stop>
                <input type="checkbox"
                       class="w-4 h-4 rounded border-gray-600 bg-gray-800 text-cyan-500 focus:ring-0 cursor-pointer"
                       :checked="groupSelected(<%= group_ids_js %>)"
                       :indeterminate="groupIndeterminate(<%= group_ids_js %>)"
                       @change="toggleGroup(<%= group_ids_js %>)">
              </td>
              <td class="pr-1 py-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-3.5 h-3.5 text-gray-500 transition-transform duration-150"
                     :class="open ? 'rotate-90' : ''"
                     viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
              </td>
              <td class="px-4 py-3" colspan="2">
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 rounded-md bg-gray-800 border border-gray-700 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 16 16">
                      <path d="M0 0h16v16H0z" fill="none"/>
                      <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8s8-3.6 8-8s-3.6-8-8-8m7 8c0 1.1-.2 2.1-.7 3l-2.7-1.2c.2-.6.4-1.2.4-1.8c0-2.2-1.8-4-4-4c-.5 0-.9.1-1.4.3L5.4 1.5c.6-.2 1.2-.4 1.8-.5l.3 3H8V1c3.9 0 7 3.1 7 7M8 5c1.7 0 3 1.3 3 3s-1.3 3-3 3s-3-1.3-3-3s1.3-3 3-3M1 8c0-1.1.2-2.1.7-3l2.7 1.2C4.2 6.8 4 7.4 4 8c0 2.2 1.8 4 4 4c.5 0 .9-.1 1.4-.3l1.2 2.8c-.6.2-1.2.4-1.8.5l-.3-3H8v3c-3.9 0-7-3.1-7-7"/>
                      <path fill="currentColor" d="M10 8a2 2 0 1 1-3.999.001A2 2 0 0 1 10 8"/>
                    </svg>
                  </div>
                  <span class="font-mono text-sm text-gray-200 truncate"><%= repo %></span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-gray-800 text-gray-400 border border-gray-700">
                    <%= imgs.size %> tag<%= imgs.size == 1 ? "" : "s" %>
                  </span>
                </div>
              </td>
              <td class="px-4 py-3 text-gray-500"><%= human_bytes(imgs.sum { |i| i["Size"].to_i }) %></td>
              <td class="px-4 py-3 text-gray-600">—</td>
              <td class="px-4 py-3"></td>
            </tr>

            <% imgs.each do |img| %>
              <%
                raw_tag     = img["RepoTags"]&.first || "<none>:<none>"
                tag_part    = raw_tag == "<none>:<none>" ? "<none>" : raw_tag.split(":").last
                short_id    = img["Id"].to_s.sub("sha256:", "")[0..11]
                img_id_safe = img["Id"]
              %>
              <tr class="hover:bg-gray-800/20 transition-colors bg-gray-900/60 border-t border-gray-800/30"
                  x-show="open" style="display:none">
                <td class="pl-4 pr-2 py-2.5">
                  <input type="checkbox"
                         class="w-4 h-4 rounded border-gray-600 bg-gray-800 text-cyan-500 focus:ring-0 cursor-pointer"
                         :checked="selected.includes('<%= img_id_safe %>')"
                         @change="toggle('<%= img_id_safe %>')">
                </td>
                <td class="py-2.5"></td>
                <td class="px-4 py-2.5 font-mono text-gray-300">
                  <div class="flex items-center gap-2">
                    <%= link_to tag_part, image_path(img_id_safe), class: "hover:text-white transition-colors", data: { turbo_frame: "_top" } %>
                    <% if img["_dangling"] %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-orange-900/40 text-orange-400 border border-orange-700/50 whitespace-nowrap">Dangling</span>
                    <% elsif img["_unused"] %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-yellow-900/40 text-yellow-400 border border-yellow-700/50 whitespace-nowrap">Não utilizado</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-2.5 font-mono text-gray-500"><%= short_id %></td>
                <td class="px-4 py-2.5 text-gray-400"><%= human_bytes(img["Size"]) %></td>
                <td class="px-4 py-2.5 text-gray-500"><%= human_age(Time.at(img["Created"].to_i)) %></td>
                <td class="px-4 py-2.5 text-right">
                  <%= button_to remove_image_path(CGI.escape(img_id_safe)),
                        method: :delete,
                        data: { turbo_confirm: "Remover imagem #{tag_part}? Esta ação não pode ser desfeita." },
                        class: "p-1.5 rounded bg-gray-800 hover:bg-red-900/40 text-gray-500 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                        title: "Remover" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>
</turbo-frame>
