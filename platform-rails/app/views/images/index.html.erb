<% page_title "Images" %>
<% page_subtitle "Imagens Docker disponíveis no host — pull, inspect e remoção" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 16 16">
    <path d="M0 0h16v16H0z" fill="none" />
    <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8s8-3.6 8-8s-3.6-8-8-8m7 8c0 1.1-.2 2.1-.7 3l-2.7-1.2c.2-.6.4-1.2.4-1.8c0-2.2-1.8-4-4-4c-.5 0-.9.1-1.4.3L5.4 1.5c.6-.2 1.2-.4 1.8-.5l.3 3H8V1c3.9 0 7 3.1 7 7M8 5c1.7 0 3 1.3 3 3s-1.3 3-3 3s-3-1.3-3-3s1.3-3 3-3M1 8c0-1.1.2-2.1.7-3l2.7 1.2C4.2 6.8 4 7.4 4 8c0 2.2 1.8 4 4 4c.5 0 .9-.1 1.4-.3l1.2 2.8c-.6.2-1.2.4-1.8.5l-.3-3H8v3c-3.9 0-7-3.1-7-7" />
    <path fill="currentColor" d="M10 8a2 2 0 1 1-3.999.001A2 2 0 0 1 10 8" />
  </svg>
<% end %>

<% content_for :title_actions do %>
  <% if Current.user&.operator? || Current.user&.admin? %>
    <%# Botão pull manual rápido + busca em registry %>
    <button type="button"
            onclick="document.getElementById('pull-search-dialog').showModal()"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-cyan-700/50 hover:bg-cyan-600/60 text-cyan-200 border border-cyan-600/50 rounded-lg transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      Pull / Buscar
    </button>
  <% end %>
<% end %>

<%# Modal de pull / busca em registry público %>
<dialog id="pull-search-dialog"
        class="w-full max-w-2xl rounded-xl bg-surface-raised border border-border shadow-2xl p-0 backdrop:bg-black/60"
        @click.self="this.close()"
        x-init>
  <div class="flex items-center justify-between px-5 py-4 border-b border-border">
    <div>
      <h3 class="text-base font-semibold text-text-primary">Pull de Imagem</h3>
      <p class="text-xs text-text-muted mt-0.5">Busque em registries públicos ou faça pull direto por nome</p>
    </div>
    <button type="button" onclick="document.getElementById('pull-search-dialog').close()"
            class="p-1 rounded text-text-muted hover:text-text-primary transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="p-5 space-y-5">
    <%# Pull direto por nome %>
    <div>
      <p class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">Pull direto</p>
      <%= form_with url: pull_images_path, method: :post, data: { turbo_frame: "_top", controller: "pull-progress" },
            class: "flex items-center gap-2" do |f| %>
        <%= f.text_field :image, placeholder: "nginx, postgres:15, ghcr.io/user/app",
              class: "flex-1 bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500 font-mono",
              autofocus: false %>
        <%= f.text_field :tag, value: "latest", placeholder: "tag",
              class: "w-24 bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500 font-mono" %>
        <%= f.submit "Pull",
              class: "px-4 py-2 text-sm font-medium bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors cursor-pointer" %>
      <% end %>
      <p class="mt-1 text-xs text-text-muted">Formatos: <code class="font-mono">nginx</code>, <code class="font-mono">nginx:1.25</code>, <code class="font-mono">ghcr.io/user/app:sha</code></p>
    </div>

    <%# Busca em registries públicos %>
    <% searchable_registries = SwarmRegistry.public_registries.searchable.order(:name) %>
    <% if searchable_registries.any? %>
      <div class="border-t border-border pt-4">
        <p class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">Buscar em registry público</p>
        <turbo-frame id="registry-search" src="<%= search_images_path %>">
          <div class="py-4 text-center text-text-muted text-xs animate-pulse">Carregando…</div>
        </turbo-frame>
      </div>
    <% else %>
      <div class="border-t border-border pt-4">
        <p class="text-xs text-text-muted">
          Nenhum registry público com busca configurado.
          <%= link_to "Adicionar em Swarm → Registries", new_swarm_registry_path, class: "text-cyan-500 hover:text-cyan-400", data: { turbo_frame: "_top" } %>.
        </p>
      </div>
    <% end %>
  </div>
</dialog>

<turbo-frame id="images-content" src="<%= rows_images_path(per_page: params[:per_page], q: params[:q], page: params[:page]) %>">
  <div class="bg-surface-raised border border-border rounded-xl overflow-hidden animate-pulse">
    <div class="px-4 py-3 border-b border-border flex items-center justify-between">
      <div class="h-4 w-48 bg-surface-inset rounded"></div>
      <div class="h-7 w-32 bg-surface-inset rounded-lg"></div>
    </div>
    <table class="w-full text-xs">
      <thead>
        <tr class="bg-surface-inset/40 border-b border-border/60">
          <th class="w-10 pl-4 pr-2 py-2"><div class="w-4 h-4 bg-surface-active rounded"></div></th>
          <th class="w-7 py-2"></th>
          <th class="px-4 py-2"><div class="h-2.5 w-8 bg-surface-active rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-6 bg-surface-active rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-12 bg-surface-active rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-12 bg-surface-active rounded"></div></th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        <% 8.times do %>
          <tr class="border-t border-border/60">
            <td class="pl-4 pr-2 py-3"><div class="w-4 h-4 bg-surface-inset rounded"></div></td>
            <td class="pr-1 py-3"><div class="w-3.5 h-3.5 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3" colspan="2">
              <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 bg-surface-inset rounded"></div>
                <div class="h-3.5 w-40 bg-surface-inset rounded"></div>
                <div class="h-4 w-12 bg-surface-inset rounded"></div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-3 w-12 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-16 bg-surface-inset rounded"></div></td>
            <td class="px-4 py-3"></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
