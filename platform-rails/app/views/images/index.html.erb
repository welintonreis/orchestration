<% page_title "Images" %>

<% if @images.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>
    <p class="text-gray-400 text-sm">No images found.</p>
    <p class="text-gray-600 text-xs mt-1">Pull an image with <span class="font-mono text-gray-500">docker pull &lt;name&gt;</span></p>
  </div>
<% else %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-800/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Repository:Tag</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">ID</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Size</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Created</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @images.each do |i| %>
          <%
            raw_tag = i["RepoTags"]&.first || "<none>:<none>"
            display_tag = raw_tag == "<none>:<none>" ? "<none>" : raw_tag
            short_id = i["Id"].to_s.sub("sha256:", "")[0..11]
          %>
          <tr class="hover:bg-gray-800/30 transition-colors">
            <td class="px-4 py-3 font-mono text-gray-200"><%= display_tag %></td>
            <td class="px-4 py-3 font-mono text-gray-400 text-xs"><%= short_id %></td>
            <td class="px-4 py-3 text-gray-300"><%= human_bytes(i["Size"]) %></td>
            <td class="px-4 py-3 text-gray-400 text-xs"><%= human_age(Time.at(i["Created"].to_i)) %></td>
            <td class="px-4 py-3">
              <%= button_to "Remove",
                    remove_image_path(CGI.escape(i["Id"])),
                    method: :delete,
                    data: { turbo_confirm: "Remove this image? This cannot be undone." },
                    class: "inline-flex items-center px-3 py-1 rounded text-xs font-medium bg-red-900/40 text-red-400 border border-red-800/60 hover:bg-red-900/70 hover:text-red-300 transition-colors" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
