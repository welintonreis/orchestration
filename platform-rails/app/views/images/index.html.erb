<% page_title "Images" %>
<% page_subtitle "Imagens Docker disponíveis no host — pull, inspect e remoção" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 16 16">
    <path d="M0 0h16v16H0z" fill="none" />
    <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8s8-3.6 8-8s-3.6-8-8-8m7 8c0 1.1-.2 2.1-.7 3l-2.7-1.2c.2-.6.4-1.2.4-1.8c0-2.2-1.8-4-4-4c-.5 0-.9.1-1.4.3L5.4 1.5c.6-.2 1.2-.4 1.8-.5l.3 3H8V1c3.9 0 7 3.1 7 7M8 5c1.7 0 3 1.3 3 3s-1.3 3-3 3s-3-1.3-3-3s1.3-3 3-3M1 8c0-1.1.2-2.1.7-3l2.7 1.2C4.2 6.8 4 7.4 4 8c0 2.2 1.8 4 4 4c.5 0 .9-.1 1.4-.3l1.2 2.8c-.6.2-1.2.4-1.8.5l-.3-3H8v3c-3.9 0-7-3.1-7-7" />
    <path fill="currentColor" d="M10 8a2 2 0 1 1-3.999.001A2 2 0 0 1 10 8" />
  </svg>
<% end %>

<turbo-frame id="images-content" src="<%= rows_images_path %>">
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden animate-pulse">
    <div class="px-4 py-3 border-b border-gray-800 flex items-center justify-between">
      <div class="h-4 w-48 bg-gray-800 rounded"></div>
      <div class="h-7 w-32 bg-gray-800 rounded-lg"></div>
    </div>
    <table class="w-full text-xs">
      <thead>
        <tr class="bg-gray-800/40 border-b border-gray-800/60">
          <th class="w-10 pl-4 pr-2 py-2"><div class="w-4 h-4 bg-gray-700 rounded"></div></th>
          <th class="w-7 py-2"></th>
          <th class="px-4 py-2"><div class="h-2.5 w-8 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-6 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-12 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-2"><div class="h-2.5 w-12 bg-gray-700 rounded"></div></th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% 8.times do %>
          <tr class="border-t border-gray-800/60">
            <td class="pl-4 pr-2 py-3"><div class="w-4 h-4 bg-gray-800 rounded"></div></td>
            <td class="pr-1 py-3"><div class="w-3.5 h-3.5 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3" colspan="2">
              <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 bg-gray-800 rounded"></div>
                <div class="h-3.5 w-40 bg-gray-800 rounded"></div>
                <div class="h-4 w-12 bg-gray-800 rounded"></div>
              </div>
            </td>
            <td class="px-4 py-3"><div class="h-3 w-12 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"><div class="h-3 w-16 bg-gray-800 rounded"></div></td>
            <td class="px-4 py-3"></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
