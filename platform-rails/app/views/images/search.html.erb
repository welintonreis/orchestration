<turbo-frame id="registry-search">
  <% if @registries.empty? %>
    <div class="py-8 text-center text-text-muted text-sm">
      <p>Nenhum registry público com busca configurado.</p>
      <p class="mt-1 text-xs">
        <%= link_to "Adicionar registry", new_swarm_registry_path, class: "text-cyan-500 hover:text-cyan-400", data: { turbo_frame: "_top" } %>
        e marque como público com API de busca.
      </p>
    </div>
  <% else %>
    <%# Formulário de busca %>
    <div class="mb-4 flex items-center gap-2">
      <%= form_with url: search_images_path, method: :get, data: { turbo_frame: "registry-search" }, class: "flex items-center gap-2 flex-1" do |f| %>
        <%= f.select :registry_id,
              @registries.map { |r| [r.name, r.id] },
              { selected: @registry&.id },
              class: "bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
        <%= f.text_field :q, value: @query, placeholder: "nginx, postgres, redis…",
              class: "flex-1 bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500",
              autofocus: true %>
        <%= f.submit "Buscar",
              class: "px-4 py-2 text-sm font-medium bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <%# Resultados %>
    <% if @query.present? && @results.empty? %>
      <p class="py-6 text-center text-text-muted text-sm">Nenhum resultado para "<%= @query %>" em <%= @registry&.name %>.</p>
    <% elsif @results.any? %>
      <div class="text-xs text-text-muted mb-2"><%= @results.size %> resultado(s) em <%= @registry&.name %></div>
      <div class="divide-y divide-border/50 max-h-96 overflow-y-auto">
        <% @results.each do |r| %>
          <div class="py-2.5 flex items-start gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-mono text-sm font-medium text-text-primary"><%= r.full_name %></span>
                <% if r.official %>
                  <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-blue-600/20 text-blue-400 border border-blue-600/40">OFFICIAL</span>
                <% end %>
                <% if r.stars > 0 %>
                  <span class="text-[11px] text-text-muted flex items-center gap-0.5">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <%= number_with_delimiter(r.stars) %>
                  </span>
                <% end %>
              </div>
              <% if r.description.present? %>
                <p class="text-xs text-text-muted mt-0.5 truncate"><%= r.description %></p>
              <% end %>
            </div>
            <%# Pull form %>
            <%= form_with url: pull_images_path, method: :post, data: { turbo_frame: "_top" }, class: "flex items-center gap-1.5 flex-shrink-0" do |f| %>
              <%= f.hidden_field :image, value: r.full_name %>
              <%= f.text_field :tag, value: "latest", placeholder: "tag",
                    class: "w-20 bg-surface-inset border border-border-subtle rounded px-2 py-1 text-xs text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500 font-mono" %>
              <%= f.submit "Pull",
                    class: "px-2.5 py-1 text-xs font-medium bg-cyan-700/60 hover:bg-cyan-600/70 text-cyan-200 border border-cyan-600/50 rounded transition-colors cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% elsif @query.blank? %>
      <p class="py-4 text-center text-text-muted text-xs">Digite um termo para buscar imagens em <%= @registry&.name %>.</p>
    <% end %>
  <% end %>
</turbo-frame>
