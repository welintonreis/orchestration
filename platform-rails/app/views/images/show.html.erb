<% short_id = @image["Id"].to_s.sub("sha256:", "").first(12) %>
<% page_title "Imagem #{short_id}" %>
<% page_subtitle @image["RepoTags"]&.first || "<none>:<none>" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 16 16">
    <path d="M0 0h16v16H0z" fill="none"/>
    <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8s8-3.6 8-8s-3.6-8-8-8m7 8c0 1.1-.2 2.1-.7 3l-2.7-1.2c.2-.6.4-1.2.4-1.8c0-2.2-1.8-4-4-4c-.5 0-.9.1-1.4.3L5.4 1.5c.6-.2 1.2-.4 1.8-.5l.3 3H8V1c3.9 0 7 3.1 7 7M8 5c1.7 0 3 1.3 3 3s-1.3 3-3 3s-3-1.3-3-3s1.3-3 3-3M1 8c0-1.1.2-2.1.7-3l2.7 1.2C4.2 6.8 4 7.4 4 8c0 2.2 1.8 4 4 4c.5 0 .9-.1 1.4-.3l1.2 2.8c-.6.2-1.2.4-1.8.5l-.3-3H8v3c-3.9 0-7-3.1-7-7"/>
    <path fill="currentColor" d="M10 8a2 2 0 1 1-3.999.001A2 2 0 0 1 10 8"/>
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= button_to remove_image_path(@image["Id"]),
        method: :delete,
        data: { turbo_confirm: "Remover esta imagem? Esta ação não pode ser desfeita." },
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-red-700/40 hover:bg-red-600/60 text-red-700 dark:text-red-300 border border-red-700/50 rounded-lg transition-colors" do %>
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    Remover
  <% end %>
<% end %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

  <%# ── Left column: tags + details + labels ── %>
  <div class="xl:col-span-1 space-y-5">

    <%# Tags %>
    <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-border">
        <h3 class="text-sm font-semibold text-text-primary">Tags da Imagem</h3>
      </div>
      <div class="px-4 py-3 space-y-1.5">
        <% tags = @image["RepoTags"]&.reject { |t| t == "<none>:<none>" } || [] %>
        <% digests = @image["RepoDigests"] || [] %>
        <% if tags.any? %>
          <% tags.each do |tag| %>
            <div class="flex items-center gap-2 py-1">
              <svg class="w-3.5 h-3.5 flex-shrink-0 text-cyan-500/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              <span class="font-mono text-xs text-text-secondary break-all"><%= tag %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-text-muted py-1">Sem tags (dangling)</p>
        <% end %>
        <% if digests.any? %>
          <div class="mt-2 pt-2 border-t border-border">
            <p class="text-[10px] text-text-muted uppercase tracking-wider mb-1">Digests</p>
            <% digests.each do |d| %>
              <p class="font-mono text-[10px] text-text-muted break-all"><%= d %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Image Details %>
    <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-border">
        <h3 class="text-sm font-semibold text-text-primary">Detalhes</h3>
      </div>
      <div class="divide-y divide-border">
        <%
          created_at = Time.parse(@image["Created"]) rescue nil
          details = [
            ["ID",      @image["Id"]],
            ["Tamanho", human_bytes(@image["Size"].to_i)],
            ["Criado",  created_at ? "#{created_at.strftime('%Y-%m-%d %H:%M:%S')} (#{human_age(created_at)})" : "—"],
            ["OS/Arch", "#{@image["Os"]} / #{@image["Architecture"]}#{@image["Variant"].present? ? "/#{@image["Variant"]}" : ""}"],
            ["DockerVersion", @image["DockerVersion"].presence || "—"],
            ["Author",  @image["Author"].presence || "—"],
          ]
        %>
        <% details.each do |label, value| %>
          <div class="px-4 py-2.5 flex gap-3">
            <span class="text-xs text-text-muted w-28 flex-shrink-0 pt-0.5"><%= label %></span>
            <span class="text-xs text-text-secondary font-mono break-all"><%= value %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Labels %>
    <% labels = @image.dig("Config", "Labels") || {} %>
    <% if labels.any? %>
      <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
        <div class="px-4 py-3 border-b border-border">
          <h3 class="text-sm font-semibold text-text-primary">Labels</h3>
        </div>
        <div class="divide-y divide-border">
          <% labels.each do |k, v| %>
            <div class="px-4 py-2 flex gap-3">
              <span class="text-xs text-text-muted font-mono min-w-0 flex-shrink truncate"><%= k %></span>
              <span class="text-xs text-text-secondary font-mono break-all ml-auto text-right"><%= v %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <%# ── Right column: dockerfile details + layers ── %>
  <div class="xl:col-span-2 space-y-5">

    <%# Dockerfile Config %>
    <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-border">
        <h3 class="text-sm font-semibold text-text-primary">Configuração da Imagem</h3>
      </div>
      <div class="divide-y divide-border">
        <%
          cfg = @image["Config"] || {}
          env_vars = (cfg["Env"] || []).each_with_object({}) { |e, h| k, v = e.split("=", 2); h[k] = v.to_s }
          exposed = (cfg["ExposedPorts"] || {}).keys
          cmd = Array(cfg["Cmd"]).join(" ")
          entrypoint = Array(cfg["Entrypoint"]).join(" ")
          workdir = cfg["WorkingDir"].presence || "/"
          user = cfg["User"].presence || "root"
        %>
        <% [["CMD", cmd], ["ENTRYPOINT", entrypoint], ["WORKDIR", workdir], ["USER", user]].each do |k, v| %>
          <div class="px-4 py-2.5 flex gap-3 items-start">
            <span class="text-xs text-orange-500 font-mono font-semibold w-24 flex-shrink-0 pt-0.5"><%= k %></span>
            <span class="text-xs text-text-secondary font-mono break-all"><%= v.presence || "—" %></span>
          </div>
        <% end %>
        <% if exposed.any? %>
          <div class="px-4 py-2.5 flex gap-3 items-start">
            <span class="text-xs text-orange-500 font-mono font-semibold w-24 flex-shrink-0 pt-0.5">EXPOSE</span>
            <div class="flex flex-wrap gap-1">
              <% exposed.each do |port| %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-cyan-900/30 text-cyan-300 border border-cyan-800/40"><%= port %></span>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if env_vars.any? %>
          <div class="px-4 py-3">
            <p class="text-xs text-orange-500 font-mono font-semibold mb-2">ENV</p>
            <div class="space-y-1">
              <% env_vars.each do |k, v| %>
                <div class="flex gap-3 text-xs">
                  <span class="text-text-secondary font-mono min-w-0 flex-shrink-0 w-40 truncate" title="<%= k %>"><%= k %></span>
                  <span class="text-text-muted font-mono break-all"><%= v %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Layers / History %>
    <div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-border flex items-center justify-between">
        <h3 class="text-sm font-semibold text-text-primary">Camadas da Imagem</h3>
        <span class="text-xs text-text-muted"><%= @history.size %> camadas</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-surface-inset/40">
            <tr>
              <th class="px-4 py-2 text-left text-[10px] font-semibold text-text-muted uppercase tracking-wider w-10">#</th>
              <th class="px-4 py-2 text-left text-[10px] font-semibold text-text-muted uppercase tracking-wider w-24">Tamanho</th>
              <th class="px-4 py-2 text-left text-[10px] font-semibold text-text-muted uppercase tracking-wider">Instrução</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/50">
            <% @history.each_with_index do |layer, i| %>
              <%
                created_by = (layer["CreatedBy"] || "").strip
                  .sub(%r{^/bin/sh -c #\(nop\)\s*}, "")
                  .sub(%r{^/bin/sh -c }, "RUN ")
                  .sub(%r{^buildkit\.dockerfile\.v\d+ .+?\s+}, "")
                size = layer["Size"].to_i
              %>
              <tr class="hover:bg-surface-inset/20 transition-colors">
                <td class="px-4 py-2 text-text-muted"><%= i %></td>
                <td class="px-4 py-2 font-mono <%= size > 0 ? "text-text-secondary" : "text-text-muted" %>">
                  <%= size > 0 ? human_bytes(size) : "0 B" %>
                </td>
                <td class="px-4 py-2 font-mono text-text-secondary max-w-0">
                  <div class="truncate" title="<%= html_escape(created_by) %>"><%= created_by.truncate(200) %></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
