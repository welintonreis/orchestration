<div class="max-w-xl">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h2 class="text-base font-semibold text-white mb-6">
      <%= git_connection.new_record? ? "Add Git Connection" : "Edit Git Connection" %>
    </h2>

    <%= form_with model: git_connection, class: "space-y-5" do |f| %>
      <%# Validation errors %>
      <% if git_connection.errors.any? %>
        <div class="rounded-lg bg-red-900/40 border border-red-800 px-4 py-3 text-sm text-red-300">
          <p class="font-medium mb-1">Please fix the following errors:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% git_connection.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div x-data="{ authType: '<%= git_connection.auth_type.presence || 'none' %>' }">

        <%# Name %>
        <div class="mb-5">
          <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= f.text_field :name,
                placeholder: "e.g. my-app-repo",
                class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        </div>

        <%# Repo URL %>
        <div class="mb-5">
          <%= f.label :repo_url, "Repository URL", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= f.text_field :repo_url,
                placeholder: "https://github.com/user/repo.git",
                class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        </div>

        <%# Branch %>
        <div class="mb-5">
          <%= f.label :branch, "Branch", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= f.text_field :branch,
                placeholder: "main",
                class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        </div>

        <%# Auth Type %>
        <div class="mb-5">
          <%= f.label :auth_type, "Authentication", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= f.select :auth_type,
                [["None (public repo)", "none"], ["Token / PAT", "token"], ["SSH Key", "ssh_key"]],
                {},
                class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors",
                "x-model": "authType" %>
        </div>

        <%# Token fields %>
        <div x-show="authType === 'token'" class="space-y-5 mb-5">
          <div>
            <%= f.label :username, "Username", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
            <%= f.text_field :username,
                  placeholder: "git username",
                  autocomplete: "off",
                  class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
          <div>
            <%= f.label :token_ciphertext, "Personal Access Token", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
            <%= f.password_field :token_ciphertext,
                  placeholder: "ghp_...",
                  autocomplete: "off",
                  class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
          </div>
        </div>

        <%# SSH Key field %>
        <div x-show="authType === 'ssh_key'" class="mb-5">
          <%= f.label :ssh_key_ciphertext, "SSH Private Key", class: "block text-sm font-medium text-gray-300 mb-1.5" %>
          <%= f.text_area :ssh_key_ciphertext,
                rows: 6,
                placeholder: "-----BEGIN OPENSSH PRIVATE KEY-----\n...",
                class: "w-full bg-gray-950 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 font-mono focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:border-cyan-600 transition-colors" %>
        </div>

        <%# Actions %>
        <div class="flex items-center gap-3 pt-2">
          <%= f.submit git_connection.new_record? ? "Add Connection" : "Update Connection",
                class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
          <%= link_to "Cancel", git_connections_path,
                class: "inline-flex items-center px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white text-sm font-medium rounded-lg transition-colors" %>
        </div>

      </div>
    <% end %>
  </div>
</div>
