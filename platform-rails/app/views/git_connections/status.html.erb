<%= turbo_frame_tag "git_connection_status_#{@git_connection.id}" do %>
  <% if @online %>
    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 border-green-500 text-green-500" title="Repositório acessível">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </span>
  <% else %>
    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 border-red-500 text-red-500" title="Repositório inacessível">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </span>
  <% end %>
<% end %>
