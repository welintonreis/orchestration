<% page_title "Git Connections" %>

<% content_for :title_actions do %>
  <%= link_to "New Connection", new_git_connection_path,
        class: "inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
<% end %>

<% if @git_connections.empty? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
    </svg>
    <p class="text-gray-400 text-sm">No git connections yet. Add one to start deploying from Git.</p>
    <%= link_to "New Connection", new_git_connection_path,
          class: "mt-4 inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
  </div>
<% else %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-800 bg-gray-950/60">
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider text-center">Status</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">URL</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Branch</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Auth</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Last Pull</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Stacks</th>
          <th class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @git_connections.each do |conn| %>
          <tr class="hover:bg-gray-800/40 transition-colors">
            <td class="px-4 py-3 text-center">
              <%= turbo_frame_tag "git_connection_status_#{conn.id}", src: status_git_connection_path(conn), loading: :lazy do %>
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 border-gray-700 animate-pulse"></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm font-medium text-white"><%= conn.name %></td>
            <td class="px-4 py-3 text-sm text-gray-300 font-mono truncate max-w-xs"><%= conn.repo_url %></td>
            <td class="px-4 py-3 text-sm text-gray-300">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-gray-800 text-gray-300 text-xs font-mono">
                <%= conn.branch %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-300">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                <%= conn.auth_type == 'none' ? 'bg-gray-800 text-gray-400' : 'bg-cyan-900/40 text-cyan-400 border border-cyan-800/60' %>">
                <%= conn.auth_type %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-400"><%= human_age(conn.last_pulled_at) %></td>
            <td class="px-4 py-3 text-sm text-gray-400"><%= conn.git_stacks.count %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= link_to "Edit", edit_git_connection_path(conn),
                      class: "text-xs text-gray-400 hover:text-white px-2 py-1 rounded bg-gray-800 hover:bg-gray-700 transition-colors" %>
                <%= button_to "Delete", git_connection_path(conn), method: :delete,
                      class: "text-xs text-red-400 hover:text-red-300 px-2 py-1 rounded bg-red-950/40 hover:bg-red-900/40 border border-red-800/40 transition-colors",
                      data: { turbo_confirm: "Delete connection \"#{conn.name}\"? This cannot be undone." } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
