<% page_title "Edit User — #{@user.email_address}" %>

<div class="max-w-lg">
  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <%= form_with model: @user, url: user_path(@user), method: :patch do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email_address, "Email", class: "block text-sm font-medium text-text-secondary mb-1" %>
          <%= f.email_field :email_address,
                class: "w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-cyan-600",
                required: true %>
        </div>

        <div>
          <%= f.label :password, "New Password", class: "block text-sm font-medium text-text-secondary mb-1" %>
          <p class="text-xs text-text-muted mb-1">Leave blank to keep current password</p>
          <%= f.password_field :password,
                class: "w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-text-primary focus:outline-none focus:border-cyan-600" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-text-secondary mb-1" %>
          <%= f.password_field :password_confirmation,
                class: "w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-text-primary focus:outline-none focus:border-cyan-600" %>
        </div>

        <div>
          <%= f.label :role, "Role", class: "block text-sm font-medium text-text-secondary mb-1" %>
          <%= f.select :role, User::ROLES.map { |r| [r.capitalize, r] },
                { selected: @user.role },
                class: "w-full px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-text-primary focus:outline-none focus:border-cyan-600" %>
        </div>

        <% if @user.errors.any? %>
          <div class="p-3 bg-red-100 dark:bg-red-900/40 border border-red-300 dark:border-red-800/60 rounded-lg">
            <% @user.errors.full_messages.each do |msg| %>
              <p class="text-sm text-red-700 dark:text-red-300"><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit "Save Changes", class: "btn-primary" %>
          <%= link_to "Cancel", users_path, class: "text-sm text-text-secondary hover:text-text-primary transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
