<% page_title "Users" %>

<% content_for :title_actions do %>
  <%= link_to "New User", new_user_path,
        class: "px-3 py-1.5 text-sm bg-cyan-700 hover:bg-cyan-600 text-text-primary rounded-lg transition-colors" %>
<% end %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-border text-left">
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Email</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Role</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Status</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border/60">
      <% @users.each do |user| %>
        <tr class="hover:bg-surface-inset/40 transition-colors">
          <td class="px-4 py-3">
            <span class="text-text-primary"><%= user.email_address %></span>
            <% if user == Current.user %>
              <span class="ml-1 text-[10px] text-cyan-500">(you)</span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <% role_cls = case user.role
               when "admin"    then "bg-purple-900/60 text-purple-700 dark:text-purple-300 border-purple-800/60"
               when "operator" then "bg-cyan-900/60 text-cyan-700 dark:text-cyan-300 border-cyan-800/60"
               else                 "bg-surface-inset text-text-secondary border-border-subtle"
               end %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= role_cls %>">
              <%= user.role %>
            </span>
          </td>
          <td class="px-4 py-3">
            <% if user.active %>
              <span class="inline-flex items-center gap-1 text-xs text-green-600 dark:text-green-400">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block"></span> Active
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-xs text-text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-gray-600 inline-block"></span> Inactive
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center justify-end gap-1">
              <%= link_to "Edit", edit_user_path(user),
                    class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-surface-active text-text-secondary hover:text-text-primary border border-border-subtle transition-colors" %>
              <% unless user == Current.user %>
                <%= button_to user.active ? "Deactivate" : "Activate",
                      toggle_active_user_path(user), method: :post,
                      class: "px-2 py-1 text-xs rounded bg-surface-inset #{user.active ? 'hover:bg-yellow-900/40 hover:text-yellow-700 dark:hover:text-yellow-300 hover:border-yellow-800' : 'hover:bg-green-900/40 hover:text-green-700 dark:hover:text-green-300 hover:border-green-800'} text-text-secondary border border-border-subtle transition-colors" %>
                <%= button_to "Delete", user_path(user), method: :delete,
                      class: "px-2 py-1 text-xs rounded bg-surface-inset hover:bg-red-900/40 text-text-secondary hover:text-red-600 dark:hover:text-red-400 border border-border-subtle hover:border-red-800 transition-colors",
                      data: { turbo_confirm: "Delete user #{user.email_address}? This cannot be undone." } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="px-4 py-2 border-t border-border text-xs text-text-muted">
    <%= @users.size %> user<%= @users.size == 1 ? "" : "s" %>
  </div>
</div>
