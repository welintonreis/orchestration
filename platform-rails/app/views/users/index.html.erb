<% page_title "Users" %>

<% content_for :title_actions do %>
  <%= link_to "New User", new_user_path, class: "btn-primary" %>
<% end %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-border text-left">
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Email</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Role</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Status</th>
        <th class="px-4 py-3 text-xs font-semibold text-text-muted uppercase tracking-wider text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border/60">
      <% @users.each do |user| %>
        <tr class="hover:bg-surface-inset/40 transition-colors">
          <td class="px-4 py-3">
            <span class="text-text-primary"><%= user.email_address %></span>
            <% if user == Current.user %>
              <span class="ml-1 text-[10px] text-cyan-500">(you)</span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <% role_color = case user.role
               when "admin"    then :purple
               when "operator" then :cyan
               else                 :gray
               end %>
            <%= render(Ui::BadgeComponent.new(color: role_color)) { user.role } %>
          </td>
          <td class="px-4 py-3">
            <% if user.active %>
              <%= render(Ui::BadgeComponent.new(color: :green, dot: true)) { "Active" } %>
            <% else %>
              <%= render(Ui::BadgeComponent.new(color: :gray, dot: true)) { "Inactive" } %>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center justify-end gap-1">
              <%= render Ui::ButtonComponent.new(url: edit_user_path(user), variant: :gray, size: :sm, label: "Edit") %>
              <% unless user == Current.user %>
                <%= render Ui::ButtonComponent.new(url: toggle_active_user_path(user), method: :post,
                      variant: user.active ? :yellow : :green, size: :sm,
                      label: user.active ? "Deactivate" : "Activate") %>
                <%= render Ui::ButtonComponent.new(url: user_path(user), method: :delete, variant: :red, size: :sm, label: "Delete",
                      confirm: "Delete user #{user.email_address}? This cannot be undone.") %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="px-4 py-2 border-t border-border text-xs text-text-muted">
    <%= @users.size %> user<%= @users.size == 1 ? "" : "s" %>
  </div>
</div>
