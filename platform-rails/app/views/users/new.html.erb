<% page_title "New User" %>

<div class="max-w-lg">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <%= form_with model: @user, url: users_path do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email_address, "Email", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.email_field :email_address,
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 placeholder-gray-600 focus:outline-none focus:border-cyan-600",
                placeholder: "user@example.com",
                required: true %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.password_field :password,
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:border-cyan-600",
                required: true %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.password_field :password_confirmation,
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:border-cyan-600",
                required: true %>
        </div>

        <div>
          <%= f.label :role, "Role", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.select :role, User::ROLES.map { |r| [r.capitalize, r] },
                { selected: @user.role },
                class: "w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:border-cyan-600" %>
        </div>

        <% if @user.errors.any? %>
          <div class="p-3 bg-red-900/40 border border-red-800/60 rounded-lg">
            <% @user.errors.full_messages.each do |msg| %>
              <p class="text-sm text-red-300"><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit "Create User",
                class: "px-4 py-2 bg-cyan-700 hover:bg-cyan-600 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
          <%= link_to "Cancel", users_path, class: "text-sm text-gray-400 hover:text-gray-200 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
