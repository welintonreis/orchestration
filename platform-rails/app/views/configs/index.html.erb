<% page_title "Configs" %>

<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none" />
    <path fill="currentColor" d="M12 18H4v-8h16v2.078a7 7 0 0 1 2 .603V10a2 2 0 0 0-2-2l-1.488-.015l-5.302-3.43A1.96 1.96 0 0 0 14 3a2.03 2.03 0 0 0-1-1.721V0h-1v2a1 1 0 1 1-1 1h-1a1.96 1.96 0 0 0 .796 1.56L5.5 7.984L4 8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8.08a7 7 0 0 1-.08-1.003A7 7 0 0 1 12 18m-.005-13.026L12 5c.006 0 .01-.027.017-.027L17 8H7Z" />
    <path fill="currentColor" d="M15 13.26V12a1 1 0 0 0-2 0v3.408a7 7 0 0 1 2-2.148M18 11a1 1 0 0 0-1 1v.294A7 7 0 0 1 19 12a1 1 0 0 0-1-1M6 11a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1m4 0a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1m13.879 9.319l-1.07-.83a4 4 0 0 0 .04-.49a2.6 2.6 0 0 0-.04-.49l1.06-.83a.26.26 0 0 0 .06-.32l-1-1.73a.25.25 0 0 0-.31-.11l-1.239.5a3.4 3.4 0 0 0-.85-.49l-.19-1.319a.24.24 0 0 0-.24-.21h-1.998a.26.26 0 0 0-.25.21l-.19 1.32a4 4 0 0 0-.85.49l-1.239-.5a.26.26 0 0 0-.31.11l-1 1.73a.25.25 0 0 0 .06.32l1.06.829a4 4 0 0 0 0 .98l-1.06.83a.26.26 0 0 0-.06.32l1 1.73a.25.25 0 0 0 .31.11l1.24-.5a3.4 3.4 0 0 0 .849.49l.19 1.319a.25.25 0 0 0 .25.21H20.1a.26.26 0 0 0 .25-.21l.19-1.32a3.7 3.7 0 0 0 .839-.49l1.25.5a.26.26 0 0 0 .31-.11l.999-1.73a.26.26 0 0 0-.06-.32m-4.758.18a1.5 1.5 0 1 1 1.5-1.5a1.497 1.497 0 0 1-1.5 1.5" />
  </svg>
<% end %>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden"
     x-data="{ perPage: 10, page: 1, total: <%= @configs.size %> }">
  <div class="px-5 py-4 border-b border-gray-800 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider">Configs</h2>
    <span class="text-xs text-gray-500"><%= @configs.size %> item<%= @configs.size == 1 ? "" : "s" %></span>
  </div>

  <% if @configs.empty? %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-700 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <p class="text-sm text-gray-500">Nenhuma config encontrada</p>
      <p class="text-xs text-gray-600 mt-1">Configs do Swarm aparecem aqui</p>
    </div>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-left">
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Criado em</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Labels</th>
          <th class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        <% @configs.each_with_index do |cfg, idx| %>
          <tr class="hover:bg-gray-800/30 transition-colors"
              x-show="perPage === 0 || ((<%= idx %>) >= (page - 1) * perPage && (<%= idx %>) < page * perPage)">
            <td class="px-5 py-3 font-mono text-sm text-gray-200"><%= cfg.dig("Spec", "Name") || cfg["ID"]&.first(12) %></td>
            <td class="px-5 py-3 text-xs text-gray-500">
              <% created = cfg["CreatedAt"] %>
              <%= created ? Time.parse(created).strftime("%Y-%m-%d %H:%M:%S") : "—" rescue "—" %>
            </td>
            <td class="px-5 py-3">
              <% labels = cfg.dig("Spec", "Labels") || {} %>
              <% labels.reject { |k,_| k.start_with?("com.docker") }.each do |k, v| %>
                <span class="inline-block text-[10px] font-mono bg-gray-800 text-gray-400 px-1.5 py-0.5 rounded mr-1"><%= k %>=<%= v %></span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-right">
              <% if Current.user&.admin? || Current.user&.operator? %>
                <%= button_to remove_config_path(cfg["ID"]), method: :delete,
                      class: "px-2 py-1 text-xs rounded bg-gray-800 hover:bg-red-900/40 text-gray-400 hover:text-red-400 border border-gray-700 hover:border-red-800 transition-colors",
                      data: { turbo_confirm: "Remover config #{cfg.dig("Spec","Name")}?" } do %>
                  Remover
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination" %>
  <% end %>
</div>
