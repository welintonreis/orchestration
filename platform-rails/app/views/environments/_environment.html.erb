<tr class="border-b border-border hover:bg-surface-inset/40 transition-colors">
  <%# Name %>
  <td class="px-4 py-3 text-sm font-medium text-text-primary">
    <%= environment.name %>
  </td>

  <%# Type %>
  <td class="px-4 py-3 text-sm">
    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
      <%= environment.unix? ? "bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 border border-blue-300 dark:border-blue-800" : "bg-purple-100 dark:bg-purple-900/60 text-purple-700 dark:text-purple-300 border border-purple-300 dark:border-purple-800" %>">
      <%= environment.endpoint_type.upcase %>
    </span>
  </td>

  <%# Endpoint %>
  <td class="px-4 py-3 text-sm text-text-secondary font-mono max-w-xs truncate">
    <%= environment.endpoint %>
  </td>

  <%# Status (reachability) %>
  <td class="px-4 py-3 text-sm">
    <% if reachable[environment.id] %>
      <span class="inline-flex items-center gap-1.5 text-green-600 dark:text-green-400">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
        Reachable
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 text-red-600 dark:text-red-400">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
        Unreachable
      </span>
    <% end %>
  </td>

  <%# Active badge %>
  <td class="px-4 py-3 text-sm">
    <% if environment.active? %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/60 text-green-700 dark:text-green-300 border border-green-300 dark:border-green-800">
        Active
      </span>
    <% else %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-inset text-text-muted border border-border-subtle">
        Inactive
      </span>
    <% end %>
  </td>

  <%# Actions %>
  <td class="px-4 py-3 text-sm">
    <div class="flex items-center gap-2">
      <% unless environment.active? %>
        <%= button_to "Set Active",
              activate_environment_path(environment),
              method: :post,
              class: "inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-cyan-100 dark:bg-cyan-900/50 text-cyan-700 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800 hover:bg-cyan-800/60 hover:text-cyan-200 transition-colors" %>
      <% end %>

      <% if Environment.count > 1 %>
        <%= button_to "Delete",
              environment_path(environment),
              method: :delete,
              data: { turbo_confirm: "Delete environment \"#{environment.name}\"? This cannot be undone." },
              class: "inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 border border-red-300 dark:border-red-900 hover:bg-red-100 dark:bg-red-900/70 hover:text-red-700 dark:hover:text-red-300 transition-colors" %>
      <% else %>
        <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-surface-raised text-text-muted border border-border cursor-not-allowed"
              title="Cannot delete the only environment">
          Delete
        </span>
      <% end %>
    </div>
  </td>
</tr>
