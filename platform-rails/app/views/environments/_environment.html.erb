<tr class="border-b border-border hover:bg-surface-inset/40 transition-colors">
  <%# Name %>
  <td class="px-4 py-3 text-sm font-medium text-text-primary">
    <%= environment.name %>
  </td>

  <%# Type %>
  <td class="px-4 py-3 text-sm">
    <%= render(Ui::BadgeComponent.new(color: environment.unix? ? :blue : :purple)) { environment.endpoint_type.upcase } %>
  </td>

  <%# Endpoint %>
  <td class="px-4 py-3 text-sm text-text-secondary font-mono max-w-xs truncate">
    <%= environment.endpoint %>
  </td>

  <%# Status (reachability) %>
  <td class="px-4 py-3 text-sm">
    <% if reachable[environment.id] %>
      <%= render(Ui::BadgeComponent.new(color: :green, dot: true)) { "Reachable" } %>
    <% else %>
      <%= render(Ui::BadgeComponent.new(color: :red, dot: true)) { "Unreachable" } %>
    <% end %>
  </td>

  <%# Active badge %>
  <td class="px-4 py-3 text-sm">
    <% if environment.active? %>
      <%= render(Ui::BadgeComponent.new(color: :green)) { "Active" } %>
    <% else %>
      <%= render(Ui::BadgeComponent.new(color: :gray)) { "Inactive" } %>
    <% end %>
  </td>

  <%# Actions %>
  <td class="px-4 py-3 text-sm">
    <div class="flex items-center gap-2">
      <% unless environment.active? %>
        <%= render Ui::ButtonComponent.new(url: activate_environment_path(environment), method: :post,
              variant: :solid_cyan, size: :sm, label: "Set Active") %>
      <% end %>

      <% if Environment.count > 1 %>
        <%= render Ui::ButtonComponent.new(url: environment_path(environment), method: :delete,
              variant: :solid_red, size: :sm, label: "Delete",
              confirm: "Delete environment \"#{environment.name}\"? This cannot be undone.") %>
      <% else %>
        <span class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-surface-raised text-text-muted border border-border cursor-not-allowed"
              title="Cannot delete the only environment">
          Delete
        </span>
      <% end %>
    </div>
  </td>
</tr>
