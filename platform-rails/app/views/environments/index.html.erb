<% page_title "Ambientes" %>
<% page_subtitle "Gerencie conexões com Docker hosts e ambientes de orquestração" %>
<% content_for :page_icon do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 2048 2048">
    <path fill="currentColor" d="M768 384h512v128H768zm0 768h512v128H768zm0 256h512v128H768zm1170 640H110l160-640h242V256q0-26 10-49t27-41t41-28t50-10h768q26 0 49 10t41 27t28 41t10 50v1152h242zM640 1664h768V256H640zm1134 256l-96-384h-142v256H512v-256H370l-96 384z"/>
  </svg>
<% end %>

<% content_for :title_actions do %>
  <%= link_to new_environment_path, class: "btn-primary flex items-center gap-2" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Novo Ambiente
  <% end %>
<% end %>

<% if @environments.empty? %>
  <div class="flex flex-col items-center justify-center py-32 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-text-muted mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
    </svg>
    <p class="text-text-secondary font-medium mb-1">Nenhum ambiente configurado</p>
    <p class="text-sm text-text-muted mb-6">Conecte um Docker host para começar a gerenciar</p>
    <%= link_to "Adicionar ambiente", new_environment_path, class: "btn-primary" %>
  </div>
<% else %>
  <%# Probing every environment over the Docker socket is the slowest action
      in the app (7 calls per environment). Load it lazily behind a skeleton
      so the page paints at once — see EnvironmentsController#rows. %>
  <turbo-frame id="environments-content" refresh="morph" src="<%= rows_environments_path %>">
    <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(380px,460px))]">
      <% @environments.size.times do %>
        <%= render Ui::SkeletonComponent.new(:detail) %>
      <% end %>
    </div>
  </turbo-frame>
<% end %>
