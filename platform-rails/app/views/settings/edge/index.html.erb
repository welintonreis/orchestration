<% content_for :title, "Edge Compute" %>

<div class="mb-6">
  <h2 class="text-xl font-bold text-text-primary">Edge Compute</h2>
  <p class="text-sm text-text-secondary mt-0.5">Gerencie agentes Docker em locais remotos e com conectividade limitada</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-surface-raised border border-border rounded-xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-text-primary">Configuração Edge</h3>
        <%= render(Ui::BadgeComponent.new(color: @edge_enabled ? :green : :gray)) { @edge_enabled ? "Habilitado" : "Desabilitado" } %>
      </div>

      <%= form_with url: settings_edge_path, method: :post, local: true do %>
        <div class="flex items-center justify-between py-3 border-b border-border mb-4">
          <div>
            <p class="text-sm text-text-primary">Habilitar Edge Compute</p>
            <p class="text-xs text-text-muted">Permite conexão de agentes remotos</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="edge_enabled" value="1" <%= @edge_enabled ? "checked" : "" %> class="sr-only peer">
            <div class="w-10 h-6 bg-surface-active peer-checked:bg-cyan-600 rounded-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-4"></div>
          </label>
        </div>
        <div class="mb-4">
          <label class="block text-xs font-medium text-text-secondary mb-1">Intervalo de Polling (segundos)</label>
          <input type="number" name="edge_polling_interval" value="<%= AppSetting.get('edge_polling_interval', default: '60') %>" min="5"
            class="w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500">
        </div>
        <button type="submit" class="btn-primary">Salvar</button>
      <% end %>
    </div>

    <div class="bg-surface-raised border border-border rounded-xl p-6">
      <h3 class="text-sm font-semibold text-text-primary mb-3">Chave Edge</h3>
      <p class="text-xs text-text-secondary mb-3">Use esta chave para registrar agentes edge. Mantenha-a segura.</p>
      <div class="flex items-center gap-2 mb-3">
        <code class="flex-1 px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-xs font-mono text-text-secondary break-all"><%= @edge_key %></code>
        <%= button_to "Copiar", "#", onclick: "navigator.clipboard.writeText('#{@edge_key}'); this.textContent='Copiado!'; setTimeout(() => this.textContent='Copiar', 2000); return false;", class: "btn-secondary text-xs px-3 py-2" %>
      </div>
      <%= render Ui::ButtonComponent.new(url: settings_edge_regenerate_key_path, method: :post, variant: :red, size: :sm,
          icon: :restart, label: "Regenerar Chave",
          confirm: "Regenerar a chave edge invalidará todos os agentes existentes. Continuar?") %>
    </div>

    <div class="bg-surface-raised border border-border rounded-xl p-6">
      <h3 class="text-sm font-semibold text-text-primary mb-3">Novo Node Edge</h3>
      <p class="text-xs text-text-secondary mb-3">Gera um token de enrollment de uso único (válido por 15 minutos) e o comando <code>docker run</code> pronto para colar no host remoto.</p>
      <%= form_with url: settings_edge_generate_enrollment_path, method: :post, local: true, class: "flex items-center gap-2" do %>
        <input type="text" name="node_name" placeholder="nome-do-node" required
          class="flex-1 bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500">
        <button type="submit" class="btn-primary whitespace-nowrap">Gerar Comando</button>
      <% end %>

      <% if flash[:enrollment_command] %>
        <div class="mt-4">
          <p class="text-xs text-amber-600 dark:text-amber-400 mb-2">Copie agora — este comando não será mostrado de novo (o token expira em 15 min e só pode ser usado uma vez).</p>
          <div class="flex items-start gap-2">
            <pre id="enrollment-command" class="flex-1 px-3 py-2 bg-surface-inset border border-border-subtle rounded-lg text-xs font-mono text-text-secondary whitespace-pre-wrap break-all"><%= flash[:enrollment_command] %></pre>
            <%= button_to "Copiar", "#", onclick: "navigator.clipboard.writeText(document.getElementById('enrollment-command').textContent); this.textContent='Copiado!'; setTimeout(() => this.textContent='Copiar', 2000); return false;", class: "btn-secondary text-xs px-3 py-2 whitespace-nowrap" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <div class="bg-surface-raised border border-border rounded-xl p-5">
      <h3 class="text-sm font-semibold text-text-primary mb-2">Nós Edge</h3>
      <p class="text-3xl font-bold text-text-primary"><%= @nodes.size %></p>
      <p class="text-xs text-text-muted mt-1">registrado(s)</p>
    </div>
    <div class="bg-surface-raised border border-border rounded-xl p-5">
      <h3 class="text-sm font-semibold text-text-primary mb-2">Como usar</h3>
      <ol class="text-xs text-text-secondary space-y-2 list-decimal list-inside">
        <li>Habilite o Edge Compute acima</li>
        <li>Gere um comando de enrollment com um nome pro node</li>
        <li>Cole e rode o comando no host remoto (Docker já instalado)</li>
        <li>O node aparece abaixo assim que enviar o primeiro heartbeat</li>
      </ol>
    </div>
  </div>
</div>

<div class="bg-surface-raised border border-border rounded-xl p-6 mt-6">
  <h3 class="text-sm font-semibold text-text-primary mb-4">Nós registrados</h3>
  <% if @nodes.empty? %>
    <p class="text-sm text-text-muted">Nenhum node edge registrado ainda.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs text-text-muted uppercase tracking-wide border-b border-border">
          <th class="py-2 pr-4">Nome</th>
          <th class="py-2 pr-4">Status</th>
          <th class="py-2 pr-4">Último contato</th>
          <th class="py-2 pr-4">Agente</th>
          <th class="py-2 pr-4">SO/Arch</th>
          <th class="py-2 pr-4"></th>
        </tr>
      </thead>
      <tbody>
        <% @nodes.each do |node| %>
          <tr class="border-b border-border-subtle last:border-0">
            <td class="py-2 pr-4 text-text-primary"><%= node.name %></td>
            <td class="py-2 pr-4">
              <% status_color = { "online" => :green, "offline" => :gray, "revoked" => :red }[node.status] || :gray %>
              <%= render(Ui::BadgeComponent.new(color: status_color)) { node.status.capitalize } %>
            </td>
            <td class="py-2 pr-4 text-text-secondary"><%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " atrás" : "nunca" %></td>
            <td class="py-2 pr-4 text-text-secondary"><%= node.agent_version || "—" %></td>
            <td class="py-2 pr-4 text-text-secondary"><%= [node.os, node.arch].compact.join("/").presence || "—" %></td>
            <td class="py-2 pr-4 text-right">
              <% unless node.revoked? %>
                <%= render Ui::ButtonComponent.new(url: settings_edge_revoke_node_path(node), method: :post, variant: :red, size: :sm,
                    label: "Revogar",
                    confirm: "Revogar o node \"#{node.name}\"? O agente perde acesso imediatamente.") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
