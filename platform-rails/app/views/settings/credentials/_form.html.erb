<%= form_with model: credential, url: credential.new_record? ? settings_credentials_path : settings_credential_path(credential), local: true do |f| %>
  <% if credential.errors.any? %>
    <div class="mb-4 p-3 bg-red-950/50 border border-red-800/60 rounded-lg text-sm text-red-400">
      <% credential.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, "Nome", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_field :name, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500", placeholder: "ex: Deploy Key Produção" %>
  </div>
  <div class="mb-4">
    <%= f.label :credential_type, "Tipo", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.select :credential_type, options_for_select([["SSH Key", "ssh_key"], ["Senha", "password"], ["API Token", "api_token"], ["TLS Certificate", "tls_cert"]], credential.credential_type),
        {}, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
  </div>
  <div class="mb-4">
    <%= f.label :username, "Usuário / Identificador", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_field :username, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
  </div>
  <div class="mb-4">
    <%= f.label :encrypted_secret, credential.new_record? ? "Segredo (chave/senha/token)" : "Segredo (deixe vazio para manter)", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_area :encrypted_secret, rows: 4, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary font-mono focus:outline-none focus:ring-1 focus:ring-cyan-500", placeholder: credential.credential_type == "ssh_key" ? "-----BEGIN OPENSSH PRIVATE KEY-----\n..." : "••••••••" %>
  </div>
  <div class="mb-5">
    <%= f.label :description, "Descrição", class: "block text-xs font-medium text-text-secondary mb-1" %>
    <%= f.text_area :description, rows: 2, class: "w-full bg-surface-inset border border-border-subtle rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:ring-1 focus:ring-cyan-500" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit credential.new_record? ? "Criar" : "Salvar", class: "btn-primary" %>
    <%= link_to "Cancelar", settings_credentials_path, class: "btn-secondary" %>
  </div>
<% end %>
