<% content_for :title, "Nova Credencial" %>
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <%= link_to "Credenciais", settings_credentials_path, class: "hover:text-gray-300" %> <span>/</span> <span class="text-gray-300">Nova</span>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h2 class="text-lg font-semibold text-white mb-5">Criar Credencial</h2>
    <%= render "form", credential: @credential %>
  </div>
</div>
