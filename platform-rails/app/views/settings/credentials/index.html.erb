<% content_for :title, "Credenciais Compartilhadas" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Credenciais Compartilhadas</h2>
    <p class="text-sm text-gray-400 mt-0.5">SSH keys, tokens e senhas reutilizáveis entre ambientes</p>
  </div>
  <%= link_to new_settings_credential_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nova Credencial
  <% end %>
</div>

<% type_badge = { "ssh_key" => ["SSH Key", "bg-purple-900/30 text-purple-300 border-purple-800/50"], "password" => ["Senha", "bg-gray-800 text-gray-300 border-gray-700"], "api_token" => ["API Token", "bg-cyan-900/30 text-cyan-300 border-cyan-800/50"], "tls_cert" => ["TLS Cert", "bg-orange-900/30 text-orange-300 border-orange-800/50"] } %>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-gray-500 uppercase border-b border-gray-800">
        <th class="px-4 py-3 text-left">Nome</th>
        <th class="px-4 py-3 text-left">Tipo</th>
        <th class="px-4 py-3 text-left">Usuário</th>
        <th class="px-4 py-3 text-left">Descrição</th>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @credentials.empty? %>
        <tr><td colspan="5" class="px-4 py-12 text-center text-gray-500">Nenhuma credencial criada</td></tr>
      <% else %>
        <% @credentials.each do |cred| %>
          <% badge_label, badge_cls = type_badge[cred.credential_type] || ["Unknown", "bg-gray-800 text-gray-400 border-gray-700"] %>
          <tr class="border-b border-gray-800/50 hover:bg-gray-800/20">
            <td class="px-4 py-3 font-medium text-gray-200">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <%= cred.name %>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= badge_cls %>"><%= badge_label %></span>
            </td>
            <td class="px-4 py-3 text-gray-400 font-mono text-xs"><%= cred.username %></td>
            <td class="px-4 py-3 text-gray-500 text-xs truncate max-w-xs"><%= cred.description.presence || "—" %></td>
            <td class="px-4 py-3 text-right flex items-center gap-2 justify-end">
              <%= link_to edit_settings_credential_path(cred), class: "p-1.5 rounded hover:bg-gray-800 text-gray-400 hover:text-white", title: "Editar" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to settings_credential_path(cred), method: :delete, data: { turbo_confirm: "Remover credencial #{cred.name}?" }, class: "p-1.5 rounded hover:bg-red-950 text-gray-400 hover:text-red-400", title: "Remover" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
