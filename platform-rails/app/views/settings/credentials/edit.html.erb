<% content_for :title, "Editar Credencial" %>
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-2 text-sm text-text-muted mb-4">
    <%= link_to "Credenciais", settings_credentials_path, class: "hover:text-text-secondary" %> <span>/</span> <span class="text-text-secondary">Editar</span>
  </div>
  <div class="bg-surface-raised border border-border rounded-xl p-6">
    <h2 class="text-lg font-semibold text-text-primary mb-5">Editar: <%= @credential.name %></h2>
    <%= render "form", credential: @credential %>
  </div>
</div>
