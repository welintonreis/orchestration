<% page_title "SeaweedFS S3 Storage" %>
<% page_subtitle "Gerenciamento de Object Storage S3 compatível, buckets, arquivos, identidades e credenciais" %>

<%# Three serial HTTP calls to the filer (config, buckets, listing) before the
    first byte — behind a lazy frame so the header paints immediately. %>
<turbo-frame id="seaweedfs-content" refresh="morph"
             src="<%= rows_seaweedfs_path(tab: params[:tab], bucket: params[:bucket], prefix: params[:prefix]) %>">
  <%= render Ui::SkeletonComponent.new(:toolbar) %>
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-1"><%= render Ui::SkeletonComponent.new(:detail) %></div>
    <div class="lg:col-span-3">
      <%= render Ui::SkeletonComponent.new(:table,
            columns: [ "w-56", "w-16", "w-28", :actions ], rows: 8) %>
    </div>
  </div>
</turbo-frame>
