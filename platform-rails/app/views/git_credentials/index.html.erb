<% content_for :title, "Credenciais Git" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-text-primary">Credenciais Git</h2>
    <p class="text-sm text-text-secondary mt-0.5">Tokens e chaves SSH reutilizáveis para deploy de stacks via Git</p>
  </div>
  <%= link_to new_git_credential_path, class: "btn-primary flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nova Credencial
  <% end %>
</div>

<% type_badge = { "token" => ["Token", "bg-cyan-900/30 text-cyan-300 border-cyan-800/50"], "ssh_key" => ["SSH Key", "bg-purple-900/30 text-purple-300 border-purple-800/50"] } %>

<div class="bg-surface-raised border border-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-xs text-text-muted uppercase border-b border-border">
        <th class="px-4 py-3 text-left">Nome</th>
        <th class="px-4 py-3 text-left">Site</th>
        <th class="px-4 py-3 text-left">Tipo</th>
        <th class="px-4 py-3 text-left">Usuário</th>
        <th class="px-4 py-3 text-left">Stacks usando</th>
        <th class="px-4 py-3 text-right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if @git_credentials.empty? %>
        <tr><td colspan="6" class="px-4 py-12 text-center text-text-muted">Nenhuma credencial Git criada ainda</td></tr>
      <% else %>
        <% @git_credentials.each do |cred| %>
          <% badge_label, badge_cls = type_badge[cred.auth_type] || ["—", "bg-surface-inset text-text-secondary border-border-subtle"] %>
          <tr class="border-b border-border/50 hover:bg-surface-inset/20">
            <td class="px-4 py-3 font-medium text-text-primary"><%= cred.name %></td>
            <td class="px-4 py-3 text-text-secondary font-mono text-xs"><%= cred.site %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= badge_cls %>"><%= badge_label %></span>
            </td>
            <td class="px-4 py-3 text-text-secondary font-mono text-xs"><%= cred.username.presence || "—" %></td>
            <td class="px-4 py-3 text-text-muted text-xs"><%= cred.git_stacks.size %></td>
            <td class="px-4 py-3 text-right flex items-center gap-2 justify-end">
              <%= link_to edit_git_credential_path(cred), class: "p-1.5 rounded hover:bg-surface-inset text-text-secondary hover:text-text-primary", title: "Editar" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to git_credential_path(cred), method: :delete, data: { turbo_confirm: "Remover credencial \"#{cred.name}\"?" }, class: "p-1.5 rounded hover:bg-red-950 text-text-secondary hover:text-red-400", title: "Remover" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
